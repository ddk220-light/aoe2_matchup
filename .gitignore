# Python
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Game data file (too large, users should copy from their own installation)
empires2_x2_p1.dat

# Extracted data + layer-1 inputs live under data/inputs/ (own .gitignore);
# machine-local working artifacts (sim caches, patch intermediates, local
# matchup DBs) live under data/local/
data/local/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.venv
env/

# Temporary files
*.tmp
*.temp
ANALYSIS.md

# User data
apps/website/matchup_votes.jsonl

# Battle score cache and DB (legacy locations; now under data/local/)
apps/website/battle_cache.json
apps/website/battle_scores.db

# Downloaded wiki assets (fetched via download scripts, not source)
apps/website/static/img/units-wiki/
apps/website/static/img/units-wiki-gifs/

# One-off download/scraping scripts
apps/website/download_wiki_*.py

# Scratch design notes
civ_detail_mockup.md
new-civ-view.md

# Claude Code worktree state
.claude/worktrees/
apps/website/backups/

# Raw extracted game graphics (19GB local dump; never commit)
graphics/game_raw_files/

# Keep source and the explicitly selected reusable unit library in Git.
# Unselected generated media is local-only; see docs/GIT_ASSET_POLICY.md.
# Scratch / working files
.scratch/
tmp/
.tmp_research/

# Nested checkouts and local scratch/archive folders (keep on disk, not in Git)
/.worktrees/
/.scratch_nb/
/delete_me/

# Local calibration runs, replay tapes, and downloaded source archives
/calibration/runs/
/calibration/tapes/
/calibration/source/*.zip
/aoe2x/js_simulation/calibration/source/*.zip

# Archived-but-kept files (see .old/README.md); local only
.old/

# Claude Code local state
.claude/launch.json
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Patch-pipeline local artifacts (pre-patch archives + intermediates;
# created by aoe2x/batch/patch_pipeline.py into data/local/, never committed)
data/golden/*.db.bak
apps/website/*.db.bak

# Local matchup working DB (in-repo Armenians-only stub removed 2026-06-11;
# real baselines live outside the repo, e.g. D:/AI/matchup_baseline_<build>.db)
data/local/matchup_db.db

# gRPC mTLS client credentials (CadeRemote) — NEVER commit; live beside aoe2x/grpc/
aoe2x/grpc/*.key
aoe2x/grpc/*.pem

# Portable lab machine settings and generated capture/simulation evidence
/aoe2lab.toml
/aoe2x/js_simulation/calibration/lab/
/aoe2x/js_simulation/.tmp-genieutils/
/aoe2x/js_simulation/*.log

# Local production evidence, downloaded tools, and extracted media.
# Source scripts/plans are tracked; generated media needs explicit retention.
/.tools/
/.pytest_cache/
/aoe2x/js_simulation/calibration/reports/
/aoe2x/js_simulation/calibration/live_observations/
/apps/video/media/
/apps/video/sim_v2/_work/
/apps/video/intro/assets/*.wav
/apps/video/intro/assets/*.wem
/apps/video/intro/assets/*.ogg
*.frames.bin
*.dpapi
client_secret_*.json

# New generated media is local-only at creation; source files remain eligible.
# Existing tracked application assets stay tracked. See docs/GIT_ASSET_POLICY.md.
/graphics/units/**/*.png
/graphics/units/**/*.gif
/graphics/units/**/*.jpg
/graphics/units/**/*.jpeg
/graphics/units/**/*.webp
/graphics/youtube/**/*.png
/graphics/youtube/**/*.gif
/graphics/youtube/**/*.jpg
/graphics/youtube/**/*.jpeg
/graphics/youtube/**/*.webp
/graphics/art/**/*.png
/graphics/art/**/*.gif
/graphics/art/**/*.jpg
/graphics/art/**/*.jpeg
/graphics/art/**/*.webp
# Owner excluded the old Temple Guard artwork collection; preserve local copies.
/graphics/art/temple_guard/
/graphics/extracted/**/*.png
/graphics/extracted/**/*.gif
/graphics/extracted/**/*.jpg
/graphics/extracted/**/*.jpeg
/graphics/extracted/**/*.webp
/apps/video/intro/assets/**/*.png
/apps/video/intro/assets/**/*.gif
/apps/video/intro/assets/**/*.jpg
/apps/video/intro/assets/**/*.jpeg
/apps/video/intro/assets/**/*.webp
/apps/video/intro/thumbnails/**/*.png
