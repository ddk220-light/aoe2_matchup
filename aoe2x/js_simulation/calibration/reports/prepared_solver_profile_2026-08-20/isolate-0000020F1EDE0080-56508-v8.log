script-source,157,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/melee-contact.js,import { allyCollisionRadius\x2C collisionRadius } from "./targeting.js";\n\n\nconst EPSILON = 1e-12;\n\n\nexport function isZeroRangeMelee(unit) {\n  const range = unit?.mechanics?.attack_range_tiles;\n  if (!Number.isFinite(range) || range < 0) {\n    throw new RangeError("attack range must be finite and nonnegative");\n  }\n  const melee = unit.mechanics.ranged === undefined || unit.mechanics.ranged === null;\n  return melee && range <= EPSILON;\n}\n\n\nexport function occupiesZeroRangeMeleeContact(unit) {\n  return unit?.alive !== false\n    && unit?.action === "attacking"\n    && isZeroRangeMelee(unit);\n}\n\n\nexport function hasUnobstructedZeroRangeMeleeContact(actor\x2C target\x2C units) {\n  if (!isZeroRangeMelee(actor)) return true;\n  for (const ally of units) {\n    if (ally.referenceId === actor.referenceId\n        || ally.owner !== actor.owner\n        || ally.alive === false) continue;\n    const separation = Math.max(\n      Math.abs(actor.x - ally.x)\x2C\n      Math.abs(actor.y - ally.y)\x2C\n    );\n    if (separation < allyCollisionRadius(actor) + allyCollisionRadius(ally) - EPSILON) {\n      return false;\n    }\n    if (!occupiesZeroRangeMeleeContact(ally)) continue;\n    if (collisionSquaresOverlap(actor\x2C ally)) return false;\n    if (alliedBodyIntersectsAttackLine(actor\x2C target\x2C ally)) return false;\n  }\n  return true;\n}\n\n\nfunction collisionSquaresOverlap(left\x2C right) {\n  const extent = collisionRadius(left) + collisionRadius(right);\n  return Math.max(\n    Math.abs(left.x - right.x)\x2C\n    Math.abs(left.y - right.y)\x2C\n  ) < extent - EPSILON;\n}\n\n\nfunction alliedBodyIntersectsAttackLine(actor\x2C target\x2C ally) {\n  const dx = target.x - actor.x;\n  const dy = target.y - actor.y;\n  const lengthSquared = dx * dx + dy * dy;\n  if (lengthSquared <= EPSILON * EPSILON) return false;\n  const centerProjection = ((ally.x - actor.x) * dx + (ally.y - actor.y) * dy)\n    / lengthSquared;\n  if (centerProjection <= EPSILON || centerProjection >= 1 - EPSILON) return false;\n  return segmentIntersectsSquare(actor\x2C target\x2C ally\x2C collisionRadius(ally));\n}\n\n\nfunction segmentIntersectsSquare(start\x2C end\x2C square\x2C radius) {\n  const dx = end.x - start.x;\n  const dy = end.y - start.y;\n  let entry = 0;\n  let exit = 1;\n  for (const [origin\x2C delta\x2C minimum\x2C maximum] of [\n    [start.x\x2C dx\x2C square.x - radius\x2C square.x + radius]\x2C\n    [start.y\x2C dy\x2C square.y - radius\x2C square.y + radius]\x2C\n  ]) {\n    if (Math.abs(delta) <= EPSILON) {\n      if (origin < minimum - EPSILON || origin > maximum + EPSILON) return false;\n      continue;\n    }\n    const first = (minimum - origin) / delta;\n    const second = (maximum - origin) / delta;\n    entry = Math.max(entry\x2C Math.min(first\x2C second));\n    exit = Math.min(exit\x2C Math.max(first\x2C second));\n    if (entry > exit + EPSILON) return false;\n  }\n  return exit > EPSILON && entry < 1 - EPSILON;\n}\n
