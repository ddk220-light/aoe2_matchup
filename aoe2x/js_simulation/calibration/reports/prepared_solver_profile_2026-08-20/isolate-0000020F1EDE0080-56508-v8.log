code-creation,Script,10,220244,0x27a6033ae9e,593, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/ai-orders.js:1:1,0x27a60339ca8,~
script-source,163,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/ai-orders.js,// AI-player order layer\x2C reverse-engineered from the 92-fight golden set.\x0d\n//\x0d\n// Every non-human AoE2 player has an AI issuing unit orders even with no\x0d\n// scripted AI file\x2C and the tapes show the melee being steered by it: 859\x0d\n// `Command.AiOrder` records (orderType 700\x2C immediate) whose loc sits exactly\x0d\n// on a designated enemy unit 99% of the time\x2C applied by the named units\x0d\n// within 60 ms in 81% of cases. Unit-level AI is lock-until-death; the AI\x0d\n// player is the only source of mid-fight target changes. Full derivation:\x0d\n// docs/RETARGETING_INVESTIGATION.md sections 6-7.\x0d\n//\x0d\n// Measured policy implemented here:\x0d\n//   * opening sweep starts at median 2.72 s; own units in DESCENDING reference\x0d\n//     id; units already engaged are skipped (13% of recipients were attacking\x0d\n//     vs 35% of the roster);\x0d\n//   * early orders group 2-4 adjacent-id units and designate ONE enemy for the\x0d\n//     group (the concentration mechanism); later orders are singles;\x0d\n//   * each sweep order designates a DISTINCT enemy \u2014 greedy\x0d\n//     nearest-unassigned\x2C the best resolved approximation (28.8% rank-1\x0d\n//     against an 18.1% unconditioned baseline);\x0d\n//   * one order per ~0.2 s per side during the sweep;\x0d\n//   * after the sweep\x2C units idle for ~1 s are re-ordered (recipients of\x0d\n//     mid-fight orders were idle 26.7% of the preceding second vs 7.1% for\x0d\n//     other allies).\x0d\n//\x0d\n// Orders apply instantly: pursuit target set\x2C engagement cleared.\x0d\n// AOE2X_EXP_ORDERS is pinned on as the committed default (see\x0d\n// ../engine-config.js); set AOE2X_EXP_ORDERS=0 to get the pre-calibration\x0d\n// baseline engine back.\x0d\n\x0d\nimport { ENGINE_CONFIG } from "../engine-config.js";\x0d\nimport { TICKS_PER_SECOND } from "../simulation-clock.js";\x0d\nimport { MIN_RANGE_SUPPRESSES_SHOOTER } from "./experiments.js";\nimport { collisionRadius\x2C isWithinReach\x2C surfaceGap } from "./targeting.js";\x0d\n\x0d\nexport const ORDERS_ENABLED = ENGINE_CONFIG.orders;\x0d\n// AOE2X_EXP_NO_RESCUE=1 disables the mid-fight idle rescue (probe flag: the\x0d\n// tape issues ~1 late order per fight where the rescue loop issues dozens).\x0d\nconst RESCUE_DISABLED = process.env.AOE2X_EXP_NO_RESCUE === "1";\x0d\n\x0d\nconst SWEEP_START_TICK = Math.round(2.72 * TICKS_PER_SECOND);\x0d\nconst SWEEP_ORDER_INTERVAL = Math.round(0.2 * TICKS_PER_SECOND);\x0d\nconst IDLE_RESCUE_TICKS = Math.round(1.0 * TICKS_PER_SECOND);\x0d\n// Mid-fight orders are sparse in the tape: the re-order sequences run at\x0d\n// roughly one order per 1.2-1.5 s per side (20v18 P3: 8.4\x2C 9.1\x2C 10.8\x2C 11.4\x2C\x0d\n// 11.6\x2C 13.0 ...). Without this cap the rescue recycles every idle unit\x0d\n// within a second and the attacking share overshoots the tape again.\x0d\nconst MID_ORDER_INTERVAL = Math.round(1.2 * TICKS_PER_SECOND);\x0d\nconst GROUP_ADJACENCY_TILES = 1.5;\x0d\nconst MAX_GROUP = 4;\x0d\n\x0d\n\x0d\nexport function createOrderState(units) {\x0d\n  const owners = [...new Set(units.map(({ owner }) => owner))].sort((a\x2C b) => a - b);\x0d\n  return {\x0d\n    perOwner: new Map(owners.map((owner) => [owner\x2C {\x0d\n      swept: new Set()\x2C        // reference ids already ordered in the sweep\x0d\n      designated: new Set()\x2C   // enemy ids already designated this sweep\x0d\n      nextOrderTick: SWEEP_START_TICK\x2C\x0d\n      sweepDone: false\x2C\x0d\n      nextMidOrderTick: 0\x2C\x0d\n    }]))\x2C\x0d\n    idleSince: new Map()\x2C      // reference id -> tick idling began\x0d\n    // The sweep designation is computed against positions at sweep START --\x0d\n    // measured as the better predictor of the tape's designations (rank<=2\x0d\n    // 54.7% with start positions vs 41.9% at order time): the AI plans once\x0d\n    // and the world moves while it issues.\x0d\n    sweepPositions: null\x2C      // reference id -> {x\x2C y} frozen at first order\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction distance(a\x2C b) {\x0d\n  return Math.hypot(a.x - b.x\x2C a.y - b.y);\x0d\n}\x0d\n\x0d\n\x0d\nfunction liveUnits(units\x2C owner\x2C same) {\x0d\n  return units.filter((unit) => unit.alive && ((unit.owner === owner) === same));\x0d\n}\x0d\n\x0d\n\x0d\n// Nearest designation -- used by the mid-fight idle rescue\x2C where the tape\x0d\n// does not resolve the rule beyond "a live enemy".\x0d\nfunction designate(recipient\x2C enemies\x2C designated) {\x0d\n  const fresh = enemies.filter(({ referenceId }) => !designated.has(referenceId));\x0d\n  const pool = fresh.length > 0 ? fresh : enemies;\x0d\n  let best = null;\x0d\n  let bestDistance = Infinity;\x0d\n  for (const enemy of pool) {\x0d\n    const gap = distance(recipient\x2C enemy);\x0d\n    if (gap < bestDistance || (gap === bestDistance && enemy.referenceId < best.referenceId)) {\x0d\n      best = enemy;\x0d\n      bestDistance = gap;\x0d\n    }\x0d\n  }\x0d\n  return best;\x0d\n}\x0d\n\x0d\n\x0d\n// Sweep designation walks the ENEMY roster in ascending reference id\x2C skipping\x0d\n// enemies already designated -- the mirror of the descending-id recipient\x0d\n// sweep\x2C and the best single predictor of the tape's designations: rank-1 by\x0d\n// id-ascending explains 37.8% of the 645 sweep orders with a steeply decaying\x0d\n// tail (13.3% rank 2\x2C 9.0% rank 3)\x2C against 28.8% for nearest-to-recipient.\x0d\n// Geometry-blind id order is also what produces the tape's long cross-melee\x0d\n// walks: median recipient-to-designation distance is 4.00 tiles where the\x0d\n// nearest unassigned enemy sits at 3.00.\x0d\nfunction designateSweep(enemies\x2C designated) {\x0d\n  const fresh = enemies.filter(({ referenceId }) => !designated.has(referenceId));\x0d\n  const pool = fresh.length > 0 ? fresh : enemies;\x0d\n  return pool.reduce((lowest\x2C enemy) => (\x0d\n    lowest === null || enemy.referenceId < lowest.referenceId ? enemy : lowest\x0d\n  )\x2C null);\x0d\n}\x0d\n\x0d\n\x0d\nfunction applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent) {\x0d\n  unit.pursuitTargetId = target.referenceId;\x0d\n  unit.avoidance = null;\x0d\n  // Orders are immediate: an engaged unit abandons its current engagement and\x0d\n  // walks (the tape shows named units switching mid-reload within 60 ms). An\x0d\n  // unreleased windup is NOT preserved; a released swing has already dealt its\x0d\n  // damage in this engine's model.\x0d\n  if (unit.engagedTargetId !== null && unit.engagedTargetId !== target.referenceId) {\x0d\n    unit.engagedTargetId = null;\x0d\n  }\x0d\n  if (unit.action === "attacking" && unit.attackTargetId !== target.referenceId) {\x0d\n    unit.attackTargetId = null;\x0d\n    unit.actionTimers.windup = 0;\x0d\n    unit.actionTimers.swing = 0;\x0d\n    unit.action = unit.actionTimers.reload > 0 ? "reload" : "idle";\x0d\n  }\x0d\n  events.push(makeEvent(tick\x2C "ai-order"\x2C unit.referenceId\x2C target.referenceId));\x0d\n}\x0d\n\x0d\n\x0d\nfunction applyApproachOrder(unit\x2C waypoint\x2C tick\x2C events\x2C makeEvent) {\x0d\n  unit.pursuitTargetId = null;\x0d\n  unit.engagedTargetId = null;\x0d\n  unit.avoidance = null;\x0d\n  if (unit.action === "attacking") {\x0d\n    unit.attackTargetId = null;\x0d\n    delete unit.attackKind;\x0d\n    unit.actionTimers.windup = 0;\x0d\n    unit.actionTimers.swing = 0;\x0d\n    unit.action = unit.actionTimers.reload > 0 ? "reload" : "idle";\x0d\n  }\x0d\n  events.push(makeEvent(tick\x2C "ai-location-order"\x2C unit.referenceId\x2C null\x2C {\x0d\n    x: waypoint.x\x2C\x0d\n    y: waypoint.y\x2C\x0d\n  }));\x0d\n}\x0d\n\x0d\n\x0d\nfunction sweepOrder(state\x2C units\x2C owner\x2C tick\x2C events\x2C makeEvent) {\x0d\n  const side = state.perOwner.get(owner);\x0d\n  if (!side || side.sweepDone || tick < side.nextOrderTick) return;\x0d\n  if (state.sweepPositions === null) {\x0d\n    state.sweepPositions = new Map(units.filter(({ alive }) => alive)\x0d\n      .map((unit) => [unit.referenceId\x2C { x: unit.x\x2C y: unit.y }]));\x0d\n  }\x0d\n  const mine = liveUnits(units\x2C owner\x2C true)\x0d\n    .filter((unit) => !side.swept.has(unit.referenceId))\x0d\n    .sort((a\x2C b) => b.referenceId - a.referenceId);\x0d\n  const enemies = liveUnits(units\x2C owner\x2C false);\x0d\n  if (enemies.length === 0 || mine.length === 0) {\x0d\n    side.sweepDone = true;\x0d\n    return;\x0d\n  }\x0d\n  // Skip units already fighting -- the sweep orders the ones not yet engaged.\x0d\n  const recipient = mine.find((unit) => unit.action !== "attacking" && unit.engagedTargetId === null);\x0d\n  if (!recipient) {\x0d\n    side.sweepDone = true;\x0d\n    return;\x0d\n  }\x0d\n  // Id-order designation is geometry-blind\x2C so the frozen sweep-start\x0d\n  // positions are no longer consulted here; they remain recorded for tooling.\x0d\n  const target = designateSweep(enemies\x2C side.designated);\x0d\n  if (!target) return;\x0d\n  // Group: unordered allies adjacent to the recipient (the tape groups 2-4\x0d\n  // consecutive-id units\x2C which spawn adjacent)\x2C all onto the SAME enemy.\x0d\n  const group = [recipient];\x0d\n  for (const ally of mine) {\x0d\n    if (group.length >= MAX_GROUP) break;\x0d\n    if (ally.referenceId === recipient.referenceId) continue;\x0d\n    if (ally.action === "attacking" || ally.engagedTargetId !== null) continue;\x0d\n    if (distance(ally\x2C recipient) <= GROUP_ADJACENCY_TILES) group.push(ally);\x0d\n  }\x0d\n  for (const unit of group) {\x0d\n    side.swept.add(unit.referenceId);\x0d\n    applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent);\x0d\n  }\x0d\n  side.designated.add(target.referenceId);\x0d\n  side.nextOrderTick = tick + SWEEP_ORDER_INTERVAL;\x0d\n}\x0d\n\x0d\n\x0d\nfunction idleRescue(state\x2C units\x2C tick\x2C events\x2C makeEvent) {\x0d\n  for (const unit of units) {\x0d\n    if (!unit.alive) {\x0d\n      state.idleSince.delete(unit.referenceId);\x0d\n      continue;\x0d\n    }\x0d\n    // Idle = blocked mid-walk\x2C OR standing with no pursuit at all. The second\x0d\n    // arm is what un-sticks ranged endgames: survivors can end up beyond\x0d\n    // line of sight (LOS 10 vs a 40-unit spawn footprint)\x2C acquire nothing\x2C\x0d\n    // and stand blind \u2014 the tape AI orders them across the map anyway (its\x0d\n    // designations are roster-wide\x2C never LOS-gated). Pre-acquisition units\x0d\n    // are excluded: their reaction lag has not run yet.\x0d\n    const idle = unit.action !== "attacking"\x0d\n      && unit.engagedTargetId === null\x0d\n      && (unit.experimentBlocked === true\x0d\n        || (unit.pursuitTargetId === null && unit.actionTimers.acquire === 0));\x0d\n    if (!idle) {\x0d\n      state.idleSince.delete(unit.referenceId);\x0d\n      continue;\x0d\n    }\x0d\n    if (!state.idleSince.has(unit.referenceId)) {\x0d\n      state.idleSince.set(unit.referenceId\x2C tick);\x0d\n      continue;\x0d\n    }\x0d\n    if (tick - state.idleSince.get(unit.referenceId) < IDLE_RESCUE_TICKS) continue;\x0d\n    const side = state.perOwner.get(unit.owner);\x0d\n    if (side && tick < side.nextMidOrderTick) continue;\x0d\n    const enemies = liveUnits(units\x2C unit.owner\x2C false);\x0d\n    if (enemies.length === 0) continue;\x0d\n    // Re-designate: nearest enemy NOT already pursued\x2C else nearest. The tape\x0d\n    // does not resolve the mid-fight designation rule beyond "a live enemy";\x0d\n    // avoiding the unit's own stuck target is the minimum that unsticks it.\x0d\n    const pool = enemies.filter(({ referenceId }) => referenceId !== unit.pursuitTargetId);\x0d\n    const target = designate(unit\x2C pool.length ? pool : enemies\x2C new Set());\x0d\n    if (!target) continue;\x0d\n    applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent);\x0d\n    state.idleSince.delete(unit.referenceId);\x0d\n    if (side) side.nextMidOrderTick = tick + MID_ORDER_INTERVAL;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Kiting controller\x2C measured on the aoe2_golden_kiting_* archives (25\x0d\n// arbalester-vs-champion fights; command streams decoded in full).\x0d\n//\x0d\n// The kited side is driven by a scripted shoot-and-scoot cycle\x2C NOT unit AI:\x0d\n//   * setup: a stop + stand-ground stance at 0.2 s \u2014 the group holds fire\x0d\n//     and position until the first beat (no champion hp drop precedes the\x0d\n//     first attack order in any of the 25 fights);\x0d\n//   * ATTACK order(s) every 2.00 s (p10 1.99 / p90 2.01) from ~2.0 s: a\x0d\n//     damage-bookkeeping assignment. Targets designated last beat and still\x0d\n//     alive keep shooters first (in last beat's order); fresh targets are\x0d\n//     picked nearest the group centroid (rank-1 in 352/406 fresh\x0d\n//     designations). Each target gets floor(hp / per-shot damage) + 1\x0d\n//     shooters \u2014 exactly enough to kill plus one insurance shot (per-shot\x0d\n//     damage is 5.0 on all 3270 recorded champion hp-drop quanta\x2C and the\x0d\n//     n-vs-hp p10 column reproduces hp/5 + 1 at every n) \u2014 with the\x0d\n//     remainder spilling to the next target\x2C and any leftover piling onto\x0d\n//     the last target (the tape's 15+5-on-one-champion endgame beats).\x0d\n//     WHICH kiters go to which target is geometrically arbitrary in the tape\x0d\n//     (nearest-own-target agreement ~50%\x2C chance level)\x2C so the id-ordered\x0d\n//     roster is sliced in assignment order.\x0d\n//   * MOVE order exactly 0.67 s after each beat (p10 0.66 / p90 0.68)\x2C plus\x0d\n//     one pre-fight move at ~1.3 s: a single shared waypoint + line\x0d\n//     formation. All 357 recorded waypoints sit on the perimeter lattice of\x0d\n//     the square ring centered on the map with half-size 3.0 and step 1.5\x0d\n//     (a 16-tile map gives {5\x2C 6.5\x2C 8\x2C 9.5\x2C 11} on both axes)\x2C and every one\x0d\n//     of the 25 fights walks the ring in one consistent rotational\x0d\n//     direction\x2C advancing 0-2 lattice steps per beat. Realized waypoint\x0d\n//     leads over the group's own ring projection sit at p25 3.07 / p50 3.96\x0d\n//     / p75 4.6 \u2014 reproduced by snapping (projection + 4.0) to the lattice\x0d\n//     and never regressing. The line formation is replicated by translating\x0d\n//     every unit by the shared centroid->waypoint vector (formFormation 2).\x0d\n//   * kiters do not auto-fire: every one of the 3270 champion hp drops lands\x0d\n//     0.38-1.5 s after a beat\x2C none between \u2014 one shot per kiter per order.\x0d\n//\x0d\n// The melee side receives ONE wave of ai-orders at ~0.6 s (orderType 700\x2C\x0d\n// squads pointed at distinct spread-out enemy positions) and then fights on\x0d\n// unit AI alone:\x0d\n//   * the wave is modelled as champion i -> kiter (i mod nKiters)\x2C both\x0d\n//     id-ordered \u2014 a deterministic spread;\x0d\n//   * pursuit is sticky until the target dies: the pursued arb ranks OUTSIDE\x0d\n//     the 5 nearest more often than not (7170 of 17884 heading samples are\x0d\n//     rank 6+) with pursuit distances to 13 tiles\x2C far beyond the 5-tile\x0d\n//     line of sight\x2C and champions idle >=1 s only 233 times across 25\x0d\n//     fights \u2014 so a dead target is replaced by the NEAREST live kiter\x0d\n//     immediately and LOS-blind;\x0d\n//   * chasers do NOT opportunistically attack enemies they brush past \u2014 see\x0d\n//     the kited-world engagement discipline in world.updateEngagements.\x0d\nexport const KITE_BEAT_TICKS = Math.round(2.0 * TICKS_PER_SECOND);\x0d\nexport const KITE_MOVE_OFFSET_TICKS = Math.round((2 / 3) * TICKS_PER_SECOND);\x0d\nconst KITE_FIRST_MOVE_TICK = Math.round((4 / 3) * TICKS_PER_SECOND);\x0d\nconst KITE_MELEE_ORDER_TICK = Math.round(0.6 * TICKS_PER_SECOND);\x0d\nconst KITE_RING_HALF_TILES = 3.0;\x0d\nconst KITE_RING_STEP_TILES = 1.5;\x0d\nconst KITE_WAYPOINT_LEAD_TILES = 4.0;\x0d\nconst KITE_MAP_MARGIN = 1.5;\x0d\n// Script cycle profile. Every recorded archive runs the same 0.667 s order\n// clock; the per-kiter cycle differs and is recorded in the truth fixture\x0d\n// as `kiteProfile` (a property of the recorded scenario\x2C like kiteOwner):\x0d\n//   arbalester (kac/avp): beat 2.00 s\x2C move +0.67 s\x2C pre-fight move ~1.3 s;\x0d\n//   elite skirm (esc/esp): beat 3.33 s (reload 3.0)\x2C moves +0.67 and\x0d\n//     +2.00 s\x2C pre-fight moves ~1.3/2.6 s;\x0d\n//   heavy cav archer (hcc/hcp): first beat ~0.57 s (they open firing)\x2C\x0d\n//     beat 2.00 s\x2C finishing TOP-UP designations +0.67 s\x2C move +1.33 s.\x0d\n// The default is the arbalester profile (backwards compatible with kac\x2C the\x0d\n// one recorded kiting scenario whose fixture carries no explicit profile).\x0d\n// Exported so the generated kite-profiles.js table can be pinned to it: its\x0d\n// arbalester row and this must stay identical\x2C which is what makes "that\x0d\n// fixture ran on the default" a checkable claim rather than an assumption.\x0d\n// Callers with a real kiter should pass its profile -- falling back to this\x0d\n// runs three of the four kiters on a cadence that is not theirs.\x0d\nexport const DEFAULT_KITE_PROFILE = Object.freeze({\x0d\n  beatTicks: KITE_BEAT_TICKS\x2C\x0d\n  firstBeatTick: KITE_BEAT_TICKS\x2C\x0d\n  moveOffsetTicks: Object.freeze([KITE_MOVE_OFFSET_TICKS])\x2C\x0d\n  topupOffsetTicks: Object.freeze([])\x2C\x0d\n  preMoveTicks: Object.freeze([KITE_FIRST_MOVE_TICK])\x2C\x0d\n});\x0d\n\x0d\n\x0d\nexport function createKiteState(kiteOwner\x2C kiteProfile = null\x2C chaseCapture = false\x2C\x0d\n  kitedEscape = false\x2C soloMovement = false) {\x0d\n  const profile = kiteProfile\x0d\n    ? {\x0d\n      beatTicks: kiteProfile.beatTicks\x2C\x0d\n      firstBeatTick: kiteProfile.firstBeatTick\x2C\x0d\n      moveOffsetTicks: [...kiteProfile.moveOffsetTicks]\x2C\x0d\n      topupOffsetTicks: [...(kiteProfile.topupOffsetTicks ?? [])]\x2C\x0d\n      preMoveTicks: [...(kiteProfile.preMoveTicks ?? [])]\x2C\x0d\n      ...(Number.isSafeInteger(kiteProfile.openingVolleyTick)\x0d\n          && kiteProfile.openingVolleyTick > 0\x0d\n        ? { openingVolleyTick: kiteProfile.openingVolleyTick }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.kitedPath === "clearance_grid" ? { kitedPath: "clearance_grid" } : {})\x2C\x0d\n      ...(kiteProfile.cohortMotion === "contact_heading"\x0d\n        ? { cohortMotion: "contact_heading" }\x0d\n        : {})\x2C\x0d\n      ...(Number.isFinite(kiteProfile.formationSpacingTiles)\x0d\n          && kiteProfile.formationSpacingTiles > 0\x0d\n        ? { formationSpacingTiles: kiteProfile.formationSpacingTiles }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.formationMotion === "translated_offsets"\x0d\n        ? { formationMotion: "translated_offsets" }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.openingVolley === "close_to_fire"\x0d\n        ? { openingVolley: "close_to_fire" }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.volleyPursuit === "close_to_fire"\x0d\n        ? { volleyPursuit: "close_to_fire" }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.meleeWave === "half_roster"\x0d\n        ? { meleeWave: "half_roster" }\x0d\n        : {})\x2C\x0d\n      ...(kiteProfile.meleeWave === "location_approach"\x0d\n        ? { meleeWave: "location_approach" }\x0d\n        : {})\x2C\x0d\n    }\x0d\n    : DEFAULT_KITE_PROFILE;\x0d\n  return {\x0d\n    owner: kiteOwner\x2C\x0d\n    profile\x2C\x0d\n    // Contact capture (see the block in world.updateEngagements) \u2014 a MEASURED\x0d\n    // per-scenario property\x2C like the profile: the rule itself shows in every\x0d\n    // full-rate action decode\x2C but it only stays truthful where the sim's\x0d\n    // contact rate matches the tape's switch rate. Recorded ON for the\x0d\n    // skirmisher and paladin chase archives; OFF where the sim still\x0d\n    // manufactures contacts the tape's geometry prevents (kac\x2C hcc).\x0d\n    chaseCapture: chaseCapture === true\x2C\x0d\n    // Kited-side escape steer (see world.steerProposals) \u2014 per-scenario\x2C like\x0d\n    // chaseCapture: the caught kiter executes its scripted move THROUGH\x0d\n    // attacker contact. ON where that closes the recorded matchup\x0d\n    // (hcavarcher_vs_champion\x2C the 12v21 forensics); OFF where the tape shows\x0d\n    // the escape FAILING (kac 5v10's picket ambush\x2C esc\x2C hcp) until clearance\x0d\n    // pathing can discriminate. AOE2X_EXP_STEP=kited forces it everywhere.\x0d\n    kitedEscape: kitedEscape === true\x2C\x0d\n    ...(soloMovement === true ? { soloMovement: true } : {})\x2C\x0d\n    nextBeat: profile.firstBeatTick\x2C\x0d\n    lastBeatTick: null\x2C\x0d\n    openingIssued: false\x2C\x0d\n    meleeAssigned: false\x2C\x0d\n    meleeActive: null\x2C      // ids of melee units that acquired a live target\x0d\n    ...(profile.meleeWave === "location_approach"\x0d\n      ? { meleeApproach: new Map() }\x0d\n      : {})\x2C\x0d\n    lastTargetIds: []\x2C\x0d\n    // A real fight resolves direction away from its enemy. The enemy-free\x0d\n    // movement viewer uses the same order engine with a fixed clockwise lap.\x0d\n    ringDirection: soloMovement === true ? 1 : 0\x2C\x0d\n    lastWaypointArc: null\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction centroid(list) {\x0d\n  const x = list.reduce((s\x2C u) => s + u.x\x2C 0) / list.length;\x0d\n  const y = list.reduce((s\x2C u) => s + u.y\x2C 0) / list.length;\x0d\n  return { x\x2C y };\x0d\n}\x0d\n\x0d\n\x0d\nfunction ringBounds(map) {\x0d\n  return {\x0d\n    loX: map.width / 2 - KITE_RING_HALF_TILES\x2C\x0d\n    hiX: map.width / 2 + KITE_RING_HALF_TILES\x2C\x0d\n    loY: map.height / 2 - KITE_RING_HALF_TILES\x2C\x0d\n    hiY: map.height / 2 + KITE_RING_HALF_TILES\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction ringPerimeter(bounds) {\x0d\n  return 2 * ((bounds.hiX - bounds.loX) + (bounds.hiY - bounds.loY));\x0d\n}\x0d\n\x0d\n\x0d\n// Arc coordinate (0..perimeter) of the ring point nearest (x\x2C y):\x0d\n// bottom edge left->right\x2C then right edge\x2C top edge right->left\x2C left edge.\x0d\nfunction ringArc(bounds\x2C x\x2C y) {\x0d\n  const width = bounds.hiX - bounds.loX;\x0d\n  const height = bounds.hiY - bounds.loY;\x0d\n  const cx = Math.min(Math.max(x\x2C bounds.loX)\x2C bounds.hiX);\x0d\n  const cy = Math.min(Math.max(y\x2C bounds.loY)\x2C bounds.hiY);\x0d\n  const sides = [\x0d\n    [Math.abs(y - bounds.loY)\x2C cx - bounds.loX]\x2C\x0d\n    [Math.abs(x - bounds.hiX)\x2C width + (cy - bounds.loY)]\x2C\x0d\n    [Math.abs(y - bounds.hiY)\x2C width + height + (bounds.hiX - cx)]\x2C\x0d\n    [Math.abs(x - bounds.loX)\x2C 2 * width + height + (bounds.hiY - cy)]\x2C\x0d\n  ];\x0d\n  let best = sides[0];\x0d\n  for (const side of sides) {\x0d\n    if (side[0] < best[0]) best = side;\x0d\n  }\x0d\n  const perimeter = ringPerimeter(bounds);\x0d\n  return ((best[1] % perimeter) + perimeter) % perimeter;\x0d\n}\x0d\n\x0d\n\x0d\nfunction ringPoint(bounds\x2C arc) {\x0d\n  const width = bounds.hiX - bounds.loX;\x0d\n  const height = bounds.hiY - bounds.loY;\x0d\n  const perimeter = ringPerimeter(bounds);\x0d\n  let a = ((arc % perimeter) + perimeter) % perimeter;\x0d\n  if (a < width) return { x: bounds.loX + a\x2C y: bounds.loY };\x0d\n  a -= width;\x0d\n  if (a < height) return { x: bounds.hiX\x2C y: bounds.loY + a };\x0d\n  a -= height;\x0d\n  if (a < width) return { x: bounds.hiX - a\x2C y: bounds.hiY };\x0d\n  a -= width;\x0d\n  return { x: bounds.loX\x2C y: bounds.hiY - a };\x0d\n}\x0d\n\x0d\n\x0d\nfunction signedArcDelta(a\x2C b\x2C perimeter) {\x0d\n  return ((((a - b) % perimeter) + perimeter + perimeter / 2) % perimeter)\x0d\n    - perimeter / 2;\x0d\n}\x0d\n\x0d\n\x0d\nfunction kiteOpeningAcquisition(state\x2C kiters\x2C enemies\x2C tick\x2C events\x2C makeEvent) {\x0d\n  // The opening player command does not carry the recurring volley script's\x0d\n  // damage bookkeeping. Each unit enters the ordinary target-acquisition\x0d\n  // path independently\x2C so geometry can make several shooters choose the\x0d\n  // same front target and naturally overkill it. Only a target already in\x0d\n  // the unit's attack envelope is eligible: the full-rate Phase 2 tapes show\x0d\n  // the farther members of the opening formation holding instead of chasing.\x0d\n  for (const unit of kiters) {\x0d\n    let target = null;\x0d\n    let bestGap = Infinity;\x0d\n    for (const enemy of enemies) {\x0d\n      if (!isWithinReach(unit\x2C enemy)) continue;\x0d\n      const gap = surfaceGap(unit\x2C enemy);\x0d\n      if (gap < bestGap\x0d\n        || (gap === bestGap && enemy.referenceId < target.referenceId)) {\x0d\n        target = enemy;\x0d\n        bestGap = gap;\x0d\n      }\x0d\n    }\x0d\n    if (target === null) continue;\x0d\n    delete unit.moveOrder;\x0d\n    unit.actionTimers.acquire = 0;\x0d\n    applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent);\x0d\n  }\x0d\n  state.openingIssued = true;\x0d\n}\x0d\n\x0d\n\x0d\nfunction kiteAttackBeat(state\x2C kiters\x2C enemies\x2C tick\x2C events\x2C makeEvent) {\x0d\n  // NOT MODELLED YET: minimum range suppresses the SHOOTER\x2C not just the one\x0d\n  // target it was aimed at. The tape's AI names every shooter here (439\x0d\n  // assignments in the skirm-vs-camel fight) but only 233 arrows leave\x2C and the\x0d\n  // split is the shooter's own min_range: firers had their nearest chaser at\x0d\n  // p50 2.2 tiles\x2C holders at p50 1.0. Confirmed on esc 20v20 measured at\x0d\n  // windup start (4.0% of launches begin with an enemy inside 1.0 vs 18.2% of\x0d\n  // the alive population) with the arbalester column\x2C min_range 0.0\x2C as a\x0d\n  // control that shows no depletion at all. Implementing it costs esc dearly\x0d\n  // (band error 2.5 -> 13.5) because the rule's cost scales with how long a\x0d\n  // chaser sits inside min_range of our shooters\x2C and ours sit there 57.3% of\x0d\n  // shooter-frames against the tape's 22.9%: blocked chasers grind at partial\x0d\n  // speed instead of routing around\x2C so the block engulfs them. Chaser\x0d\n  // mobility has to come first. See docs/CAMEL_CHASER_GEOMETRY_2026-08-06.md.\x0d\n  const shooters = MIN_RANGE_SUPPRESSES_SHOOTER\x0d\n    ? kiters.filter((unit) => {\x0d\n      const range = unit.mechanics?.ranged?.min_range_tiles ?? 0;\x0d\n      if (!(range > 0)) return true;\x0d\n      return !enemies.some((enemy) => Math.hypot(enemy.x - unit.x\x2C enemy.y - unit.y) < range);\x0d\n    })\x0d\n    : kiters;\x0d\n  const roster = [...shooters].sort((a\x2C b) => a.referenceId - b.referenceId);\n  if (roster.length === 0) return;\n  const directOpening = state.openingIssued !== true\n    && state.lastBeatTick === null\n    && (state.profile.openingVolley === "close_to_fire"\n      || state.profile.volleyPursuit === "close_to_fire");\n  const closingBeat = directOpening || state.profile.volleyPursuit === "close_to_fire";\n  const assigned = [];\n  const enemyById = new Map(enemies.map((enemy) => [enemy.referenceId\x2C enemy]));\n  // A volley command does not allocate an HP-aware damage budget. Every\n  // shooter performs ordinary closest-target selection from its own position\x2C\n  // so several shooters can naturally choose and overkill the same body. A\n  // live reachable target remains sticky; closest-target selection runs when\n  // that target is gone or no longer eligible\x2C rather than globally reshuffling\n  // the whole cohort on every beat.\n  for (const unit of roster) {\n    const eligible = (enemy) => {\n      const withinSight = Math.hypot(enemy.x - unit.x\x2C enemy.y - unit.y)\n        <= (unit.mechanics?.line_of_sight_tiles ?? 0) + 1e-12;\n      return isWithinReach(unit\x2C enemy) || (closingBeat && withinSight);\n    };\n    let target = enemyById.get(unit.pursuitTargetId) ?? null;\n    if (!target || !target.alive || !eligible(target)) {\n      target = null;\n      let bestGap = Infinity;\n      for (const enemy of enemies) {\n        if (!eligible(enemy)) continue;\n        const gap = surfaceGap(unit\x2C enemy);\n        if (gap < bestGap\n          || (gap === bestGap && (target === null || enemy.referenceId < target.referenceId))) {\n          target = enemy;\n          bestGap = gap;\n        }\n      }\n    }\n    if (target === null) continue;\n    delete unit.moveOrder;\n    if (directOpening) unit.actionTimers.acquire = 0;\n    applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent);\n    assigned.push(target.referenceId);\n  }\n  state.lastTargetIds = [...new Set(assigned)];\n}\n\x0d\n\x0d\nfunction kiteMoveOrder(state\x2C kiters\x2C enemies\x2C map\x2C tick\x2C events\x2C makeEvent) {\x0d\n  const bounds = ringBounds(map);\x0d\n  const perimeter = ringPerimeter(bounds);\x0d\n  const own = centroid(kiters);\x0d\n  const arc = ringArc(bounds\x2C own.x\x2C own.y);\x0d\n  if (state.ringDirection === 0) {\x0d\n    const foe = centroid(enemies);\x0d\n    // One-time direction choice: whichever way's first waypoint ends farther\x0d\n    // from the chasing side. Every recorded fight runs a single consistent\x0d\n    // direction picked at the start.\x0d\n    const forward = ringPoint(bounds\x2C arc + KITE_WAYPOINT_LEAD_TILES);\x0d\n    const backward = ringPoint(bounds\x2C arc - KITE_WAYPOINT_LEAD_TILES);\x0d\n    const forwardAway = Math.hypot(forward.x - foe.x\x2C forward.y - foe.y);\x0d\n    const backwardAway = Math.hypot(backward.x - foe.x\x2C backward.y - foe.y);\x0d\n    state.ringDirection = forwardAway >= backwardAway ? 1 : -1;\x0d\n  }\x0d\n  let snapped = Math.round(\x0d\n    (arc + state.ringDirection * KITE_WAYPOINT_LEAD_TILES) / KITE_RING_STEP_TILES\x2C\x0d\n  ) * KITE_RING_STEP_TILES;\x0d\n  if (state.lastWaypointArc !== null\x0d\n      && signedArcDelta(snapped\x2C state.lastWaypointArc\x2C perimeter)\x0d\n        * state.ringDirection < 0) {\x0d\n    snapped = state.lastWaypointArc;\x0d\n  }\x0d\n  state.lastWaypointArc = snapped;\x0d\n  const waypoint = ringPoint(bounds\x2C snapped);\x0d\n  // Formation slots (formFormation 2 in the tape): the recorded group\x0d\n  // converges into a compact grid \u2014 20 units hold ~2.0 x 2.3 tiles with\x0d\n  // nearest-neighbor spacing p50 0.29-0.43 \u2014 and REFORMS every cycle:\x0d\n  // arrived units stop while stragglers keep walking (tape arb median\x0d\n  // displacement 0.40 tiles/s against a 0.64 duty-cycle ceiling). A shared\x0d\n  // per-unit translate cannot reform (laggards stay laggards and get picked\x0d\n  // off)\x2C so each unit is ordered to its own absolute slot in a grid\x0d\n  // centered on the waypoint: ~sqrt(n) columns across the travel\x0d\n  // perpendicular\x2C 0.5-tile spacing (collision diameter 0.4 + margin)\x2C\x0d\n  // ranks trailing the waypoint. Units map to slots in matching (perp\x2C\x0d\n  // along) sort order so the formation never crosses itself.\x0d\n  let tx = waypoint.x - own.x;\x0d\n  let ty = waypoint.y - own.y;\x0d\n  const norm = Math.hypot(tx\x2C ty);\x0d\n  if (norm > 1e-9) {\x0d\n    tx /= norm;\x0d\n    ty /= norm;\x0d\n  } else {\x0d\n    const ahead = ringPoint(bounds\x2C snapped + state.ringDirection * 0.5);\x0d\n    const tangent = Math.hypot(ahead.x - waypoint.x\x2C ahead.y - waypoint.y);\x0d\n    tx = tangent > 1e-9 ? (ahead.x - waypoint.x) / tangent : 1;\x0d\n    ty = tangent > 1e-9 ? (ahead.y - waypoint.y) / tangent : 0;\x0d\n  }\x0d\n  const px = -ty;\x0d\n  const py = tx;\x0d\n  const count = kiters.length;\x0d\n  const columns = Math.max(1\x2C Math.ceil(Math.sqrt(count)));\x0d\n  const hasSourcedBodies = kiters.every((unit) => (\x0d\n    Number.isFinite(unit.mechanics?.collision_size_tiles?.x)\x0d\n    && Number.isFinite(unit.mechanics?.collision_size_tiles?.y)\x0d\n  ));\x0d\n  const spacing = state.profile.formationSpacingTiles\x0d\n    ?? (hasSourcedBodies\x0d\n      ? 2 * Math.max(...kiters.map((unit) => collisionRadius(unit)))\x0d\n      : 0.5);\x0d\n  const slots = [];\x0d\n  for (let index = 0; index < count; index += 1) {\x0d\n    const column = index % columns;\x0d\n    const row = Math.floor(index / columns);\x0d\n    slots.push({\x0d\n      perp: (column - (columns - 1) / 2) * spacing\x2C\x0d\n      along: -row * spacing\x2C\x0d\n    });\x0d\n  }\x0d\n  slots.sort((a\x2C b) => (a.perp !== b.perp ? a.perp - b.perp : a.along - b.along));\x0d\n  const orderedUnits = [...kiters].map((unit) => ({\x0d\n    unit\x2C\x0d\n    perp: (unit.x - own.x) * px + (unit.y - own.y) * py\x2C\x0d\n    along: (unit.x - own.x) * tx + (unit.y - own.y) * ty\x2C\x0d\n  })).sort((a\x2C b) => (\x0d\n    a.perp !== b.perp ? a.perp - b.perp\x0d\n      : (a.along !== b.along ? a.along - b.along\x0d\n        : a.unit.referenceId - b.unit.referenceId)));\x0d\n  const clampX = (value) => Math.min(map.width - KITE_MAP_MARGIN\x2C\x0d\n    Math.max(KITE_MAP_MARGIN\x2C value));\x0d\n  const clampY = (value) => Math.min(map.height - KITE_MAP_MARGIN\x2C\x0d\n    Math.max(KITE_MAP_MARGIN\x2C value));\x0d\n  orderedUnits.forEach(({ unit }\x2C index) => {\x0d\n    const slot = slots[index];\x0d\n    const translatedOffsets = state.profile.formationMotion === "translated_offsets";\x0d\n    unit.moveOrder = Object.freeze({\x0d\n      x: clampX(translatedOffsets\x0d\n        ? unit.x + waypoint.x - own.x\x0d\n        : waypoint.x + px * slot.perp + tx * slot.along)\x2C\x0d\n      y: clampY(translatedOffsets\x0d\n        ? unit.y + waypoint.y - own.y\x0d\n        : waypoint.y + py * slot.perp + ty * slot.along)\x2C\x0d\n    });\x0d\n    unit.engagedTargetId = null;\x0d\n    // Cancel only an unreleased swing (windup still pending); a released\x0d\n    // swing has already dealt its damage in this engine's model.\x0d\n    if (unit.action === "attacking" && unit.actionTimers.windup > 0) {\x0d\n      unit.attackTargetId = null;\x0d\n      delete unit.attackKind;\x0d\n      unit.actionTimers.windup = 0;\x0d\n      unit.actionTimers.swing = 0;\x0d\n      unit.action = unit.actionTimers.reload > 0 ? "reload" : "idle";\x0d\n    }\x0d\n    events.push(makeEvent(tick\x2C "kite-move"\x2C unit.referenceId\x2C null\x2C {\x0d\n      x: unit.moveOrder.x\x2C\x0d\n      y: unit.moveOrder.y\x2C\x0d\n    }));\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function issueKiteOrders(state\x2C units\x2C map\x2C tick\x2C events\x2C makeEvent) {\x0d\n  if (!state) return;\x0d\n  const kiters = units.filter((unit) => unit.alive && unit.owner === state.owner);\x0d\n  const enemies = units.filter((unit) => unit.alive && unit.owner !== state.owner);\x0d\n  const soloMovement = state.soloMovement === true && enemies.length === 0;\x0d\n  if (kiters.length === 0 || (enemies.length === 0 && !soloMovement)) return;\x0d\n\x0d\n  // Pre-fight hold (the tape's stop + stand-ground at 0.2 s): anchor every\x0d\n  // kiter to its spawn until the first move order so nobody drifts toward an\x0d\n  // acquired target or fires before the first beat.\x0d\n  if (tick === 1) {\x0d\n    for (const unit of kiters) {\x0d\n      unit.moveOrder = Object.freeze({ x: unit.x\x2C y: unit.y });\x0d\n    }\x0d\n  }\x0d\n\x0d\n  // Enemy-free movement inspection: preserve the kiter's tape-derived order\x0d\n  // clock and formation movement\x2C but skip attack and melee designation. For\x0d\n  // Hand Cannoneers this publishes a new movement order every 80 ticks.\x0d\n  if (soloMovement) {\x0d\n    const { profile } = state;\x0d\n    if (tick === state.nextBeat) {\x0d\n      state.lastBeatTick = tick;\x0d\n      state.nextBeat = tick + profile.beatTicks;\x0d\n      return;\x0d\n    }\x0d\n    if (state.lastBeatTick === null) {\x0d\n      if (profile.preMoveTicks.includes(tick)) {\x0d\n        kiteMoveOrder(state\x2C kiters\x2C enemies\x2C map\x2C tick\x2C events\x2C makeEvent);\x0d\n      }\x0d\n      return;\x0d\n    }\x0d\n    if (profile.moveOffsetTicks.includes(tick - state.lastBeatTick)) {\x0d\n      kiteMoveOrder(state\x2C kiters\x2C enemies\x2C map\x2C tick\x2C events\x2C makeEvent);\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const { profile } = state;\x0d\n  // Phase 2 begins with a one-off player attack command before the recurring\x0d\n  // move/fire script. Keep that order separate: using it as the first beat\x0d\n  // shifts every later movement order and creates a different battle.\x0d\n  if (tick === profile.openingVolleyTick) {\x0d\n    kiteOpeningAcquisition(state\x2C kiters\x2C enemies\x2C tick\x2C events\x2C makeEvent);\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  // Melee-side order wave at ~0.6 s. Coverage is measured and EXACT across\x0d\n  // all six archives: the wave orders all but the FOUR lowest-id units\x0d\n  // (10 champions -> 6 ordered\x2C 15 -> 11\x2C 20 -> 16\x2C the unordered always\x0d\n  // being the lowest 4 ids) \u2014 and a side of exactly 5 gets ONE aiOrder to\x0d\n  // the single HIGHEST id\x2C i.e. the same slice(4): the command streams\x0d\n  // record recipient 1609\x2C orderType 700\x2C location = the kiter-group\x0d\n  // centroid\x2C in every 10v5 of every archive. The other four are spawn\x0d\n  // pickets: they stand until an enemy walks into their line of sight\x0d\n  // (engine acquisition) \u2014 the steppe 10v5 tapes show 1605/1608 frozen at\x0d\n  // spawn for 20+ s while the lap stays clear (kac's pickets acquired\x0d\n  // within ~2 s by spawn geometry\x2C which is what the old covers-everyone\x0d\n  // reading mistook for order coverage)\x2C and the recorded 5v10 collapses\x0d\n  // when two pickets first move at 15.0 s and 19.1 s\x2C exactly as the\x0d\n  // kiting lap reaches their corner. A single-recipient wave aims at the\x0d\n  // order's location \u2014 the kiter nearest the group centroid (1273 in\x0d\n  // every recorded 10v5\x2C matching designate's fresh pick); a multi-unit\x0d\n  // wave keeps the measured deterministic spread. Ordered chasers whose\x0d\n  // target has died re-designate the nearest live kiter immediately and\x0d\n  // LOS-blind (chasers idle >= 1 s only 233 short times across 25 fights).\x0d\n  if (state.opponentMode !== "ordinary-ranged" && !state.meleeAssigned) {\n    if (tick === KITE_MELEE_ORDER_TICK) {\x0d\n      const melee = [...enemies].sort((a\x2C b) => a.referenceId - b.referenceId);\x0d\n      if (state.meleeOpeningOrder === "attack-move-all") {\x0d\n        const waypoint = centroid(kiters);\x0d\n        if (state.alliedTransit) {\x0d\n          state.alliedTransit.cohort = new Set(melee.map(({ referenceId }) => referenceId));\x0d\n        }\x0d\n        for (const unit of melee) {\x0d\n          state.meleeApproach.set(unit.referenceId\x2C waypoint);\x0d\n          applyApproachOrder(unit\x2C waypoint\x2C tick\x2C events\x2C makeEvent);\x0d\n          // Attack-move scans while advancing. Arm acquisition now so a\x0d\n          // visible enemy interrupts the location order on the next tick;\x0d\n          // an out-of-sight unit keeps walking toward the waypoint and scans\x0d\n          // again every tick until something enters line of sight.\x0d\n          unit.actionTimers.acquire = 0;\x0d\n        }\x0d\n        state.meleeActive = new Set();\x0d\n        state.meleeAssigned = true;\x0d\n        return;\x0d\n      }\x0d\n      const wave = melee.slice(state.profile.meleeWave === "half_roster"\x0d\n        ? Math.ceil(melee.length / 2)\x0d\n        : 4);\x0d\n      const spread = [...kiters].sort((a\x2C b) => a.referenceId - b.referenceId);\x0d\n      if (state.profile.meleeWave === "location_approach") {\x0d\n        wave.forEach((unit\x2C index) => {\x0d\n          const anchor = spread[index % spread.length];\x0d\n          const waypoint = { x: anchor.x\x2C y: anchor.y };\x0d\n          state.meleeApproach.set(unit.referenceId\x2C waypoint);\x0d\n          applyApproachOrder(unit\x2C waypoint\x2C tick\x2C events\x2C makeEvent);\x0d\n        });\x0d\n      } else if (wave.length === 1) {\x0d\n        // The recorded single order carries location = the kiter-group\x0d\n        // centroid; the recipient's first pursuit is the kiter nearest it.\x0d\n        const anchor = centroid(kiters);\x0d\n        let target = null;\x0d\n        let bestGap = Infinity;\x0d\n        for (const kiter of kiters) {\x0d\n          const gap = Math.hypot(kiter.x - anchor.x\x2C kiter.y - anchor.y);\x0d\n          if (gap < bestGap\x0d\n            || (gap === bestGap && kiter.referenceId < target.referenceId)) {\x0d\n            target = kiter;\x0d\n            bestGap = gap;\x0d\n          }\x0d\n        }\x0d\n        if (target) applyOrder(wave[0]\x2C target\x2C tick\x2C events\x2C makeEvent);\x0d\n      } else {\x0d\n        wave.forEach((unit\x2C index) => {\x0d\n          applyOrder(unit\x2C spread[index % spread.length]\x2C tick\x2C events\x2C makeEvent);\x0d\n        });\x0d\n      }\x0d\n      state.meleeActive = new Set(state.profile.meleeWave === "location_approach"\x0d\n        ? []\x0d\n        : wave.map(({ referenceId }) => referenceId));\x0d\n      state.meleeAssigned = true;\x0d\n    }\x0d\n  } else if (state.opponentMode !== "ordinary-ranged") {\n    for (const unit of enemies) {\x0d\n      if (unit.pursuitTargetId !== null && unit.pursuitTargetId !== undefined) {\x0d\n        // A picket that acquired through line of sight joins the active set\x0d\n        // and re-designates like any chaser from then on.\x0d\n        state.meleeApproach?.delete(unit.referenceId);\x0d\n        state.meleeActive.add(unit.referenceId);\x0d\n        continue;\x0d\n      }\x0d\n      if (state.meleeApproach?.has(unit.referenceId)) continue;\x0d\n      if (!state.meleeActive.has(unit.referenceId)) continue;\x0d\n      const target = designate(unit\x2C kiters\x2C new Set());\x0d\n      if (target) applyOrder(unit\x2C target\x2C tick\x2C events\x2C makeEvent);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (tick === state.nextBeat) {\x0d\n    kiteAttackBeat(state\x2C kiters\x2C enemies\x2C tick\x2C events\x2C makeEvent);\x0d\n    state.lastBeatTick = tick;\x0d\n    state.nextBeat = tick + profile.beatTicks;\x0d\n    return;\x0d\n  }\x0d\n  if (state.lastBeatTick === null) {\x0d\n    if (profile.preMoveTicks.includes(tick)) {\x0d\n      kiteMoveOrder(state\x2C kiters\x2C enemies\x2C map\x2C tick\x2C events\x2C makeEvent);\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n  const offset = tick - state.lastBeatTick;\x0d\n  if (profile.topupOffsetTicks.includes(offset)) {\x0d\n    // Finishing top-up: re-run the bookkeeping designation against current\x0d\n    // hit points. Units already reloading keep their cycle; only shooters\x0d\n    // that have not fired yet (still closing) change aim \u2014 the recorded\x0d\n    // top-ups are 1-2 unit finishing commands.\x0d\n    kiteAttackBeat(state\x2C kiters\x2C enemies\x2C tick\x2C events\x2C makeEvent);\x0d\n    return;\x0d\n  }\x0d\n  if (profile.moveOffsetTicks.includes(offset)) {\x0d\n    kiteMoveOrder(state\x2C kiters\x2C enemies\x2C map\x2C tick\x2C events\x2C makeEvent);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Called once per tick from stepWorld\x2C before movement. A kited side is\x0d\n// driven exclusively by its beat controller: the sweep and the rescue skip\x0d\n// it entirely.\x0d\nexport function issueOrders(state\x2C units\x2C tick\x2C events\x2C makeEvent\x2C kiteOwner = null) {\x0d\n  if (!ORDERS_ENABLED || !state) return;\x0d\n  const owners = [...state.perOwner.keys()].filter((owner) => owner !== kiteOwner);\x0d\n  for (const owner of owners) sweepOrder(state\x2C units\x2C owner\x2C tick\x2C events\x2C makeEvent);\x0d\n  if (RESCUE_DISABLED) return;\x0d\n  const allSwept = owners.every((owner) => state.perOwner.get(owner).sweepDone);\x0d\n  if (allSwept || tick > SWEEP_START_TICK + 20 * TICKS_PER_SECOND) {\x0d\n    idleRescue(state\x2C units.filter((unit) => unit.owner !== kiteOwner)\x2C\x0d\n      tick\x2C events\x2C makeEvent);\x0d\n  }\x0d\n}\x0d\n
