script-source,159,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/experiments.js,// TEMPORARY experiment harness for the retargeting investigation.\x0d\n//\x0d\n// AOE2X_EXP_ENGAGEMENT and AOE2X_EXP_ORDERS are pinned to their calibrated\x0d\n// values ("pursuit" and on) as the committed default -- see\x0d\n// ../engine-config.js. Every locked gate and golden baseline measured under\x0d\n// that engine is what "default" now means. The other flags below remain OFF\x0d\n// by default. To get the pre-calibration baseline engine back\x2C set\x0d\n// AOE2X_EXP_ENGAGEMENT=free (engine-config.js maps that sentinel to ""\x2C since\x0d\n// PowerShell's `$env:X = ""` deletes rather than sets) and\x0d\n// AOE2X_EXP_ORDERS=0. Delete this module and its two call sites in world.js\x0d\n// once the retargeting rule is settled.\x0d\n//\x0d\n// See docs/RETARGETING_INVESTIGATION.md for the matrix these flags implement.\x0d\n//\x0d\n//   AOE2X_EXP_ENGAGEMENT = "pursuit"\x0d\n//       A unit engages the target it is PURSUING and nothing else\x2C instead of\x0d\n//       whatever enemy drifts into reach. Without this\x2C moveUnits refuses to\x0d\n//       move an "attacking" unit\x2C so a unit en route is captured by the first\x0d\n//       body it brushes past and never arrives.\x0d\n//\x0d\n//   AOE2X_EXP_PURSUIT = "tick" | "blocked" | "swing" | "blocked+swing"\x0d\n//       When a unit re-evaluates a still-living pursuit target.\x0d\n//       "blocked" fires on the engine's existing blocked condition (actual\x0d\n//       movement differed from the proposal) -- a physics trigger\x2C not a\x0d\n//       tuned constant.\x0d\n\x0d\n//   AOE2X_EXP_AVOID = "all"\x0d\n//       Local avoidance routes around EVERY live body\x2C not only allies. The\x0d\n//       tapes show chasers keeping full speed around the enemy formation\x0d\n//       (camel speed is bimodal: 46.1% stopped\x2C 52.9% at the dat 1.595\x2C 0.6%\x0d\n//       in between)\x2C which an ally-only constraint set cannot produce.\x0d\n//\x0d\n//   AOE2X_EXP_STEP = "bimodal" | "steer" | "chaser"\x0d\n//       "bimodal": a step the collision solver had to shorten becomes no step\x0d\n//       at all. Genie units never grind along a body -- see the histogram\x0d\n//       above and docs/CAMEL_CHASER_GEOMETRY_2026-08-06.md.\x0d\n//       "steer": the same\x2C plus a blocked unit first looks for a clear\x0d\n//       full-speed heading near the one it wanted\x2C so it walks AROUND the\x0d\n//       body instead of stopping dead in front of it. Cancelling without\x0d\n//       steering strands the kite formation (duty cycle 0.18 against the\x0d\n//       tape's 0.79).\x0d\n//       "chaser": bimodal cancellation applied ONLY to the chasing side of a\x0d\n//       kited scenario (world.kiteState present\x2C unit not on the kiting\x0d\n//       side). The blanket modes above each fail for a measured reason --\x0d\n//       bimodal strands the kite block\x2C steer lets it escape forever\x2C and\x0d\n//       both perturb every melee fight. The 12v21 hcc forensics\x0d\n//       (STANDARD_UNITS_SUMMARY_2026-08-07) show the defect only DECIDES\x0d\n//       kited chases: sim chasers grind along the ball at partial speed\x0d\n//       (7.5-15.4% of approach-band frames vs the tape's 0.6-0.8%)\x2C pinning\x0d\n//       the median chaser-to-kiter gap at 0.75 tiles vs the tape's 1.6.\x0d\n//       Scoping to kited chasers leaves every non-kited fight bit-identical.\x0d\n\x0d\nimport { ENGINE_CONFIG } from "../engine-config.js";\x0d\n\x0d\nconst engagement = ENGINE_CONFIG.engagement;\x0d\nconst pursuit = ENGINE_CONFIG.pursuit;\x0d\nconst orders = ENGINE_CONFIG.orders ? "1" : "";\x0d\nconst avoid = ENGINE_CONFIG.avoid;\x0d\nconst step = ENGINE_CONFIG.step;\x0d\n// AOE2X_EXP_MINRANGE=shooter -- minimum range holds the SHOOTER\x2C not just the\x0d\n// one target it aimed at: a kiter with any enemy inside min_range is not given\x0d\n// a shot this beat. Measured on the camel tape (439 named shooters\x2C 233 arrows\x0d\n// away\x2C 225 of them hits; firers' nearest chaser p50 2.2 tiles against holders'\x0d\n// 1.0) with the min_range-0 arbalester column as a null control.\x0d\nconst minRange = ENGINE_CONFIG.minRange;\x0d\n// AOE2X_EXP_KITE_ENGAGE=blocker -- a kited-world chaser that is physically\x0d\n// blocked engages whatever enemy is stopping it\x2C instead of holding out for\x0d\n// its sticky pursuit target.\x0d\nconst kiteEngage = ENGINE_CONFIG.kiteEngage;\x0d\n// AOE2X_EXP_CHASE_PATH=grid -- per-unit obstacle-aware pursuit pathing\x0d\n// (src/combat/chase-path.js): each kited-world chaser plans a coarse A* route\x0d\n// to its own target around the actual unit bodies before walking. This is the\x0d\n// plan step the 12v21 forensics called for -- the tape's chasers hold a\x0d\n// 1.4-2.1 tile median gap at full speed\x2C which no local per-step rule\x0d\n// reproduces without stranding a catching column (the measured ladder in\x0d\n// docs/HCC_CHASER_MOBILITY_2026-08-07.md). A tangent-disc variant ("ball")\x0d\n// was measured and rejected: it flips hcavarcher_vs_paladin 20v15 (corpus\x0d\n// 576.3 / 3 wrong winners vs grid's 522.7 / 1).\x0d\nconst chasePath = ENGINE_CONFIG.chasePath;\x0d\n\x0d\nconst VALID_ENGAGEMENT = new Set([""\x2C "pursuit"]);\x0d\nconst VALID_PURSUIT = new Set([""\x2C "tick"\x2C "blocked"\x2C "swing"\x2C "blocked+swing"]);\x0d\nconst VALID_AVOID = new Set([""\x2C "all"]);\x0d\nconst VALID_STEP = new Set([""\x2C "bimodal"\x2C "steer"\x2C "chaser"\x2C "kited"]);\x0d\nconst VALID_MIN_RANGE = new Set([""\x2C "shooter"]);\x0d\nconst VALID_KITE_ENGAGE = new Set([""\x2C "blocker"]);\x0d\nconst VALID_CHASE_PATH = new Set([""\x2C "grid"]);\x0d\n\x0d\nif (!VALID_ENGAGEMENT.has(engagement)) {\x0d\n  throw new RangeError(`AOE2X_EXP_ENGAGEMENT must be one of ""\x2C "pursuit"`);\x0d\n}\x0d\nif (!VALID_PURSUIT.has(pursuit)) {\x0d\n  throw new RangeError(\x0d\n    `AOE2X_EXP_PURSUIT must be one of ""\x2C "tick"\x2C "blocked"\x2C "swing"\x2C "blocked+swing"`\x2C\x0d\n  );\x0d\n}\x0d\nif (!VALID_AVOID.has(avoid)) {\x0d\n  throw new RangeError(`AOE2X_EXP_AVOID must be one of ""\x2C "all"`);\x0d\n}\x0d\nif (!VALID_STEP.has(step)) {\x0d\n  throw new RangeError(\x0d\n    `AOE2X_EXP_STEP must be one of ""\x2C "bimodal"\x2C "steer"\x2C "chaser"\x2C "kited"`\x2C\x0d\n  );\x0d\n}\x0d\nif (!VALID_MIN_RANGE.has(minRange)) {\x0d\n  throw new RangeError(`AOE2X_EXP_MINRANGE must be one of ""\x2C "shooter"`);\x0d\n}\x0d\nif (!VALID_KITE_ENGAGE.has(kiteEngage)) {\x0d\n  throw new RangeError(`AOE2X_EXP_KITE_ENGAGE must be one of ""\x2C "blocker"`);\x0d\n}\x0d\nif (!VALID_CHASE_PATH.has(chasePath)) {\x0d\n  throw new RangeError(`AOE2X_EXP_CHASE_PATH must be one of ""\x2C "grid"`);\x0d\n}\x0d\n\x0d\nexport const ENGAGEMENT_FOLLOWS_PURSUIT = engagement === "pursuit";\x0d\nexport const REEVALUATE_EVERY_TICK = pursuit === "tick";\x0d\nexport const REEVALUATE_ON_BLOCKED = pursuit === "blocked" || pursuit === "blocked+swing";\x0d\nexport const REEVALUATE_ON_SWING = pursuit === "swing" || pursuit === "blocked+swing";\x0d\n// AOE2X_EXP_ORDERS=1 enables the AI-player order layer (src/combat/ai-orders.js).\x0d\n// It counts as an experiment so the blocked flag gets stamped for idle rescue.\x0d\nexport const AVOID_ALL_BODIES = avoid === "all";\x0d\nexport const BIMODAL_STEP = step === "bimodal" || step === "steer";\x0d\nexport const STEER_AROUND_BODIES = step === "steer";\x0d\nexport const CHASER_BIMODAL_STEP = step === "chaser" || step === "kited";\x0d\n// "kited" extends the chaser rule to the KITING side's move-ordered units:\x0d\n// the 12v21 victim forensics show the caught kiter executing its scripted\x0d\n// ball move THROUGH attacker contact at the ball's own pace (victim 1 s\x0d\n// displacement 0.50-0.67 vs ball-mates 0.55-0.66)\x2C where the sim's kiter\x0d\n// grinds on the pressing champion's body (0.13-0.39\x2C below even its mates).\x0d\nexport const KITED_SIDE_STEER = step === "kited";\x0d\nexport const MIN_RANGE_SUPPRESSES_SHOOTER = minRange === "shooter";\x0d\nexport const KITE_ENGAGE_BLOCKER = kiteEngage === "blocker";\x0d\nexport const CHASE_PATH_GRID = chasePath === "grid";\x0d\nexport const ANY_EXPERIMENT = Boolean(\x0d\n  engagement || pursuit || orders === "1" || avoid || step || minRange || kiteEngage\x0d\n  || chasePath\x2C\x0d\n);\x0d\n\x0d\n\x0d\n// True when this unit should drop a still-living pursuit target this tick.\x0d\nexport function shouldReevaluatePursuit(unit) {\x0d\n  if (REEVALUATE_EVERY_TICK) return true;\x0d\n  if (REEVALUATE_ON_BLOCKED && unit.experimentBlocked === true) return true;\x0d\n  if (REEVALUATE_ON_SWING && unit.experimentSwungThisTick === true) return true;\x0d\n  return false;\x0d\n}\x0d\n\x0d\n\x0d\nexport function describeExperiment() {\x0d\n  if (!ANY_EXPERIMENT) return "baseline";\x0d\n  return `engagement=${engagement || "free"} pursuit=${pursuit || "locked"}`;\x0d\n}\x0d\n
