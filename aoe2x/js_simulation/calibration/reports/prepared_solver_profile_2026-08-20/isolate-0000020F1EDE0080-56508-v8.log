script-source,142,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/phase2-batch1-comparison.js,import { readFile } from "node:fs/promises";\x0d\n\x0d\nimport { buildArenaPhysicsMap } from "./arena-physics-map.js";\x0d\nimport { hashCanonicalJson } from "./canonical-json.js";\x0d\nimport {\x0d\n  deriveKiteProfile\x2C\x0d\n  kitePolicyFor\x2C\x0d\n  warWagonChasePolicy\x2C\x0d\n} from "./combat/kite-timing.js";\x0d\nimport { createUnitState } from "./combat/unit-state.js";\x0d\nimport { createWorld\x2C runWorld } from "./combat/world.js";\x0d\nimport { resolveFamily } from "./placement.js";\x0d\nimport { signedScore } from "./standard-units-comparison.js";\x0d\nimport { UNIT_REGISTRY } from "./unit-registry.js";\x0d\n\x0d\n\x0d\nexport const PHASE2_MAX_TICKS = 9000;\x0d\nexport const PHASE2_OPENING_VOLLEY_TICK = 1;\x0d\nconst unitByMaster = new Map(UNIT_REGISTRY.map((unit) => [unit.master\x2C unit]));\x0d\n\x0d\n\x0d\nexport async function loadPhase2Batch1Truth(root) {\x0d\n  return JSON.parse(await readFile(\x0d\n    new URL("calibration/fixtures/phase2/batch1_truth.json"\x2C root)\x2C\x0d\n    "utf8"\x2C\x0d\n  ));\x0d\n}\x0d\n\x0d\n\x0d\nexport async function loadPhase2Batch1Context(root\x2C truth = undefined) {\x0d\n  const selectedTruth = truth ?? await loadPhase2Batch1Truth(root);\x0d\n  const masters = [...new Set(selectedTruth.rows.flatMap((row) => [\x0d\n    row.side2.master\x2C\x0d\n    row.side3.master\x2C\x0d\n  ]))];\x0d\n  const [mapFixture\x2C mechanicsEntries] = await Promise.all([\x0d\n    readFile(new URL("fixtures/golden_map.json"\x2C root)\x2C "utf8").then(JSON.parse)\x2C\x0d\n    Promise.all(masters.map(async (master) => {\x0d\n      const unit = unitByMaster.get(master);\x0d\n      if (!unit) throw new RangeError(`no unit registry entry for master ${master}`);\x0d\n      const mechanics = JSON.parse(await readFile(\x0d\n        new URL(`fixtures/unit_stats/${unit.fixture}`\x2C root)\x2C\x0d\n        "utf8"\x2C\x0d\n      ));\x0d\n      return [master\x2C mechanics];\x0d\n    }))\x2C\x0d\n  ]);\x0d\n  return Object.freeze({\x0d\n    map: buildArenaPhysicsMap(mapFixture)\x2C\x0d\n    mechanicsByMaster: new Map(mechanicsEntries)\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function scenarioFromPhase2Batch1Row({ row\x2C sampleIndex\x2C seed\x2C context }) {\x0d\n  requireSampleInputs(row\x2C sampleIndex\x2C seed\x2C context);\x0d\n  const canonical = row.runs[0];\x0d\n  const ranks = acquisitionRanks(canonical.starting_units\x2C sampleIndex\x2C seed\x2C row.id);\x0d\n  const units = canonical.starting_units.map((unit) => {\x0d\n    const mechanics = context.mechanicsByMaster.get(unit.master);\x0d\n    if (!mechanics) throw new RangeError(`missing mechanics for master ${unit.master}`);\x0d\n    return createUnitState({\x0d\n      referenceId: unit.id\x2C\x0d\n      owner: unit.owner\x2C\x0d\n      x: unit.x\x2C\x0d\n      y: unit.y\x2C\x0d\n      facing: 0\x2C\x0d\n      mechanics\x2C\x0d\n      acquisitionRank: ranks.get(unit.id)\x2C\x0d\n      acquisitionCount: canonical.starting_units.length\x2C\x0d\n    });\x0d\n  });\x0d\n  const side2Unit = unitByMaster.get(row.side2.master);\x0d\n  const side3Unit = unitByMaster.get(row.side3.master);\x0d\n  if (!side2Unit || !side3Unit) throw new RangeError(`unknown unit in ${row.id}`);\x0d\n  const family = resolveFamily({\x0d\n    side2Class: side2Unit.class\x2C\x0d\n    side3Class: side3Unit.class\x2C\x0d\n  });\x0d\n  const mobileOwners = [\n    side2Unit.class === "mobile_ranged" ? 2 : null\x2C\n    side3Unit.class === "mobile_ranged" ? 3 : null\x2C\n  ].filter(Number.isSafeInteger);\n  // In the raw Phase 2 ranged-versus-ranged recordings\x2C the unique-unit\n  // subject is the player-commanded shoot-and-move side while its standard\n  // opponent continues through ordinary ranged unit/AI combat. Comparison\n  // normalization can swap that subject to owner 3 (Gbeto-vs-HCA)\x2C so carry\n  // the order role through the swap instead of keying behavior to a player\n  // number. This is scenario command fidelity\x2C not a unit matchup modifier.\n  const subjectOwner = row.side2.slug === row.subject_slug\n    ? 2\n    : (row.side3.slug === row.subject_slug ? 3 : null);\n  const subjectUnit = subjectOwner === 2 ? side2Unit : (subjectOwner === 3 ? side3Unit : null);\n  const opposingUnit = subjectOwner === 2 ? side3Unit : (subjectOwner === 3 ? side2Unit : null);\n  const subjectMechanics = subjectUnit\n    ? context.mechanicsByMaster.get(subjectUnit.master)\n    : null;\n  const opposingMechanics = opposingUnit\n    ? context.mechanicsByMaster.get(opposingUnit.master)\n    : null;\n  // A shoot-and-move order can maintain or increase separation only when the\n  // commanded side can fire from at least the opponent's range. A shorter-\n  // ranged subject (Gbeto into HCA) has no kiting envelope and remains an\n  // ordinary ranged engagement\x2C matching the absence of patrol movement in\n  // that command stream.\n  const hasRangedKitingEnvelope = (subjectMechanics?.attack_range_tiles ?? -Infinity)\n    >= (opposingMechanics?.attack_range_tiles ?? Infinity);\n  const orderedRangedOwner = family === "rvr"\n      && subjectUnit?.class === "mobile_ranged" && hasRangedKitingEnvelope\n    ? subjectOwner\n    : null;\n  const kiteOwner = orderedRangedOwner\n    ?? (family === "kite" && mobileOwners.length === 1 ? mobileOwners[0] : null);\n  const hasMelee = side2Unit.class === "melee" || side3Unit.class === "melee";\x0d\n  const kiter = kiteOwner === 2 ? side2Unit : (kiteOwner === 3 ? side3Unit : null);\x0d\n  const kiterMechanics = kiteOwner === null\x0d\n    ? null\x0d\n    : context.mechanicsByMaster.get(kiter.master);\x0d\n  const chaserMechanics = kiteOwner === 2\x0d\n    ? context.mechanicsByMaster.get(side3Unit.master)\x0d\n    : (kiteOwner === 3 ? context.mechanicsByMaster.get(side2Unit.master) : null);\x0d\n  const warWagonKiter = kiter?.slug === "elite_war_wagon";\x0d\n  return Object.freeze({\x0d\n    ratio: `${row.side2.count}v${row.side3.count}`\x2C\n    units: Object.freeze(units)\x2C\n    map: context.map\x2C\n    ...(family === "rvr" && orderedRangedOwner === null ? {\n      rangedTargetPressureOwner: 3\x2C\n      rangedOpportunityRetargetOwner: 2\x2C\n      rangedWindupRetargetOwner: 3\x2C\n    } : {})\x2C\n    ...(kiteOwner === null\n      ? {}\n      : {\n        kiteOwner\x2C\x0d\n        // Every Phase 2 ranged-melee tape opens with an immediate attack\x0d\n        // command and then settles onto the mechanics-derived recurring beat.\x0d\n        // This is scenario order state\x2C not a unit/outcome calibration: the\x0d\n        // same tick-one opening applies whichever eligible ranged unit owns\x0d\n        // the kiting side\x2C while its reload and release timing remain sourced\x0d\n        // from that unit's mechanics.\x0d\n        kiteProfile: deriveKiteProfile(kiterMechanics\x2C {\x0d\n          ...kitePolicyFor(kiter.slug)\x2C\n          openingVolleyTick: PHASE2_OPENING_VOLLEY_TICK\x2C\n          openingVolley: "close_to_fire"\x2C\n        })\x2C\n        kiteNavigation: "cohesive"\x2C\n        ...(orderedRangedOwner === null\n          ? {\n            kiteMeleeOpeningOrder: "attack-move-all"\x2C\n            chaseCapture: true\x2C\n            kiteChaseDwellTicks: 0\x2C\n            persistentMeleePursuitRouting: true\x2C\n            ...(warWagonKiter ? warWagonChasePolicy(kiter.slug\x2C chaserMechanics) : {})\x2C\n          }\n          : { kiteOpponentMode: "ordinary-ranged" })\x2C\n      })\x2C\n    ...(hasMelee ? { preventiveContactSteering: true } : {})\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function runPhase2Batch1Sample({ row\x2C sampleIndex\x2C seed\x2C context }) {\x0d\n  const scenario = scenarioFromPhase2Batch1Row({ row\x2C sampleIndex\x2C seed\x2C context });\x0d\n  let result;\x0d\n  try {\x0d\n    result = runWorld(createWorld(scenario)\x2C {\x0d\n      maxTicks: PHASE2_MAX_TICKS\x2C\x0d\n      retainSnapshots: false\x2C\x0d\n    });\x0d\n  } catch (error) {\x0d\n    if (!String(error?.message ?? error).includes("world exceeded")) throw error;\x0d\n    return Object.freeze({\x0d\n      rowId: row.id\x2C\x0d\n      sampleIndex\x2C\x0d\n      seed\x2C\x0d\n      outcome: "timeout"\x2C\x0d\n      winnerOwner: null\x2C\x0d\n      winnerHp: null\x2C\x0d\n      score: null\x2C\x0d\n      ticks: PHASE2_MAX_TICKS\x2C\x0d\n      finalStateHash: null\x2C\x0d\n      eventLogHash: null\x2C\x0d\n    });\x0d\n  }\x0d\n  const live = result.world.units.filter(({ alive }) => alive);\x0d\n  const winnerOwner = result.winner;\x0d\n  const winnerHp = live.reduce((total\x2C unit) => total + unit.hp\x2C 0);\x0d\n  return Object.freeze({\x0d\n    rowId: row.id\x2C\x0d\n    sampleIndex\x2C\x0d\n    seed\x2C\x0d\n    outcome: "win"\x2C\x0d\n    winnerOwner\x2C\x0d\n    winnerHp\x2C\x0d\n    score: signedScore({\x0d\n      winnerOwner\x2C\x0d\n      winnerHp\x2C\x0d\n      startingHpByOwner: row.runs[0].starting_hp_by_owner\x2C\x0d\n    })\x2C\x0d\n    ticks: result.ticks\x2C\x0d\n    finalStateHash: hashCanonicalJson({\x0d\n      tick: result.world.tick\x2C\x0d\n      ratio: scenario.ratio\x2C\x0d\n      units: result.world.units\x2C\x0d\n    })\x2C\x0d\n    eventLogHash: hashCanonicalJson(result.events)\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireSampleInputs(row\x2C sampleIndex\x2C seed\x2C context) {\x0d\n  if (!row?.runs?.[0]?.starting_units?.length) {\x0d\n    throw new RangeError("Phase 2 row requires a canonical starting roster");\x0d\n  }\x0d\n  if (!Number.isSafeInteger(sampleIndex) || sampleIndex < 0) {\x0d\n    throw new RangeError(`sampleIndex must be a nonnegative safe integer\x2C got ${sampleIndex}`);\x0d\n  }\x0d\n  if (!Number.isSafeInteger(seed)) throw new RangeError(`seed must be a safe integer\x2C got ${seed}`);\x0d\n  if (!(context?.mechanicsByMaster instanceof Map) || !context.map) {\x0d\n    throw new TypeError("Phase 2 comparison context is required");\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction acquisitionRanks(roster\x2C sampleIndex\x2C seed\x2C rowId) {\x0d\n  const ordered = [...roster];\x0d\n  if (sampleIndex !== 0) {\x0d\n    const random = mulberry32(mixSeed(seed\x2C sampleIndex\x2C rowId));\x0d\n    for (let index = ordered.length - 1; index > 0; index -= 1) {\x0d\n      const swap = Math.floor(random() * (index + 1));\x0d\n      [ordered[index]\x2C ordered[swap]] = [ordered[swap]\x2C ordered[index]];\x0d\n    }\x0d\n  }\x0d\n  return new Map(ordered.map(({ id }\x2C index) => [id\x2C index]));\x0d\n}\x0d\n\x0d\n\x0d\nfunction mixSeed(seed\x2C sampleIndex\x2C rowId) {\x0d\n  let value = (seed ^ sampleIndex) >>> 0;\x0d\n  for (const char of rowId) value = Math.imul(value ^ char.charCodeAt(0)\x2C 16777619) >>> 0;\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction mulberry32(initial) {\x0d\n  let state = initial >>> 0;\x0d\n  return () => {\x0d\n    state = (state + 0x6D2B79F5) >>> 0;\x0d\n    let value = state;\x0d\n    value = Math.imul(value ^ (value >>> 15)\x2C value | 1);\x0d\n    value ^= value + Math.imul(value ^ (value >>> 7)\x2C value | 61);\x0d\n    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;\x0d\n  };\x0d\n}\x0d\n
