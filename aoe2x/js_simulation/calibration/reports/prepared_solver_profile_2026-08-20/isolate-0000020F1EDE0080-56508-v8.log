 {\x0d\n      const [leftId\x2C rightId] = diagnostic.pairKey.split(":").map(Number);\x0d\n      const { type\x2C pairKey\x2C ...details } = diagnostic;\x0d\n      events.push(event(\x0d\n        tick\x2C\x0d\n        `contact-${type}`\x2C\x0d\n        leftId\x2C\x0d\n        rightId\x2C\x0d\n        { pairKey\x2C ...details }\x2C\x0d\n      ));\x0d\n    }\x0d\n  }\x0d\n  let movementOptions = {\x0d\n    pairInteractions: createPairInteractionSnapshot({\n      contactReservations: contactUpdate?.contactReservations ?? new Map()\x2C\n      pursuitTransitReferenceIds\x2C\n    })\x2C\x0d\n    ...(kiteState ? { collisionRecoveryState: kiteState.collisionRecoveryState } : {})\x2C\x0d\n    ...(authoritativeRouteReferenceIds.size > 0\x0d\n      ? { authoritativeReferenceIds: authoritativeRouteReferenceIds }\x0d\n      : {})\x2C\x0d\n  };\x0d\n  let planned = planLocalAvoidance(live\x2C proposals\x2C map\x2C movementOptions);\x0d\n  for (const contactSteeringState of contactSteeringStates.values()) {\n    const contactPlan = planPreventiveContactSteering(\n      planned.units\x2C\x0d\n      planned.proposals\x2C\x0d\n      map\x2C\x0d\n      {\n        owner: contactSteeringState.owner\x2C\n        strength: contactSteeringState.strength\x2C\n        authoritativeReferenceIds: authoritativeRouteReferenceIds\x2C\n        pursuitTransitReferenceIds\x2C\n      }\x2C\n    );\x0d\n    contactSteeringState.steeredSteps += contactPlan.steered.length;\x0d\n    for (const { referenceId } of contactPlan.steered) {\x0d\n      contactSteeringState.steeredUnits.add(referenceId);\x0d\n    }\x0d\n    planned = Object.freeze({ ...planned\x2C proposals: contactPlan.proposals });\x0d\n  }\x0d\n  const moved = resolveMovement(planned\x2C byReference\x2C map\x2C kiteState\x2C movementOptions);\x0d\n  const movedByReference = new Map(moved.map((unit) => [unit.referenceId\x2C unit]));\x0d\n  const proposalByReference = new Map(proposals.map((proposal) => [proposal.referenceId\x2C proposal]));\x0d\n  const moveEvents = [];\x0d\n  const blockedEvents = [];\x0d\n  const routeEvents = [];\x0d\n  const movedIds = new Set();\x0d\n  const blockedIds = new Set();\x0d\n  // Per-tick displacement of every live unit\x2C for ballistics lead (smart_mode\x0d\n  // bit 1). Transient \u2014 never stamped on a unit\x2C so it can't reach any hash.\x0d\n  const velocities = new Map();\x0d\n  for (const unit of units) {\x0d\n    const before = byReference.get(unit.referenceId);\x0d\n    if (!before) continue;\x0d\n    const result = movedByReference.get(unit.referenceId);\x0d\n    const dx = result.x - before.x;\x0d\n    const dy = result.y - before.y;\x0d\n    velocities.set(unit.referenceId\x2C { dx\x2C dy });\x0d\n    unit.x = result.x;\x0d\n    unit.y = result.y;\x0d\n    unit.avoidance = result.avoidance;\x0d\n    if (dx !== 0 || dy !== 0) {\x0d\n      movedIds.add(unit.referenceId);\x0d\n      unit.facing = Math.atan2(dy\x2C dx);\x0d\n      moveEvents.push(event(\x0d\n        tick\x2C\x0d\n        "move"\x2C\x0d\n        unit.referenceId\x2C\x0d\n        unit.pursuitTargetId\x2C\x0d\n        { dx\x2C dy }\x2C\x0d\n      ));\x0d\n    }\x0d\n    const proposal = proposalByReference.get(unit.referenceId);\n    if (before.action === "attacking"\n        && pursuitTransitReferenceIds.has(unit.referenceId)\n        && Math.hypot(proposal.dx\x2C proposal.dy) <= ZERO_STEP_EPSILON\n        && Math.hypot(dx\x2C dy) > ZERO_STEP_EPSILON) {\n      // A hard four-body decongestion escape may move the currently planted\n      // attacker when no incoming chaser has a collision-valid exit. Movement\n      // interrupts that swing exactly as an ordinary move order would; combat\n      // acquisition resumes from the legal separated position next tick.\n      unit.action = unit.actionTimers.reload > 0 ? "reload" : "idle";\n      unit.attackTargetId = null;\n      unit.actionTimers.swing = 0;\n      unit.actionTimers.windup = 0;\n      delete unit.attackKind;\n      moveEvents.push(event(\n        tick\x2C\n        "pursuit-decongestion"\x2C\n        unit.referenceId\x2C\n        unit.pursuitTargetId\x2C\n        { dx\x2C dy }\x2C\n      ));\n    }\n    const isBlocked = Math.abs(dx - proposal.dx) > 1e-12 || Math.abs(dy - proposal.dy) > 1e-12;\n    if (authoritativeRouteReferenceIds.has(unit.referenceId)) {\x0d\n      const route = kiteState?.chaseRoutes?.get(unit.referenceId);\x0d\n      const waypoint = route?.waypoints?.[route.waypointIndex];\x0d\n      if (waypoint) {\x0d\n        if (persistentRouteMotionStalled(before\x2C result)) {\x0d\n          const proposedX = before.x + proposal.dx;\x0d\n          const proposedY = before.y + proposal.dy;\x0d\n          const blockingReferenceIds = live.filter((other) => {\x0d\n            if (other.referenceId === unit.referenceId) return false;\x0d\n            const interaction = resolvePairInteraction(\x0d\n              before\x2C other\x2C movementOptions.pairInteractions\x2C\x0d\n            );\x0d\n            return interaction.pathObstructs\x0d\n              && Math.max(\x0d\n                Math.abs(proposedX - other.x)\x2C\x0d\n                Math.abs(proposedY - other.y)\x2C\x0d\n              ) < interaction.collisionExtent - STEP_EPSILON;\x0d\n          }).map(({ referenceId }) => referenceId);\x0d\n          kiteState.chaseRoutes.delete(unit.referenceId);\x0d\n          routeEvents.push(event(tick\x2C "pursuit-route-invalidated"\x2C unit.referenceId\x2C\x0d\n            route.targetReferenceId\x2C {\x0d\n              reason: "no-progress"\x2C\x0d\n              waypointX: waypoint.x\x2C\x0d\n              waypointY: waypoint.y\x2C\x0d\n              beforeX: before.x\x2C\x0d\n              beforeY: before.y\x2C\x0d\n              proposedX\x2C\x0d\n              proposedY\x2C\x0d\n              afterX: result.x\x2C\x0d\n              afterY: result.y\x2C\x0d\n              blockingReferenceIds\x2C\x0d\n            }));\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n    // Only stamp experiment state when an experiment is running: the canonical\x0d\n    // unit record feeds finalStateHash\x2C so an always-present field would change\x0d\n    // every golden hash for no reason.\x0d\n    if (ANY_EXPERIMENT) {\x0d\n      unit.experimentBlocked = isBlocked\x0d\n        && (proposal.dx !== 0 || proposal.dy !== 0);\x0d\n      // Which body stopped it\x2C if any: the enemy the unconstrained step would\x0d\n      // have walked into. An ally block is a different situation entirely --\x0d\n      // the unit is queued behind its own side\x2C not stopped by the enemy in\x0d\n      // front of it -- and conflating the two is what made the first version\x0d\n      // of KITE_ENGAGE=blocker fire all over the kac corpus.\x0d\n      unit.experimentBlockedByEnemyId = null;\x0d\n      if (unit.experimentBlocked) {\x0d\n        let nearest = null;\x0d\n        let nearestGap = Infinity;\x0d\n        const wantX = before.x + proposal.dx;\x0d\n        const wantY = before.y + proposal.dy;\x0d\n        for (const other of live) {\x0d\n          if (other.owner === unit.owner || other.referenceId === unit.referenceId) continue;\x0d\n          const extent = collisionRadius(before) + collisionRadius(other);\x0d\n          const gap = Math.max(Math.abs(wantX - other.x)\x2C Math.abs(wantY - other.y));\x0d\n          if (gap < extent - STEP_EPSILON && gap < nearestGap) {\x0d\n            nearest = other.referenceId;\x0d\n            nearestGap = gap;\x0d\n          }\x0d\n        }\x0d\n        unit.experimentBlockedByEnemyId = nearest;\x0d\n      }\x0d\n    }\x0d\n    if (isBlocked) {\x0d\n      if (proposal.dx !== 0 || proposal.dy !== 0) {\x0d\n        blockedIds.add(unit.referenceId);\x0d\n      }\x0d\n      blockedEvents.push(event(tick\x2C "blocked"\x2C unit.referenceId\x2C unit.pursuitTargetId\x2C {\x0d\n        proposedDx: proposal.dx\x2C\x0d\n        proposedDy: proposal.dy\x2C\x0d\n        actualDx: dx\x2C\x0d\n        actualDy: dy\x2C\x0d\n      }));\x0d\n    }\x0d\n  }\x0d\n  events.push(...moveEvents\x2C ...blockedEvents\x2C ...routeEvents);\x0d\n  if (kiteState?.soloNavigationState) {\x0d\n    finishSoloNavigationTick(\x0d\n      kiteState.soloNavigationState\x2C\x0d\n      units.filter((unit) => unit.alive && unit.owner === kiteState.owner)\x2C\x0d\n      blockedIds\x2C\x0d\n    );\x0d\n  }\x0d\n  return {\x0d\n    contacts: queryEnemyContactManifold(live\x2C units.filter(({ alive }) => alive).map(freezeUnit))\x2C\x0d\n    movedIds\x2C\x0d\n    blockedIds\x2C\x0d\n    velocities\x2C\x0d\n    contactUpdate\x2C\x0d\n    pairInteractions: movementOptions.pairInteractions\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\n// Kited-world swing-start dwell (measured\x2C kac archives): a chaser adjacent\x0d\n// to its own caught target does NOT swing immediately \u2014 64% of sustained\x0d\n// (>=0.5 s) adjacency windows produce no hit\x2C and the window hit rate only\x0d\n// crosses ~50% at ~1.75-2.0 s (0.17 at 0.5 s / 0.25 at 1.0 s / 0.46 at\x0d\n// 1.5 s / 0.51 at 2.0 s\x2C attribution-inflated upper bounds). With the 0.75 s\x0d\n// windup inside those windows\x2C the swing START needs ~1.0 s of continuous\x0d\n// in-reach dwell on the pursuit target. A kiting target that stands only\x0d\n// 0.67 s per beat therefore escapes most catches\x2C while a blocked or\x0d\n// cornered one (the 5v10 chain kills) is hit repeatedly \u2014 exactly the\x0d\n// recorded contrast. Engagement\x2C once started\x2C persists while the target\x0d\n// stays in reach\x2C so reload-paced multi-hit catches still occur.\x0d\nconst KITE_CHASE_DWELL_TICKS = Math.round(1.0 * TICKS_PER_SECOND);\x0d\nconst KITE_DWELL_HOLD_RADIUS_TILES = 1.0;\x0d\n// Body contact for contact capture: collision-box touch plus a float\x0d\n// tolerance. The solver holds enemy pairs at exactly the summed half-extents\x0d\n// when they press\x2C so anything within 0.02 of the box IS a touch\x2C and the\x0d\n// recorded switch distances sit exactly on the contact band (see the capture\x0d\n// comment in updateEngagements). A tolerance\x2C not a physical constant.\x0d\nconst CONTACT_CAPTURE_EPSILON = 0.02;\x0d\n\x0d\n\x0d\nfunction updateEngagements(units\x2C contacts\x2C tick\x2C events\x2C blockedIds\x2C kiteState = null\x2C\x0d\n  pairInteractions = createPairInteractionSnapshot()) {\x0d\n  const kiteOwner = kiteState ? kiteState.owner : null;\x0d\n  if (kiteState && !kiteState.reachDwell) kiteState.reachDwell = new Map();\x0d\n  const snapshot = Object.freeze(units.map(freezeUnit));\x0d\n  for (const unit of units) {\x0d\n    if (!unit.alive) {\x0d\n      unit.engagedTargetId = null;\x0d\n      continue;\x0d\n    }\x0d\n    // No engagement before first acquisition: the outline reach can span the\x0d\n    // spawn bands (steppe-vs-elephant 1v1 spawns sit at exactly outline gap\x0d\n    // 1.1)\x2C yet the tapes show no unit swinging before its acquisition delay\x0d\n    // has run. Collision-based reach never spanned a spawn gap\x2C so this gate\x0d\n    // changes nothing for the recorded range-0 fixtures.\x0d\n    if (unit.actionTimers.acquire > 0) {\x0d\n      unit.engagedTargetId = null;\x0d\n      continue;\x0d\n    }\x0d\n    // A kite move order suppresses engagement until the next attack beat\x0d\n    // re-designates (the tape wraps each move in a no-attack stance toggle).\x0d\n    if (unit.moveOrder) {\x0d\n      unit.engagedTargetId = null;\x0d\n      continue;\x0d\n    }\x0d\n    const previousTargetId = unit.engagedTargetId;\x0d\n    // Kited-world chase discipline (measured\x2C kac archives): a chaser engages\x0d\n    // ONLY its sticky pursuit target. 64% of its sustained (>=0.5 s)\x0d\n    // adjacency windows with OTHER enemies produce no swing at all\x2C while its\x0d\n    // own caught target is hit within the first second 63-80% of the time\x0d\n    // (svc contrast). Hits land at up to 1.91 tiles center distance at the\x0d\n    // damage frame\x2C so release stays unconditional (commitReadyAttacks has no\x0d\n    // distance check) \u2014 the discipline is entirely in the swing START.\x0d\n    if (kiteOwner !== null && unit.owner !== kiteOwner\n        && kiteState.opponentMode !== "ordinary-ranged") {\n      // CONTACT CAPTURE (measured on the full-rate action decode\x2C five\x0d\n      // archives): a walking chaser that comes into BODY CONTACT with a live\x0d\n      // enemy switches its pursuit to that enemy\x2C old target dead or alive.\x0d\n      // svcam camels: 64 alive-switches\x2C distance to the NEW target at the\x0d\n      // switch p25 0.49 / p50 0.54 / p75 0.59 \u2014 exactly the collision-contact\x0d\n      // band (Chebyshev 0.45 spans Euclidean 0.45-0.64) \u2014 at full walking\x0d\n      // speed (11% stopped)\x2C not under attack (1/64)\x2C no recent hp loss\x0d\n      // (13/64). Same signature: esc champions (46\x2C p50 0.50)\x2C avp paladins\x0d\n      // (38\x2C p50 0.58)\x2C esp paladins (43\x2C p50 0.54)\x2C avst steppe (6\x2C p50\x0d\n      // 0.51). kac champions show only 9 alive-switches\x2C 7/9 under attack at\x0d\n      // p50 1.68 \u2014 those are the sparse mid-fight AI orders\x2C and the rule\x0d\n      // correctly almost never fires there because kac chasers rarely touch a\x0d\n      // non-target body. The interactive attack-move viewer enables the same\x0d\n      // physical rule for every supported ranged roster so a Champion that\x0d\n      // reaches a different front-line body attacks it instead of continuing\x0d\n      // to press through toward an obsolete sticky target. This is what keeps\x0d\n      // chasers at the formation's EDGE:\x0d\n      // the first body a chaser touches captures it\x2C so it fights the\x0d\n      // surface instead of wading in (tape victim rank r1 = 71-79%).\x0d\n      //\x0d\n      // The 64%-no-swing adjacency measurement that built the sticky\x0d\n      // discipline used a 1-tile adjacency radius; contact capture needs\x0d\n      // actual box contact\x2C a strictly smaller trigger\x2C so both hold.\x0d\n      // The capture is FRONTAL: at the recorded switches the new target sits\x0d\n      // in the chaser's direction of motion (cos p50 +0.76..+0.91; cos > 0 in\x0d\n      // 81-92% across svcam/esc/avp/esp). A body pressed against the flank in\x0d\n      // a chasing scrum does not capture \u2014 which is why kac\x2C whose champions\x0d\n      // touch arbs almost only laterally\x2C records just 9 alive-switches. The\x0d\n      // front is taken as the direction toward the current pursuit target\x0d\n      // (what a walking chaser's motion approximates)\x2C so a unit with no\x0d\n      // pursuit yet cannot be captured.\x0d\n      // Capture is an EVENT\x2C not a per-tick state: it fires while the chaser\x0d\n      // is still WALKING toward a target beyond its reach (the recorded old\x0d\n      // target sits p25 0.88 / p50 1.12 away at the switch)\x2C and once it\x0d\n      // fires the new pursuit target is the body in contact\x2C so the rule goes\x0d\n      // quiet until the chaser is walking at something distant again. Without\x0d\n      // the beyond-reach condition a chaser pressed against two bodies\x0d\n      // ping-pongs between them every tick and its dwell never completes.\x0d\n      const capturePursued = unit.pursuitTargetId === null || unit.pursuitTargetId === undefined\x0d\n        ? null\x0d\n        : snapshot.find(({ referenceId }) => referenceId === unit.pursuitTargetId);\x0d\n      if (kiteState.chaseCapture === true\x0d\n        && unit.action !== "attacking" && unit.engagedTargetId === null\x0d\n        && capturePursued && capturePursued.alive\x0d\n        && !isWithinReach(unit\x2C capturePursued)) {\x0d\n        const frontX = capturePursued.x - unit.x;\x0d\n        const frontY = capturePursued.y - unit.y;\x0d\n        let touched = null;\x0d\n        let touchedGap = Infinity;\x0d\n        for (const candidate of snapshot) {\x0d\n          if (!candidate.alive || candidate.owner === unit.owner) continue;\x0d\n          if (candidate.referenceId === unit.pursuitTargetId) continue;\x0d\n          const contactGap = Math.max(\x0d\n            Math.abs(candidate.x - unit.x)\x2C\x0d\n            Math.abs(candidate.y - unit.y)\x2C\x0d\n          ) - resolvePairInteraction(\x0d\n            unit\x2C\x0d\n            candidate\x2C\x0d\n            pairInteractions\x2C\x0d\n          ).attackSurfaceExtent;\x0d\n          if (contactGap > CONTACT_CAPTURE_EPSILON) continue;\x0d\n          const towardX = candidate.x - unit.x;\x0d\n          const towardY = candidate.y - unit.y;\x0d\n          if (frontX * towardX + frontY * towardY <= 0) continue;\x0d\n          const euclid = Math.hypot(towardX\x2C towardY);\x0d\n          if (euclid < touchedGap - 1e-12\x0d\n            || (euclid < touchedGap + 1e-12\x0d\n              && (touched === null || candidate.referenceId < touched.referenceId))) {\x0d\n            touched = candidate;\x0d\n            touchedGap = euclid;\x0d\n          }\x0d\n        }\x0d\n        if (touched) {\x0d\n          unit.pursuitTargetId = touched.referenceId;\x0d\n          unit.avoidance = null;\x0d\n          events.push(event(tick\x2C "contact-capture"\x2C unit.referenceId\x2C touched.referenceId));\x0d\n        }\x0d\n      }\x0d\n      const pursued = unit.pursuitTargetId === null || unit.pursuitTargetId === undefined\x0d\n        ? null\x0d\n        : snapshot.find(({ referenceId }) => referenceId === unit.pursuitTargetId);\x0d\n      // Dwell counts continuous in-reach ticks on the current pursuit\x0d\n      // target \u2014 EXCEPT that a chaser parked inside its target's own\x0d\n      // MINIMUM RANGE keeps accumulating through reach flickers: the target\x0d\n      // cannot shoot its pinner (dat type_50.min_range) and backpedals at\x0d\n      // near-zero relative speed\x2C which is the skirmisher tapes' steady\x0d\n      // grind (hits within the first second of contact 37% of the time).\x0d\n      // Against a min-range-0 kiter no pin exists\x2C the chaser loses reach\x0d\n      // for a full walk phase every cycle and resets \u2014 the arbalester\x0d\n      // tapes' 0.09-0.17 conversion. Swing START still requires reach.\x0d\n      const gap = pursued && pursued.alive && pursued.owner !== unit.owner\x0d\n        ? Math.hypot(pursued.x - unit.x\x2C pursued.y - unit.y)\x0d\n        : Infinity;\x0d\n      // A REACH fighter (nonzero melee attack range: the Elite Steppe\x0d\n      // Lancer's 1.0) converts on reach entry with no dwell at all \u2014 across\x0d\n      // 3508 attributed kills in the three steppe kiting archives the median\x0d\n      // continuous pre-swing dwell is 0.0 s at every radius up to 1.75 and\x0d\n      // the median swing-start gap is 1.5 tiles\x2C its exact outline reach.\x0d\n      // The dwell gate and its contact hold radius are range-0 chaser\x0d\n      // behavior (the champion/paladin conversion friction above).\x0d\n      const reachTiles = unit.mechanics?.ranged\x0d\n        ? 0\x0d\n        : (unit.mechanics?.attack_range_tiles ?? 0);\x0d\n      const reachFighter = reachTiles >= 1 - 1e-12;\x0d\n      const chaseDwellTicks = kiteState.chaseDwellTicks ?? KITE_CHASE_DWELL_TICKS;\x0d\n      const inReach = Number.isFinite(gap)\x0d\n        && (reachFighter || gap <= KITE_DWELL_HOLD_RADIUS_TILES + 1e-12)\x0d\n        && isWithinReach(unit\x2C pursued);\x0d\n      const pinned = gap < (pursued?.mechanics?.ranged?.min_range_tiles ?? 0) - 1e-12;\x0d\n      const previous = kiteState.reachDwell.get(unit.referenceId);\x0d\n      const carried = previous && previous.targetId === pursued?.referenceId\x0d\n        ? previous.ticks\x0d\n        : 0;\x0d\n      const accumulating = inReach || pinned;\x0d\n      if (accumulating) {\x0d\n        kiteState.reachDwell.set(unit.referenceId\x2C\x0d\n          { targetId: pursued.referenceId\x2C ticks: carried + 1 });\x0d\n      } else {\x0d\n        kiteState.reachDwell.delete(unit.referenceId);\x0d\n      }\x0d\n      let nextTargetId = inReach\x0d\n        && (carried + 1 >=