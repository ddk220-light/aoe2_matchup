code-creation,Script,10,227239,0x1084f94cd6e,288, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/engine-config.js:1:1,0x1084f94c940,~
script-source,169,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/engine-config.js,// The calibrated engine configuration\x2C as committed defaults.\x0d\n//\x0d\n// These are the values every number in docs/ was measured under. They used to\x0d\n// live only in environment variables\x2C which meant a viewer started per the\x0d\n// README ran a different engine than the corpus. Environment variables still\x0d\n// override -- an explicitly-set variable (including an explicit empty\x0d\n// string) always wins over the default; only a genuinely UNSET variable\x0d\n// falls back to the calibrated value.\x0d\n//\x0d\n// This project's documented commands are PowerShell (see README.md)\x2C and\x0d\n// `$env:AOE2X_EXP_ENGAGEMENT = ""` DELETES the variable rather than setting\x0d\n// it empty\x2C which would make the baseline (un-calibrated) engagement arm\x0d\n// unreachable. AOE2X_EXP_ENGAGEMENT=free is accepted as an explicit sentinel\x0d\n// for "" -- "free" is this project's existing name for that state\x2C already\x0d\n// printed by describeExperiment() in combat/experiments.js. The mapping\x0d\n// happens here so experiments.js's own validation still only ever sees ""\x0d\n// or "pursuit".\x0d\nconst DEFAULTS = Object.freeze({\x0d\n  engagement: "pursuit"\x2C\x0d\n  pursuit: ""\x2C\x0d\n  orders: true\x2C\x0d\n  avoid: ""\x2C\x0d\n  // "chaser": the kited-world chasing side steers around NON-target enemy\x0d\n  // bodies at full speed or stops -- never the solver's partial slide. Landed\x0d\n  // 2026-08-08 after the hcc 12v21 frames.bin forensics: corpus scoreboard\x0d\n  // 444.0 -> 423.0 summed band error\x2C wrong winners unchanged (both\x0d\n  // pre-existing)\x2C every non-kited recorded ratio bit-identical. Set\x0d\n  // AOE2X_EXP_STEP= (empty) for the pre-calibration solver. Full ladder of\x0d\n  // measured variants: docs/HCC_CHASER_MOBILITY_2026-08-07.md.\x0d\n  step: "chaser"\x2C\x0d\n  minRange: ""\x2C\x0d\n  kiteEngage: ""\x2C\x0d\n  // "grid": per-unit obstacle-aware pursuit pathing (combat/chase-path.js).\x0d\n  // Landed 2026-08-08: the first configuration with zero kited wrong winners\x0d\n  // (corpus 522.7 / 1\x2C the survivor being the champion_vs_paladin 6v3\x0d\n  // knife-edge; fixes arbalester_vs_firelancer 15v20). Band-error cost over\x0d\n  // the chaser-only solver is margin-side only. AOE2X_EXP_CHASE_PATH=none\x0d\n  // restores goal-blind pursuit.\x0d\n  chasePath: "grid"\x2C\x0d\n});\x0d\n\x0d\n\x0d\nfunction envString(name\x2C fallback) {\x0d\n  const value = process.env?.[name];\x0d\n  return value === undefined ? fallback : value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction envBoolean(name\x2C fallback) {\x0d\n  const value = process.env?.[name];\x0d\n  return value === undefined ? fallback : value === "1";\x0d\n}\x0d\n\x0d\n\x0d\nconst rawEngagement = envString("AOE2X_EXP_ENGAGEMENT"\x2C DEFAULTS.engagement);\x0d\n// Same PowerShell problem as engagement's "free" sentinel above: now that\x0d\n// "step" has a non-empty default\x2C the baseline solver needs a reachable\x0d\n// explicit sentinel. AOE2X_EXP_STEP=none maps to "".\x0d\nconst rawStep = envString("AOE2X_EXP_STEP"\x2C DEFAULTS.step);\x0d\nconst rawChasePath = envString("AOE2X_EXP_CHASE_PATH"\x2C DEFAULTS.chasePath);\x0d\n\x0d\nexport const ENGINE_CONFIG = Object.freeze({\x0d\n  engagement: rawEngagement === "free" ? "" : rawEngagement\x2C\x0d\n  pursuit: envString("AOE2X_EXP_PURSUIT"\x2C DEFAULTS.pursuit)\x2C\x0d\n  orders: envBoolean("AOE2X_EXP_ORDERS"\x2C DEFAULTS.orders)\x2C\x0d\n  avoid: envString("AOE2X_EXP_AVOID"\x2C DEFAULTS.avoid)\x2C\x0d\n  step: rawStep === "none" ? "" : rawStep\x2C\x0d\n  minRange: envString("AOE2X_EXP_MINRANGE"\x2C DEFAULTS.minRange)\x2C\x0d\n  kiteEngage: envString("AOE2X_EXP_KITE_ENGAGE"\x2C DEFAULTS.kiteEngage)\x2C\x0d\n  chasePath: rawChasePath === "none" ? "" : rawChasePath\x2C\x0d\n});\x0d\n
