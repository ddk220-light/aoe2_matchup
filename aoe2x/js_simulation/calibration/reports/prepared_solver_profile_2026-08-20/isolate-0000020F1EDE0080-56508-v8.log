script-source,167,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/chase-path.js,// Per-unit obstacle-aware pursuit pathing (AOE2X_EXP_CHASE_PATH=grid).\x0d\n//\x0d\n// The real game plans a route on its obstruction grid before walking; this\x0d\n// engine historically had no plan step at all -- a chaser beelines at its\x0d\n// target and reacts body-by-body\x2C which presses it onto the kiting ball at\x0d\n// partial speed (the 12v21 forensics\x2C docs/HCC_CHASER_MOBILITY_2026-08-07.md).\x0d\n// This module is the missing plan step\x2C per unit\x2C against the actual bodies:\x0d\n//\x0d\n//   * obstacles = the map's static obstruction cells plus enemy collision\x0d\n//     boxes except the pursuit target (walking into the target is the catch);\x0d\n//     friendly crowd bodies stay dynamic in local avoidance/collision;\x0d\n//   * a coarse A* over 0.25-tile cells\x2C 8-connected\x2C octile heuristic\x2C\x0d\n//     deterministic tie-breaks (cell index order);\x0d\n//   * straight line clear -> no plan\x2C the caller keeps its live tracking;\x0d\n//   * target cell unreachable -> best-effort: path toward the closest\x0d\n//     reachable approach\x2C and when no approach improves on where the unit\x0d\n//     stands\x2C STAND STILL -- the tape's stopped-at-clearance chasers;\x0d\n//   * the plan yields one waypoint a couple of tiles ahead; execution stays\x0d\n//     with the ordinary movement/collision layers underneath.\x0d\n//\x0d\n// Everything is a pure function of this tick's positions. No RNG\x2C no clock.\x0d\nimport {\x0d\n  collisionRadius\x2C\x0d\n  MELEE_CONTACT_TOLERANCE_TILES\x2C\x0d\n} from "./targeting.js";\x0d\nimport {\x0d\n  createPairInteractionSnapshot\x2C\x0d\n  resolvePairInteraction\x2C\x0d\n} from "./pair-interactions.js";\x0d\n\x0d\nconst CELL_TILES = 0.25;\x0d\n// One waypoint this far along the path (in cells) is handed to the walker.\x0d\nconst WAYPOINT_LOOKAHEAD_CELLS = 8; // 2.0 tiles\x0d\n// A* node budget. The grid is 64x64 = 4096 cells on the 16x16 recording map;\x0d\n// the budget only exists so a degenerate map cannot spin.\x0d\nconst MAX_EXPANSIONS = 8192;\x0d\nconst STRAIGHT_COST = 10;\x0d\nconst DIAGONAL_COST = 14;\x0d\nconst ROUTE_WAYPOINT_REACHED_TILES = CELL_TILES * 0.75;\x0d\nconst MAX_DEEP_CONTACT_DEGREE = 2;\x0d\nconst SLOT_OCCUPYING_CONTACT_KINDS = new Set([\x0d\n  "allied-transit"\x2C\x0d\n  "ranged-ingress"\x2C\x0d\n  "enemy-transit"\x2C\x0d\n  "engagement-contact"\x2C\x0d\n]);\x0d\nconst ALLIED_SLOT_CONTACT_KINDS = new Set([\x0d\n  "allied-transit"\x2C\x0d\n  "ranged-ingress"\x2C\x0d\n]);\x0d\n\x0d\nfunction cellIndex(cx\x2C cy\x2C cols) {\x0d\n  return cy * cols + cx;\x0d\n}\x0d\n\x0d\nfunction octile(ax\x2C ay\x2C bx\x2C by) {\x0d\n  const dx = Math.abs(ax - bx);\x0d\n  const dy = Math.abs(ay - by);\x0d\n  return dx > dy\x0d\n    ? STRAIGHT_COST * (dx - dy) + DIAGONAL_COST * dy\x0d\n    : STRAIGHT_COST * (dy - dx) + DIAGONAL_COST * dx;\x0d\n}\x0d\n\x0d\nfunction obstacleRadius(body) {\x0d\n  const explicit = body?.radius ?? body?.collisionRadius ?? body?.collision_radius;\x0d\n  if (explicit === undefined) return collisionRadius(body);\x0d\n  if (!Number.isFinite(explicit) || explicit <= 0) {\x0d\n    throw new RangeError("path obstacle radius must be positive and finite");\x0d\n  }\x0d\n  return explicit;\x0d\n}\x0d\n\x0d\n// Blocked-cell grid for ONE mover: a cell is blocked when placing the mover's\x0d\n// centre there would overlap an obstacle body (Chebyshev\x2C radius sum -- the\x0d\n// same test the collision solver applies).\x0d\nfunction buildBlockedGrid(mover\x2C obstacles\x2C cols\x2C rows\x2C options = {}) {\x0d\n  const blocked = new Uint8Array(cols * rows);\x0d\n  const moverRadius = collisionRadius(mover);\x0d\n  const pairInteractions = options.pairInteractions\x0d\n    ?? createPairInteractionSnapshot();\x0d\n  for (const body of obstacles) {\x0d\n    const dynamicEnemy = body.owner !== undefined && body.owner !== mover.owner;\x0d\n    const interaction = dynamicEnemy\x0d\n      ? resolvePairInteraction(mover\x2C body\x2C pairInteractions)\x0d\n      : null;\x0d\n    if (interaction && !interaction.pathObstructs) continue;\x0d\n    const reach = interaction?.collisionExtent ?? moverRadius + obstacleRadius(body);\x0d\n    const loX = Math.max(0\x2C Math.floor((body.x - reach) / CELL_TILES - 0.5) + 1);\x0d\n    const hiX = Math.min(cols - 1\x2C Math.ceil((body.x + reach) / CELL_TILES - 0.5) - 1);\x0d\n    const loY = Math.max(0\x2C Math.floor((body.y - reach) / CELL_TILES - 0.5) + 1);\x0d\n    const hiY = Math.min(rows - 1\x2C Math.ceil((body.y + reach) / CELL_TILES - 0.5) - 1);\x0d\n    for (let cy = loY; cy <= hiY; cy += 1) {\x0d\n      for (let cx = loX; cx <= hiX; cx += 1) {\x0d\n        const centreX = (cx + 0.5) * CELL_TILES;\x0d\n        const centreY = (cy + 0.5) * CELL_TILES;\x0d\n        if (Math.max(Math.abs(centreX - body.x)\x2C Math.abs(centreY - body.y))\x0d\n          < reach) {\x0d\n          blocked[cellIndex(cx\x2C cy\x2C cols)] = 1;\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  return blocked;\x0d\n}\x0d\n\x0d\nfunction toCell(value\x2C limit) {\x0d\n  return Math.max(0\x2C Math.min(limit - 1\x2C Math.floor(value / CELL_TILES)));\x0d\n}\x0d\n\x0d\n// Straight-line clearance over the blocked grid (conservative supercover walk).\x0d\nfunction lineClear(blocked\x2C cols\x2C ax\x2C ay\x2C bx\x2C by) {\x0d\n  const steps = Math.max(Math.abs(bx - ax)\x2C Math.abs(by - ay));\x0d\n  if (steps === 0) return true;\x0d\n  for (let i = 1; i <= steps; i += 1) {\x0d\n    const cx = Math.round(ax + ((bx - ax) * i) / steps);\x0d\n    const cy = Math.round(ay + ((by - ay) * i) / steps);\x0d\n    if (blocked[cellIndex(cx\x2C cy\x2C cols)]) return false;\x0d\n  }\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// Binary min-heap keyed on (f\x2C h\x2C index) for deterministic pops.\x0d\nfunction heapPush(heap\x2C node) {\x0d\n  heap.push(node);\x0d\n  let i = heap.length - 1;\x0d\n  while (i > 0) {\x0d\n    const parent = (i - 1) >> 1;\x0d\n    if (compare(heap[parent]\x2C heap[i]) <= 0) break;\x0d\n    [heap[parent]\x2C heap[i]] = [heap[i]\x2C heap[parent]];\x0d\n    i = parent;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction compare(a\x2C b) {\x0d\n  if (a.f !== b.f) return a.f - b.f;\x0d\n  if (a.h !== b.h) return a.h - b.h;\x0d\n  return a.index - b.index;\x0d\n}\x0d\n\x0d\nfunction heapPop(heap) {\x0d\n  const top = heap[0];\x0d\n  const last = heap.pop();\x0d\n  if (heap.length > 0) {\x0d\n    heap[0] = last;\x0d\n    let i = 0;\x0d\n    for (;;) {\x0d\n      const left = 2 * i + 1;\x0d\n      const right = left + 1;\x0d\n      let smallest = i;\x0d\n      if (left < heap.length && compare(heap[left]\x2C heap[smallest]) < 0) smallest = left;\x0d\n      if (right < heap.length && compare(heap[right]\x2C heap[smallest]) < 0) smallest = right;\x0d\n      if (smallest === i) break;\x0d\n      [heap[i]\x2C heap[smallest]] = [heap[smallest]\x2C heap[i]];\x0d\n      i = smallest;\x0d\n    }\x0d\n  }\x0d\n  return top;\x0d\n}\x0d\n\x0d\nconst NEIGHBORS = Object.freeze([\x0d\n  [1\x2C 0\x2C STRAIGHT_COST]\x2C [-1\x2C 0\x2C STRAIGHT_COST]\x2C\x0d\n  [0\x2C 1\x2C STRAIGHT_COST]\x2C [0\x2C -1\x2C STRAIGHT_COST]\x2C\x0d\n  [1\x2C 1\x2C DIAGONAL_COST]\x2C [1\x2C -1\x2C DIAGONAL_COST]\x2C\x0d\n  [-1\x2C 1\x2C DIAGONAL_COST]\x2C [-1\x2C -1\x2C DIAGONAL_COST]\x2C\x0d\n]);\x0d\n\x0d\n// Plan a walk aim for `mover` toward `target` around `obstacles`.\x0d\n// Returns:\x0d\n//   null                     -- straight line is clear; keep live tracking\x0d\n//   { stand: true }          -- no reachable progress; stand still\x0d\n//   { x\x2C y }                 -- next waypoint along the planned path (tiles)\x0d\nfunction planGridAim(mover\x2C target\x2C obstacles\x2C map\x2C enterBlockedGoal\x2C options = {}) {\x0d\n  const cols = Math.max(1\x2C Math.round(map.width / CELL_TILES));\x0d\n  const rows = Math.max(1\x2C Math.round(map.height / CELL_TILES));\x0d\n  const blocked = buildBlockedGrid(mover\x2C obstacles\x2C cols\x2C rows\x2C options);\x0d\n\x0d\n  const startX = toCell(mover.x\x2C cols);\x0d\n  const startY = toCell(mover.y\x2C rows);\x0d\n  const goalX = toCell(target.x\x2C cols);\x0d\n  const goalY = toCell(target.y\x2C rows);\x0d\n  // Continuous collision has already established that the mover's exact\x0d\n  // position is legal. Its coarse cell centre can nevertheless fall inside\x0d\n  // inflated obstacle geometry\x2C especially at obstacle corners. Never trap\x0d\n  // the mover inside that rasterization error.\x0d\n  const startIndex = cellIndex(startX\x2C startY\x2C cols);\x0d\n  const startCellWasBlocked = blocked[startIndex] === 1;\x0d\n  blocked[startIndex] = 0;\x0d\n  if (lineClear(blocked\x2C cols\x2C startX\x2C startY\x2C goalX\x2C goalY)) return null;\x0d\n\x0d\n  const goalIndex = cellIndex(goalX\x2C goalY\x2C cols);\x0d\n  const gScore = new Map([[startIndex\x2C 0]]);\x0d\n  const cameFrom = new Map();\x0d\n  const closed = new Set();\x0d\n  const startH = octile(startX\x2C startY\x2C goalX\x2C goalY);\x0d\n  const heap = [{ index: startIndex\x2C g: 0\x2C h: startH\x2C f: startH }];\x0d\n  let best = { index: startIndex\x2C h: startH };\x0d\n  let expansions = 0;\x0d\n\x0d\n  while (heap.length > 0 && expansions < MAX_EXPANSIONS) {\x0d\n    const current = heapPop(heap);\x0d\n    if (closed.has(current.index)) continue;\x0d\n    closed.add(current.index);\x0d\n    expansions += 1;\x0d\n    if (current.h < best.h\x0d\n      || (current.h === best.h && current.index < best.index)) {\x0d\n      best = { index: current.index\x2C h: current.h };\x0d\n    }\x0d\n    if (current.index === goalIndex) { best = current; break; }\x0d\n    const cx = current.index % cols;\x0d\n    const cy = (current.index - cx) / cols;\x0d\n    for (const [dx\x2C dy\x2C cost] of NEIGHBORS) {\x0d\n      const nx = cx + dx;\x0d\n      const ny = cy + dy;\x0d\n      if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) continue;\x0d\n      const nIndex = cellIndex(nx\x2C ny\x2C cols);\x0d\n      if (closed.has(nIndex)) continue;\x0d\n      // The goal cell is enterable even when covered by clutter near the\x0d\n      // target; every other blocked cell is not.\x0d\n      if (blocked[nIndex] && (!enterBlockedGoal || nIndex !== goalIndex)) continue;\x0d\n      // No corner cutting between two blocked orthogonals.\x0d\n      if (dx !== 0 && dy !== 0) {\x0d\n        if (blocked[cellIndex(cx + dx\x2C cy\x2C cols)]\x0d\n          || blocked[cellIndex(cx\x2C cy + dy\x2C cols)]) continue;\x0d\n      }\x0d\n      const tentative = current.g + cost;\x0d\n      const known = gScore.get(nIndex);\x0d\n      if (known !== undefined && known <= tentative) continue;\x0d\n      gScore.set(nIndex\x2C tentative);\x0d\n      cameFrom.set(nIndex\x2C current.index);\x0d\n      const h = octile(nx\x2C ny\x2C goalX\x2C goalY);\x0d\n      heapPush(heap\x2C { index: nIndex\x2C g: tentative\x2C h\x2C f: tentative + h });\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (best.index === startIndex) {\x0d\n    return startCellWasBlocked && enterBlockedGoal\x0d\n      ? null\x0d\n      : Object.freeze({ stand: true });\x0d\n  }\x0d\n\x0d\n  // Rebuild the path start -> best\x2C then take the lookahead waypoint.\x0d\n  const path = [];\x0d\n  for (let index = best.index; index !== undefined; index = cameFrom.get(index)) {\x0d\n    path.push(index);\x0d\n    if (index === startIndex) break;\x0d\n  }\x0d\n  path.reverse();\x0d\n  const waypointIndex = path[Math.min(WAYPOINT_LOOKAHEAD_CELLS\x2C path.length - 1)];\x0d\n  const wx = (waypointIndex % cols + 0.5) * CELL_TILES;\x0d\n  const wy = (Math.floor(waypointIndex / cols) + 0.5) * CELL_TILES;\x0d\n  return Object.freeze({ x: wx\x2C y: wy });\x0d\n}\x0d\n\x0d\n\x0d\n// Plan toward an unoccupied move-order coordinate. Unlike pursuit\x2C a blocked\x0d\n// goal cell is not enterable: the best reachable approach is used instead.\x0d\nexport function planMoveAim(mover\x2C goal\x2C obstacles\x2C map\x2C options = {}) {\x0d\n  const planned = planGridAim(\x0d\n    mover\x2C goal\x2C [...(map.obstacles ?? [])\x2C ...obstacles]\x2C map\x2C false\x2C options\x2C\x0d\n  );\x0d\n  if (planned?.stand !== true || !obstacles.some(({ owner }) => owner !== undefined)) {\x0d\n    return planned;\x0d\n  }\x0d\n  // A temporary ring of moving bodies must not become a permanent movement\x0d\n  // order. Retry against static geometry only and let pairwise collision and\x0d\n  // local avoidance resolve the live escape direction on this tick.\x0d\n  return planGridAim(\x0d\n    mover\x2C\x0d\n    goal\x2C\x0d\n    [\x0d\n      ...(map.obstacles ?? [])\x2C\x0d\n      ...obstacles.filter(({ owner }) => owner === undefined)\x2C\x0d\n    ]\x2C\x0d\n    map\x2C\x0d\n    false\x2C\x0d\n    options\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\nexport function planChaseAim(mover\x2C target\x2C obstacles\x2C map\x2C options = {}) {\x0d\n  const blocking = obstacles.filter((body) => (\x0d\n    body.owner === undefined || body.owner !== mover.owner\x0d\n  ));\x0d\n  const planned = planGridAim(\x0d\n    mover\x2C target\x2C [...(map.obstacles ?? [])\x2C ...blocking]\x2C map\x2C true\x2C options\x2C\x0d\n  );\x0d\n  if (planned?.stand !== true || blocking.length === 0) return planned;\x0d\n  // Dynamic bodies can move on the very next tick. If only those bodies make\x0d\n  // A* declare the mover boxed in\x2C continue live pursuit and let the local\x0d\n  // collision layers handle this tick. Static map geometry may still produce\x0d\n  // a genuine stand result.\x0d\n  return planGridAim(mover\x2C target\x2C map.obstacles ?? []\x2C map\x2C true\x2C options);\x0d\n}\x0d\n\x0d\n\x0d\nfunction addHardBody(blocked\x2C body\x2C reach\x2C cols\x2C rows) {\x0d\n  const loX = Math.max(0\x2C Math.floor((body.x - reach) / CELL_TILES - 0.5) + 1);\x0d\n  const hiX = Math.min(cols - 1\x2C Math.ceil((body.x + reach) / CELL_TILES - 0.5) - 1);\x0d\n  const loY = Math.max(0\x2C Math.floor((body.y - reach) / CELL_TILES - 0.5) + 1);\x0d\n  const hiY = Math.min(rows - 1\x2C Math.ceil((body.y + reach) / CELL_TILES - 0.5) - 1);\x0d\n  for (let cy = loY; cy <= hiY; cy += 1) {\x0d\n    for (let cx = loX; cx <= hiX; cx += 1) {\x0d\n      const centreX = (cx + 0.5) * CELL_TILES;\x0d\n      const centreY = (cy + 0.5) * CELL_TILES;\x0d\n      if (Math.max(Math.abs(centreX - body.x)\x2C Math.abs(centreY - body.y)) < reach) {\x0d\n        blocked[cellIndex(cx\x2C cy\x2C cols)] = 1;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction contactSlotUsage(pairInteractions) {\x0d\n  const deepDegree = new Map();\x0d\n  const allied = new Set();\x0d\n  for (const reservation of pairInteractions.contactReservations.values()) {\x0d\n    if (!SLOT_OCCUPYING_CONTACT_KINDS.has(reservation.kind)) continue;\x0d\n    for (const referenceId of [reservation.leftId\x2C reservation.rightId]) {\x0d\n      deepDegree.set(referenceId\x2C (deepDegree.get(referenceId) ?? 0) + 1);\x0d\n      if (ALLIED_SLOT_CONTACT_KINDS.has(reservation.kind)) allied.add(referenceId);\x0d\n    }\x0d\n  }\x0d\n  return { deepDegree\x2C allied };\x0d\n}\x0d\n\x0d\n\x0d\nfunction alliedTransitSlotAvailable(mover\x2C body\x2C slots) {\x0d\n  return !slots.allied.has(mover.referenceId)\x0d\n    && !slots.allied.has(body.referenceId)\x0d\n    && (slots.deepDegree.get(mover.referenceId) ?? 0) < MAX_DEEP_CONTACT_DEGREE\x0d\n    && (slots.deepDegree.get(body.referenceId) ?? 0) < MAX_DEEP_CONTACT_DEGREE;\x0d\n}\x0d\n\x0d\n\x0d\n// Persistent pursuit differs from the legacy one-waypoint planner in how it\x0d\n// treats FRIENDLY bodies. They are not hard walls: AoE2's dat-derived friendly\x0d\n// shrink and this engine's pair interactions can permit a shallow crossing.\x0d\n// Instead\x2C a candidate cell pays the geometric clearance distance needed to\x0d\n// leave every allied body it penetrates. One ally can therefore remain the\x0d\n// shortest physical route; the costs of a dense pack add and make walking\x0d\n// around the connected crowd cheaper without a roster-size or unit-name gate.\x0d\nfunction buildPersistentGrid(mover\x2C target\x2C obstacles\x2C cols\x2C rows\x2C options = {}) {\x0d\n  const blocked = new Uint8Array(cols * rows);\x0d\n  const congestion = new Uint32Array(cols * rows);\x0d\n  const alliedOccupancy = new Uint8Array(cols * rows);\x0d\n  const moverRadius = collisionRadius(mover);\x0d\n  const pairInteractions = options.pairInteractions\x0d\n    ?? createPairInteractionSnapshot();\x0d\n  const contactSlots = contactSlotUsage(pairInteractions);\x0d\n  for (const body of [...(options.mapObstacles ?? [])\x2C ...obstacles]) {\x0d\n    if (body.referenceId === mover.referenceId\x0d\n        || body.referenceId === target.referenceId) continue;\x0d\n    const dynamic = body.owner !== undefined;\x0d\n    const interaction = dynamic\x0d\n      ? resolvePairInteraction(mover\x2C body\x2C pairInteractions)\x0d\n      : null;\x0d\n    if (interaction && !interaction.pathObstructs) continue;\x0d\n    const reach = interaction?.collisionExtent ?? moverRadius + obstacleRadius(body);\x0d\n    if (!dynamic || body.owner !== mover.owner) {\x0d\n      addHardBody(blocked\x2C body\x2C reach\x2C cols\x2C rows);\x0d\n      continue;\x0d\n    }\x0d\n    // A planner may admit one ally only when the unified contact authority\x0d\n    // can actually publish that pair on this tick. If either body already\x0d\n    // owns its one allied lane (or its two total deep-contact slots)\x2C the\x0d\n    // next ally is route geometry\x2C not a second simultaneous transit. An\x0d\n    // existing releasing surface is likewise hard until separation.\x0d\n    if (interaction.kind !== "hard"\x0d\n        || !alliedTransitSlotAvailable(mover\x2C body\x2C contactSlots)) {\x0d\n      addHardBody(blocked\x2C body\x2C reach\x2C cols\x2C rows);\x0d\n      continue;\x0d\n    }\x0d\n    // A cell inside one ally can be admitted by the pairwise transit layer on\x0d\n    // this same tick. A cell inside two allies would require a three-body\x0d\n    // collapse\x2C so it becomes hard route geometry after all bodies are tallied.\x0d\n    const loX = Math.max(0\x2C Math.floor((body.x - reach) / CELL_TILES - 0.5) + 1);\x0d\n    const hiX = Math.min(cols - 1\x2C Math.ceil((body.x + reach) / CELL_TILES - 0.5) - 1);\x0d\n    const loY = Math.max(0\x2C Math.floor((body.y - reach) / CELL_TILES - 0.5) + 1);\x0d\n    const hiY = Math.min(rows - 1\x2C Math.ceil((body.y + reach) / CELL_TILES - 0.5) - 1);\x0d\n    for (let cy = loY; cy <= hiY; cy += 1) {\x0d\n      for (let cx = loX; cx <= hiX; cx += 1) {\x0d\n        const centreX = (cx + 0.5) * CELL_TILES;\x0d\n        const centreY = (cy + 0.5) * CELL_TILES;\x0d\n        const penetration = reach - Math.max(\x0d\n          Math.abs(centreX - body.x)\x2C\x0d\n          Math.abs(centreY - body.y)\x2C\x0d\n        );\x0d\n        if (penetration <= 0) continue;\x0d\n        alliedOccupancy[cellIndex(cx\x2C cy\x2C cols)] += 1;\x0d\n        // Convert physical clearance distance to the same distance units as\x0d\n        // A*: ten cost points per orthogonal grid cell.\x0d\n        congestion[cellIndex(cx\x2C cy\x2C cols)] += Math.ceil(\x0d\n          penetration / CELL_TILES\x2C\x0d\n        ) * STRAIGHT_COST;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  for (let index = 0; index < alliedOccupancy.length; index += 1) {\x0d\n    if (alliedOccupancy[index] >= 2) blocked[index] = 1;\x0d\n  }\x0d\n  return { blocked\x2C congestion\x2C pairInteractions };\x0d\n}\x0d\n\x0d\n\x0d\nfunction lineHasPersistentObstruction(blocked\x2C congestion\x2C cols\x2C ax\x2C ay\x2C bx\x2C by) {\n  const steps = Math.max(Math.abs(bx - ax)\x2C Math.abs(by - ay));\x0d\n  if (steps === 0) return false;\x0d\n  for (let i = 1; i <= steps; i += 1) {\x0d\n    const cx = Math.round(ax + ((bx - ax) * i) / steps);\x0d\n    const cy = Math.round(ay + ((by - ay) * i) / steps);\x0d\n    const index = cellIndex(cx\x2C cy\x2C cols);\x0d\n    // A single transit-eligible ally is a cost if A* is already routing\x2C not\x0d\n    // a reason to abandon a clear direct pursuit. Only hard geometry (which\x0d\n    // includes simultaneous penetration of two allies) starts a detour.\x0d\n    if (blocked[index]) return true;\x0d\n  }\x0d\n  return false;\x0d\n}\n\n\nfunction clearDirectPrefix(blocked\x2C cols\x2C ax\x2C ay\x2C bx\x2C by) {\n  const steps = Math.max(Math.abs(bx - ax)\x2C Math.abs(by - ay));\n  const path = [cellIndex(ax\x2C ay\x2C cols)];\n  if (steps === 0) return path;\n  for (let i = 1; i <= steps; i += 1) {\n    const cx = Math.round(ax + ((bx - ax) * i) / steps);\n    const cy = Math.round(ay + ((by - ay) * i) / steps);\n    const index = cellIndex(cx\x2C cy\x2C cols);\n    if (blocked[index]) break;\n    if (path.at(-1) !== index) path.push(index);\n  }\n  return path;\n}\n\x0d\n\x0d\nfunction meleeStopReach(mover\x2C target\x2C pairInteractions) {\x0d\n  const range = mover?.mechanics?.attack_range_tiles ?? 0;\x0d\n  if (!Number.isFinite(range) || range < 0) {\x0d\n    throw new RangeError("persistent chase attack range must be nonnegative and finite");\x0d\n  }\x0d\n  const interaction = resolvePairInteraction(mover\x2C target\x2C pairInteractions);\x0d\n  const stop = interaction.kind === "enemy-transit"\x0d\n    ? range\x0d\n    : Math.max(range\x2C MELEE_CONTACT_TOLERANCE_TILES);\x0d\n  return interaction.attackSurfaceExtent + stop;\x0d\n}\x0d\n\x0d\n\x0d\nfunction inGoalEnvelope(cx\x2C cy\x2C target\x2C reach) {\x0d\n  const x = (cx + 0.5) * CELL_TILES;\x0d\n  const y = (cy + 0.5) * CELL_TILES;\x0d\n  return Math.max(Math.abs(x - target.x)\x2C Math.abs(y - target.y)) <= reach + 1e-12;\x0d\n}\x0d\n\x0d\n\x0d\nfunction envelopeHeuristic(cx\x2C cy\x2C target\x2C reach) {\x0d\n  const x = (cx + 0.5) * CELL_TILES;\x0d\n  const y = (cy + 0.5) * CELL_TILES;\x0d\n  const dx = Math.max(0\x2C Math.abs(x - target.x) - reach);\x0d\n  const dy = Math.max(0\x2C Math.abs(y - target.y) - reach);\x0d\n  // Floor keeps this heuristic admissible for a goal envelope whose edge may\x0d\n  // fall between cell centres.\x0d\n  return octile(\x0d\n    0\x2C\x0d\n    0\x2C\x0d\n    Math.floor(dx / CELL_TILES)\x2C\x0d\n    Math.floor(dy / CELL_TILES)\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\nfunction freezePersistentRoute(target\x2C path\x2C cols\x2C { progressive = false } = {}) {\n  const waypoints = Object.freeze(path.slice(1).map((index) => Object.freeze({\x0d\n    x: (index % cols + 0.5) * CELL_TILES\x2C\x0d\n    y: (Math.floor(index / cols) + 0.5) * CELL_TILES\x2C\x0d\n  })));\x0d\n  return Object.freeze({\x0d\n    targetReferenceId: target.referenceId\x2C\x0d\n    targetX: target.x\x2C\x0d\n    targetY: target.y\x2C\x0d\n    waypoints\x2C\n    waypointIndex: 0\x2C\n    ...(progressive ? { progressive: true } : {})\x2C\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction detourPrefix(path\x2C blocked\x2C congestion\x2C cols\x2C targetX\x2C targetY) {\x0d\n  // A pursuit target moves continuously. Persist only until the path has\x0d\n  // cleared the obstruction that forced the detour\x2C then hand control back to\x0d\n  // live target tracking. Persisting the complete A* path would chase the\x0d\n  // target's old position after every kite beat.\x0d\n  for (let pathIndex = 1; pathIndex < path.length; pathIndex += 1) {\x0d\n    const index = path[pathIndex];\x0d\n    const cx = index % cols;\x0d\n    const cy = (index - cx) / cols;\x0d\n    if (!lineHasPersistentObstruction(\x0d\n      blocked\x2C congestion\x2C cols\x2C cx\x2C cy\x2C targetX\x2C targetY\x2C\x0d\n    )) {\x0d\n      return path.slice(0\x2C pathIndex + 1);\x0d\n    }\x0d\n  }\x0d\n  return path;\x0d\n}\x0d\n\x0d\n\x0d\n// Return a complete\x2C persistent detour corridor. `null` deliberately means\x0d\n// the live direct route is clear; the caller should continue tracking the\x0d\n// moving target. Unlike planChaseAim\x2C this plans to the actor's physical stop\x0d\n// envelope and includes geometric allied congestion in the route cost.\x0d\nexport function planPersistentChaseRoute(mover\x2C target\x2C obstacles\x2C map\x2C options = {}) {\x0d\n  const cols = Math.max(1\x2C Math.round(map.width / CELL_TILES));\x0d\n  const rows = Math.max(1\x2C Math.round(map.height / CELL_TILES));\x0d\n  const { blocked\x2C congestion\x2C pairInteractions } = buildPersistentGrid(\x0d\n    mover\x2C\x0d\n    target\x2C\x0d\n    obstacles\x2C\x0d\n    cols\x2C\x0d\n    rows\x2C\x0d\n    { ...options\x2C mapObstacles: map.obstacles ?? [] }\x2C\x0d\n  );\x0d\n  const startX = toCell(mover.x\x2C cols);\x0d\n  const startY = toCell(mover.y\x2C rows);\x0d\n  const targetX = toCell(target.x\x2C cols);\x0d\n  const targetY = toCell(target.y\x2C rows);\x0d\n  const startIndex = cellIndex(startX\x2C startY\x2C cols);\x0d\n  blocked[startIndex] = 0;\x0d\n  congestion[startIndex] = 0;\x0d\n  const reach = meleeStopReach(mover\x2C target\x2C pairInteractions);\x0d\n  if (inGoalEnvelope(startX\x2C startY\x2C target\x2C reach)) return null;\x0d\n  if (!lineHasPersistentObstruction(\n    blocked\x2C congestion\x2C cols\x2C startX\x2C startY\x2C targetX\x2C targetY\x2C\n  )) return null;\n  const directPrefix = clearDirectPrefix(\n    blocked\x2C cols\x2C startX\x2C startY\x2C targetX\x2C targetY\x2C\n  );\n  if (directPrefix.length > 1) {\n    return freezePersistentRoute(target\x2C directPrefix\x2C cols\x2C { progressive: true });\n  }\n\n  const gScore = new Map([[startIndex\x2C 0]]);\n  const cameFrom = new Map();\x0d\n  const closed = new Set();\x0d\n  const startH = envelopeHeuristic(startX\x2C startY\x2C target\x2C reach);\n  const heap = [{ index: startIndex\x2C g: 0\x2C h: startH\x2C f: startH }];\n  let goalIndex = null;\n  let frontierIndex = startIndex;\n  let frontierH = startH;\n  let frontierG = 0;\n  let expansions = 0;\n  while (heap.length > 0 && expansions < MAX_EXPANSIONS) {\n    const current = heapPop(heap);\n    if (closed.has(current.index)) continue;\n    closed.add(current.index);\n    expansions += 1;\n    if (current.h < frontierH\n        || (current.h === frontierH && current.g < frontierG)) {\n      frontierIndex = current.index;\n      frontierH = current.h;\n      frontierG = current.g;\n    }\n    const cx = current.index % cols;\x0d\n    const cy = (current.index - cx) / cols;\x0d\n    if (inGoalEnvelope(cx\x2C cy\x2C target\x2C reach)) {\x0d\n      goalIndex = current.index;\x0d\n      break;\x0d\n    }\x0d\n    for (const [dx\x2C dy\x2C cost] of NEIGHBORS) {\x0d\n      const nx = cx + dx;\x0d\n      const ny = cy + dy;\x0d\n      if (nx < 0 || nx >= cols || ny < 0 || ny >= rows) continue;\x0d\n      const nIndex = cellIndex(nx\x2C ny\x2C cols);\x0d\n      if (closed.has(nIndex) || blocked[nIndex]) continue;\x0d\n      if (dx !== 0 && dy !== 0\x0d\n          && (blocked[cellIndex(cx + dx\x2C cy\x2C cols)]\x0d\n            || blocked[cellIndex(cx\x2C cy + dy\x2C cols)])) continue;\x0d\n      const tentative = current.g + cost + congestion[nIndex];\x0d\n      const known = gScore.get(nIndex);\x0d\n      if (known !== undefined && known <= tentative) continue;\x0d\n      gScore.set(nIndex\x2C tentative);\x0d\n      cameFrom.set(nIndex\x2C current.index);\x0d\n      const h = envelopeHeuristic(nx\x2C ny\x2C target\x2C reach);\x0d\n      heapPush(heap\x2C { index: nIndex\x2C g: tentative\x2C h\x2C f: tentative + h });\x0d\n    }\x0d\n  }\x0d\n  if (goalIndex === null && frontierIndex === startIndex) {\n    return Object.freeze({ stand: true });\n  }\n  const path = [];\n  for (let index = goalIndex ?? frontierIndex;\n    index !== undefined;\n    index = cameFrom.get(index)) {\n    path.push(index);\n    if (index === startIndex) break;\n  }\n  path.reverse();\n  if (goalIndex === null) {\n    return freezePersistentRoute(target\x2C path\x2C cols\x2C { progressive: true });\n  }\n  return freezePersistentRoute(\n    target\x2C\x0d\n    detourPrefix(path\x2C blocked\x2C congestion\x2C cols\x2C targetX\x2C targetY)\x2C\x0d\n    cols\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\nexport function advancePersistentChaseRoute(mover\x2C route) {\x0d\n  if (!route || !Array.isArray(route.waypoints)) {\x0d\n    throw new TypeError("persistent chase route with waypoints is required");\x0d\n  }\x0d\n  let waypointIndex = route.waypointIndex;\x0d\n  while (waypointIndex < route.waypoints.length) {\x0d\n    const waypoint = route.waypoints[waypointIndex];\x0d\n    if (Math.hypot(waypoint.x - mover.x\x2C waypoint.y - mover.y)\x0d\n        > ROUTE_WAYPOINT_REACHED_TILES + 1e-12) break;\x0d\n    waypointIndex += 1;\x0d\n  }\x0d\n  if (waypointIndex === route.waypointIndex) return route;\x0d\n  return Object.freeze({ ...route\x2C waypointIndex });\x0d\n}\x0d\n\x0d\n\x0d\nexport function persistentRouteMotionStalled(before\x2C after) {\x0d\n  return Math.hypot(after.x - before.x\x2C after.y - before.y) <= 1e-12;\x0d\n}\x0d\n
