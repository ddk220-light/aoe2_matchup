code-creation,Script,10,202294,0xe84b3de756,64, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/canonical-json.js:1:1,0xe84b3de450,~
script-source,147,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/canonical-json.js,import { createHash } from "node:crypto";\x0d\n\x0d\n\x0d\nfunction canonicalJson(value\x2C ancestors = new Set()) {\x0d\n  if (value === null || typeof value === "string" || typeof value === "boolean") {\x0d\n    return JSON.stringify(value);\x0d\n  }\x0d\n  if (typeof value === "number") {\x0d\n    if (!Number.isFinite(value)) throw new TypeError("canonical JSON requires a finite number");\x0d\n    return JSON.stringify(value);\x0d\n  }\x0d\n  if (!value || typeof value !== "object") {\x0d\n    throw new TypeError(`canonical JSON does not support ${typeof value}`);\x0d\n  }\x0d\n  if (ancestors.has(value)) throw new TypeError("canonical JSON does not support cycles");\x0d\n\x0d\n  ancestors.add(value);\x0d\n  let serialized;\x0d\n  if (Array.isArray(value)) {\x0d\n    serialized = `[${value.map((child) => canonicalJson(child\x2C ancestors)).join("\x2C")}]`;\x0d\n  } else {\x0d\n    const prototype = Object.getPrototypeOf(value);\x0d\n    if (prototype !== Object.prototype && prototype !== null) {\x0d\n      throw new TypeError("canonical JSON requires plain objects");\x0d\n    }\x0d\n    serialized = `{${Object.keys(value).sort().map((key) => (\x0d\n      `${JSON.stringify(key)}:${canonicalJson(value[key]\x2C ancestors)}`\x0d\n    )).join("\x2C")}}`;\x0d\n  }\x0d\n  ancestors.delete(value);\x0d\n  return serialized;\x0d\n}\x0d\n\x0d\n\x0d\nexport function hashCanonicalJson(value) {\x0d\n  return createHash("sha256").update(canonicalJson(value)).digest("hex");\x0d\n}\x0d\n
