u2014 current\x0d\n// position plus its current per-tick displacement times the flight time to\x0d\n// the led point (two-pass fixed point). Measured on the kiting archives:\x0d\n// every one of 3270 beat-assigned shots lands on champions running\x0d\n// tangentially at 1.056 tiles/s (probe C\x2C damage landed p50 = 100% of\x0d\n// assigned)\x2C which aim-at-fire-position cannot produce; targets that CHANGE\x0d\n// direction mid-flight still escape\x2C which is what the avs walked-away\x0d\n// residue shows for unled straight-line semantics.\x0d\nfunction leadAimPoint(unit\x2C target\x2C spec\x2C velocities) {\x0d\n  const velocity = velocities?.get(target.referenceId);\x0d\n  if (!velocity || (velocity.dx === 0 && velocity.dy === 0)) {\x0d\n    return { x: target.x\x2C y: target.y };\x0d\n  }\x0d\n  const stepLength = spec.projectileSpeed / TICKS_PER_SECOND;\x0d\n  let aimX = target.x;\x0d\n  let aimY = target.y;\x0d\n  for (let pass = 0; pass < 2; pass += 1) {\x0d\n    const flightTicks = Math.hypot(aimX - unit.x\x2C aimY - unit.y) / stepLength;\x0d\n    aimX = target.x + velocity.dx * flightTicks;\x0d\n    aimY = target.y + velocity.dy * flightTicks;\x0d\n  }\x0d\n  return { x: aimX\x2C y: aimY };\x0d\n}\x0d\n\x0d\n\x0d\n// Deterministic per-shot RNG (mulberry32 step over world.shotRng.state)\x2C\x0d\n// consumed in the deterministic unit-loop order. Present only in worlds\x0d\n// where a unit can miss or blast.\x0d\nfunction nextShotRoll(shotRng) {\x0d\n  const a = (shotRng.state + 0x6d2b79f5) >>> 0;\x0d\n  shotRng.state = a;\x0d\n  let t = Math.imul(a ^ (a >>> 15)\x2C 1 | a);\x0d\n  t = (t + Math.imul(t ^ (t >>> 7)\x2C 61 | t)) ^ t;\x0d\n  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\x0d\n}\x0d\n\x0d\n\x0d\nfunction releaseRangedShot(unit\x2C target\x2C spec\x2C tick\x2C events\x2C projectiles\x2C velocities\x2C shotRng) {\x0d\n  if (!target?.alive || target.owner === unit.owner) return;\x0d\n  let aim = (spec.smartMode & 1) === 1\x0d\n    ? leadAimPoint(unit\