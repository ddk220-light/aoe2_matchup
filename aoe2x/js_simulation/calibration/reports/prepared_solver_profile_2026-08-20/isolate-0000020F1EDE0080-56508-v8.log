code-creation,Script,10,201539,0xe84b3dd93e,85, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/unit-state.js:1:1,0xe84b3dd400,~
script-source,146,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/unit-state.js,import { secondsToTicksNearest } from "../simulation-clock.js";\x0d\nimport { chargeSpec } from "./attacks.js";\x0d\nimport { acquisitionDelaySeconds } from "./targeting.js";\x0d\n\x0d\n\x0d\n// Mechanics fixtures must be machine-generated from the Genie .dat and the\x0d\n// reference DB (tools/export_unit_mechanics.py)\x2C never hand-written. The guard\x0d\n// is on PROVENANCE\x2C not on which unit it is: pinning this to the Champion's\x0d\n// master/HP was what stopped the engine from running any second unit\x2C and the\x0d\n// Paladin tapes confirm every sourced field generalizes unchanged.\x0d\nconst REQUIRED_PROVENANCE = ["dat_sha256"\x2C "reference_db_sha256"\x2C "fields"];\x0d\n\x0d\n\x0d\nfunction freezeTimers(timers) {\x0d\n  const result = {};\x0d\n  for (const [name\x2C value] of Object.entries(timers)) {\x0d\n    if (!Number.isSafeInteger(value) || value < 0) {\x0d\n      throw new RangeError(`action timer ${name} must be a nonnegative safe integer`);\x0d\n    }\x0d\n    result[name] = value;\x0d\n  }\x0d\n  return Object.freeze(result);\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireSafeInteger(value\x2C name) {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nexport function createUnitState({\x0d\n  referenceId\x2C\x0d\n  owner\x2C\x0d\n  x\x2C\x0d\n  y\x2C\x0d\n  facing\x2C\x0d\n  mechanics\x2C\x0d\n  actionTimers = null\x2C\x0d\n  acquisitionRank = 0\x2C\x0d\n  acquisitionCount = 1\x2C\x0d\n} = {}) {\x0d\n  requireSafeInteger(referenceId\x2C "reference ID");\x0d\n  requireSafeInteger(owner\x2C "owner");\x0d\n  requireFinite(x\x2C "x");\x0d\n  requireFinite(y\x2C "y");\x0d\n  requireFinite(facing\x2C "facing");\x0d\n  if (!mechanics || typeof mechanics !== "object") {\x0d\n    throw new TypeError("unit mechanics are required");\x0d\n  }\x0d\n  for (const field of REQUIRED_PROVENANCE) {\x0d\n    if (mechanics.provenance?.[field] === undefined) {\x0d\n      throw new TypeError(`unit mechanics must carry provenance.${field}`);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const unitMaster = requireSafeInteger(mechanics.unit_master\x2C "unit mechanics unit master");\x0d\n  if (unitMaster <= 0) throw new RangeError("unit mechanics master must be positive");\x0d\n  const hp = requireFinite(mechanics.hp\x2C "unit mechanics hp");\x0d\n  if (hp <= 0) throw new RangeError("unit mechanics hp must be positive");\x0d\n\x0d\n  const timers = actionTimers ?? {\x0d\n    windup: 0\x2C\x0d\n    reload: 0\x2C\x0d\n    swing: 0\x2C\x0d\n    acquire: secondsToTicksNearest(\x0d\n      acquisitionDelaySeconds(acquisitionRank\x2C acquisitionCount)\x2C\x0d\n    )\x2C\x0d\n  };\x0d\n  // Charge-capable units (Fire Lancer family) carry their charge level in\x0d\n  // unit state; every tape unit opens its first fight with a full charge.\x0d\n  // Gated on the mechanics block so non-charge fixtures keep their exact\x0d\n  // canonical unit shape (and therefore their golden state hashes).\x0d\n  const charge = chargeSpec(mechanics);\x0d\n  return Object.freeze({\x0d\n    referenceId\x2C\x0d\n    owner\x2C\x0d\n    x\x2C\x0d\n    y\x2C\x0d\n    facing\x2C\x0d\n    mechanics\x2C\x0d\n    unitMaster\x2C\x0d\n    hp\x2C\x0d\n    // Charge units also remember their own reaction-lag draw: completing the\x0d\n    // charge cycle re-enters combat through the same acquisition gate (see\x0d\n    // progressAttacks)\x2C and the tapes' post-charge first-melee-swing spread\x0d\n    // (1.3 s across byte-identical repeats) carries the acquisition-roll\x0d\n    // signature rather than any deterministic cycle rule.\x0d\n    ...(charge ? { charge: charge.maxCharge\x2C acquireDelayTicks: timers.acquire } : {})\x2C\x0d\n    alive: true\x2C\x0d\n    pursuitTargetId: null\x2C\x0d\n    engagedTargetId: null\x2C\x0d\n    attackTargetId: null\x2C\x0d\n    avoidance: null\x2C\x0d\n    action: "idle"\x2C\x0d\n    actionTimers: freezeTimers(timers)\x2C\x0d\n  });\x0d\n}\x0d\n
