code-creation,Script,10,214658,0xe84b3ffb5e,241, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/collision.js:1:1,0xe84b3feb88,~
script-source,156,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/collision.js,import { collisionRadius } from "./targeting.js";\x0d\nimport {\x0d\n  createPairInteractionSnapshot\x2C\x0d\n  resolvePairInteraction\x2C\x0d\n} from "./pair-interactions.js";\x0d\n\x0d\n\x0d\nconst EPSILON = 1e-12;\x0d\n// Hard collision publication uses a world-scale tolerance rather than the\x0d\n// floating-point comparison epsilon. At a 0.2-tile Champion radius this is\x0d\n// 0.05% of the body size: physically invisible\x2C but large enough to keep a\x0d\n// sequential solver from treating a sub-pixel residual as a broken world.\x0d\nconst GEOMETRY_SLOP = 1e-4;\n// Crowds pinched between a static obstacle and an enemy body converge\x0d\n// geometrically. The former 256-sweep ceiling could stop with a sub-micron\x0d\n// residual overlap even though each pass was still making deterministic\x0d\n// progress. This remains a failure ceiling\x2C not a physical tolerance: hard\x0d\n// geometry must still satisfy EPSILON before a movement step is published.\x0d\nconst MAX_CONSTRAINT_SWEEPS = 4096;\nconst PREPARED_MOVEMENT_RESOLUTION = Symbol("prepared movement resolution");\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireReferenceId(value\x2C name = "reference ID") {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction pairKey(a\x2C b) {\x0d\n  return a.referenceId - b.referenceId;\x0d\n}\x0d\n\x0d\n\x0d\nfunction obstacleRadius(obstacle) {\x0d\n  const value = obstacle.radius ?? obstacle.collisionRadius ?? obstacle.collision_radius;\x0d\n  const radius = value === undefined\x0d\n    ? collisionRadius(obstacle)\x0d\n    : requireFinite(value\x2C "obstacle radius");\x0d\n  if (radius <= 0) throw new RangeError("obstacle radius must be positive");\x0d\n  return radius;\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeObstacles(map) {\x0d\n  if (map?.obstacles === undefined) return [];\x0d\n  if (!Array.isArray(map.obstacles)) throw new TypeError("map obstacles must be an array");\x0d\n  return map.obstacles.map((obstacle\x2C index) => {\x0d\n    const x = requireFinite(obstacle?.x\x2C "obstacle x");\x0d\n    const y = requireFinite(obstacle?.y\x2C "obstacle y");\x0d\n    const radius = obstacleRadius(obstacle);\x0d\n    const referenceId = obstacle.referenceId ?? obstacle.reference_id ?? obstacle.id ?? null;\x0d\n    if (referenceId !== null) requireReferenceId(referenceId\x2C "obstacle reference ID");\x0d\n    return {\x0d\n      x\x2C\x0d\n      y\x2C\x0d\n      radius\x2C\x0d\n      referenceId\x2C\x0d\n      sortKey: referenceId === null\x0d\n        ? `~${x.toPrecision(17)}\x2C${y.toPrecision(17)}\x2C${radius.toPrecision(17)}\x2C${index}`\x0d\n        : `${referenceId.toString().padStart(20\x2C "0")}`\x2C\x0d\n      label: referenceId ?? `at (${x}\x2C ${y})`\x2C\x0d\n    };\x0d\n  }).sort((a\x2C b) => a.sortKey.localeCompare(b.sortKey));\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeBodies(snapshot\x2C proposals) {\n  if (!Array.isArray(snapshot)) throw new TypeError("snapshot must be an array");\x0d\n  if (!Array.isArray(proposals)) throw new TypeError("proposals must be an array");\x0d\n\x0d\n  const byReference = new Map();\x0d\n  for (const proposal of proposals) {\x0d\n    const referenceId = requireReferenceId(proposal?.referenceId\x2C "proposal reference ID");\x0d\n    if (byReference.has(referenceId)) {\x0d\n      throw new Error(`duplicate movement proposal for reference ${referenceId}`);\x0d\n    }\x0d\n    byReference.set(referenceId\x2C {\x0d\n      dx: requireFinite(proposal.dx\x2C "proposal dx")\x2C\x0d\n      dy: requireFinite(proposal.dy\x2C "proposal dy")\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  const seen = new Set();\x0d\n  const bodies = snapshot.map((unit\x2C inputIndex) => {\x0d\n    const referenceId = requireReferenceId(unit?.referenceId);\x0d\n    if (seen.has(referenceId)) throw new Error(`duplicate unit reference ${referenceId}`);\x0d\n    seen.add(referenceId);\x0d\n    const proposed = byReference.get(referenceId) ?? { dx: 0\x2C dy: 0 };\x0d\n    return {\x0d\n      unit\x2C\x0d\n      inputIndex\x2C\x0d\n      referenceId\x2C\x0d\n      x: requireFinite(unit.x\x2C "unit x")\x2C\x0d\n      y: requireFinite(unit.y\x2C "unit y")\x2C\x0d\n      radius: collisionRadius(unit)\x2C\x0d\n      unitMaster: requireReferenceId(\x0d\n        unit.unitMaster ?? unit.mechanics?.unit_master\x2C\x0d\n        "unit master"\x2C\x0d\n      )\x2C\x0d\n      owner: unit.owner\x2C\x0d\n      dx: proposed.dx\x2C\x0d\n      dy: proposed.dy\x2C\x0d\n    };\x0d\n  });\x0d\n  for (const referenceId of byReference.keys()) {\x0d\n    if (!seen.has(referenceId)) {\x0d\n      throw new Error(`movement proposal references unknown unit ${referenceId}`);\x0d\n    }\x0d\n  }\x0d\n  bodies.sort(pairKey);\n  for (let solverIndex = 0; solverIndex < bodies.length; solverIndex += 1) {\n    bodies[solverIndex].solverIndex = solverIndex;\n  }\n  return bodies;\n}\n\n\nfunction applyMovementProposals(baseBodies\x2C proposals) {\n  if (!Array.isArray(proposals)) throw new TypeError("proposals must be an array");\n  const byReference = new Map();\n  for (const proposal of proposals) {\n    const referenceId = requireReferenceId(proposal?.referenceId\x2C "proposal reference ID");\n    if (byReference.has(referenceId)) {\n      throw new Error(`duplicate movement proposal for reference ${referenceId}`);\n    }\n    byReference.set(referenceId\x2C {\n      dx: requireFinite(proposal.dx\x2C "proposal dx")\x2C\n      dy: requireFinite(proposal.dy\x2C "proposal dy")\x2C\n    });\n  }\n  const bodies = baseBodies.map((body) => {\n    const proposed = byReference.get(body.referenceId) ?? { dx: 0\x2C dy: 0 };\n    byReference.delete(body.referenceId);\n    return { ...body\x2C dx: proposed.dx\