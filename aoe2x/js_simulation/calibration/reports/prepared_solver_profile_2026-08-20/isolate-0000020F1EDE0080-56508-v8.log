e.get(unit.engagedTargetId)\x0d\n        ?? byReference.get(unit.pursuitTargetId);\x0d\n      if (chargeTarget?.alive && chargeTarget.owner !== unit.owner) {\x0d\n        const distance = Math.hypot(chargeTarget.x - unit.x\x2C chargeTarget.y - unit.y);\x0d\n        if (distance <= unit.mechanics.line_of_sight_tiles) {\x0d\n          events.push(createAttackStartEvent({\x0d\n            tick\x2C\x0d\n            actorId: unit.referenceId\x2C\x0d\n            targetId: chargeTarget.referenceId\x2C\x0d\n            readyTick: tick + spec.windupTicks\x2C\x0d\n            kind: "charge"\x2C\x0d\n          }));\x0d\n          unit.action = "attacking";\x0d\n          unit.attackKind = "charge";\x0d\n          unit.attackTargetId = chargeTarget.referenceId;\x0d\n          unit.actionTimers.swing = 0;\x0d\n          unit.actionTimers.windup = spec.windupTicks;\x0d\n          unit.actionTimers.reload = reloadTicks(unit.mechanics);\x0d\n          continue;\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    const target = byReference.get(unit.engagedTargetId);\x0d\n    if (\n      unit.actionTimers.reload !== 0 ||\n      !target?.alive ||\n      target.owner === unit.owner\n    ) continue;\n    if (!hasUnobstructedZeroRangeMeleeContact(unit\x2C target\x2C units)) continue;\n    if (!isWithinStopRange(unit\x2C target) && movedIds.has(unit.referenceId)) continue;\n\x0d\n    const delay = attackDelayTicks(unit.mechanics);\x0d\n    const readyTick = tick + delay;\x0d\n    events.push(createAttackStartEvent({\x0d\n      tick\x2C\x0d\n      actorId: unit.referenceId\x2C\x0d\n      targetId: target.referenceId\x2C\x0d\n      readyTick\x2C\x0d\n    }));\x0d\n    unit.action = "attacking";\x0d\n    unit.attackTargetId = target.referenceId;\x0d\n    unit.actionTimers.swing = 0;\x0d\n    unit.actionTimers.windup = delay;\x0d\n    unit.actionTimers.reload = reloadTicks(unit.mechanics);\x0d\n    if (delay === 0) {\x0d\n      ready.push({\x0d\n        type: "attack-ready"\x2C\x0d\n      