script-source,164,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/movement.js,import { createPairInteractionSnapshot\x2C resolvePairInteraction } from "./pair-interactions.js";\x0d\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction movementInputs(unit\x2C target\x2C ticksPerSecond) {\x0d\n  const ticks = requireFinite(ticksPerSecond\x2C "ticks per second");\x0d\n  if (ticks <= 0) throw new RangeError("ticks per second must be positive");\x0d\n\x0d\n  const speed = requireFinite(\x0d\n    unit?.mechanics?.speed_tiles_per_second\x2C\x0d\n    "movement speed"\x2C\x0d\n  );\x0d\n  if (speed < 0) throw new RangeError("movement speed must be nonnegative");\x0d\n\x0d\n  const dx = requireFinite(target?.x\x2C "target x") - requireFinite(unit?.x\x2C "unit x");\x0d\n  const dy = requireFinite(target?.y\x2C "target y") - requireFinite(unit?.y\x2C "unit y");\x0d\n  return Object.freeze({ ticks\x2C speed\x2C dx\x2C dy\x2C centerDistance: Math.hypot(dx\x2C dy) });\x0d\n}\x0d\n\x0d\n\x0d\nexport function proposePointMovement(unit\x2C target\x2C ticksPerSecond) {\x0d\n  const { ticks\x2C speed\x2C dx\x2C dy\x2C centerDistance } = movementInputs(\x0d\n    unit\x2C\x0d\n    target\x2C\x0d\n    ticksPerSecond\x2C\x0d\n  );\x0d\n  if (centerDistance === 0 || speed === 0) {\x0d\n    return Object.freeze({ referenceId: unit.referenceId\x2C dx: 0\x2C dy: 0 });\x0d\n  }\x0d\n\x0d\n  const magnitude = Math.min(speed / ticks\x2C centerDistance);\x0d\n  return Object.freeze({\x0d\n    referenceId: unit.referenceId\x2C\x0d\n    dx: dx / centerDistance * magnitude\x2C\x0d\n    dy: dy / centerDistance * magnitude\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function proposeMovement(unit\x2C target\x2C ticksPerSecond\x2C options = {}) {\x0d\n  const { ticks\x2C speed\x2C dx\x2C dy\x2C centerDistance } = movementInputs(\x0d\n    unit\x2C\x0d\n    target\x2C\x0d\n    ticksPerSecond\x2C\x0d\n  );\x0d\n  const pairInteractions = options.pairInteractions\x0d\n    ?? createPairInteractionSnapshot();\x0d\n  const gap = centerDistance\x0d\n    - resolvePairInteraction(unit\x2C target\x2C pairInteractions).attackSurfaceExtent;\x0d\n  if (centerDistance === 0 || gap <= 0 || speed === 0) {\x0d\n    return Object.freeze({ referenceId: unit.referenceId\x2C dx: 0\x2C dy: 0 });\x0d\n  }\x0d\n\x0d\n  const magnitude = Math.min(speed / ticks\x2C gap);\x0d\n  return Object.freeze({\x0d\n    referenceId: unit.referenceId\x2C\x0d\n    dx: dx / centerDistance * magnitude\x2C\x0d\n    dy: dy / centerDistance * magnitude\x2C\x0d\n  });\x0d\n}\x0d\n
