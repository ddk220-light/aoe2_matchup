script-source,168,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/contact-graph-steering.js,import { collisionRadius } from "./targeting.js";\x0d\nimport { hasLimitedClosurePerReload } from "./reach-melee.js";\x0d\n\x0d\n\x0d\nconst EPSILON = 1e-12;\x0d\n// Candidate density is numerical search resolution\x2C not a unit calibration:\x0d\n// the movement budget and lookahead below still come entirely from sourced\x0d\n// unit collision geometry and the already-computed physics proposal.\x0d\nconst TURN_INCREMENT = Math.PI / 12;\x0d\nconst MAX_TURNS = 6;\x0d\nexport const PREVENTIVE_CONTACT_STEERING_STRENGTH = 0.5;\x0d\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireReferenceId(value\x2C name = "reference ID") {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeStrength(value) {\x0d\n  requireFinite(value\x2C "steering strength");\x0d\n  if (value < 0 || value > 1) {\x0d\n    throw new RangeError("steering strength must be between 0 and 1");\x0d\n  }\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeInputs(snapshot\x2C proposals\x2C owner) {\x0d\n  if (!Array.isArray(snapshot)) throw new TypeError("snapshot must be an array");\x0d\n  if (!Array.isArray(proposals)) throw new TypeError("proposals must be an array");\x0d\n  requireReferenceId(owner\x2C "steering owner");\x0d\n  const units = [...snapshot].sort((left\x2C right) => (\x0d\n    requireReferenceId(left?.referenceId) - requireReferenceId(right?.referenceId)\x0d\n  ));\x0d\n  const byReference = new Map();\x0d\n  for (const unit of units) {\x0d\n    if (byReference.has(unit.referenceId)) {\x0d\n      throw new Error(`duplicate unit reference ${unit.referenceId}`);\x0d\n    }\x0d\n    byReference.set(unit.referenceId\x2C unit);\x0d\n  }\x0d\n  const proposalByReference = new Map();\x0d\n  for (const row of proposals) {\x0d\n    const referenceId = requireReferenceId(row?.referenceId\x2C "proposal reference ID");\x0d\n    if (!byReference.has(referenceId)) {\x0d\n      throw new Error(`movement proposal references unknown unit ${referenceId}`);\x0d\n    }\x0d\n    if (proposalByReference.has(referenceId)) {\x0d\n      throw new Error(`duplicate movement proposal for reference ${referenceId}`);\x0d\n    }\x0d\n    proposalByReference.set(referenceId\x2C Object.freeze({\x0d\n      referenceId\x2C\x0d\n      dx: requireFinite(row.dx\x2C "proposal dx")\x2C\x0d\n      dy: requireFinite(row.dy\x2C "proposal dy")\x2C\x0d\n    }));\x0d\n  }\x0d\n  for (const unit of units) {\x0d\n    if (!proposalByReference.has(unit.referenceId)) {\x0d\n      proposalByReference.set(unit.referenceId\x2C Object.freeze({\x0d\n        referenceId: unit.referenceId\x2C\x0d\n        dx: 0\x2C\x0d\n        dy: 0\x2C\x0d\n      }));\x0d\n    }\x0d\n  }\x0d\n  return { units\x2C byReference\x2C proposalByReference };\x0d\n}\x0d\n\x0d\n\x0d\nfunction contactExtent(left\x2C right) {\x0d\n  return collisionRadius(left) + collisionRadius(right);\x0d\n}\x0d\n\x0d\n\x0d\nfunction touches(left\x2C leftPoint\x2C right\x2C rightPoint) {\x0d\n  return Math.max(\x0d\n    Math.abs(leftPoint.x - rightPoint.x)\x2C\x0d\n    Math.abs(leftPoint.y - rightPoint.y)\x2C\x0d\n  ) < contactExtent(left\x2C right) - EPSILON;\x0d\n}\x0d\n\x0d\n\x0d\nfunction graphFor(units\x2C points) {\n  const neighbors = new Map(units.map(({ referenceId }) => [referenceId\x2C new Set()]));\x0d\n  for (let leftIndex = 0; leftIndex < units.length; leftIndex += 1) {\x0d\n    const left = units[leftIndex];\x0d\n    for (let rightIndex = leftIndex + 1; rightIndex < units.length; rightIndex += 1) {\x0d\n      const right = units[rightIndex];\x0d\n      if (!touches(\x0d\n        left\x2C points.get(left.referenceId)\x2C right\x2C points.get(right.referenceId)\x2C\x0d\n      )) continue;\x0d\n      neighbors.get(left.referenceId).add(right.referenceId);\x0d\n      neighbors.get(right.referenceId).add(left.referenceId);\x0d\n    }\x0d\n  }\x0d\n  return neighbors;\x0d\n}\n\n\nfunction fourCliques(units\x2C points) {\n  const graph = graphFor(units\x2C points);\n  const result = [];\n  for (let a = 0; a < units.length; a += 1) {\n    const aId = units[a].referenceId;\n    for (let b = a + 1; b < units.length; b += 1) {\n      const bId = units[b].referenceId;\n      if (!graph.get(aId).has(bId)) continue;\n      for (let c = b + 1; c < units.length; c += 1) {\n        const cId = units[c].referenceId;\n        if (!graph.get(aId).has(cId) || !graph.get(bId).has(cId)) continue;\n        for (let d = c + 1; d < units.length; d += 1) {\n          const dId = units[d].referenceId;\n          if (graph.get(aId).has(dId)\n              && graph.get(bId).has(dId)\n              && graph.get(cId).has(dId)) {\n            result.push([aId\x2C bId\x2C cId\x2C dId]);\n          }\n        }\n      }\n    }\n  }\n  return result;\n}\n\n\nfunction oneStepPoints(units\x2C proposals) {\n  return new Map(units.map((unit) => {\n    const movement = proposals.get(unit.referenceId);\n    return [unit.referenceId\x2C {\n      x: unit.x + (movement?.dx ?? 0)\x2C\n      y: unit.y + (movement?.dy ?? 0)\x2C\n    }];\n  }));\n}\n\x0d\n\x0d\nfunction componentIds(graph\x2C start) {\x0d\n  const seen = new Set([start]);\x0d\n  const queue = [start];\x0d\n  while (queue.length) {\x0d\n    const current = queue.shift();\x0d\n    for (const neighbor of graph.get(current) ?? []) {\x0d\n      if (seen.has(neighbor)) continue;\x0d\n      seen.add(neighbor);\x0d\n      queue.push(neighbor);\x0d\n    }\x0d\n  }\x0d\n  return seen;\x0d\n}\x0d\n\x0d\n\x0d\nfunction movementHorizon(unit\x2C proposal\x2C byReference\x2C alliedUnits) {\x0d\n  const distance = Math.hypot(proposal.dx\x2C proposal.dy);\x0d\n  if (distance <= EPSILON) return 0;\x0d\n  const largestAllyRadius = alliedUnits.reduce(\x0d\n    (maximum\x2C ally) => Math.max(maximum\x2C collisionRadius(ally))\x2C\x0d\n    collisionRadius(unit)\x2C\x0d\n  );\x0d\n  let horizon = collisionRadius(unit) + largestAllyRadius;\x0d\n  const target = byReference.get(unit.pursuitTargetId);\x0d\n  if (target?.alive !== false && target && target.owner !== unit.owner) {\x0d\n    const centerDistance = Math.hypot(target.x - unit.x\x2C target.y - unit.y);\x0d\n    const attackRange = Number.isFinite(unit?.mechanics?.attack_range_tiles)\x0d\n      ? Math.max(0\x2C unit.mechanics.attack_range_tiles) : 0;\x0d\n    const remaining = Math.max(\x0d\n      0\x2C\x0d\n      centerDistance - contactExtent(unit\x2C target) - attackRange\x2C\x0d\n    );\x0d\n    horizon = Math.min(horizon\x2C remaining);\x0d\n  }\x0d\n  return Math.max(distance\x2C horizon);\x0d\n}\x0d\n\x0d\n\x0d\nfunction projectedPoint(unit\x2C proposal\x2C byReference\x2C alliedUnits) {\x0d\n  const distance = Math.hypot(proposal.dx\x2C proposal.dy);\x0d\n  if (distance <= EPSILON) return { x: unit.x\x2C y: unit.y };\x0d\n  const horizon = movementHorizon(unit\x2C proposal\x2C byReference\x2C alliedUnits);\x0d\n  return {\x0d\n    x: unit.x + proposal.dx / distance * horizon\x2C\x0d\n    y: unit.y + proposal.dy / distance * horizon\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction staticGeometryClears(unit\x2C proposal\x2C map) {\x0d\n  if (!map) return true;\x0d\n  const radius = collisionRadius(unit);\x0d\n  const end = { x: unit.x + proposal.dx\x2C y: unit.y + proposal.dy };\x0d\n  if (\x0d\n    end.x < radius - EPSILON\x0d\n    || end.x > map.width - radius + EPSILON\x0d\n    || end.y < radius - EPSILON\x0d\n    || end.y > map.height - radius + EPSILON\x0d\n  ) return false;\x0d\n  for (const obstacle of map.obstacles ?? []) {\x0d\n    const obstacleRadius = obstacle.radius\x0d\n      ?? obstacle.collisionRadius\x0d\n      ?? obstacle.collision_radius\x0d\n      ?? collisionRadius(obstacle);\x0d\n    const vx = end.x - unit.x;\x0d\n    const vy = end.y - unit.y;\x0d\n    const lengthSquared = vx * vx + vy * vy;\x0d\n    const projection = lengthSquared === 0 ? 0 : Math.max(0\x2C Math.min(1\x2C (\x0d\n      (obstacle.x - unit.x) * vx + (obstacle.y - unit.y) * vy\x0d\n    ) / lengthSquared));\x0d\n    const nearestX = unit.x + projection * vx;\x0d\n    const nearestY = unit.y + projection * vy;\x0d\n    if (Math.hypot(obstacle.x - nearestX\x2C obstacle.y - nearestY)\x0d\n        < radius + obstacleRadius - EPSILON) return false;\x0d\n  }\x0d\n  return true;\x0d\n}\x0d\n\x0d\n\x0d\nfunction riskFor(mover\x2C alliedUnits\x2C currentGraph\x2C projectedPoints) {\x0d\n  const projectedGraph = graphFor(alliedUnits\x2C projectedPoints);\x0d\n  const moverId = mover.referenceId;\x0d\n  const neighbors = [...projectedGraph.get(moverId)].sort((left\x2C right) => left - right);\x0d\n  const currentNeighbors = currentGraph.get(moverId);\x0d\n  const currentComponent = componentIds(currentGraph\x2C moverId);\x0d\n  let triangles = 0;\x0d\n  let fourCliques = 0;\x0d\n  for (let leftIndex = 0; leftIndex < neighbors.length; leftIndex += 1) {\x0d\n    for (let rightIndex = leftIndex + 1; rightIndex < neighbors.length; rightIndex += 1) {\x0d\n      if (!projectedGraph.get(neighbors[leftIndex]).has(neighbors[rightIndex])) continue;\x0d\n      triangles += 1;\x0d\n      for (let thirdIndex = rightIndex + 1; thirdIndex < neighbors.length; thirdIndex += 1) {\x0d\n        const third = neighbors[thirdIndex];\x0d\n        if (\x0d\n          projectedGraph.get(neighbors[leftIndex]).has(third)\x0d\n          && projectedGraph.get(neighbors[rightIndex]).has(third)\x0d\n        ) fourCliques += 1;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  const newNeighbors = neighbors.filter((referenceId) => !currentNeighbors.has(referenceId));\x0d\n  const internalClosures = newNeighbors.filter((referenceId) => (\x0d\n    currentComponent.has(referenceId)\x0d\n  )).length;\x0d\n  return Object.freeze({\x0d\n    fourCliques\x2C\x0d\n    triangles\x2C\x0d\n    internalClosures\x2C\x0d\n    multiAdmission: currentNeighbors.size === 0 && neighbors.length >= 2 ? 1 : 0\x2C\x0d\n    neighborCount: neighbors.length\x2C\x0d\n    newContacts: newNeighbors.length\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction riskTuple(risk) {\x0d\n  return [\x0d\n    risk.fourCliques\x2C\x0d\n    risk.triangles\x2C\x0d\n    risk.internalClosures\x2C\x0d\n    risk.multiAdmission\x2C\x0d\n    risk.newContacts\x2C\x0d\n  ];\x0d\n}\x0d\n\x0d\n\x0d\nfunction compareRisk(left\x2C right) {\x0d\n  const leftTuple = riskTuple(left);\x0d\n  const rightTuple = riskTuple(right);\x0d\n  for (let index = 0; index < leftTuple.length; index += 1) {\x0d\n    if (leftTuple[index] !== rightTuple[index]) return leftTuple[index] - rightTuple[index];\x0d\n  }\x0d\n  return 0;\x0d\n}\x0d\n\x0d\n\x0d\nfunction isCompactRisk(risk) {\x0d\n  return risk.fourCliques > 0\x0d\n    || risk.triangles > 0\x0d\n    || risk.internalClosures > 0\x0d\n    || risk.multiAdmission > 0;\x0d\n}\x0d\n\x0d\n\x0d\nfunction admitsReachMeleeWedge(mover\x2C byReference\x2C risk) {\x0d\n  const attackRange = Number.isFinite(mover?.mechanics?.attack_range_tiles)\x0d\n    ? Math.max(0\x2C mover.mechanics.attack_range_tiles) : 0;\x0d\n  if (attackRange < 1 - EPSILON) return false;\x0d\n  if (risk.fourCliques > 0 || risk.neighborCount > 2) return false;\x0d\n  const target = byReference.get(mover.pursuitTargetId);\x0d\n  if (!target || target.alive === false || target.owner === mover.owner) return false;\x0d\n  if (!hasLimitedClosurePerReload(mover\x2C target)) return false;\x0d\n  const centerDistance = Math.max(\x0d\n    Math.abs(target.x - mover.x)\x2C\x0d\n    Math.abs(target.y - mover.y)\x2C\x0d\n  );\x0d\n  const remaining = Math.max(\x0d\n    0\x2C\x0d\n    centerDistance - contactExtent(mover\x2C target) - attackRange\x2C\x0d\n  );\x0d\n  return remaining <= attackRange + EPSILON;\x0d\n}\x0d\n\x0d\n\x0d\nfunction rotatedProposal(proposal\x2C side\x2C turn) {\x0d\n  if (turn === 0) return proposal;\x0d\n  const distance = Math.hypot(proposal.dx\x2C proposal.dy);\x0d\n  const heading = Math.atan2(proposal.dy\x2C proposal.dx) + side * turn * TURN_INCREMENT;\x0d\n  return Object.freeze({\x0d\n    referenceId: proposal.referenceId\x2C\x0d\n    dx: Math.cos(heading) * distance\x2C\x0d\n    dy: Math.sin(heading) * distance\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction moverPriority(left\x2C right\x2C byReference) {\x0d\n  const targetDistance = (unit) => {\x0d\n    const target = byReference.get(unit.pursuitTargetId);\x0d\n    return target && target.owner !== unit.owner\x0d\n      ? Math.hypot(target.x - unit.x\x2C target.y - unit.y)\x0d\n      : Infinity;\x0d\n  };\x0d\n  return targetDistance(left) - targetDistance(right)\x0d\n    || left.referenceId - right.referenceId;\x0d\n}\x0d\n\x0d\n\x0d\nexport function planPreventiveContactSteering(snapshot\x2C proposals\x2C map\x2C {\n  owner\x2C\n  strength = PREVENTIVE_CONTACT_STEERING_STRENGTH\x2C\n  pursuitTransitReferenceIds = new Set()\x2C\n} = {}) {\n  const normalizedStrength = normalizeStrength(strength);\x0d\n  const {\x0d\n    units\x2C byReference\x2C proposalByReference\x2C\x0d\n  } = normalizeInputs(snapshot\x2C proposals\x2C owner);\x0d\n  const alliedUnits = units.filter((unit) => unit.alive !== false && unit.owner === owner);\x0d\n  const currentPoints = new Map(alliedUnits.map((unit) => [\x0d\n    unit.referenceId\x2C { x: unit.x\x2C y: unit.y }\x2C\x0d\n  ]));\x0d\n  const currentGraph = graphFor(alliedUnits\x2C currentPoints);\x0d\n  const chosen = new Map(proposalByReference);\x0d\n  const steered = [];\n  const movers = alliedUnits\n    .filter((unit) => {\n      const row = chosen.get(unit.referenceId);\n      return Math.hypot(row.dx\x2C row.dy) > EPSILON;\n    })\x0d\n    .sort((left\x2C right) => moverPriority(left\x2C right\x2C byReference));\x0d\n\x0d\n  for (const mover of movers) {\n    // Active melee pursuit uses authoritative pairwise allied transit. It is\n    // allowed to form ordinary two/three-body traffic and is shaped only by\n    // the explicit four-body guard below; the older compact-contact heuristic\n    // would otherwise manufacture tangents before a prohibited pile exists.\n    if (pursuitTransitReferenceIds.has(mover.referenceId)) continue;\n    const direct = chosen.get(mover.referenceId);\n    const projectedFor = (candidate) => new Map(alliedUnits.map((unit) => {\x0d\n      const row = unit.referenceId === mover.referenceId\x0d\n        ? candidate : chosen.get(unit.referenceId);\x0d\n      return [unit.referenceId\x2C projectedPoint(unit\x2C row\x2C byReference\x2C alliedUnits)];\x0d\n    }));\x0d\n    const directRisk = riskFor(mover\x2C alliedUnits\x2C currentGraph\x2C projectedFor(direct));\x0d\n    if (!isCompactRisk(directRisk)) continue;\x0d\n    if (admitsReachMeleeWedge(mover\x2C byReference\x2C directRisk)) continue;\x0d\n\x0d\n    const preferredSide = mover.avoidance?.side === -1 || mover.avoidance?.side === 1\x0d\n      ? mover.avoidance.side : 1;\x0d\n    const candidates = [];\x0d\n    for (let turn = 1; turn <= MAX_TURNS; turn += 1) {\x0d\n      for (const side of [preferredSide\x2C -preferredSide]) {\n        const proposal = rotatedProposal(direct\x2C side\x2C turn);\n        // Friendly crowd shaping may bend a valid pursuit step\x2C but it must\n        // never reverse it. Enemy bodies and static geometry are the only\n        // reasons a chaser may need a route whose instantaneous projection is\n        // not targetward; allied density alone is not such a reason.\n        if (proposal.dx * direct.dx + proposal.dy * direct.dy <= EPSILON) continue;\n        if (!staticGeometryClears(mover\x2C proposal\x2C map)) continue;\n        candidates.push({\n          proposal\x2C\x0d\n          side\x2C\x0d\n          turn\x2C\x0d\n          risk: riskFor(mover\x2C alliedUnits\x2C currentGraph\x2C projectedFor(proposal))\x2C\x0d\n        });\x0d\n      }\x0d\n    }\x0d\n    candidates.sort((left\x2C right) => (\x0d\n      compareRisk(left.risk\x2C right.risk)\x0d\n      || left.turn - right.turn\x0d\n      || (left.side === preferredSide ? -1 : 1)\x0d\n    ));\x0d\n    const selected = candidates[0];\x0d\n    if (!selected || compareRisk(selected.risk\x2C directRisk) >= 0) continue;\x0d\n    if (normalizedStrength <= EPSILON) continue;\x0d\n    const applied = rotatedProposal(\x0d\n      direct\x2C\x0d\n      selected.side\x2C\x0d\n      selected.turn * normalizedStrength\x2C\x0d\n    );\x0d\n    if (!staticGeometryClears(mover\x2C applied\x2C map)) continue;\x0d\n    chosen.set(mover.referenceId\x2C applied);\x0d\n    steered.push(Object.freeze({\n      referenceId: mover.referenceId\x2C\x0d\n      reason: "compact-contact"\x2C\x0d\n      side: selected.side\x2C\x0d\n      turnRadians: selected.turn * TURN_INCREMENT * normalizedStrength\x2C\x0d\n    }));\n  }\n\n  // Pairwise allied transit keeps a chase moving through its own formation\x2C\n  // but it must not collapse four bodies into one physical stack. Enforce the\n  // actual next-tick geometry after the softer look-ahead pass above. The\n  // rearmost involved mover takes the smallest full-speed rotation that\n  // reduces the number of four-cliques while preserving a positive component\n  // along its already planned route. This is geometry-derived: no unit name\x2C\n  // roster size\x2C or matchup calibration participates.\n  for (let pass = 0; pass < alliedUnits.length * 2; pass += 1) {\n    const currentCliques = fourCliques(alliedUnits\x2C oneStepPoints(alliedUnits\x2C chosen));\n    if (currentCliques.length === 0) break;\n    const involved = new Set(currentCliques.flat());\n    let best = null;\n    const rearFirst = [...movers].reverse();\n    for (let moverRank = 0; moverRank < rearFirst.length; moverRank += 1) {\n      const mover = rearFirst[moverRank];\n      if (!involved.has(mover.referenceId)) continue;\n      const direct = proposalByReference.get(mover.referenceId);\n      const distance = Math.hypot(direct.dx\x2C direct.dy);\n      if (distance <= EPSILON) continue;\n      const preferredSide = mover.avoidance?.side === -1 || mover.avoidance?.side === 1\n        ? mover.avoidance.side : (mover.referenceId % 2 === 0 ? 1 : -1);\n      for (let turn = 1; turn < MAX_TURNS; turn += 1) {\n        for (const side of [preferredSide\x2C -preferredSide]) {\n          const candidate = rotatedProposal(direct\x2C side\x2C turn);\n          const forward = candidate.dx * direct.dx + candidate.dy * direct.dy;\n          if (forward <= EPSILON || !staticGeometryClears(mover\x2C candidate\x2C map)) continue;\n          const candidateProposals = new Map(chosen);\n          candidateProposals.set(mover.referenceId\x2C candidate);\n          const cliqueCount = fourCliques(\n            alliedUnits\x2C\n            oneStepPoints(alliedUnits\x2C candidateProposals)\x2C\n          ).length;\n          if (cliqueCount >= currentCliques.length) continue;\n          const ranked = {\n            proposal: candidate\x2C\n            referenceId: mover.referenceId\x2C\n            cliqueCount\x2C\n            moverRank\x2C\n            side\x2C\n            turn\x2C\n            preferred: side === preferredSide ? 0 : 1\x2C\n          };\n          if (!best\n              || ranked.cliqueCount < best.cliqueCount\n              || (ranked.cliqueCount === best.cliqueCount && ranked.turn < best.turn)\n              || (ranked.cliqueCount === best.cliqueCount && ranked.turn === best.turn\n                && ranked.moverRank < best.moverRank)\n              || (ranked.cliqueCount === best.cliqueCount && ranked.turn === best.turn\n                && ranked.moverRank === best.moverRank && ranked.preferred < best.preferred)) {\n            best = ranked;\n          }\n        }\n      }\n    }\n    if (best === null) break;\n    chosen.set(best.referenceId\x2C best.proposal);\n    const priorIndex = steered.findIndex(({ referenceId }) => referenceId === best.referenceId);\n    if (priorIndex !== -1) steered.splice(priorIndex\x2C 1);\n    steered.push(Object.freeze({\n      referenceId: best.referenceId\x2C\n      reason: "four-way-contact-limit"\x2C\n      side: best.side\x2C\n      turnRadians: best.turn * TURN_INCREMENT\x2C\n    }));\n  }\n\n  return Object.freeze({\n    proposals: Object.freeze([...chosen.values()].sort((left\x2C right) => (\x0d\n      left.referenceId - right.referenceId\x0d\n    )))\x2C\x0d\n    steered: Object.freeze(steered.sort((left\x2C right) => (\x0d\n      left.referenceId - right.referenceId\x0d\n    )))\x2C\x0d\n  });\x0d\n}\x0d\n
