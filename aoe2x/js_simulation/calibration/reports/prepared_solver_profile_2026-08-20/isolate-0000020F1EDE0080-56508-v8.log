script-source,161,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/attacks.js,import { secondsToTicksCeil\x2C secondsToTicksNearest } from "../simulation-clock.js";\x0d\nimport {\x0d\n  MELEE_CONTACT_TOLERANCE_TILES\x2C\x0d\n  chebyshevGap\x2C\x0d\n  collisionRadius\x2C\x0d\n  surfaceGap as euclideanCollisionGap\x2C\x0d\n} from "./targeting.js";\x0d\nimport { createPairInteractionSnapshot\x2C resolvePairInteraction } from "./pair-interactions.js";\x0d\n\x0d\n\x0d\nfunction compareText(left\x2C right) {\x0d\n  const leftText = String(left ?? "");\x0d\n  const rightText = String(right ?? "");\x0d\n  if (leftText === rightText) return 0;\x0d\n  return leftText < rightText ? -1 : 1;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireReference(value\x2C name) {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireTick(value\x2C name) {\x0d\n  requireReference(value\x2C name);\x0d\n  if (value < 0) throw new RangeError(`${name} must be nonnegative`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction classValue(classes\x2C classId\x2C name) {\x0d\n  const value = classes?.[classId];\x0d\n  if (value === undefined) return undefined;\x0d\n  return requireFinite(value\x2C `${name} class ${classId}`);\x0d\n}\x0d\n\x0d\n\x0d\nfunction attackerHasCategory(mechanics\x2C category) {\x0d\n  const declared = mechanics?.combat_categories;\x0d\n  if (declared !== undefined) {\x0d\n    if (!Array.isArray(declared) || declared.some((value) => typeof value !== "string")) {\x0d\n      throw new TypeError("combat categories must be an array of strings");\x0d\n    }\x0d\n    if (declared.includes(category)) return true;\x0d\n  }\x0d\n  // Build 177723 marks mounted attackers with a negative class-39 attack\x0d\n  // entry. It covers cavalry\x2C cavalry archers\x2C Conquistador-class units and\x0d\n  // Ballista Elephants without relying on a simulator-side unit-name list.\x0d\n  if (category === "mounted") {\x0d\n    const marker = classValue(mechanics?.attack_classes\x2C "39"\x2C "attack");\x0d\n    return marker !== undefined && marker < 0;\x0d\n  }\x0d\n  return false;\x0d\n}\x0d\n\x0d\n\x0d\nfunction conditionalDamageReduction(actor\x2C target) {\x0d\n  const reductions = target?.mechanics?.damage_reduction_by_attacker_category;\x0d\n  if (reductions == null) return 0;\x0d\n  if (typeof reductions !== "object" || Array.isArray(reductions)) {\x0d\n    throw new TypeError("damage reduction by attacker category must be an object");\x0d\n  }\x0d\n  let total = 0;\x0d\n  for (const [category\x2C rawValue] of Object.entries(reductions)) {\x0d\n    const value = requireFinite(rawValue\x2C `${category} damage reduction`);\x0d\n    if (value < 0) throw new RangeError(`${category} damage reduction must be nonnegative`);\x0d\n    if (attackerHasCategory(actor?.mechanics\x2C category)) total += value;\x0d\n  }\x0d\n  return total;\x0d\n}\x0d\n\x0d\n\x0d\nfunction createEvent(type\x2C details) {\x0d\n  const tick = requireTick(details?.tick\x2C "event tick");\x0d\n  const actorId = requireReference(details?.actorId\x2C "actor reference ID");\x0d\n  const targetId = requireReference(details?.targetId\x2C "target reference ID");\x0d\n  const readyTick = requireTick(details?.readyTick\x2C "ready tick");\x0d\n  // A charge volley can land several projectiles on one victim in the same\x0d\n  // tick; the index keeps their event ids distinct.\x0d\n  const suffix = details?.projectileIndex !== undefined\x0d\n    ? `:${details.projectileIndex}`\x0d\n    : "";\x0d\n  const id = `${tick}:${type}:${actorId}:${targetId}${suffix}`;\x0d\n  return Object.freeze({\x0d\n    id\x2C\x0d\n    eventId: id\x2C\x0d\n    type\x2C\x0d\n    ...details\x2C\x0d\n    tick\x2C\x0d\n    actorId\x2C\x0d\n    targetId\x2C\x0d\n    readyTick\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function attackDelayTicks(mechanics) {\x0d\n  return secondsToTicksNearest(\x0d\n    requireFinite(mechanics?.attack_delay_seconds\x2C "attack delay seconds")\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\n// Full attack animation: the unit is committed to its swing for this long\x2C and\x0d\n// the hit lands partway through it (attackDelayTicks). Sourced from the Genie\x0d\n// attack graphic's frame_count x frame_duration.\x0d\nexport function attackAnimationTicks(mechanics) {\x0d\n  const seconds = requireFinite(\x0d\n    mechanics?.attack_animation?.seconds\x2C\x0d\n    "attack animation seconds"\x2C\x0d\n  );\x0d\n  if (seconds <= 0) throw new RangeError("attack animation must be positive");\x0d\n  const ticks = secondsToTicksNearest(seconds);\x0d\n  const delay = attackDelayTicks(mechanics);\x0d\n  if (delay > ticks) {\x0d\n    throw new RangeError("attack delay must not exceed the attack animation");\x0d\n  }\x0d\n  return ticks;\x0d\n}\x0d\n\x0d\n\x0d\nexport function reloadTicks(mechanics) {\x0d\n  return secondsToTicksCeil(\x0d\n    requireFinite(mechanics?.reload_seconds\x2C "reload seconds")\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\n// Movement STOP rule: a unit pursues until its COLLISION-box Chebyshev gap to\x0d\n// the target is at most max(range\x2C 0.1). Measured on the steppe tapes: the\x0d\n// range-1 lancer's approach stops are victim-invariant only in collision\x0d\n// terms and pile up in [0.95\x2C 1.00) against every victim type (p50 0.95\x2C\x0d\n// p90 0.995\x2C nothing between 1.0 and 1.1)\x2C while range-0 units keep the\x0d\n// long-established 0.1 stop. Units therefore walk INSIDE their outline\x0d\n// attack envelope (isWithinReach) before stopping; eligibility and stopping\x0d\n// are different rules with different boxes.\x0d\nexport function isWithinStopRange(actor\x2C target\x2C options = {}) {\x0d\n  const range = requireFinite(actor?.mechanics?.attack_range_tiles\x2C "attack range");\x0d\n  if (range < 0) throw new RangeError("attack range must be nonnegative");\x0d\n  const pairInteractions = options.pairInteractions\x0d\n    ?? createPairInteractionSnapshot();\x0d\n  const interaction = resolvePairInteraction(actor\x2C target\x2C pairInteractions);\x0d\n  // A one-to-one transit reservation is already the collision state for this\x0d\n  // pair. Range-zero melee therefore closes to that physical contact surface\x0d\n  // instead of stopping at the ordinary 0.1 approach tolerance; sourced\x0d\n  // attack eligibility still uses the unchanged outline reach below.\x0d\n  const stop = interaction.kind === "enemy-transit"\x0d\n    ? range\x0d\n    : Math.max(range\x2C MELEE_CONTACT_TOLERANCE_TILES);\x0d\n  const physicalExtent = collisionRadius(actor) + collisionRadius(target);\x0d\n  const overlapDepth = physicalExtent\x0d\n    - interaction.attackSurfaceExtent;\x0d\n  // Projectile units stop inside their Euclidean range circle (the same\x0d\n  // metric as their reach \u2014 see isWithinReach); melee units keep the\x0d\n  // Chebyshev collision-box rule measured on the steppe tapes.\x0d\n  if (actor?.mechanics?.ranged) {\x0d\n    return euclideanCollisionGap(actor\x2C target) + overlapDepth <= stop + 1e-12;\x0d\n  }\x0d\n  return chebyshevGap(actor\x2C target) + overlapDepth <= stop + 1e-12;\x0d\n}\x0d\n\x0d\n\x0d\nexport function calculateDamage(actor\x2C target) {\x0d\n  const attacks = actor?.mechanics?.attack_classes;\x0d\n  const armors = target?.mechanics?.armor_classes;\x0d\n  if (!attacks || typeof attacks !== "object") {\x0d\n    throw new TypeError("attacker classes are required");\x0d\n  }\x0d\n  if (!armors || typeof armors !== "object") {\x0d\n    throw new TypeError("target armor classes are required");\x0d\n  }\x0d\n\x0d\n  // Melee units carry their base attack in class 4\x2C ranged units in class 3\x0d\n  // (archers have no class-4 attack at all); both resolve through the one\x0d\n  // shared armor-class rule\x2C then any matching bonus classes stack on top.\x0d\n  const baseAttack = classValue(attacks\x2C "4"\x2C "attack");\x0d\n  const baseArmor = classValue(armors\x2C "4"\x2C "armor");\x0d\n  const pierceAttack = classValue(attacks\x2C "3"\x2C "attack");\x0d\n  const pierceArmor = classValue(armors\x2C "3"\x2C "armor");\x0d\n  if (\x0d\n    (baseAttack === undefined || baseArmor === undefined)\x0d\n    && (pierceAttack === undefined || pierceArmor === undefined)\x0d\n  ) {\x0d\n    throw new TypeError("attack and armor must share class 4 or class 3");\x0d\n  }\x0d\n  const term = (attackValue\x2C armorValue) => (\x0d\n    attackValue === undefined || armorValue === undefined\x0d\n      ? 0\x0d\n      : Math.max(0\x2C attackValue - armorValue)\x0d\n  );\x0d\n  let damage = term(baseAttack\x2C baseArmor) + term(pierceAttack\x2C pierceArmor);\x0d\n  for (const [classId\x2C attack] of Object.entries(attacks)) {\x0d\n    if (classId === "4" || classId === "3" || attack <= 0) continue;\x0d\n    const armor = classValue(armors\x2C classId\x2C "armor");\x0d\n    if (armor === undefined) continue;\x0d\n    damage += Math.max(0\x2C requireFinite(attack\x2C `attack class ${classId}`) - armor);\x0d\n  }\x0d\n  return Math.max(1\x2C damage - conditionalDamageReduction(actor\x2C target));\x0d\n}\x0d\n\x0d\n\x0d\n// Melee blast ("trample")\x2C sourced from the Genie dat and measured on the\x0d\n// authorized elephant tapes (54 fights): the blast is a circle of radius\x0d\n// blast.width_tiles centred on the ATTACKER at the instant its hit lands\x2C and\x0d\n// it reaches every ENEMY unit whose collision box intersects the circle \u2014\x0d\n// 1694/1694 tape bystander samples separate cleanly on that rule (hits reach\x0d\n// box-distance 0.396\x2C misses start at 0.402\x2C dat width 0.4). Each victim takes\x0d\n// blast.damage_fraction x the post-armor damage against ITSELF (14 -> 3.5 on\x0d\n// Champions\x2C 13 -> 3.25 on Paladins). Allies are never hit despite the dat's\x0d\n// level-2/friendly-fire flags\x2C and the main target takes only the main hit.\x0d\n// Gate mirrors the Python ability registry: blast_attack_level == 2 with a\x0d\n// true fraction (the Champion carries width 0 / damage -5.0 sentinels).\x0d\nexport function trampleSpec(mechanics) {\x0d\n  const blast = mechanics?.blast;\x0d\n  if (!blast) return null;\x0d\n  const width = requireFinite(blast.width_tiles\x2C "blast width");\x0d\n  const fraction = requireFinite(blast.damage_fraction\x2C "blast damage fraction");\x0d\n  if (blast.attack_level !== 2 || width <= 0 || fraction <= 0 || fraction >= 1) {\x0d\n    return null;\x0d\n  }\x0d\n  return { widthTiles: width\x2C damageFraction: fraction };\x0d\n}\x0d\n\x0d\n\x0d\n// Ranged attack (projectile-armed units)\x2C measured on the authorized\x0d\n// arbalester-vs-eliteskirm archive (25 fights\x2C 6312 shots):\x0d\n//   - the attack CYCLE is the ordinary cycle: same outline-box reach at\x0d\n//     range + 0.1 (max observed fire distance 8.56 = 8 + 0.1 + two 0.2\x0d\n//     outlines)\x2C same collision-box stop rule\x2C same windup frame and reload\x0d\n//     cadence \u2014 only the damage delivery differs;\x0d\n//   - the shot flies at the projectile unit's dat speed to the target's\x0d\n//     position at FIRE time (smart_mode 0: no leading)\x2C and on arrival hits\x0d\n//     iff the target is alive and still within its own collision box of that\x0d\n//     aim point. 5141/6312 tape shots hit; 1068 found a corpse (died\x0d\n//     mid-flight)\x2C 23 found the target walked away (displacement >= 0.23 at\x0d\n//     arrival while hits sit at p90 0.0)\x2C and 80 (1.27%) missed a live\x0d\n//     stationary target \u2014 the accuracy-roll residue\x2C which the deterministic\x0d\n//     engine does not simulate (documented overshoot).\x0d\nexport function rangedSpec(mechanics) {\x0d\n  const ranged = mechanics?.ranged;\x0d\n  if (!ranged) return null;\x0d\n  const speed = requireFinite(\x0d\n    ranged.projectile_speed_tiles_per_second\x2C "ranged projectile speed");\x0d\n  if (speed <= 0) throw new RangeError("ranged projectile speed must be positive");\x0d\n  const minRange = requireFinite(ranged.min_range_tiles ?? 0\x2C "ranged min range");\x0d\n  if (minRange < 0) throw new RangeError("ranged min range must be nonnegative");\x0d\n  const passThrough = ranged.pass_through === true;\x0d\n  const halfWidth = requireFinite(\x0d\n    ranged.projectile_half_width_tiles ?? 0\x2C "projectile half width");\x0d\n  if (passThrough && halfWidth <= 0) {\x0d\n    throw new RangeError("pass-through bolts need a positive projectile width");\x0d\n  }\x0d\n  // Dat attribute 19 bitfield on the projectile unit: bit 1 = ballistics\x0d\n  // lead on moving targets (set by the Ballistics tech on its projectile\x0d\n  // list)\x2C bit 2 = full damage on unintended targets. Absent on fixtures\x0d\n  // exported before the attribute was sourced; those fly unled.\x0d\n  const smartMode = requireFinite(ranged.smart_mode ?? 0\x2C "ranged smart mode");\x0d\n  // Accuracy (dat accuracy_percent < 100 gates the whole mechanic; every\x0d\n  // converged-corpus archer is 100): an aim-true roll per shot; a missed\x0d\n  // shot scatters within the dat dispersion half-radius and deals HALF\x0d\n  // damage to whatever it hits (measured on the standard-units tapes:\x0d\n  // hand-cannoneer quanta 22/11\x2C 11/5.5 and 8/4 across four defender\x0d\n  // armors are exact full/half pairs).\x0d\n  const accuracy = requireFinite(ranged.accuracy_percent ?? 100\x2C "ranged accuracy");\x0d\n  const dispersion = requireFinite(\x0d\n    ranged.accuracy_dispersion_tiles ?? 0\x2C "ranged dispersion");\x0d\n  // Mangonel-family blast: the FIRING unit's blast width is the area radius\x0d\n  // at the primary projectile's impact point. Secondaries are visual-only\x0d\n  // dat units with EMPTY attack lists \u2014 each lands scattered over the\x0d\n  // spawning area for the floor 1 damage (the tapes' ubiquitous 1.0 hits).\x0d\n  const blastRadius = ranged.pass_through\x0d\n    ? 0\x0d\n    : requireFinite(mechanics?.blast?.width_tiles ?? 0\x2C "blast width");\x0d\n  const secondaryCount = requireFinite(\x0d\n    ranged.secondary_projectile_count ?? 0\x2C "secondary projectile count");\x0d\n  const spawnArea = Array.isArray(ranged.projectile_spawning_area)\x0d\n    ? ranged.projectile_spawning_area\x0d\n    : [0\x2C 0];\x0d\n  return {\x0d\n    projectileSpeed: speed\x2C\x0d\n    minRangeTiles: minRange\x2C\x0d\n    passThrough\x2C\x0d\n    projectileHalfWidth: halfWidth\x2C\x0d\n    smartMode\x2C\x0d\n    accuracyPercent: accuracy\x2C\x0d\n    dispersionTiles: dispersion\x2C\x0d\n    blastRadius\x2C\x0d\n    secondaryCount\x2C\x0d\n    spawnArea\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nexport const MISS_DAMAGE_FRACTION = 0.5;\x0d\n\x0d\n\x0d\n// Pass-through bolt constants\x2C measured on the scorpion archives (50 fights):\x0d\n//   - every pass victim takes exactly HALF its own post-armor damage\x0d\n//     (5407/5407 events: 5.5 on 11-damage arbalesters\x2C 6.0 on 12-damage\x0d\n//     champions; the firer's action target takes full damage\x2C 577/577);\x0d\n//   - the bolt expires ~3.0 tiles past its aim point (victim overshoot p95\x0d\n//     plateaus at 2.97-3.00 across target distances 3-5 where the arena\x0d\n//     leaves room\x2C softening only where the map clips the line).\x0d\nexport const PASS_THROUGH_DAMAGE_FRACTION = 0.5;\x0d\nexport const BOLT_OVERSHOOT_TILES = 3.0;\x0d\n\x0d\n\x0d\n// Charge volley (Fire Lancer family)\x2C sourced from the Genie dat and measured\x0d\n// on the four authorized firelancer archives (108 fights\x2C 265 volleys):\x0d\n//   - charge_type 6 fires `projectile_count` charge projectiles as the unit's\x0d\n//     FIRST attack cycle. Units spawn with full charge; every tape volley is\x0d\n//     the firer's opening attack and no unit ever refired (recharge takes 30 s\x0d\n//     and no recorded fight leaves a unit in combat that long after firing).\x0d\n//   - The charge cycle runs on the dat `special_graphic` animation (2.000 s\x0d\n//     for the Elite Fire Lancer) with the volley released on animation frame\x0d\n//     `frame_delay`: 10/30 -> 0.6667 s\x2C tape floor 0.668 across 265 volleys.\x0d\n//     The unit stands for the WHOLE animation (first post-volley movement at\x0d\n//     anim end + the recorder's detection lag)\x2C and its regular reload runs\x0d\n//     from the same swing start\x2C so the next melee swing follows one reload\x0d\n//     after the charge swing (tape minimum gap 2.016 s).\x0d\n//   - It is fired from a standstill at the acquisition target\x2C 1.5-5.2 tiles\x0d\n//     out in the tapes\x2C without closing first; line of sight is the bound.\x0d\n//   - Each projectile deals the class-matched attack total with the victim's\x0d\n//     armor VALUES ignored: champions (PA 5)\x2C paladins (PA 7)\x2C steppe lancers\x0d\n//     (PA 6) and elephants (PA 9) all take exactly 3.0 -- 684/684 events.\x0d\n//   - 88% of tape hits land on the volley's target and 2.58 of 3 projectiles\x0d\n//     land on average\x2C victim-size independent; the residual in-game scatter\x0d\n//     is not resolvable at the recorder's 10 Hz missile sampling\x2C so the\x0d\n//     engine flies all three at the target and accepts the ~1 damage/volley\x0d\n//     overshoot (documented in docs/FIRE_LANCER_CHARGE_2026-08-06.md).\x0d\nexport function chargeSpec(mechanics) {\x0d\n  const charge = mechanics?.charge;\x0d\n  if (!charge) return null;\x0d\n  if (charge.charge_type !== 6) {\x0d\n    throw new RangeError(`unsupported charge_type ${charge.charge_type}`);\x0d\n  }\x0d\n  const maxCharge = requireFinite(charge.max_charge\x2C "max charge");\x0d\n  const rechargeRate = requireFinite(charge.recharge_rate\x2C "recharge rate");\x0d\n  const projectileCount = charge.projectile_count;\x0d\n  if (!Number.isSafeInteger(projectileCount) || projectileCount < 1) {\x0d\n    throw new RangeError("charge projectile count must be a positive integer");\x0d\n  }\x0d\n  const speed = requireFinite(\x0d\n    charge.projectile_speed_tiles_per_second\x2C "charge projectile speed");\x0d\n  if (maxCharge <= 0 || speed <= 0) {\x0d\n    throw new RangeError("charge and projectile speed must be positive");\x0d\n  }\x0d\n  const windupTicks = secondsToTicksNearest(\x0d\n    requireFinite(charge.windup_seconds\x2C "charge windup seconds"));\x0d\n  const animationTicks = secondsToTicksNearest(\x0d\n    requireFinite(charge.charge_animation?.seconds\x2C "charge animation seconds"));\x0d\n  if (windupTicks <= 0 || windupTicks > animationTicks) {\x0d\n    throw new RangeError("charge windup must sit inside the charge animation");\x0d\n  }\x0d\n  const attacks = charge.projectile_attacks;\x0d\n  if (!attacks || typeof attacks !== "object" || !Object.keys(attacks).length) {\x0d\n    throw new TypeError("charge projectile attacks are required");\x0d\n  }\x0d\n  return {\x0d\n    maxCharge\x2C\x0d\n    rechargeRate\x2C\x0d\n    projectileCount\x2C\x0d\n    projectileSpeed: speed\x2C\x0d\n    projectileAttacks: attacks\x2C\x0d\n    windupTicks\x2C\x0d\n    animationTicks\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\n// Charge projectile damage: standard armor-class matching\x2C armor value IGNORED.\x0d\n// The victim takes the projectile's attack amount for every bonus class it\x0d\n// carries (min 1 like any hit). All four recorded victim types measure exactly\x0d\n// the projectile's class-3 pierce amount\x2C through pierce armor 5-9.\x0d\nexport function chargeProjectileDamage(spec\x2C target) {\x0d\n  const armors = target?.mechanics?.armor_classes;\x0d\n  if (!armors || typeof armors !== "object") {\x0d\n    throw new TypeError("target armor classes are required");\x0d\n  }\x0d\n  let damage = 0;\x0d\n  for (const [classId\x2C attack] of Object.entries(spec.projectileAttacks)) {\x0d\n    if (attack <= 0) continue;\x0d\n    if (classValue(armors\x2C classId\x2C "armor") === undefined) continue;\x0d\n    damage += requireFinite(attack\x2C `charge attack class ${classId}`);\x0d\n  }\x0d\n  return Math.max(1\x2C damage);\x0d\n}\x0d\n\x0d\n\x0d\nexport function createAttackStartEvent(details) {\x0d\n  return createEvent("attack-start"\x2C details);\x0d\n}\x0d\n\x0d\n\x0d\nexport function createDamageEvent(details) {\x0d\n  return createEvent("damage"\x2C details);\x0d\n}\x0d\n\x0d\n\x0d\nexport function createDeathEvent(details) {\x0d\n  return createEvent("death"\x2C details);\x0d\n}\x0d\n\x0d\n\x0d\nexport function createAttackCanceledEvent(details) {\x0d\n  return createEvent("attack-canceled"\x2C details);\x0d\n}\x0d\n\x0d\n\x0d\nexport function orderReadyAttacks(attacks) {\x0d\n  if (!Array.isArray(attacks)) throw new TypeError("ready attacks must be an array");\x0d\n  return [...attacks].sort((left\x2C right) => (\x0d\n    left.readyTick - right.readyTick ||\x0d\n    left.actorId - right.actorId ||\x0d\n    left.targetId - right.targetId ||\x0d\n    compareText(left.type\x2C right.type)\x0d\n  ));\x0d\n}\x0d\n
