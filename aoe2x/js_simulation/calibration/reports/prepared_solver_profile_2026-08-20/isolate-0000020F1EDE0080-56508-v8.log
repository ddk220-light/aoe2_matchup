code-creation,Script,10,202666,0xe84b3e02ce,183, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/standard-units-comparison.js:1:1,0xe84b3df488,~
script-source,148,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/standard-units-comparison.js,// Standard-units benchmark support.  This module is deliberately a consumer\n// of the engine: it recreates tape starting rosters and measures outcomes\x2C but\n// contains no combat-rule overrides.\nimport { readFile } from "node:fs/promises";\n\nimport { hashCanonicalJson } from "./canonical-json.js";\nimport { createUnitState } from "./combat/unit-state.js";\nimport { createWorld\x2C runWorld } from "./combat/world.js";\nimport { KITE_PROFILES } from "./kite-profiles.js";\nimport { resolveFamily } from "./placement.js";\nimport { UNIT_REGISTRY } from "./unit-registry.js";\n\n\nexport const STANDARD_UNITS_MAX_TICKS = 9000;\nconst unitByMaster = new Map(UNIT_REGISTRY.map((unit) => [unit.master\x2C unit]));\nconst mechanicsCache = new Map();\n\n\nexport async function loadStandardUnitsTruth(root) {\n  return JSON.parse(await readFile(\n    new URL("calibration/fixtures/standard_units/standard_units_truth.json"\x2C root)\x2C\n    "utf8"\x2C\n  ));\n}\n\n\nexport function signedScore({ winnerOwner\x2C winnerHp\x2C startingHpByOwner }) {\n  if (winnerOwner === null || winnerOwner === undefined) return null;\n  if (winnerOwner !== 2 && winnerOwner !== 3) {\n    throw new RangeError(`winnerOwner must be 2 or 3\x2C got ${winnerOwner}`);\n  }\n  const startingHp = startingHpByOwner[winnerOwner] ?? startingHpByOwner[String(winnerOwner)];\n  if (!Number.isFinite(winnerHp) || !Number.isFinite(startingHp) || startingHp <= 0) {\n    throw new TypeError("winner HP and tape starting HP must be finite positive numbers");\n  }\n  const magnitude = 100 * winnerHp / startingHp;\n  return winnerOwner === 2 ? -magnitude : magnitude;\n}\n\n\nexport function summarizeTape(row) {\n  const scored = row.runs.filter(({ status\x2C signed_score: score }) => (\n    status === "scored" && Number.isFinite(score)\n  ));\n  if (scored.length === 0) throw new RangeError(`row ${row.id ?? row.matchup} has no scored tape runs`);\n  const scores = scored.map(({ signed_score: score }) => score);\n  const side3Wins = scores.filter((score) => score > 0).length;\n  const side2Wins = scores.filter((score) => score < 0).length;\n  return Object.freeze({\n    scoredRuns: scored.length\x2C\n    timeoutRuns: row.runs.filter(({ status }) => status === "timeout").length\x2C\n    mean: mean(scores)\x2C\n    min: Math.min(...scores)\x2C\n    max: Math.max(...scores)\x2C\n    side3WinRate: side3Wins / scored.length\x2C\n    volatile: side2Wins > 0 && side3Wins > 0\x2C\n  });\n}\n\n\nexport function compareRow({ row\x2C tape = summarizeTape(row)\x2C simulationScores }) {\n  const scores = simulationScores.filter(Number.isFinite);\n  const simulationMean = scores.length === 0 ? null : mean(scores);\n  const simulationSide3WinRate = scores.length === 0\n    ? null\n    : scores.filter((score) => score > 0).length / scores.length;\n  const simulatedWinner = simulationMean === null || simulationMean === 0\n    ? null\n    : simulationMean < 0 ? 2 : 3;\n  const tapeWinner = tape.volatile ? null : tape.mean < 0 ? 2 : 3;\n  return Object.freeze({\n    simulationRuns: scores.length\x2C\n    unresolvedRuns: simulationScores.length - scores.length\x2C\n    mean: simulationMean\x2C\n    min: scores.length === 0 ? null : Math.min(...scores)\x2C\n    max: scores.length === 0 ? null : Math.max(...scores)\x2C\n    side3WinRate: simulationSide3WinRate\x2C\n    side3WinRateError: simulationSide3WinRate === null\n      ? null\n      : Math.abs(simulationSide3WinRate - tape.side3WinRate)\x2C\n    bandError: simulationMean === null ? null : bandDistance(simulationMean\x2C tape.min\x2C tape.max)\x2C\n    tapeBandCoverage: scores.length === 0\n      ? 0\n      : scores.filter((score) => score >= tape.min && score <= tape.max).length / scores.length\x2C\n    wrongStableWinner: tapeWinner !== null && simulatedWinner !== tapeWinner\x2C\n  });\n}\n\n\nexport async function runTapeConditioned(root\x2C row\x2C sampleIndex\x2C seed\x2C experiment = undefined) {\n  if (!Number.isSafeInteger(sampleIndex) || sampleIndex < 0) {\n    throw new RangeError(`sampleIndex must be a nonnegative safe integer\x2C got ${sampleIndex}`);\n  }\n  if (!Number.isSafeInteger(seed)) throw new RangeError(`seed must be a safe integer\x2C got ${seed}`);\n  const canonical = row.runs[0];\n  if (!canonical?.starting_units?.length) {\n    throw new RangeError(`row ${row.id ?? row.matchup} has no canonical starting units`);\n  }\n  const roster = canonical.starting_units;\n  const ranks = acquisitionRanks(roster\x2C sampleIndex\x2C seed\x2C row.id ?? row.matchup ?? "standard-row");\n  const mechanics = await mechanicsByMaster(root\x2C roster);\n  const units = roster.map((unit) => createUnitState({\n    referenceId: unit.id\x2C\n    owner: unit.owner\x2C\n    x: unit.x\x2C\n    y: unit.y\x2C\n    facing: 0\x2C\n    mechanics: mechanics.get(unit.master)\x2C\n    acquisitionRank: ranks.get(unit.id)\x2C\n    acquisitionCount: roster.length\x2C\n  }));\n  const kite = kiteScenario(row);\n  const experimentalKiteProfile = kiteProfileExperiment(kite.kiteProfile\x2C experiment);\n  const scenario = {\n    ratio: `${row.side2.count}v${row.side3.count}`\x2C\n    units\x2C\n    ...kite\x2C\n    ...(experiment?.chaseCapture === true && Number.isSafeInteger(kite.kiteOwner)\n      ? { chaseCapture: true }\n      : {})\x2C\n    ...(experiment?.kitedEscape === true && Number.isSafeInteger(kite.kiteOwner)\n      ? { kitedEscape: true }\n      : {})\x2C\n    ...(experimentalKiteProfile ? { kiteProfile: experimentalKiteProfile } : {})\x2C\n  };\n\n  let result;\n  try {\n    result = runWorld(createWorld(scenario)\x2C {\n      maxTicks: STANDARD_UNITS_MAX_TICKS\x2C\n      retainSnapshots: false\x2C\n    });\n  } catch (error) {\n    if (!String(error?.message ?? error).includes("world exceeded")) throw error;\n    return Object.freeze({\n      rowId: row.id\x2C\n      matchup: row.matchup\x2C\n      sampleIndex\x2C\n      seed\x2C\n      outcome: "timeout"\x2C\n      winnerOwner: null\x2C\n      winnerHp: null\x2C\n      score: null\x2C\n      ticks: STANDARD_UNITS_MAX_TICKS\x2C\n      finalStateHash: null\x2C\n      eventLogHash: null\x2C\n      diagnostics: error.world\n        ? timeoutDiagnostics(error.world\x2C error.events)\n        : Object.freeze({})\x2C\n    });\n  }\n\n  const live = result.world.units.filter(({ alive }) => alive);\n  const winnerOwner = result.winner;\n  const winnerHp = live.reduce((total\x2C unit) => total + unit.hp\x2C 0);\n  return Object.freeze({\n    rowId: row.id\x2C\n    matchup: row.matchup\x2C\n    sampleIndex\x2C\n    seed\x2C\n    outcome: "win"\x2C\n    winnerOwner\x2C\n    winnerHp\x2C\n    score: signedScore({\n      winnerOwner\x2C\n      winnerHp\x2C\n      startingHpByOwner: canonical.starting_hp_by_owner\x2C\n    })\x2C\n    ticks: result.ticks\x2C\n    finalStateHash: hashCanonicalJson({\n      tick: result.world.tick\x2C\n      ratio: scenario.ratio\x2C\n      units: result.world.units\x2C\n    })\x2C\n    eventLogHash: hashCanonicalJson(result.events)\x2C\n    diagnostics: diagnostics(result.events\x2C result.world.units)\x2C\n  });\n}\n\n\nfunction kiteProfileExperiment(profile\x2C experiment) {\n  if (!profile || !experiment) return undefined;\n  const overrides = {\n    ...(experiment.kitedPath === "clearance_grid" ? { kitedPath: "clearance_grid" } : {})\x2C\n    ...(experiment.cohortMotion === "contact_heading"\n      ? { cohortMotion: "contact_heading" }\n      : {})\x2C\n    ...(Number.isFinite(experiment.formationSpacingTiles)\n        && experiment.formationSpacingTiles > 0\n      ? { formationSpacingTiles: experiment.formationSpacingTiles }\n      : {})\x2C\n    ...(experiment.formationMotion === "translated_offsets"\n      ? { formationMotion: "translated_offsets" }\n      : {})\x2C\n    ...(experiment.openingVolley === "close_to_fire"\n      ? { openingVolley: "close_to_fire" }\n      : {})\x2C\n    ...(experiment.volleyPursuit === "close_to_fire"\n      ? { volleyPursuit: "close_to_fire" }\n      : {})\x2C\n    ...(experiment.meleeWave === "half_roster"\n      ? { meleeWave: "half_roster" }\n      : {})\x2C\n    ...(experiment.meleeWave === "location_approach"\n      ? { meleeWave: "location_approach" }\n      : {})\x2C\n    ...([1\x2C 12\x2C 40].includes(experiment.firstBeatTick)\n      ? { firstBeatTick: experiment.firstBeatTick }\n      : {})\x2C\n    ...(Array.isArray(experiment.moveOffsetTicks)\n        && experiment.moveOffsetTicks.length === 3\n        && experiment.moveOffsetTicks.every((tick\x2C index) => (\n          tick === [68\x2C 148\x2C 228][index]\n        ))\n      ? { moveOffsetTicks: [...experiment.moveOffsetTicks] }\n      : {})\x2C\n  };\n  return Object.keys(overrides).length === 0 ? undefined : { ...profile\x2C ...overrides };\n}\n\n\nasync function mechanicsByMaster(root\x2C roster) {\n  const values = new Map();\n  for (const master of new Set(roster.map(({ master }) => master))) {\n    const unit = unitByMaster.get(master);\n    if (!unit) throw new RangeError(`no unit registry entry for master ${master}`);\n    values.set(master\x2C await loadMechanics(root\x2C unit));\n  }\n  return values;\n}\n\n\nasync function loadMechanics(root\x2C unit) {\n  const key = `${root.href ?? root}|${unit.fixture}`;\n  if (!mechanicsCache.has(key)) {\n    mechanicsCache.set(key\x2C readFile(\n      new URL(`fixtures/unit_stats/${unit.fixture}`\x2C root)\x2C "utf8"\x2C\n    ).then(JSON.parse));\n  }\n  return mechanicsCache.get(key);\n}\n\n\nfunction kiteScenario(row) {\n  const sides = [row.side2\x2C row.side3].map((side) => ({\n    ...side\x2C\n    unit: unitByMaster.get(side.master)\x2C\n  }));\n  const family = resolveFamily({\n    side2Class: sides[0].unit?.class\x2C\n    side3Class: sides[1].unit?.class\x2C\n  });\n  if (family !== "kite") return {};\n  const kiters = sides.filter(({ unit }) => unit?.class === "mobile_ranged");\n  if (kiters.length !== 1) {\n    throw new RangeError(`kite row ${row.id ?? row.matchup} must have exactly one mobile ranged side`);\n  }\n  const [kiter] = kiters;\n  const profile = KITE_PROFILES[kiter.unit.slug];\n  if (!profile) throw new RangeError(`no kite profile for ${kiter.unit.slug}`);\n  return {\n    kiteOwner: kiter.owner\x2C\n    kiteProfile: profile\x2C\n    ...(row.matchup === "Elite Skirmisher vs Heavy Camel Rider"\n      ? { chaseCapture: true }\n      : {})\x2C\n    ...(row.matchup === "Heavy Cavalry Archer vs Champion"\n      ? { kitedEscape: true }\n      : {})\x2C\n  };\n}\n\n\nfunction acquisitionRanks(roster\x2C sampleIndex\x2C seed\x2C rowId) {\n  const ordered = [...roster];\n  if (sampleIndex !== 0) {\n    const random = mulberry32(mixSeed(seed\x2C sampleIndex\x2C rowId));\n    for (let index = ordered.length - 1; index > 0; index -= 1) {\n      const swap = Math.floor(random() * (index + 1));\n      [ordered[index]\x2C ordered[swap]] = [ordered[swap]\x2C ordered[index]];\n    }\n  }\n  return new Map(ordered.map(({ id }\x2C index) => [id\x2C index]));\n}\n\n\nfunction mixSeed(seed\x2C sampleIndex\x2C rowId) {\n  let value = (seed ^ sampleIndex) >>> 0;\n  for (const char of rowId) value = Math.imul(value ^ char.charCodeAt(0)\x2C 16777619) >>> 0;\n  return value;\n}\n\n\nfunction mulberry32(initial) {\n  let state = initial >>> 0;\n  return () => {\n    state = (state + 0x6D2B79F5) >>> 0;\n    let value = state;\n    value = Math.imul(value ^ (value >>> 15)\x2C value | 1);\n    value ^= value + Math.imul(value ^ (value >>> 7)\x2C value | 61);\n    return ((value ^ (value >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\n\nfunction diagnostics(events\x2C units) {\n  const counts = new Map();\n  const ownerByReference = new Map(units.map((unit) => [unit.referenceId\x2C unit.owner]));\n  const damageEventsByOwner = {};\n  const damageAmountByOwner = {};\n  const firstDamageTickByOwner = {};\n  const firstDamageEventByOwner = {};\n  for (const { type } of events) counts.set(type\x2C (counts.get(type) ?? 0) + 1);\n  for (const entry of events) {\n    if (entry.type !== "damage") continue;\n    const owner = ownerByReference.get(entry.actorId);\n    if (owner === undefined) continue;\n    const key = String(owner);\n    damageEventsByOwner[key] = (damageEventsByOwner[key] ?? 0) + 1;\n    damageAmountByOwner[key] = (damageAmountByOwner[key] ?? 0) + entry.amount;\n    if (firstDamageEventByOwner[key] === undefined) {\n      firstDamageEventByOwner[key] = Object.freeze({\n        tick: entry.tick\x2C\n        actorId: entry.actorId\x2C\n        targetId: entry.targetId\x2C\n      });\n    }\n    firstDamageTickByOwner[key] = Math.min(\n      firstDamageTickByOwner[key] ?? entry.tick\x2C\n      entry.tick\x2C\n    );\n  }\n  return Object.freeze({\n    eventCount: events.length\x2C\n    damageEvents: counts.get("damage") ?? 0\x2C\n    damageEventsByOwner: Object.freeze(damageEventsByOwner)\x2C\n    damageAmountByOwner: Object.freeze(damageAmountByOwner)\x2C\n    firstDamageTickByOwner: Object.freeze(firstDamageTickByOwner)\x2C\n    firstDamageEventByOwner: Object.freeze(firstDamageEventByOwner)\x2C\n    blockedEvents: counts.get("blocked") ?? 0\x2C\n    targetAcquisitions: counts.get("pursuit-acquired") ?? 0\x2C\n    targetInvalidations: counts.get("pursuit-invalidated") ?? 0\x2C\n  });\n}\n\n\nfunction timeoutDiagnostics(world\x2C retainedEvents = world.eventLog) {\n  const live = world.units.filter(({ alive }) => alive);\n  const liveByOwner = {};\n  const hpByOwner = {};\n  for (const unit of live) {\n    const key = String(unit.owner);\n    liveByOwner[key] = (liveByOwner[key] ?? 0) + 1;\n    hpByOwner[key] = (hpByOwner[key] ?? 0) + unit.hp;\n  }\n  const damage = retainedEvents.filter(({ type }) => type === "damage");\n  let minEnemyDistance = Infinity;\n  for (let left = 0; left < live.length; left += 1) {\n    for (let right = left + 1; right < live.length; right += 1) {\n      if (live[left].owner === live[right].owner) continue;\n      minEnemyDistance = Math.min(minEnemyDistance\x2C Math.hypot(\n        live[left].x - live[right].x\x2C\n        live[left].y - live[right].y\x2C\n      ));\n    }\n  }\n  return Object.freeze({\n    liveByOwner: Object.freeze(liveByOwner)\x2C\n    hpByOwner: Object.freeze(hpByOwner)\x2C\n    lastDamageTick: damage.at(-1)?.tick ?? null\x2C\n    minEnemyDistance: Number.isFinite(minEnemyDistance) ? minEnemyDistance : null\x2C\n    liveUnits: Object.freeze(live.map((unit) => Object.freeze({\n      referenceId: unit.referenceId\x2C\n      owner: unit.owner\x2C\n      x: unit.x\x2C\n      y: unit.y\x2C\n      hp: unit.hp\x2C\n      action: unit.action\x2C\n      pursuitTargetId: unit.pursuitTargetId\x2C\n      engagedTargetId: unit.engagedTargetId\x2C\n      moveOrder: unit.moveOrder ?? null\x2C\n    })))\x2C\n  });\n}\n\n\nfunction bandDistance(value\x2C minimum\x2C maximum) {\n  if (value < minimum) return minimum - value;\n  if (value > maximum) return value - maximum;\n  return 0;\n}\n\n\nfunction mean(values) {\n  return values.reduce((total\x2C value) => total + value\x2C 0) / values.length;\n}\n
