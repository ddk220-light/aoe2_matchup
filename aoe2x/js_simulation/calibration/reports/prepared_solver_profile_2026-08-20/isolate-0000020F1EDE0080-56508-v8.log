persistence (measured\x2C three archives): a unit shoved out\x0d\n    // of reach that TRIES to close and is fully blocked keeps its attack\x0d\n    // cycle on its live target \u2014 a pve 5v3 paladin swings from collision gap\x0d\n    // 0.523-0.575 for 25 straight seconds after the scrum separates the pair\x2C\x0d\n    // and steppe lancers land tail hits lagging their reach by exactly one\x0d\n    // reload. A unit that CAN move chases instead (engagement drops below)\x2C\x0d\n    // which is what keeps fleeing-target pursuit intact. Line of sight is the\x0d\n    // outer sanity bound (dat-sourced); no swing was ever observed beyond\x0d\n    // outline gap +0.24\x2C all from deep scrums.\x0d\n    if (\x0d\n      previousTargetId !== null && previousTargetId !== undefined\x0d\n      && blockedIds.has(unit.referenceId)\x0d\n    ) {\x0d\n      const engaged = snapshot.find(({ referenceId }) => referenceId === previousTargetId);\x0d\n      if (engaged && engaged.alive && engaged.owner !== unit.owner) {\x0d\n        const distance = Math.hypot(engaged.x - unit.x\x2C engaged.y - unit.y);\x0d\n        if (distance <= unit.mechanics.line_of_sight_tiles) continue;\x0d\n      }\x0d\n    }\x0d\n    const self = snapshot.find(({ referenceId }) => referenceId === unit.referenceId);\x0d\n    const selection = selectEngagementTarget(self\x2C snapshot\x2C contacts);\x0d\n    // Experiment harness: engagement follows pursuit. Off by default.\x0d\n    //\x0d\n    // Priority\x2C not exclusivity: a unit whose pursuit target is in reach\x0d\n    // engages it over anything else\x2C but a unit BLOCKED short of its pursuit\x0d\n    // target fights whatever enemy is in reach instead of standing idle.\x0d\n    // Aggressive-stance unit AI never sleeps next to an enemy; the strict\x0d\n    // version of this rule starved crowded fights -- in 21v10 the surplus\x0d\n    // champions parked idle waiting for rate-limited rescue orders (65.8\x0d\n    // orders/fight vs the tape's 15\x2C 38 after 15 s vs the tape's 1) and the\x0d\n    // paladins won all 25 sampled runs where the tape flips.\x0d\n    const pursued = ENGAGEMENT_FOLLOWS_PURSUIT\x0d\n      && unit.pursuitTargetId !== null && unit.pursuitTargetId !== undefined\x0d\n      ? snapshot.find(({ referenceId }) => referenceId === unit.pursuitTargetId)\x0d\n      : null;\x0d\n    // The pursuit target takes priority only once the unit has CLOSED to its\x0d\n    // movement stop range \u2014 the same distance at which the old collision-based\x0d\n    // engine applied this rule for range-0 units\x2C kept range-aware here.\x0d\n    // Widening the priority to the outline envelope re-focused fire enough to\x0d\n    // swing paladin_vs_elephant 5v3 from band error 0.4 to 10.7; blocked units\x0d\n    // farther out fight through selectEngagementTarget's outline fallback\x0d\n    // instead\x2C which is what the steppe back line actually exercises.\x0d\n    // The pursuit target must also be legally attackable: isWithinReach\x0d\n    // carries the minimum-range gate (dat type_50.min_range; scorpion fire\x0d\n    // distances bottom out at 2.19 vs its 2.0\x2C and the skirmisher tapes\x0d\n    // deliver less than half their theoretical beat output because chasers\x0d\n    // glued inside 1.0 cannot be shot). For melee actors stop range implies\x0d\n    // reach (collision gap >= outline gap)\x2C so this adds nothing there. A\x0d\n    // ranged unit PINNED this way (pursuit target closed inside its minimum\x0d\n    // range) does not freelance onto another target either \u2014 it holds fire\x0d\n    // and min-range-retreats\x2C target lock intact: letting it fall through\x0d\n    // to selectEngagementTarget kept every pinned scorpion firing full\x0d\n    // pass-through bolts at the rest of the pack and flipped svc 15v20 to a\x0d\n    // scorpion win the tape refutes.\x0d\n    const pursuedClosed = pursued && pursued.alive && isWithinStopRange(\x0d\n      self\x2C\x0d\n      pursued\x2C\x0d\n      { pairInteractions }\x2C\x0d\n    );\x0d\n    const nextTargetId = pursuedClosed && isWithinReach(self\x2C pursued)\x0d\n      ? pursued.referenceId\x0d\n      : (pursuedClosed && unit.mechanics?.ranged\x0d\n        ? null\x0d\n        : selection.target?.referenceId ?? null);\x0d\n    if (nextTargetId === previousTargetId) continue;\x0d\n    if (previousTargetId !== null && previousTargetId !== undefined) {\x0d\n      events.push(event(tick\x2C "engagement-ended"\x2C unit.referenceId\x2C previousTargetId\x2C {\x0d\n        reason: snapshot.find(({ referenceId }) => referenceId === previousTargetId)?.alive\x0d\n          ? "contact-lost"\x0d\n          : "target-dead"\x2C\x0d\n      }));\x0d\n    }\x0d\n    unit.engagedTargetId = nextTargetId;\x0d\n    if (nextTargetId === null) continue;\x0d\n    unit.avoidance = null;\x0d\n    events.push(event(tick\x2C "engagement-started"\x2C unit.referenceId\x2C nextTargetId\x2C {\x0d\n      sweptToi: selection.contact?.sweptToi ?? null\x2C\x0d\n      finalSurfaceGap: selection.contact?.finalSurfaceGap ?? null\x2C\x0d\n    }));\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// One attack cycle\x2C matching the lifecycle the authorized tapes expose:\x0d\n//\x0d\n//   swing start ---- attackDelayTicks ----> hit ---- rest of animation ---->\x0d\n//   animation end ---- remainder of the reload ----> next swing start\x0d\n//\x0d\n// The unit is committed for the whole animation (it neither moves nor retargets\x0d\n// while `action === "attacking"`)\x2C the hit lands halfway through it\x2C and the\x0d\n// reload runs swing-start to swing-start so the cadence is exactly reload_seconds.\x0d\n//\x0d\n// A swing only STARTS from a standstill: either the movement stop rule is\x0d\n// satisfied against the engaged target\x2C or the unit did not move this tick\x0d\n// (blocked\x2C or already parked). The steppe tapes show approaching lancers\x0d\n// never swinging mid-walk \u2014 they close to collision gap <= 1.0 first \u2014 while\x0d\n// blocked back-line