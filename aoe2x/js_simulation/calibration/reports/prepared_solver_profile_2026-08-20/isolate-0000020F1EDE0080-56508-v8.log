script-source,150,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/world.js,import {\n  prepareMovementResolution\x2C\n  queryEnemyContactManifold\x2C\n  resolvePreparedMovementProposals\x2C\n} from "./collision.js";\nimport {\n  createPairInteractionSnapshot\x2C\n  resolvePairInteraction\x2C\n} from "./pair-interactions.js";\nimport { hasUnobstructedZeroRangeMeleeContact } from "./melee-contact.js";\nimport {\x0d\n  createContactReservationState\x2C\x0d\n  updateContactReservations\x2C\x0d\n} from "./contact-reservations.js";\x0d\nimport {\x0d\n  createKiteState\x2C\x0d\n  createOrderState\x2C\x0d\n  issueKiteOrders\x2C\x0d\n  issueOrders\x2C\x0d\n  ORDERS_ENABLED\x2C\x0d\n} from "./ai-orders.js";\x0d\nimport {\x0d\n  ANY_EXPERIMENT\x2C\x0d\n  BIMODAL_STEP\x2C\x0d\n  CHASE_PATH_GRID\x2C\x0d\n  CHASER_BIMODAL_STEP\x2C\x0d\n  ENGAGEMENT_FOLLOWS_PURSUIT\x2C\x0d\n  KITE_ENGAGE_BLOCKER\x2C\x0d\n  KITED_SIDE_STEER\x2C\x0d\n  STEER_AROUND_BODIES\x2C\x0d\n  shouldReevaluatePursuit\x2C\x0d\n} from "./experiments.js";\x0d\nimport {\x0d\n  advancePersistentChaseRoute\x2C\x0d\n  persistentRouteMotionStalled\x2C\x0d\n  planChaseAim\x2C\x0d\n  planMoveAim\x2C\x0d\n  planPersistentChaseRoute\x2C\x0d\n} from "./chase-path.js";\x0d\nimport { planCohortContactMotion } from "./cohort-motion.js";\x0d\nimport { planLocalAvoidance } from "./local-avoidance.js";\x0d\nimport {\x0d\n  planPreventiveContactSteering\x2C\x0d\n  PREVENTIVE_CONTACT_STEERING_STRENGTH\x2C\x0d\n} from "./contact-graph-steering.js";\x0d\nimport { proposeMovement\x2C proposePointMovement } from "./movement.js";\x0d\nimport {\x0d\n  createSoloNavigationState\x2C\x0d\n  finishSoloNavigationTick\x2C\x0d\n  planSoloNavigation\x2C\x0d\n  soloNavigationSnapshot\x2C\x0d\n} from "./solo-navigation.js";\x0d\nimport {\x0d\n  chebyshevGap\x2C\x0d\n  isWithinReach\x2C\x0d\n  selectEngagementTarget\x2C\x0d\n  selectPursuitTarget\x2C\x0d\n} from "./targeting.js";\x0d\nimport { TICKS_PER_SECOND\x2C secondsToTicksCeil } from "../simulation-clock.js";\x0d\nimport {\x0d\n  BOLT_OVERSHOOT_TILES\x2C\x0d\n  MISS_DAMAGE_FRACTION\x2C\x0d\n  PASS_THROUGH_DAMAGE_FRACTION\x2C\x0d\n  attackAnimationTicks\x2C\x0d\n  attackDelayTicks\x2C\x0d\n  calculateDamage\x2C\x0d\n  chargeProjectileDamage\x2C\x0d\n  chargeSpec\x2C\x0d\n  createAttackCanceledEvent\x2C\x0d\n  createAttackStartEvent\x2C\x0d\n  createDamageEvent\x2C\x0d\n  createDeathEvent\x2C\x0d\n  isWithinStopRange\x2C\x0d\n  orderReadyAttacks\x2C\x0d\n  rangedSpec\x2C\x0d\n  reloadTicks\x2C\x0d\n  trampleSpec\x2C\x0d\n} from "./attacks.js";\x0d\nimport { collisionRadius } from "./targeting.js";\x0d\n\x0d\n\x0d\nconst DEFAULT_MAP = Object.freeze({\x0d\n  width: 16\x2C\x0d\n  height: 16\x2C\x0d\n  obstacles: Object.freeze([])\x2C\x0d\n});\x0d\n// Default runaway guard for a single fight\x2C and the hard ceiling a caller may\x0d\n// raise it to. 60 s covers every recorded melee fight with margin\x2C but the\x0d\n// ranged tapes' own 20v15 fights run 56.5-59.8 s and the sim legitimately\x0d\n// needs more clock for max-range attrition endgames \u2014 callers pass maxTicks\x0d\n// up to the ceiling for those.\x0d\nconst DEFAULT_WORLD_TICKS = 3600;\x0d\nconst MAX_WORLD_TICKS = 9000;\x0d\n\x0d\n\x0d\nfunction hasMeleeMode(unit) {\x0d\n  return unit?.mechanics?.ranged === undefined || unit.mechanics.ranged === null;\x0d\n}\x0d\n\x0d\n\x0d\nfunction freezeUnit(unit) {\x0d\n  return Object.freeze({\x0d\n    ...unit\x2C\x0d\n    avoidance: unit.avoidance === null || unit.avoidance === undefined\x0d\n      ? null\x0d\n      : Object.freeze({ ...unit.avoidance })\x2C\x0d\n    actionTimers: Object.freeze({ ...unit.actionTimers })\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction immutableClone(value) {\x0d\n  if (!value || typeof value !== "object") return value;\x0d\n  if (Array.isArray(value)) {\x0d\n    return Object.freeze(value.map(immutableClone));\x0d\n  }\x0d\n  return Object.freeze(Object.fromEntries(\x0d\n    Object.entries(value).map(([name\x2C child]) => [name\x2C immutableClone(child)])\x2C\x0d\n  ));\x0d\n}\x0d\n\x0d\n\x0d\nfunction event(tick\x2C type\x2C actorId\x2C targetId\x2C details = {}) {\x0d\n  const id = `${tick}:${type}:${actorId}:${targetId ?? "-"}`;\x0d\n  return Object.freeze({\x0d\n    id\x2C\x0d\n    eventId: id\x2C\x0d\n    type\x2C\x0d\n    tick\x2C\x0d\n    actorId\x2C\x0d\n    targetId\x2C\x0d\n    ...details\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction canonicalUnits(units\x2C { cloneMechanics = false } = {}) {\x0d\n  if (!Array.isArray(units)) throw new TypeError("scenario units must be an array");\x0d\n  const references = new Set();\x0d\n  const result = units.map((unit) => {\x0d\n    if (!Number.isSafeInteger(unit?.referenceId)) {\x0d\n      throw new TypeError("unit reference ID must be a safe integer");\x0d\n    }\x0d\n    if (references.has(unit.referenceId)) {\x0d\n      throw new Error(`duplicate unit reference ${unit.referenceId}`);\x0d\n    }\x0d\n    if (Object.hasOwn(unit\x2C "targetId")) {\x0d\n      throw new Error("legacy targetId is ambiguous; use explicit target state");\x0d\n    }\x0d\n    for (const name of ["pursuitTargetId"\x2C "engagedTargetId"\x2C "attackTargetId"]) {\x0d\n      if (unit[name] !== null && !Number.isSafeInteger(unit[name])) {\x0d\n        throw new TypeError(`${name} must be null or a safe integer`);\x0d\n      }\x0d\n    }\x0d\n    references.add(unit.referenceId);\x0d\n    return freezeUnit({\x0d\n      ...unit\x2C\x0d\n      mechanics: cloneMechanics ? immutableClone(unit.mechanics) : unit.mechanics\x2C\x0d\n    });\x0d\n  }).sort((a\x2C b) => a.referenceId - b.referenceId);\x0d\n  return Object.freeze(result);\x0d\n}\x0d\n\x0d\n\x0d\nfunction mutableUnit(unit) {\x0d\n  return {\x0d\n    ...unit\x2C\x0d\n    avoidance: unit.avoidance === null ? null : { ...unit.avoidance }\x2C\x0d\n    actionTimers: { ...unit.actionTimers }\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction freezeMap(map) {\x0d\n  return immutableClone({ ...map\x2C obstacles: [...(map.obstacles ?? [])] });\x0d\n}\x0d\n\x0d\n\x0d\nfunction createSnapshot(tick\x2C units\x2C events\x2C navigation = null) {\x0d\n  return Object.freeze({ tick\x2C units\x2C events\x2C ...(navigation ? { navigation } : {}) });\x0d\n}\x0d\n\x0d\n\x0d\nfunction validateInitialAttackState(units) {\x0d\n  const byReference = new Map(units.map((unit) => [unit.referenceId\x2C unit]));\x0d\n  for (const unit of units) {\x0d\n    if (unit.action !== "attacking") {\x0d\n      if (unit.attackTargetId !== null) {\x0d\n        throw new Error(\x0d\n          `${unit.action} unit ${unit.referenceId} must not retain attackTargetId`\x2C\x0d\n        );\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    const target = byReference.get(unit.attackTargetId);\x0d\n    if (!target?.alive || target.owner === unit.owner) {\x0d\n      throw new Error(\x0d\n        `attacking unit ${unit.referenceId} attackTargetId must reference a live enemy`\x2C\x0d\n      );\x0d\n    }\x0d\n    const windup = unit.actionTimers.windup;\x0d\n    const maximumWindup = attackDelayTicks(unit.mechanics);\x0d\n    if (\x0d\n      !Number.isSafeInteger(windup)\x0d\n      || windup <= 0\x0d\n      || windup > maximumWindup\x0d\n      || unit.actionTimers.reload !== 0\x0d\n    ) {\x0d\n      throw new Error(\x0d\n        `attacking unit ${unit.referenceId} must have a coherent windup and zero reload`\x2C\x0d\n      );\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nexport function createWorld(scenario) {\x0d\n  if (!scenario || typeof scenario !== "object") {\x0d\n    throw new TypeError("scenario is required");\x0d\n  }\x0d\n  const units = canonicalUnits(scenario.units\x2C { cloneMechanics: true });\x0d\n  validateInitialAttackState(units);\x0d\n  const map = scenario.map ? freezeMap(scenario.map) : DEFAULT_MAP;\x0d\n  const scenarioOwners = new Set(units.map(({ owner }) => owner));\x0d\n  const meleeOwners = [...new Set(units\n    .filter(hasMeleeMode)\n    .map(({ owner }) => owner))]\n    .sort((left\x2C right) => left - right);\n  const contactReservationState = createContactReservationState();\n  if (scenario.rangedTargetPressureOwner !== undefined\x0d\n      && !Number.isSafeInteger(scenario.rangedTargetPressureOwner)) {\x0d\n    throw new TypeError("ranged target pressure owner must be a safe integer");\x0d\n  }\x0d\n  if (Number.isSafeInteger(scenario.rangedTargetPressureOwner)\x0d\n      && !units.some(({ owner }) => owner === scenario.rangedTargetPressureOwner)) {\x0d\n    throw new RangeError("ranged target pressure owner must identify a scenario owner");\x0d\n  }\x0d\n  if (scenario.rangedOpportunityRetargetOwner !== undefined\x0d\n      && !Number.isSafeInteger(scenario.rangedOpportunityRetargetOwner)) {\x0d\n    throw new TypeError("ranged opportunity retarget owner must be a safe integer");\x0d\n  }\x0d\n  if (Number.isSafeInteger(scenario.rangedOpportunityRetargetOwner)\x0d\n      && !units.some(({ owner }) => owner === scenario.rangedOpportunityRetargetOwner)) {\x0d\n    throw new RangeError("ranged opportunity retarget owner must identify a scenario owner");\x0d\n  }\x0d\n  if (scenario.rangedWindupRetargetOwner !== undefined\x0d\n      && !Number.isSafeInteger(scenario.rangedWindupRetargetOwner)) {\x0d\n    throw new TypeError("ranged windup retarget owner must be a safe integer");\x0d\n  }\x0d\n  if (Number.isSafeInteger(scenario.rangedWindupRetargetOwner)\x0d\n      && !units.some(({ owner }) => owner === scenario.rangedWindupRetargetOwner)) {\x0d\n    throw new RangeError("ranged windup retarget owner must identify a scenario owner");\x0d\n  }\x0d\n  const events = Object.freeze([]);\x0d\n  const kiteState = Number.isSafeInteger(scenario.kiteOwner)\n    ? createKiteState(\x0d\n      scenario.kiteOwner\x2C\x0d\n      scenario.kiteProfile ?? null\x2C\x0d\n      scenario.chaseCapture === true\x2C\x0d\n      scenario.kitedEscape === true\x2C\x0d\n      scenario.soloMovement === true\x2C\x0d\n    )\n    : null;\n  if (scenario.kiteOpponentMode !== undefined\n      && scenario.kiteOpponentMode !== "ordinary-ranged") {\n    throw new RangeError("kite opponent mode must be ordinary-ranged");\n  }\n  if (scenario.kiteOpponentMode === "ordinary-ranged") {\n    if (!kiteState) {\n      throw new RangeError("kite opponent mode requires a kiting owner");\n    }\n    kiteState.opponentMode = "ordinary-ranged";\n  }\n  if (scenario.persistentMeleePursuitRouting === true) {\x0d\n    if (!kiteState) {\x0d\n      throw new RangeError("persistent melee pursuit routing requires a kiting owner");\x0d\n    }\x0d\n    kiteState.persistentMeleePursuitRouting = true;\n    kiteState.chaseRoutes = new Map();\n    kiteState.chaseRouteDeferrals = new Map();\n  } else if (scenario.persistentMeleePursuitRouting !== undefined\x0d\n      && scenario.persistentMeleePursuitRouting !== false) {\x0d\n    throw new TypeError("persistent melee pursuit routing must be boolean");\x0d\n  }\x0d\n  let contactSteeringStates = null;\x0d\n  if (kiteState) kiteState.collisionRecoveryState = { active: false };\x0d\n  if (scenario.kiteChaseDwellTicks !== undefined) {\x0d\n    if (!kiteState) {\x0d\n      throw new RangeError("kite chase dwell requires a kiting owner");\x0d\n    }\x0d\n    if (!Number.isSafeInteger(scenario.kiteChaseDwellTicks)\x0d\n        || scenario.kiteChaseDwellTicks < 0) {\x0d\n      throw new RangeError("kite chase dwell must be a nonnegative integer");\x0d\n    }\x0d\n    kiteState.chaseDwellTicks = scenario.kiteChaseDwellTicks;\x0d\n  }\x0d\n  const navigationVariant = scenario.kiteNavigation\x0d\n    ?? (kiteState?.soloMovement === true ? scenario.soloNavigation ?? "baseline" : null);\x0d\n  if (kiteState && navigationVariant !== null) {\x0d\n    kiteState.soloNavigationState = createSoloNavigationState(\x0d\n      navigationVariant\x2C\x0d\n      units.filter((unit) => unit.owner === kiteState.owner)\x2C\x0d\n      map\x2C\x0d\n      kiteState.profile\x2C\x0d\n    );\x0d\n  }\x0d\n  if (kiteState && scenario.kiteMeleeOpeningOrder === "attack-move-all") {\x0d\n    kiteState.meleeOpeningOrder = "attack-move-all";\x0d\n    kiteState.meleeApproach = new Map();\x0d\n  }\x0d\n  if (scenario.attackMoveTargetPressureTiles !== undefined) {\x0d\n    if (!kiteState || scenario.kiteMeleeOpeningOrder !== "attack-move-all") {\x0d\n      throw new RangeError("attack-move target pressure requires a kiting attack-move scenario");\x0d\n    }\x0d\n    if (!Number.isFinite(scenario.attackMoveTargetPressureTiles)\x0d\n        || scenario.attackMoveTargetPressureTiles < 0) {\x0d\n      throw new RangeError("attack-move target pressure must be nonnegative and finite");\x0d\n    }\x0d\n    kiteState.attackMoveTargetPressureTiles = scenario.attackMoveTargetPressureTiles;\x0d\n  }\x0d\n  if (scenario.attackMoveStickyPursuit === true) {\x0d\n    if (!kiteState || scenario.kiteMeleeOpeningOrder !== "attack-move-all") {\x0d\n      throw new RangeError("sticky attack-move pursuit requires a kiting attack-move scenario");\x0d\n    }\x0d\n    kiteState.attackMoveStickyPursuit = true;\x0d\n  }\x0d\n  if (scenario.preventiveContactSteering === true) {\x0d\n    if (meleeOwners.length === 0) {\x0d\n      throw new RangeError("preventive contact steering requires a melee unit");\x0d\n    }\x0d\n    const strength = scenario.preventiveContactSteeringStrength\x0d\n      ?? PREVENTIVE_CONTACT_STEERING_STRENGTH;\x0d\n    if (!Number.isFinite(strength) || strength < 0 || strength > 1) {\x0d\n      throw new RangeError("preventive contact steering strength must be between 0 and 1");\x0d\n    }\x0d\n    contactSteeringStates = new Map(meleeOwners.map((owner) => [owner\x2C {\x0d\n      owner\x2C\x0d\n      strength\x2C\x0d\n      steeredSteps: 0\x2C\x0d\n      steeredUnits: new Set()\x2C\x0d\n    }]));\x0d\n  }\x0d\n  const snapshot = createSnapshot(0\x2C units\x2C events\x2C\x0d\n    soloNavigationSnapshot(kiteState?.soloNavigationState));\x0d\n  // Charge-projectile flight queue\x2C present only when the roster can fire one\x0d\n  // (Fire Lancer family) so worlds without charge units keep their exact\x0d\n  // published shape.\x0d\n  const anyCharge = units.some((unit) => (\x0d\n    chargeSpec(unit.mechanics) !== null || rangedSpec(unit.mechanics) !== null\x0d\n  ));\x0d\n  return Object.freeze({\x0d\n    // Experiment-only mutable AI-player state; absent in baseline so world\x0d\n    // shape and hashes are unchanged (the object is frozen but Maps inside\x0d\n    // stay mutable across ticks by design).\x0d\n    ...(ORDERS_ENABLED ? { orderState: createOrderState(units) } : {})\x2C\x0d\n    // Kiting-side beat controller (see issueKiteOrders): present only when\x0d\n    // the scenario names a kiting owner\x2C so every other world keeps its\x0d\n    // exact published shape.\x0d\n    ...(kiteState ? { kiteState } : {})\x2C\n    ...(Number.isSafeInteger(scenario.rangedTargetPressureOwner)\x0d\n      ? { rangedTargetPressureOwner: scenario.rangedTargetPressureOwner }\x0d\n      : {})\x2C\x0d\n    ...(Number.isSafeInteger(scenario.rangedOpportunityRetargetOwner)\x0d\n      ? { rangedOpportunityRetargetOwner: scenario.rangedOpportunityRetargetOwner }\x0d\n      : {})\x2C\x0d\n    ...(Number.isSafeInteger(scenario.rangedWindupRetargetOwner)\x0d\n      ? { rangedWindupRetargetOwner: scenario.rangedWindupRetargetOwner }\x0d\n      : {})\x2C\x0d\n    contactReservationState\x2C\x0d\n    contactReservationDiagnostics: Object.freeze([])\x2C\x0d\n    ...(contactSteeringStates ? { contactSteeringStates } : {})\x2C\x0d\n    ...(anyCharge ? { projectiles: Object.freeze([]) } : {})\x2C\x0d\n    // Deterministic per-shot RNG\x2C present only when a unit can miss or blast\x0d\n    // (dat accuracy < 100 or blast width > 0 \u2014 nothing in the converged\x0d\n    // corpus). Seeded with the golden constant; state lives OUTSIDE units so\x0d\n    // no hash can move. Mutable by design across ticks\x2C like kiteState.\x0d\n    ...(units.some((unit) => {\x0d\n      const spec = rangedSpec(unit.mechanics);\x0d\n      return spec && (spec.accuracyPercent < 100\x0d\n        || spec.blastRadius > 0 || spec.secondaryCount > 0);\x0d\n    }) ? { shotRng: { state: 20260411 >>> 0 } } : {})\x2C\x0d\n    tick: 0\x2C\x0d\n    ratio: scenario.ratio\x2C\x0d\n    mapHash: scenario.mapHash\x2C\x0d\n    map\x2C\x0d\n    units\x2C\x0d\n    events\x2C\x0d\n    eventLog: events\x2C\x0d\n    snapshots: Object.freeze([snapshot])\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction validatePursuitTargets(units\x2C tick\x2C events) {\x0d\n  const byReference = new Map(units.map((unit) => [unit.referenceId\x2C unit]));\x0d\n  for (const unit of units) {\x0d\n    if (!unit.alive) {\x0d\n      unit.pursuitTargetId = null;\x0d\n      unit.engagedTargetId = null;\x0d\n      unit.attackTargetId = null;\x0d\n      unit.avoidance = null;\x0d\n      unit.action = "dead";\x0d\n      delete unit.attackKind;\x0d\n      delete unit.moveOrder;\x0d\n      unit.actionTimers = { windup: 0\x2C reload: 0\x2C swing: 0\x2C acquire: 0 };\x0d\n      continue;\x0d\n    }\x0d\n    if (unit.pursuitTargetId === null || unit.pursuitTargetId === undefined) continue;\x0d\n    const target = byReference.get(unit.pursuitTargetId);\x0d\n    if (target?.alive) {\x0d\n      if (target.owner === unit.owner) {\x0d\n        throw new Error(\x0d\n          `unit ${unit.referenceId} has friendly pursuit target ${target.referenceId}`\x2C\x0d\n        );\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n\x0d\n    const invalidTargetId = unit.pursuitTargetId;\x0d\n    events.push(event(\x0d\n      tick\x2C\x0d\n      "pursuit-invalidated"\x2C\x0d\n      unit.referenceId\x2C\x0d\n      invalidTargetId\x2C\x0d\n      { reason: "target-dead" }\x2C\x0d\n    ));\x0d\n    unit.pursuitTargetId = null;\x0d\n    unit.avoidance = null;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction validateAttackTargets(units\x2C tick\x2C events\x2C rangedWindupRetargetOwner = null) {\x0d\n  const byReference = new Map(units.map((unit) => [unit.referenceId\x2C unit]));\x0d\n  for (const unit of units) {\x0d\n    if (!unit.alive || unit.action !== "attacking") continue;\x0d\n    const target = byReference.get(unit.attackTargetId);\x0d\n    if (target?.alive && target.owner !== unit.owner) continue;\x0d\n    const invalidTargetId = unit.attackTargetId;\x0d\n    if (!Number.isSafeInteger(invalidTargetId)) {\x0d\n      throw new Error(`attacking unit ${unit.referenceId} has no captured attack target`);\x0d\n    }\x0d\n    // A swing that has already released its hit runs to the end of its animation\x0d\n    // even though the target is gone -- that is what makes a killer slower to\x0d\n    // pick a new target than the bystanders swinging at the same corpse. Only an\x0d\n    // unreleased swing is abandoned on the spot. A charge cycle releases on its\x0d\n    // own (later) frame; an abandoned unreleased charge keeps its charge.\x0d\n    const releaseTicks = unit.attackKind === "charge"\x0d\n      ? chargeSpec(unit.mechanics).windupTicks\x0d\n      : attackDelayTicks(unit.mechanics);\x0d\n    if (unit.actionTimers.swing >= releaseTicks) continue;\x0d\n    if (unit.owner === rangedWindupRetargetOwner\x0d\n        && rangedSpec(unit.mechanics) !== null\x0d\n        && unit.attackKind !== "charge") {\x0d\n      const replacement = selectPursuitTarget(\x0d\n        { ...freezeUnit(unit)\x2C pursuitTargetId: null }\x2C\x0d\n        Object.freeze(units\x0d\n          .filter((candidate) => (\x0d\n            candidate.owner === unit.owner\x0d\n            || (candidate.alive && isWithinReach(unit\x2C candidate))\x0d\n          ))\x0d\n          .map(freezeUnit))\x2C\x0d\n      );\x0d\n      if (replacement !== null) {\x0d\n        unit.pursuitTargetId = replacement.referenceId;\x0d\n        unit.engagedTargetId = replacement.referenceId;\x0d\n        unit.attackTargetId = replacement.referenceId;\x0d\n        unit.avoidance = null;\x0d\n        events.push(event(\x0d\n          tick\x2C\x0d\n          "attack-retargeted"\x2C\x0d\n          unit.referenceId\x2C\x0d\n          replacement.referenceId\x2C\x0d\n          { fromTargetId: invalidTargetId }\x2C\x0d\n        ));\x0d\n        continue;\x0d\n      }\x0d\n    }\x0d\n    events.push(createAttackCanceledEvent({\x0d\n      tick\x2C\x0d\n      actorId: unit.referenceId\x2C\x0d\n      targetId: invalidTargetId\x2C\x0d\n      readyTick: tick + Math.max(0\x2C releaseTicks - unit.actionTimers.swing)\x2C\x0d\n      reason: !target?.alive ? "target-dead" : "target-invalidated"\x2C\x0d\n    }));\x0d\n    unit.attackTargetId = null;\x0d\n    delete unit.attackKind;\x0d\n    unit.actionTimers.windup = 0;\x0d\n    unit.actionTimers.swing = 0;\x0d\n    unit.action = unit.actionTimers.reload > 0 ? "reload" : "idle";\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction acquirePursuitTargets(\n  units\x2C\n  tick\x2C\n  events\x2C\n  kiteState = null\x2C\n  rangedTargetPressureOwner = null\x2C\n  rangedOpportunityRetargetOwner = null\x2C\n) {\n  const snapshot = Object.freeze(units.map(freezeUnit));\x0d\n  const targetPressureTiles = kiteState?.attackMoveTargetPressureTiles ?? 0;\x0d\n  const targetLoadById = targetPressureTiles > 0\x0d\n      || Number.isSafeInteger(rangedTargetPressureOwner)\x0d\n    ? new Map()\x0d\n    : null;\x0d\n  if (targetLoadById) {\x0d\n    for (const unit of units) {\x0d\n      const kitePressureApplies = targetPressureTiles > 0\x0d\n        && unit.owner !== kiteState.owner;\x0d\n      const rangedPressureApplies = unit.owner === rangedTargetPressureOwner;\x0d\n      if (!unit.alive || (!kitePressureApplies && !rangedPressureApplies)) continue;\x0d\n      if (unit.pursuitTargetId === null || unit.pursuitTargetId === undefined) continue;\x0d\n      targetLoadById.set(\x0d\n        unit.pursuitTargetId\x2C\x0d\n        (targetLoadById.get(unit.pursuitTargetId) ?? 0) + 1\x2C\x0d\n      );\x0d\n    }\x0d\n  }\n  for (const unit of units) {\n    if (!unit.alive) continue;\n    // Initial target-acquisition delay. Only the first acquisition waits; once a\n    // unit has been in combat\x2C re-acquisition is governed by its swing state.\n    if (unit.actionTimers.acquire > 0) {\n      unit.actionTimers.acquire -= 1;\n      // Acquire on the very tick the delay expires\x2C so no unit is ever briefly\x0d\n      // idle with an expired timer and no target.\x0d\n      if (unit.actionTimers.acquire > 0) continue;\n    }\n    // Experiment harness (docs/RETARGETING_INVESTIGATION.md). Off by default:\x0d\n    // shouldReevaluatePursuit is false unless AOE2X_EXP_PURSUIT is set\x2C so this\x0d\n    // reduces to the original `if (pursuitTargetId !== null) continue`.\x0d\n    const blockedAttackMover = kiteState?.meleeOpeningOrder === "attack-move-all"\x0d\n      && unit.owner !== kiteState.owner\x0d\n      && kiteState.attackMoveStickyPursuit !== true\x0d\n      && unit.experimentBlocked === true;\x0d\n    const pursued = unit.pursuitTargetId === null\x0d\n      ? null\x0d\n      : snapshot.find(({ referenceId }) => referenceId === unit.pursuitTargetId);\x0d\n    const rangedOpportunity = unit.owner === rangedOpportunityRetargetOwner\x0d\n      && unit.mechanics?.ranged !== undefined\x0d\n      && pursued?.alive === true\x0d\n      && !isWithinReach(unit\x2C pursued)\x0d\n      && snapshot.some((candidate) => (\x0d\n        candidate.alive\x0d\n        && candidate.owner !== unit.owner\x0d\n        && isWithinReach(unit\x2C candidate)\x0d\n      ));\x0d\n    const reevaluate = unit.pursuitTargetId !== null\x0d\n      && (shouldReevaluatePursuit(unit) || blockedAttackMover || rangedOpportunity);\x0d\n    if (unit.pursuitTargetId !== null && !reevaluate) continue;\x0d\n    const kitePressureApplies = targetPressureTiles > 0\x0d\n      && unit.owner !== kiteState.owner;\x0d\n    const rangedPressureApplies = unit.owner === rangedTargetPressureOwner;\x0d\n    const pressureApplies = targetLoadById !== null\x0d\n      && (kitePressureApplies || rangedPressureApplies);\x0d\n    const pressureTiles = rangedPressureApplies\x0d\n      ? 2 * collisionRadius(unit)\x0d\n      : targetPressureTiles;\x0d\n    if (pressureApplies && reevaluate) {\x0d\n      const previousLoad = targetLoadById.get(unit.pursuitTargetId) ?? 0;\x0d\n      if (previousLoad <= 1) targetLoadById.delete(unit.pursuitTargetId);\x0d\n      else targetLoadById.set(unit.pursuitTargetId\x2C previousLoad - 1);\x0d\n    }\x0d\n    const found = snapshot.find(({ referenceId }) => referenceId === unit.referenceId);\x0d\n    // selectPursuitTarget short-circuits on a live locked target\x2C so a\x0d\n    // re-evaluation has to present the unit as unlocked to force a fresh scan.\x0d\n    const candidate = reevaluate ? { ...found\x2C pursuitTargetId: null } : found;\x0d\n    const target = selectPursuitTarget(candidate\x2C snapshot\x2C pressureApplies\x0d\n      ? { targetLoadById\x2C targetLoadPenaltyTiles: pressureTiles }\x0d\n      : undefined);\x0d\n    if (target === null) {\x0d\n      if (pressureApplies && reevaluate) {\x0d\n        targetLoadById.set(\x0d\n          unit.pursuitTargetId\x2C\x0d\n          (targetLoadById.get(unit.pursuitTargetId) ?? 0) + 1\x2C\x0d\n        );\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (pressureApplies) {\x0d\n      targetLoadById.set(target.referenceId\x2C (targetLoadById.get(target.referenceId) ?? 0) + 1);\x0d\n    }\x0d\n    if (target.referenceId !== unit.pursuitTargetId) {\n      events.push(event(tick\x2C "pursuit-acquired"\x2C unit.referenceId\x2C target.referenceId));\n    }\x0d\n    unit.pursuitTargetId = target.referenceId;\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// A unit holding a FULL charge does not close on its target: all 265 tape\x0d\n// volleys are fired from a standstill at the acquisition target\x2C 1.5-5.2\x0d\n// tiles out (line of sight is the bound)\x2C with the unit's first movement only\x0d\n// after the charge animation completes. The charge cycle it is about to start\x0d\n// (progressAttacks below) then pins it via `action === "attacking"`; once the\x0d\n// charge