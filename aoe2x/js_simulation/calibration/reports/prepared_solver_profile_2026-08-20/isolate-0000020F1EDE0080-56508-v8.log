less.\x0d\n    if (unit.charge !== undefined) {\x0d\n      const spec = chargeSpec(unit.mechanics);\x0d\n      unit.charge = Math.min(\x0d\n        spec.maxCharge\x2C\x0d\n        unit.charge + spec.rechargeRate / TICKS_PER_SECOND\x2C\x0d\n      );\x0d\n    }\x0d\n\x0d\n    if (unit.action === "attacking") {\x0d\n      // A charge cycle runs on the dat special_graphic animation with its own\x0d\n      // (later) release frame; a melee cycle keeps the attack graphic timing.\x0d\n      const charge = unit.attackKind === "charge" ? chargeSpec(unit.mechanics) : null;\x0d\n      const delay = charge ? charge.windupTicks : attackDelayTicks(unit.mechanics);\x0d\n      const animation = charge\x0d\n        ? charge.animationTicks\x0d\n        : attackAnimationTicks(unit.mechanics);\x0d\n      unit.actionTimers.swing += 1;\x0d\n      unit.actionTimers.windup = Math.max(0\x2C delay - unit.actionTimers.swing);\x0d\n      if (unit.actionTimers.swing === delay) {\x0d\n        const target = byReference.get(unit.attackTargetId);\x0d\n        const ranged = rangedSpec(unit.mechanics);\x0d\n        if (charge) {\x0d\n          releaseChargeVolley(unit\x2C target\x2C charge\x2C tick\x2C events\x2C projectiles);\x0d\n        } else if (ranged) {\x0d\n          releaseRangedShot(unit\x2C target\x2C ranged\x2C tick\x2C events\x2C projectiles\x2C\x0d\n            velocities\x2C shotRng);\x0d\n        } else {\x0d\n          ready.push({\x0d\n            type: "attack-ready"\x2C\x0d\n            readyTick: tick\x2C\x0d\n            actorId: unit.referenceId\x2C\x0d\n            targetId: unit.attackTargetId\x2C\x0d\n            amount: target ? calculateDamage(unit\x2C target) : 0\x2C\x0d\n          });\x0d\n        }\x0d\n      }\x0d\n      if (unit.actionTimers.swing >= animation) {\x0d\n        // Animation finished: the unit is free to retarget again. A unit whose\x0d\n        // target died mid-recovery only becomes available here\x2C which is why the\x0d\n        // tapes show kill