script-source,166,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/local-avoidance.js,import { TICKS_PER_SECOND } from "../simulation-clock.js";\x0d\nimport { AVOID_ALL_BODIES } from "./experiments.js";\x0d\nimport { collisionRadius } from "./targeting.js";\x0d\nimport {\x0d\n  createPairInteractionSnapshot\x2C\x0d\n  resolvePairInteraction\x2C\x0d\n} from "./pair-interactions.js";\x0d\n\x0d\n\x0d\n// Floating-point comparison tolerance only; no physical value is adjusted.\x0d\nconst EPSILON = 1e-12;\x0d\n\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireReferenceId(value\x2C name = "reference ID") {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction clampUnit(value) {\x0d\n  return Math.max(-1\x2C Math.min(1\x2C value));\x0d\n}\x0d\n\x0d\n\x0d\nfunction positiveAngle(value) {\x0d\n  const fullTurn = 2 * Math.PI;\x0d\n  return ((value % fullTurn) + fullTurn) % fullTurn;\x0d\n}\x0d\n\x0d\n\x0d\nfunction directedAngle(from\x2C to\x2C side) {\x0d\n  return side === 1 ? positiveAngle(to - from) : positiveAngle(from - to);\x0d\n}\x0d\n\x0d\n\x0d\nfunction freezeAvoidance(value) {\x0d\n  if (value === null || value === undefined) return null;\x0d\n  requireReferenceId(value.targetReferenceId\x2C "avoidance target reference ID");\x0d\n  if (value.side !== -1 && value.side !== 1) {\x0d\n    throw new RangeError("avoidance side must be -1 or 1");\x0d\n  }\x0d\n  if (value.blockerObstacleIndex !== undefined) {\x0d\n    if (!Number.isSafeInteger(value.blockerObstacleIndex) || value.blockerObstacleIndex < 0) {\x0d\n      throw new TypeError("avoidance blocker obstacle index must be a nonnegative integer");\x0d\n    }\x0d\n    return Object.freeze({\x0d\n      blockerObstacleIndex: value.blockerObstacleIndex\x2C\x0d\n      targetReferenceId: value.targetReferenceId\x2C\x0d\n      side: value.side\x2C\x0d\n    });\x0d\n  }\x0d\n  requireReferenceId(value.blockerReferenceId\x2C "avoidance blocker reference ID");\x0d\n  return Object.freeze({\x0d\n    blockerReferenceId: value.blockerReferenceId\x2C\x0d\n    targetReferenceId: value.targetReferenceId\x2C\x0d\n    side: value.side\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction attackGoalRadius(mover\x2C target) {\x0d\n  const range = requireFinite(mover?.mechanics?.attack_range_tiles\x2C "attack range");\x0d\n  if (range < 0) throw new RangeError("attack range must be nonnegative");\x0d\n  return collisionRadius(mover) + collisionRadius(target) + range;\x0d\n}\x0d\n\x0d\n\x0d\nfunction contactGoal(mover\x2C target) {\x0d\n  const dx = mover.x - target.x;\x0d\n  const dy = mover.y - target.y;\x0d\n  const distance = Math.hypot(dx\x2C dy);\x0d\n  const radius = attackGoalRadius(mover\x2C target);\x0d\n  if (distance <= radius + EPSILON) {\x0d\n    return { reached: true\x2C radius\x2C x: mover.x\x2C y: mover.y };\x0d\n  }\x0d\n  return {\x0d\n    reached: false\x2C\x0d\n    radius\x2C\x0d\n    x: target.x + dx / distance * radius\x2C\x0d\n    y: target.y + dy / distance * radius\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction firstSegmentCircleIntersection(start\x2C end\x2C center\x2C radius) {\x0d\n  const dx = end.x - start.x;\x0d\n  const dy = end.y - start.y;\x0d\n  const fx = start.x - center.x;\x0d\n  const fy = start.y - center.y;\x0d\n  const a = dx * dx + dy * dy;\x0d\n  if (a === 0) return null;\x0d\n  const startOffset = fx * fx + fy * fy - radius * radius;\x0d\n  const inwardDerivative = fx * dx + fy * dy;\x0d\n  if (\x0d\n    startOffset < -EPSILON\x0d\n    || (Math.abs(startOffset) <= EPSILON && inwardDerivative < -EPSILON)\x0d\n  ) return 0;\x0d\n  const b = 2 * inwardDerivative;\x0d\n  const discriminant = b * b - 4 * a * startOffset;\x0d\n  if (discriminant <= 0) return null;\x0d\n  const root = Math.sqrt(discriminant);\x0d\n  return [(-b - root) / (2 * a)\x2C (-b + root) / (2 * a)]\x0d\n    .filter((value) => value > EPSILON && value <= 1 + EPSILON)\x0d\n    .sort((left\x2C right) => left - right)[0] ?? null;\x0d\n}\x0d\n\x0d\n\x0d\nfunction circleIntersections(first\x2C firstRadius\x2C second\x2C secondRadius) {\x0d\n  const dx = second.x - first.x;\x0d\n  const dy = second.y - first.y;\x0d\n  const distance = Math.hypot(dx\x2C dy);\x0d\n  if (\x0d\n    distance <= EPSILON\x0d\n    || distance > firstRadius + secondRadius + EPSILON\x0d\n    || distance < Math.abs(firstRadius - secondRadius) - EPSILON\x0d\n  ) return [];\x0d\n  const along = (\x0d\n    firstRadius ** 2 - secondRadius ** 2 + distance ** 2\x0d\n  ) / (2 * distance);\x0d\n  const height = Math.sqrt(Math.max(0\x2C firstRadius ** 2 - along ** 2));\x0d\n  const ux = dx / distance;\x0d\n  const uy = dy / distance;\x0d\n  const baseX = first.x + ux * along;\x0d\n  const baseY = first.y + uy * along;\x0d\n  if (height <= EPSILON) return [{ x: baseX\x2C y: baseY }];\x0d\n  return [\x0d\n    { x: baseX - uy * height\x2C y: baseY + ux * height }\x2C\x0d\n    { x: baseX + uy * height\x2C y: baseY - ux * height }\x2C\x0d\n  ];\x0d\n}\x0d\n\x0d\n\x0d\nfunction entryTangent(mover\x2C blocker\x2C side) {\x0d\n  const dx = mover.x - blocker.x;\x0d\n  const dy = mover.y - blocker.y;\x0d\n  const distance = Math.hypot(dx\x2C dy);\x0d\n  if (distance < blocker.radius - EPSILON) return null;\x0d\n  const fromAngle = Math.atan2(dy\x2C dx);\x0d\n  const offset = distance <= blocker.radius + EPSILON\x0d\n    ? 0\x0d\n    : Math.acos(clampUnit(blocker.radius / distance));\x0d\n  const angle = fromAngle + side * offset;\x0d\n  const point = {\x0d\n    x: blocker.x + blocker.radius * Math.cos(angle)\x2C\x0d\n    y: blocker.y + blocker.radius * Math.sin(angle)\x2C\x0d\n  };\x0d\n  const pointDistance = Math.hypot(point.x - mover.x\x2C point.y - mover.y);\x0d\n  const direction = pointDistance > EPSILON\x0d\n    ? { x: (point.x - mover.x) / pointDistance\x2C y: (point.y - mover.y) / pointDistance }\x0d\n    : { x: side * -Math.sin(angle)\x2C y: side * Math.cos(angle) };\x0d\n  return { point\x2C angle\x2C distance: pointDistance\x2C direction };\x0d\n}\x0d\n\x0d\n\x0d\nfunction firstIntersectionOnSide(intersections\x2C blocker\x2C entryAngle\x2C side) {\x0d\n  return intersections\x0d\n    .map((point) => {\x0d\n      const angle = Math.atan2(point.y - blocker.y\x2C point.x - blocker.x);\x0d\n      return { point\x2C angle\x2C arcAngle: directedAngle(entryAngle\x2C angle\x2C side) };\x0d\n    })\x0d\n    .sort((left\x2C right) => left.arcAngle - right.arcAngle)[0] ?? null;\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeToContact(mover\x2C target\x2C blocker\x2C side) {\x0d\n  const goalRadius = attackGoalRadius(mover\x2C target);\x0d\n  const entry = entryTangent(mover\x2C blocker\x2C side);\x0d\n  if (entry === null) return null;\x0d\n  const centerDistance = Math.hypot(target.x - blocker.x\x2C target.y - blocker.y);\x0d\n  const intersections = circleIntersections(blocker\x2C blocker.radius\x2C target\x2C goalRadius);\x0d\n  let exit;\x0d\n  let goalPoint;\x0d\n  let lineDistance;\x0d\n\x0d\n  if (intersections.length > 0) {\x0d\n    exit = firstIntersectionOnSide(intersections\x2C blocker\x2C entry.angle\x2C side);\x0d\n    goalPoint = exit.point;\x0d\n    lineDistance = 0;\x0d\n  } else {\x0d\n    if (\x0d\n      centerDistance <= EPSILON\x0d\n      || centerDistance <= Math.abs(blocker.radius - goalRadius) + EPSILON\x0d\n    ) return null;\x0d\n    const ux = (target.x - blocker.x) / centerDistance;\x0d\n    const uy = (target.y - blocker.y) / centerDistance;\x0d\n    const px = -uy;\x0d\n    const py = ux;\x0d\n    const cosine = clampUnit((blocker.radius - goalRadius) / centerDistance);\x0d\n    const sine = Math.sqrt(Math.max(0\x2C 1 - cosine ** 2));\x0d\n    const nx = ux * cosine - side * px * sine;\x0d\n    const ny = uy * cosine - side * py * sine;\x0d\n    const exitPoint = {\x0d\n      x: blocker.x + blocker.radius * nx\x2C\x0d\n      y: blocker.y + blocker.radius * ny\x2C\x0d\n    };\x0d\n    exit = {\x0d\n      point: exitPoint\x2C\x0d\n      angle: Math.atan2(exitPoint.y - blocker.y\x2C exitPoint.x - blocker.x)\x2C\x0d\n    };\x0d\n    exit.arcAngle = directedAngle(entry.angle\x2C exit.angle\x2C side);\x0d\n    goalPoint = {\x0d\n      x: target.x + goalRadius * nx\x2C\x0d\n      y: target.y + goalRadius * ny\x2C\x0d\n    };\x0d\n    lineDistance = Math.hypot(goalPoint.x - exit.point.x\x2C goalPoint.y - exit.point.y);\x0d\n  }\x0d\n\x0d\n  return {\x0d\n    side\x2C\x0d\n    blocker\x2C\x0d\n    entry\x2C\x0d\n    exit\x2C\x0d\n    goalPoint\x2C\x0d\n    lineDistance\x2C\x0d\n    pathLength: entry.distance + blocker.radius * exit.arcAngle + lineDistance\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction pointSegmentDistance(point\x2C start\x2C end) {\x0d\n  const dx = end.x - start.x;\x0d\n  const dy = end.y - start.y;\x0d\n  const lengthSquared = dx * dx + dy * dy;\x0d\n  if (lengthSquared === 0) return Math.hypot(point.x - start.x\x2C point.y - start.y);\x0d\n  const projection = Math.max(0\x2C Math.min(1\x2C (\x0d\n    (point.x - start.x) * dx + (point.y - start.y) * dy\x0d\n  ) / lengthSquared));\x0d\n  return Math.hypot(\x0d\n    point.x - start.x - projection * dx\x2C\x0d\n    point.y - start.y - projection * dy\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\nfunction segmentClears(start\x2C end\x2C constraint) {\x0d\n  return pointSegmentDistance(constraint\x2C start\x2C end) >= constraint.radius - EPSILON;\x0d\n}\x0d\n\x0d\n\x0d\nfunction arcClears(route\x2C constraint) {\x0d\n  const endpointDistance = Math.min(\x0d\n    Math.hypot(constraint.x - route.entry.point.x\x2C constraint.y - route.entry.point.y)\x2C\x0d\n    Math.hypot(constraint.x - route.exit.point.x\x2C constraint.y - route.exit.point.y)\x2C\x0d\n  );\x0d\n  const centerAngle = Math.atan2(\x0d\n    constraint.y - route.blocker.y\x2C\x0d\n    constraint.x - route.blocker.x\x2C\x0d\n  );\x0d\n  const angleWithinArc = directedAngle(route.entry.angle\x2C centerAngle\x2C route.side)\x0d\n    <= route.exit.arcAngle + EPSILON;\x0d\n  const radialDistance = Math.hypot(\x0d\n    constraint.x - route.blocker.x\x2C\x0d\n    constraint.y - route.blocker.y\x2C\x0d\n  );\x0d\n  const minimum = angleWithinArc\x0d\n    ? Math.min(endpointDistance\x2C Math.abs(radialDistance - route.blocker.radius))\x0d\n    : endpointDistance;\x0d\n  return minimum >= constraint.radius - EPSILON;\x0d\n}\x0d\n\x0d\n\x0d\nfunction pointInsideBounds(point\x2C radius\x2C bounds) {\x0d\n  if (bounds === null) return true;\x0d\n  return (\x0d\n    point.x >= radius - EPSILON\x0d\n    && point.x <= bounds.width - radius + EPSILON\x0d\n    && point.y >= radius - EPSILON\x0d\n    && point.y <= bounds.height - radius + EPSILON\x0d\n  );\x0d\n}\x0d\n\x0d\n\x0d\nfunction arcInsideBounds(route\x2C moverRadius\x2C bounds) {\x0d\n  if (bounds === null) return true;\x0d\n  const points = [route.entry.point\x2C route.exit.point];\x0d\n  for (const angle of [0\x2C Math.PI / 2\x2C Math.PI\x2C -Math.PI / 2]) {\x0d\n    if (directedAngle(route.entry.angle\x2C angle\x2C route.side) <= route.exit.arcAngle + EPSILON) {\x0d\n      points.push({\x0d\n        x: route.blocker.x + route.blocker.radius * Math.cos(angle)\x2C\x0d\n        y: route.blocker.y + route.blocker.radius * Math.sin(angle)\x2C\x0d\n      });\x0d\n    }\x0d\n  }\x0d\n  return points.every((point) => pointInsideBounds(point\x2C moverRadius\x2C bounds));\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeClears(route\x2C constraints\x2C moverRadius\x2C bounds) {\x0d\n  if (\x0d\n    !pointInsideBounds(route.entry.point\x2C moverRadius\x2C bounds)\x0d\n    || !pointInsideBounds(route.goalPoint\x2C moverRadius\x2C bounds)\x0d\n    || !arcInsideBounds(route\x2C moverRadius\x2C bounds)\x0d\n  ) return false;\x0d\n  return constraints.every((constraint) => (\x0d\n    constraint.key === route.blocker.key\x0d\n    || (\x0d\n      segmentClears(route.entryStart\x2C route.entry.point\x2C constraint)\x0d\n      && arcClears(route\x2C constraint)\x0d\n      && segmentClears(route.exit.point\x2C route.goalPoint\x2C constraint)\x0d\n    )\x0d\n  ));\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeStep(mover\x2C target\x2C route\x2C budget) {\x0d\n  if (budget <= EPSILON) return { dx: 0\x2C dy: 0\x2C remainingPathLength: route.pathLength };\x0d\n  const goalRadius = attackGoalRadius(mover\x2C target);\x0d\n  const towardTargetX = target.x - mover.x;\x0d\n  const towardTargetY = target.y - mover.y;\x0d\n  const projection = towardTargetX * route.entry.direction.x\x0d\n    + towardTargetY * route.entry.direction.y;\x0d\n  const perpendicularSquared = towardTargetX ** 2 + towardTargetY ** 2 - projection ** 2;\x0d\n  const contactDistance = projection > EPSILON && perpendicularSquared <= goalRadius ** 2\x0d\n    ? projection - Math.sqrt(Math.max(0\x2C goalRadius ** 2 - perpendicularSquared))\x0d\n    : null;\x0d\n  const remainingPathLength = contactDistance !== null && contactDistance > EPSILON\x0d\n    ? contactDistance\x0d\n    : route.pathLength;\x0d\n  const distance = Math.min(budget\x2C remainingPathLength);\x0d\n  const end = {\x0d\n    x: mover.x + route.entry.direction.x * distance\x2C\x0d\n    y: mover.y + route.entry.direction.y * distance\x2C\x0d\n  };\x0d\n  const contact = firstSegmentCircleIntersection(mover\x2C end\x2C target\x2C goalRadius);\x0d\n  const travel = contact === null ? distance : distance * contact;\x0d\n  return {\x0d\n    dx: route.entry.direction.x * travel\x2C\x0d\n    dy: route.entry.direction.y * travel\x2C\x0d\n    remainingPathLength: Math.max(0\x2C remainingPathLength - travel)\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction stepClears(mover\x2C movement\x2C constraints\x2C moverRadius\x2C bounds) {\x0d\n  const end = { x: mover.x + movement.dx\x2C y: mover.y + movement.dy };\x0d\n  return pointInsideBounds(end\x2C moverRadius\x2C bounds)\x0d\n    && constraints.every((constraint) => segmentClears(mover\x2C end\x2C constraint));\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeState(blocker\x2C target\x2C side) {\x0d\n  return freezeAvoidance(blocker.kind === "unit" ? {\x0d\n    blockerReferenceId: blocker.referenceId\x2C\x0d\n    targetReferenceId: target.referenceId\x2C\x0d\n    side\x2C\x0d\n  } : {\x0d\n    blockerObstacleIndex: blocker.obstacleIndex\x2C\x0d\n    targetReferenceId: target.referenceId\x2C\x0d\n    side\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction constraintForState(constraints\x2C avoidance) {\x0d\n  if (avoidance.blockerObstacleIndex !== undefined) {\x0d\n    return constraints.find(({ kind\x2C obstacleIndex }) => (\x0d\n      kind === "map" && obstacleIndex === avoidance.blockerObstacleIndex\x0d\n    ));\x0d\n  }\x0d\n  return constraints.find(({ kind\x2C referenceId }) => (\x0d\n    kind === "unit" && referenceId === avoidance.blockerReferenceId\x0d\n  ));\x0d\n}\x0d\n\x0d\n\x0d\nfunction blockerIntersection(mover\x2C goal\x2C blocker) {\x0d\n  return firstSegmentCircleIntersection(mover\x2C goal\x2C blocker\x2C blocker.radius);\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeCandidate(mover\x2C target\x2C blocker\x2C side\x2C constraints\x2C mapInfo\x2C budget) {\x0d\n  const route = routeToContact(mover\x2C target\x2C blocker\x2C side);\x0d\n  if (route === null) return null;\x0d\n  route.entryStart = mover;\x0d\n  if (!routeClears(route\x2C constraints\x2C collisionRadius(mover)\x2C mapInfo.bounds)) return null;\x0d\n  const movement = routeStep(mover\x2C target\x2C route\x2C budget);\x0d\n  if (!stepClears(mover\x2C movement\x2C constraints\x2C collisionRadius(mover)\x2C mapInfo.bounds)) return null;\x0d\n  return { route\x2C movement };\x0d\n}\x0d\n\x0d\n\x0d\nfunction safeStepCandidate(mover\x2C target\x2C blocker\x2C side\x2C constraints\x2C mapInfo\x2C budget) {\x0d\n  const route = routeToContact(mover\x2C target\x2C blocker\x2C side);\x0d\n  if (route === null) return null;\x0d\n  route.entryStart = mover;\x0d\n  const movement = routeStep(mover\x2C target\x2C route\x2C budget);\x0d\n  if (!stepClears(mover\x2C movement\x2C constraints\x2C collisionRadius(mover)\x2C mapInfo.bounds)) {\x0d\n    return null;\x0d\n  }\x0d\n  return { route\x2C movement };\x0d\n}\x0d\n\x0d\n\x0d\nfunction compareCandidates(left\x2C right\x2C mover) {\x0d\n  if (left.route.pathLength < right.route.pathLength - EPSILON) return -1;\x0d\n  if (right.route.pathLength < left.route.pathLength - EPSILON) return 1;\x0d\n  const facingX = Math.cos(mover.facing);\x0d\n  const facingY = Math.sin(mover.facing);\x0d\n  const leftAlignment = facingX * left.route.entry.direction.x\x0d\n    + facingY * left.route.entry.direction.y;\x0d\n  const rightAlignment = facingX * right.route.entry.direction.x\x0d\n    + facingY * right.route.entry.direction.y;\x0d\n  if (leftAlignment > rightAlignment + EPSILON) return -1;\x0d\n  if (rightAlignment > leftAlignment + EPSILON) return 1;\x0d\n  // A blocked direct path must never win merely because the two detours are\x0d\n  // geometrically identical. Reference parity is a stable per-unit tiebreaker\x0d\n  // that avoids sending an entire symmetric cohort around the same side.\x0d\n  const preferredSide = mover.referenceId % 2 === 0 ? 1 : -1;\x0d\n  if (left.route.side === preferredSide && right.route.side !== preferredSide) return -1;\x0d\n  if (right.route.side === preferredSide && left.route.side !== preferredSide) return 1;\x0d\n  const blockerOrder = left.route.blocker.key.localeCompare(right.route.blocker.key);\x0d\n  if (blockerOrder !== 0) return blockerOrder;\x0d\n  return 0;\x0d\n}\x0d\n\x0d\n\x0d\nfunction selectRoute(mover\x2C target\x2C goal\x2C constraints\x2C mapInfo\x2C budget) {\x0d\n  const directBlockers = constraints\x0d\n    .map((constraint) => ({\x0d\n      constraint\x2C\x0d\n      intersection: blockerIntersection(mover\x2C goal\x2C constraint)\x2C\x0d\n    }))\x0d\n    .filter(({ intersection }) => intersection !== null)\x0d\n    .sort((left\x2C right) => (\x0d\n      left.intersection - right.intersection\x0d\n      || left.constraint.key.localeCompare(right.constraint.key)\x0d\n    ));\x0d\n  if (directBlockers.length === 0) return null;\x0d\n\x0d\n  const directKeys = new Set(directBlockers.map(({ constraint }) => constraint.key));\x0d\n  const blockers = [\x0d\n    ...directBlockers.map(({ constraint }) => constraint)\x2C\x0d\n    ...constraints\x0d\n      .filter(({ key }) => !directKeys.has(key))\x0d\n      .sort((left\x2C right) => left.key.localeCompare(right.key))\x2C\x0d\n  ];\x0d\n  let candidates = blockers.flatMap((blocker) => [-1\x2C 1]\x0d\n    .map((side) => routeCandidate(\x0d\n      mover\x2C\x0d\n      target\x2C\x0d\n      blocker\x2C\x0d\n      side\x2C\x0d\n      constraints\x2C\x0d\n      mapInfo\x2C\x0d\n      budget\x2C\x0d\n    ))\x0d\n    .filter((candidate) => candidate !== null));\x0d\n  // A complete tangent route can be invalidated by another distant body even\x0d\n  // though its immediate step is safe. Take that certified local step and\x0d\n  // re-plan next tick instead of falling back to the blocked direct segment.\x0d\n  if (candidates.length === 0) {\x0d\n    candidates = blockers.flatMap((blocker) => [-1\x2C 1]\x0d\n      .map((side) => safeStepCandidate(\x0d\n        mover\x2C\x0d\n        target\x2C\x0d\n        blocker\x2C\x0d\n        side\x2C\x0d\n        constraints\x2C\x0d\n        mapInfo\x2C\x0d\n        budget\x2C\x0d\n      ))\x0d\n      .filter((candidate) => candidate !== null));\x0d\n  }\x0d\n  if (candidates.length === 0) return null;\x0d\n  const ranked = candidates.sort((left\x2C right) => compareCandidates(left\x2C right\x2C mover));\x0d\n  return ranked[0];\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeMap(map\x2C moverRadius) {\x0d\n  if (map === undefined || map === null) return { bounds: null\x2C obstacles: [] };\x0d\n  const width = requireFinite(map.width\x2C "map width");\x0d\n  const height = requireFinite(map.height\x2C "map height");\x0d\n  if (width <= 0 || height <= 0) throw new RangeError("map dimensions must be positive");\x0d\n  if (!Array.isArray(map.obstacles ?? [])) throw new TypeError("map obstacles must be an array");\x0d\n  const obstacles = (map.obstacles ?? []).map((obstacle\x2C obstacleIndex) => {\x0d\n    const explicitRadius = obstacle.radius\x0d\n      ?? obstacle.collisionRadius\x0d\n      ?? obstacle.collision_radius;\x0d\n    const radius = explicitRadius === undefined\x0d\n      ? collisionRadius(obstacle)\x0d\n      : requireFinite(explicitRadius\x2C "map obstacle radius");\x0d\n    if (radius <= 0) throw new RangeError("map obstacle radius must be positive");\x0d\n    return {\x0d\n      kind: "map"\x2C\x0d\n      key: `map:${obstacleIndex.toString().padStart(10\x2C "0")}`\x2C\x0d\n      obstacleIndex\x2C\x0d\n      x: requireFinite(obstacle.x\x2C "map obstacle x")\x2C\x0d\n      y: requireFinite(obstacle.y\x2C "map obstacle y")\x2C\x0d\n      radius: moverRadius + radius\x2C\x0d\n    };\x0d\n  });\x0d\n  return { bounds: { width\x2C height }\x2C obstacles };\x0d\n}\x0d\n\x0d\n\x0d\nfunction constraintsFor(mover\x2C target\x2C units\x2C map\x2C pairInteractions) {\x0d\n  const moverRadius = collisionRadius(mover);\x0d\n  const mapInfo = normalizeMap(map\x2C moverRadius);\x0d\n  const bodies = units\x0d\n    .filter((unit) => (\x0d\n      unit.alive !== false\x0d\n      && unit.referenceId !== mover.referenceId\x0d\n      && unit.referenceId !== target.referenceId\x0d\n      && resolvePairInteraction(mover\x2C unit\x2C pairInteractions).pathObstructs\x0d\n      // Enemy bodies obstruct exactly as ally bodies do -- 99.76% of\x0d\n      // camel-to-skirmisher pairs across the kiting tapes hold the full\x0d\n      // 0.45 Chebyshev separation -- so a chaser has to route around the\x0d\n      // formation standing between it and its target. Ally-only routing\x0d\n      // leaves it walking into the block and grinding along bodies at\x0d\n      // partial speed\x2C which no tape shows. See AOE2X_EXP_AVOID.\x0d\n      && (AVOID_ALL_BODIES || unit.owner === mover.owner)\x0d\n    ))\x0d\n    .map((unit) => {\x0d\n      const interaction = resolvePairInteraction(mover\x2C unit\x2C pairInteractions);\x0d\n      return {\x0d\n        kind: "unit"\x2C\x0d\n        key: `unit:${unit.referenceId.toString().padStart(20\x2C "0")}`\x2C\x0d\n        referenceId: unit.referenceId\x2C\x0d\n        x: unit.x\x2C\x0d\n        y: unit.y\x2C\x0d\n        radius: interaction.collisionExtent\x2C\x0d\n      };\x0d\n    });\x0d\n  return { constraints: [...bodies\x2C ...mapInfo.obstacles]\x2C mapInfo };\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeInputs(snapshot\x2C proposals) {\x0d\n  if (!Array.isArray(snapshot)) throw new TypeError("snapshot must be an array");\x0d\n  if (!Array.isArray(proposals)) throw new TypeError("proposals must be an array");\x0d\n  const proposalByReference = new Map();\x0d\n  for (const row of proposals) {\x0d\n    const referenceId = requireReferenceId(row?.referenceId\x2C "proposal reference ID");\x0d\n    if (proposalByReference.has(referenceId)) {\x0d\n      throw new Error(`duplicate movement proposal for reference ${referenceId}`);\x0d\n    }\x0d\n    const movementIntent = row.movementIntent ?? null;\x0d\n    if (movementIntent !== null && movementIntent !== "minimum-range-retreat") {\x0d\n      throw new RangeError(`unknown movement intent ${movementIntent}`);\x0d\n    }\x0d\n    proposalByReference.set(referenceId\x2C Object.freeze({\x0d\n      referenceId\x2C\x0d\n      dx: requireFinite(row.dx\x2C "proposal dx")\x2C\x0d\n      dy: requireFinite(row.dy\x2C "proposal dy")\x2C\x0d\n      ...(movementIntent === null ? {} : { movementIntent })\x2C\x0d\n    }));\x0d\n  }\x0d\n  const seen = new Set();\x0d\n  const units = snapshot.map((unit) => {\x0d\n    const referenceId = requireReferenceId(unit?.referenceId);\x0d\n    if (seen.has(referenceId)) throw new Error(`duplicate unit reference ${referenceId}`);\x0d\n    seen.add(referenceId);\x0d\n    return Object.freeze({ ...unit\x2C avoidance: freezeAvoidance(unit.avoidance) });\x0d\n  });\x0d\n  for (const referenceId of proposalByReference.keys()) {\x0d\n    if (!seen.has(referenceId)) throw new Error(`movement proposal references unknown unit ${referenceId}`);\x0d\n  }\x0d\n  return { units\x2C proposalByReference };\x0d\n}\x0d\n\x0d\n\x0d\nexport function planLocalAvoidance(snapshot\x2C proposals\x2C map\x2C options = {}) {\x0d\n  const pairInteractions = options.pairInteractions\x0d\n    ?? createPairInteractionSnapshot();\x0d\n  const authoritativeReferenceIds = options.authoritativeReferenceIds ?? new Set();\x0d\n  const { units\x2C proposalByReference } = normalizeInputs(snapshot\x2C proposals);\x0d\n  const byReference = new Map(units.map((unit) => [unit.referenceId\x2C unit]));\x0d\n  const nextUnits = [];\x0d\n  const nextProposals = [];\x0d\n  const routes = [];\x0d\n\x0d\n  for (const mover of units) {\x0d\n    const original = proposalByReference.get(mover.referenceId)\x0d\n      ?? Object.freeze({ referenceId: mover.referenceId\x2C dx: 0\x2C dy: 0 });\x0d\n    // A persistent grid route has already considered the whole obstruction\x0d\n    // corridor. Replacing that step with a one-body tangent recreates the\x0d\n    // per-tick local minimum the route is intended to escape.\x0d\n    if (authoritativeReferenceIds.has(mover.referenceId)) {\x0d\n      nextUnits.push(Object.freeze({ ...mover\x2C avoidance: null }));\x0d\n      nextProposals.push(original);\x0d\n      continue;\x0d\n    }\x0d\n    const originalBudget = Math.hypot(original.dx\x2C original.dy);\x0d\n    // A kite-move marcher walks its formation slot\x2C not toward contact with\x0d\n    // its beat target \u2014 routing it around blockers toward that target would\x0d\n    // override the scripted march (and did: the recorded formation flows at\x0d\n    // 0.40-0.52 tiles/s median while goal-routed marchers crawled at 0.22).\x0d\n    // It still stands as an obstacle in every other mover's constraint set.\x0d\n    // A minimum-range retreat is deliberately moving AWAY from a pursuit\x0d\n    // target that is already inside the unit's maximum firing range. Treating\x0d\n    // it as an ordinary pursuit makes contactGoal report "reached" and\x0d\n    // cancels the retreat before collision resolution can see it.\x0d\n    const target = mover.moveOrder || original.movementIntent === "minimum-range-retreat"\x0d\n      ? null\x0d\n      : byReference.get(mover.pursuitTargetId);\x0d\n    const goal = target?.alive === false || !target ? null : contactGoal(mover\x2C target);\x0d\n    let avoidance = mover.avoidance;\x0d\n    let selected = null;\x0d\n\x0d\n    if (goal === null || goal.reached || mover.alive === false) {\x0d\n      avoidance = null;\x0d\n    } else {\x0d\n      const speed = requireFinite(\x0d\n        mover?.mechanics?.speed_tiles_per_second\x2C\x0d\n        "movement speed"\x2C\x0d\n      );\x0d\n      if (speed < 0) throw new RangeError("movement speed must be nonnegative");\x0d\n      const budget = speed / TICKS_PER_SECOND;\x0d\n      const { constraints\x2C mapInfo } = constraintsFor(\x0d\n        mover\x2C target\x2C units\x2C map\x2C pairInteractions\x2C\x0d\n      );\x0d\n      if (avoidance !== null && avoidance.targetReferenceId === target.referenceId) {\x0d\n        const blocker = constraintForState(constraints\x2C avoidance);\x0d\n        const blocksDirect = blocker !== undefined\x0d\n          && blockerIntersection(mover\x2C goal\x2C blocker) !== null;\x0d\n        if (blocksDirect) {\x0d\n          if (originalBudget > EPSILON) {\x0d\n            selected = routeCandidate(\x0d\n              mover\x2C\x0d\n              target\x2C\x0d\n              blocker\x2C\x0d\n              avoidance.side\x2C\x0d\n              constraints\x2C\x0d\n              mapInfo\x2C\x0d\n              budget\x2C\x0d\n            );\x0d\n            if (selected === null) {\x0d\n              selected = safeStepCandidate(\x0d\n                mover\x2C\x0d\n                target\x2C\x0d\n                blocker\x2C\x0d\n                avoidance.side\x2C\x0d\n                constraints\x2C\x0d\n                mapInfo\x2C\x0d\n                budget\x2C\x0d\n              );\x0d\n            }\x0d\n          }\x0d\n        }\x0d\n        if (!blocksDirect) {\x0d\n          avoidance = null;\x0d\n        } else if (originalBudget > EPSILON && selected === null) {\x0d\n          avoidance = null;\x0d\n        }\x0d\n      } else {\x0d\n        avoidance = null;\x0d\n      }\x0d\n      if (selected === null && originalBudget > EPSILON) {\x0d\n        selected = selectRoute(mover\x2C target\x2C goal\x2C constraints\x2C mapInfo\x2C budget);\x0d\n        if (selected !== null) {\x0d\n          avoidance = routeState(selected.route.blocker\x2C target\x2C selected.route.side);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n\x0d\n    let nextProposal = original;\x0d\n    if (goal?.reached) {\x0d\n      // Movement proposals are generated before contact is rechecked. Cancel a\x0d\n      // stale pursuit step here so a unit already at its attack goal cannot\x0d\n      // walk through the target or an overlapping blocker.\x0d\n      nextProposal = Object.freeze({ referenceId: mover.referenceId\x2C dx: 0\x2C dy: 0 });\x0d\n    } else if (selected !== null) {\x0d\n      nextProposal = Object.freeze({\x0d\n        referenceId: mover.referenceId\x2C\x0d\n        dx: selected.movement.dx\x2C\x0d\n        dy: selected.movement.dy\x2C\x0d\n      });\x0d\n      routes.push(Object.freeze({\x0d\n        referenceId: mover.referenceId\x2C\x0d\n        blockerReferenceId: selected.route.blocker.referenceId ?? null\x2C\x0d\n        blockerObstacleIndex: selected.route.blocker.obstacleIndex ?? null\x2C\x0d\n        targetReferenceId: target.referenceId\x2C\x0d\n        side: selected.route.side\x2C\x0d\n        remainingPathLength: Math.max(\x0d\n          0\x2C\x0d\n          selected.movement.remainingPathLength\x2C\x0d\n        )\x2C\x0d\n      }));\x0d\n    }\x0d\n\x0d\n    nextUnits.push(Object.freeze({ ...mover\x2C avoidance }));\x0d\n    nextProposals.push(nextProposal);\x0d\n  }\x0d\n\x0d\n  return Object.freeze({\x0d\n    units: Object.freeze(nextUnits)\x2C\x0d\n    proposals: Object.freeze(nextProposals)\x2C\x0d\n    routes: Object.freeze(routes.sort((left\x2C right) => left.referenceId - right.referenceId))\x2C\x0d\n  });\x0d\n}\x0d\n
