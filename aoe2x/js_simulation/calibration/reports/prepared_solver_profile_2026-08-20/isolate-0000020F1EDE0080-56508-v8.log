code-creation,Script,10,219548,0x27a60338a56,106, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/cohort-motion.js:1:1,0x27a60338628,~
script-source,162,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/cohort-motion.js,import { collisionRadius } from "./targeting.js";\n\nconst TURN_STEP_RADIANS = Math.PI / 12;\nconst MAX_TURNS = 6;\nconst EPSILON = 1e-12;\n\nfunction stepClear(unit\x2C dx\x2C dy\x2C enemies\x2C map) {\n  const radius = collisionRadius(unit);\n  const x = unit.x + dx;\n  const y = unit.y + dy;\n  if (x < radius || x > map.width - radius || y < radius || y > map.height - radius) {\n    return false;\n  }\n  for (const enemy of enemies) {\n    const reach = radius + collisionRadius(enemy);\n    if (Math.max(Math.abs(x - enemy.x)\x2C Math.abs(y - enemy.y)) < reach - EPSILON) {\n      return false;\n    }\n  }\n  return true;\n}\n\nfunction candidateOffsets(preferredTurn) {\n  const result = [{ turns: 0\x2C sideRank: 0 }];\n  for (let turns = 1; turns <= MAX_TURNS; turns += 1) {\n    result.push({ turns: preferredTurn * turns\x2C sideRank: 0 });\n    result.push({ turns: -preferredTurn * turns\x2C sideRank: 1 });\n  }\n  return result;\n}\n\nfunction better(candidate\x2C best) {\n  if (best === null) return true;\n  if (candidate.clear !== best.clear) return candidate.clear > best.clear;\n  if (Math.abs(candidate.forward - best.forward) > EPSILON) {\n    return candidate.forward > best.forward;\n  }\n  if (candidate.absTurns !== best.absTurns) return candidate.absTurns < best.absTurns;\n  return candidate.sideRank < best.sideRank;\n}\n\nexport function planCohortContactMotion({ units\x2C proposals\x2C enemies\x2C map\x2C preferredTurn }) {\n  if (!Array.isArray(units) || !Array.isArray(proposals) || !Array.isArray(enemies)) {\n    throw new TypeError("units\x2C proposals\x2C and enemies must be arrays");\n  }\n  if (units.length !== proposals.length) {\n    throw new RangeError("cohort units and proposals must have equal length");\n  }\n  if (units.length < 2) return Object.freeze([...proposals]);\n  const movers = proposals.map((proposal\x2C index) => ({\n    unit: units[index]\x2C\n    proposal\x2C\n    distance: Math.hypot(proposal.dx\x2C proposal.dy)\x2C\n  })).filter(({ distance }) => distance > EPSILON);\n  if (movers.length === 0) return Object.freeze([...proposals]);\n  if (!movers.some(({ unit\x2C proposal }) => (\n    !stepClear(unit\x2C proposal.dx\x2C proposal.dy\x2C enemies\x2C map)\n  ))) return Object.freeze([...proposals]);\n\n  let meanX = 0;\n  let meanY = 0;\n  for (const { proposal\x2C distance } of movers) {\n    meanX += proposal.dx / distance;\n    meanY += proposal.dy / distance;\n  }\n  if (Math.hypot(meanX\x2C meanY) <= EPSILON) return Object.freeze([...proposals]);\n  const baseAngle = Math.atan2(meanY\x2C meanX);\n  const turn = preferredTurn === -1 ? -1 : 1;\n  let best = null;\n  for (const offset of candidateOffsets(turn)) {\n    const angle = baseAngle + offset.turns * TURN_STEP_RADIANS;\n    const ux = Math.cos(angle);\n    const uy = Math.sin(angle);\n    let clear = 0;\n    let forward = 0;\n    for (const { unit\x2C proposal\x2C distance } of movers) {\n      const dx = ux * distance;\n      const dy = uy * distance;\n      if (stepClear(unit\x2C dx\x2C dy\x2C enemies\x2C map)) clear += 1;\n      forward += dx * (proposal.dx / distance) + dy * (proposal.dy / distance);\n    }\n    const candidate = {\n      angle\x2C\n      clear\x2C\n      forward\x2C\n      absTurns: Math.abs(offset.turns)\x2C\n      sideRank: offset.sideRank\x2C\n    };\n    if (better(candidate\x2C best)) best = candidate;\n  }\n\n  const ux = Math.cos(best.angle);\n  const uy = Math.sin(best.angle);\n  return Object.freeze(proposals.map((proposal) => {\n    const distance = Math.hypot(proposal.dx\x2C proposal.dy);\n    return distance <= EPSILON\n      ? Object.freeze({ referenceId: proposal.referenceId\x2C dx: 0\x2C dy: 0 })\n      : Object.freeze({\n        referenceId: proposal.referenceId\x2C\n        dx: ux * distance\x2C\n        dy: uy * distance\x2C\n      });\n  }));\n}\n
