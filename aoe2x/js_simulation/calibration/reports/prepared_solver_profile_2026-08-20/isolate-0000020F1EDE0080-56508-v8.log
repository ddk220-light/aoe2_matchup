script-source,165,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/solo-navigation.js,import { TICKS_PER_SECOND } from "../simulation-clock.js";\x0d\n\x0d\n\x0d\nexport const SOLO_NAVIGATION_VARIANTS = Object.freeze([\x0d\n  "baseline"\x2C\x0d\n  "per-unit-grid"\x2C\x0d\n  "cohesive"\x2C\x0d\n]);\x0d\n\x0d\nconst MIN_SLOT_SPACING_TILES = 0.48;\x0d\nconst MIN_ROUTE_CLEARANCE_TILES = 1.25;\x0d\nconst ROUTE_CLEARANCE_MARGIN_TILES = 0.07;\x0d\nconst ANCHOR_LEASH_TILES = 0.62;\x0d\nconst ANCHOR_REACHED_TILES = 0.18;\x0d\nconst FIRST_ORDER_DELTA_TILES = 0.25;\x0d\nconst STALL_REPLAN_TICKS = Math.round(1.25 * TICKS_PER_SECOND);\x0d\nconst ROUTE_LOOKAHEAD_TILES = 0.75;\x0d\n\x0d\n\x0d\nexport function requireSoloNavigationVariant(value) {\x0d\n  if (!SOLO_NAVIGATION_VARIANTS.includes(value)) {\x0d\n    throw new RangeError(\x0d\n      `navigation must be one of ${SOLO_NAVIGATION_VARIANTS.join("\x2C ")}\x2C got ${value}`\x2C\x0d\n    );\x0d\n  }\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction centroid(units) {\x0d\n  if (units.length === 0) return { x: 0\x2C y: 0 };\x0d\n  return {\x0d\n    x: units.reduce((sum\x2C unit) => sum + unit.x\x2C 0) / units.length\x2C\x0d\n    y: units.reduce((sum\x2C unit) => sum + unit.y\x2C 0) / units.length\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction orderCentroid(units\x2C fallback) {\x0d\n  const ordered = units.filter(({ moveOrder }) => moveOrder);\x0d\n  if (ordered.length === 0) return fallback;\x0d\n  return {\x0d\n    x: ordered.reduce((sum\x2C unit) => sum + unit.moveOrder.x\x2C 0) / ordered.length\x2C\x0d\n    y: ordered.reduce((sum\x2C unit) => sum + unit.moveOrder.y\x2C 0) / ordered.length\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction maximumCollisionRadius(units) {\x0d\n  return units.reduce((maximum\x2C unit) => Math.max(\x0d\n    maximum\x2C\x0d\n    unit.mechanics?.collision_size_tiles?.x ?? 0\x2C\x0d\n  )\x2C 0);\x0d\n}\x0d\n\x0d\n\x0d\nfunction compactSlots(count\x2C spacing) {\x0d\n  const width = Math.ceil(Math.sqrt(count));\x0d\n  const height = Math.ceil(count / width);\x0d\n  const candidates = [];\x0d\n  for (let row = 0; row < height; row += 1) {\x0d\n    for (let column = 0; column < width; column += 1) {\x0d\n      candidates.push({\x0d\n        x: (column - (width - 1) / 2) * spacing\x2C\x0d\n        y: (row - (height - 1) / 2) * spacing\x2C\x0d\n      });\x0d\n    }\x0d\n  }\x0d\n  return candidates\x0d\n    .sort((a\x2C b) => {\x0d\n      const da = a.x * a.x + a.y * a.y;\x0d\n      const db = b.x * b.x + b.y * b.y;\x0d\n      return da !== db ? da - db : (a.y !== b.y ? a.y - b.y : a.x - b.x);\x0d\n    })\x0d\n    .slice(0\x2C count)\x0d\n    .sort((a\x2C b) => (a.y !== b.y ? a.y - b.y : a.x - b.x));\x0d\n}\x0d\n\x0d\n\x0d\nfunction assignStableSlots(units\x2C { formationSpacingTiles } = {}) {\x0d\n  const own = centroid(units);\x0d\n  const ordered = [...units].sort((a\x2C b) => (\x0d\n    a.y !== b.y ? a.y - b.y : (a.x !== b.x ? a.x - b.x : a.referenceId - b.referenceId)\x0d\n  ));\x0d\n  // Formation orders are allowed to compress allied bodies: the movement\x0d\n  // solver deliberately exempts two allies that both hold formation orders\x2C\x0d\n  // matching the recorded marching blocks. Most ranged units use the measured\x0d\n  // half-tile lattice. A tape-measured profile may provide a wider lattice for\x0d\n  // a large body; this has to reach cohesive navigation as well as the visible\x0d\n  // kite order\x2C otherwise the navigation layer silently compresses the group\x0d\n  // back to 0.48 tiles on the next tick.\x0d\n  const spacing = Number.isFinite(formationSpacingTiles) && formationSpacingTiles > 0\x0d\n    ? formationSpacingTiles\x0d\n    : MIN_SLOT_SPACING_TILES;\x0d\n  const slots = compactSlots(units.length\x2C spacing);\x0d\n  return new Map(ordered.map((unit\x2C index) => [unit.referenceId\x2C slots[index]]));\x0d\n}\x0d\n\x0d\n\x0d\nfunction perimeter(bounds) {\x0d\n  return 2 * ((bounds.hiX - bounds.loX) + (bounds.hiY - bounds.loY));\x0d\n}\x0d\n\x0d\n\x0d\nfunction ringArc(bounds\x2C point) {\x0d\n  const width = bounds.hiX - bounds.loX;\x0d\n  const height = bounds.hiY - bounds.loY;\x0d\n  const x = Math.min(bounds.hiX\x2C Math.max(bounds.loX\x2C point.x));\x0d\n  const y = Math.min(bounds.hiY\x2C Math.max(bounds.loY\x2C point.y));\x0d\n  const choices = [\x0d\n    { gap: Math.abs(point.y - bounds.loY)\x2C arc: x - bounds.loX }\x2C\x0d\n    { gap: Math.abs(point.x - bounds.hiX)\x2C arc: width + y - bounds.loY }\x2C\x0d\n    { gap: Math.abs(point.y - bounds.hiY)\x2C arc: width + height + bounds.hiX - x }\x2C\x0d\n    { gap: Math.abs(point.x - bounds.loX)\x2C arc: 2 * width + height + bounds.hiY - y }\x2C\x0d\n  ];\x0d\n  return choices.reduce((best\x2C candidate) => candidate.gap < best.gap ? candidate : best).arc;\x0d\n}\x0d\n\x0d\n\x0d\nfunction ringPoint(bounds\x2C arc) {\x0d\n  const width = bounds.hiX - bounds.loX;\x0d\n  const height = bounds.hiY - bounds.loY;\x0d\n  let value = ((arc % perimeter(bounds)) + perimeter(bounds)) % perimeter(bounds);\x0d\n  if (value < width) return { x: bounds.loX + value\x2C y: bounds.loY };\x0d\n  value -= width;\x0d\n  if (value < height) return { x: bounds.hiX\x2C y: bounds.loY + value };\x0d\n  value -= height;\x0d\n  if (value < width) return { x: bounds.hiX - value\x2C y: bounds.hiY };\x0d\n  value -= width;\x0d\n  return { x: bounds.loX\x2C y: bounds.hiY - value };\x0d\n}\x0d\n\x0d\n\x0d\nfunction nominalRing(map) {\x0d\n  return {\x0d\n    loX: map.width / 2 - 3\x2C\x0d\n    hiX: map.width / 2 + 3\x2C\x0d\n    loY: map.height / 2 - 3\x2C\x0d\n    hiY: map.height / 2 + 3\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction centralObstacleEnvelope(map\x2C slots\x2C bodyRadius) {\x0d\n  const nominal = nominalRing(map);\x0d\n  const central = (map.obstacles ?? []).filter((body) => (\x0d\n    body.x >= nominal.loX && body.x <= nominal.hiX\x0d\n    && body.y >= nominal.loY && body.y <= nominal.hiY\x0d\n  ));\x0d\n  if (central.length === 0) return nominal;\x0d\n  const slotReach = [...slots.values()].reduce((maximum\x2C slot) => Math.max(\x0d\n    maximum\x2C\x0d\n    Math.abs(slot.x)\x2C\x0d\n    Math.abs(slot.y)\x2C\x0d\n  )\x2C 0);\x0d\n  const margin = Math.max(\x0d\n    MIN_ROUTE_CLEARANCE_TILES\x2C\x0d\n    slotReach + bodyRadius + ROUTE_CLEARANCE_MARGIN_TILES\x2C\x0d\n  );\x0d\n  return {\x0d\n    loX: Math.min(...central.map((body) => body.x - body.radius)) - margin\x2C\x0d\n    hiX: Math.max(...central.map((body) => body.x + body.radius)) + margin\x2C\x0d\n    loY: Math.min(...central.map((body) => body.y - body.radius)) - margin\x2C\x0d\n    hiY: Math.max(...central.map((body) => body.y + body.radius)) + margin\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction mapAiWaypointToEnvelope(state) {\x0d\n  const nominalArc = ringArc(state.nominalRing\x2C state.aiWaypoint);\x0d\n  const nominalPerimeter = perimeter(state.nominalRing);\x0d\n  const routePerimeter = perimeter(state.routeBounds);\x0d\n  const raw = (nominalArc / nominalPerimeter) * routePerimeter;\x0d\n  let unwrapped = raw;\x0d\n  if (state.targetRouteArc !== null) {\x0d\n    while (unwrapped < state.targetRouteArc - routePerimeter / 2) {\x0d\n      unwrapped += routePerimeter;\x0d\n    }\x0d\n    unwrapped = Math.max(unwrapped\x2C state.targetRouteArc);\x0d\n  }\x0d\n  state.targetRouteArc = unwrapped;\x0d\n}\x0d\n\x0d\n\x0d\nfunction routeAnchor(state\x2C units\x2C map\x2C tick) {\x0d\n  const speed = units[0]?.mechanics?.speed_tiles_per_second ?? 0;\x0d\n  // At a corner\x2C static bodies can temporarily push one unit away from its\x0d\n  // ideal slot. The formation must be elastic by at least one unit diameter\x0d\n  // or large siege bodies can hold the entire anchor forever while trying to\x0d\n  // occupy an obstructed slot. Ordinary ranged bodies retain the established\x0d\n  // 0.62-tile leash; Scorpions derive a one-tile leash from their mechanics.\x0d\n  const leash = Math.max(ANCHOR_LEASH_TILES\x2C 2 * maximumCollisionRadius(units));\x0d\n  const errors = units.map((unit) => {\x0d\n    const slot = state.slots.get(unit.referenceId);\x0d\n    if (!slot) return { referenceId: unit.referenceId\x2C error: 0 };\x0d\n    const goal = { x: state.anchor.x + slot.x\x2C y: state.anchor.y + slot.y };\x0d\n    return {\x0d\n      referenceId: unit.referenceId\x2C\x0d\n      error: Math.hypot(unit.x - goal.x\x2C unit.y - goal.y)\x2C\x0d\n    };\x0d\n  });\x0d\n  const maximumError = errors.reduce((maximum\x2C current) => (\x0d\n    Math.max(maximum\x2C current.error)\x0d\n  )\x2C 0);\x0d\n  const mobileErrors = errors.filter(({ referenceId }) => (\n    !state.blockedReferenceIds.has(referenceId)\n  ));\n  const strictMajority = Math.floor(units.length / 2) + 1;\n  const leashError = mobileErrors.length >= strictMajority\n    ? [...mobileErrors]\n      .sort((left\x2C right) => left.error - right.error)[strictMajority - 1].error\n    : maximumError;\n  if (state.phase === "forming-first-order") {\x0d\n    if (leashError > leash || speed <= 0) return maximumError;\x0d\n    state.phase = "routing";\x0d\n    state.lastAnchorMoveTick = tick;\x0d\n  }\x0d\n  const reached = !state.routeWaypoint\x0d\n    || Math.hypot(state.anchor.x - state.routeWaypoint.x\x2C\x0d\n      state.anchor.y - state.routeWaypoint.y) <= ANCHOR_REACHED_TILES;\x0d\n  const stalled = tick - state.lastAnchorMoveTick >= STALL_REPLAN_TICKS;\x0d\n  mapAiWaypointToEnvelope(state);\x0d\n  if (reached) {\x0d\n    state.routeArc = Math.min(\x0d\n      state.targetRouteArc\x2C\x0d\n      state.routeArc + ROUTE_LOOKAHEAD_TILES\x2C\x0d\n    );\x0d\n    state.routeWaypoint = ringPoint(state.routeBounds\x2C state.routeArc);\x0d\n  }\x0d\n  if (stalled && tick - state.lastStallReplanTick >= STALL_REPLAN_TICKS) {\x0d\n    state.lastStallReplanTick = tick;\x0d\n    state.replans += 1;\x0d\n    // Re-project to the next clockwise perimeter point. This handles an anchor\x0d\n    // that was held while stragglers regrouped without reversing the lap.\x0d\n    state.routeArc = Math.max(state.routeArc\x2C ringArc(state.routeBounds\x2C state.anchor));\x0d\n    state.routeWaypoint = ringPoint(state.routeBounds\x2C state.routeArc);\x0d\n  }\x0d\n\x0d\n  // The strict majority owns formation progress. A minority of physically\n  // blocked or independently lagging units rejoins from its own destination;\n  // it cannot freeze the shared ranged order. If the majority falls outside\n  // the leash\x2C the anchor still waits so the cohort does not dissolve.\n  if (leashError > leash || speed <= 0) return maximumError;\x0d\n  const dx = state.routeWaypoint.x - state.anchor.x;\x0d\n  const dy = state.routeWaypoint.y - state.anchor.y;\x0d\n  const distance = Math.hypot(dx\x2C dy);\x0d\n  if (distance <= 1e-12) return maximumError;\x0d\n  const step = Math.min(distance\x2C speed / TICKS_PER_SECOND);\x0d\n  state.anchor.x += (dx / distance) * step;\x0d\n  state.anchor.y += (dy / distance) * step;\x0d\n  state.totalAnchorDistance += step;\x0d\n  state.lastAnchorMoveTick = tick;\x0d\n  return maximumError;\x0d\n}\x0d\n\x0d\n\x0d\nfunction destinationsFor(state\x2C units) {\x0d\n  const destinations = new Map();\x0d\n  if (state.variant === "cohesive") {\x0d\n    if (state.phase === "awaiting-first-order") {\x0d\n      for (const unit of units) {\x0d\n        destinations.set(unit.referenceId\x2C { x: unit.x\x2C y: unit.y });\x0d\n      }\x0d\n      return destinations;\x0d\n    }\x0d\n    for (const unit of units) {\x0d\n      const slot = state.slots.get(unit.referenceId) ?? { x: 0\x2C y: 0 };\x0d\n      destinations.set(unit.referenceId\x2C {\x0d\n        x: state.anchor.x + slot.x\x2C\x0d\n        y: state.anchor.y + slot.y\x2C\x0d\n      });\x0d\n    }\x0d\n  } else {\x0d\n    for (const unit of units) {\x0d\n      destinations.set(unit.referenceId\x2C unit.moveOrder\x0d\n        ? { x: unit.moveOrder.x\x2C y: unit.moveOrder.y }\x0d\n        : { x: unit.x\x2C y: unit.y });\x0d\n    }\x0d\n  }\x0d\n  return destinations;\x0d\n}\x0d\n\x0d\n\x0d\nfunction buildDiagnostics(state\x2C units\x2C blockedCount = 0) {\x0d\n  const own = centroid(units);\x0d\n  const cohesionRadius = units.reduce((maximum\x2C unit) => Math.max(\x0d\n    maximum\x2C Math.hypot(unit.x - own.x\x2C unit.y - own.y)\x2C\x0d\n  )\x2C 0);\x0d\n  const maxSlotError = units.reduce((maximum\x2C unit) => {\x0d\n    const goal = state.destinations.get(unit.referenceId);\x0d\n    return goal ? Math.max(maximum\x2C Math.hypot(unit.x - goal.x\x2C unit.y - goal.y)) : maximum;\x0d\n  }\x2C 0);\x0d\n  return Object.freeze({\x0d\n    variant: state.variant\x2C\x0d\n    phase: state.phase\x2C\x0d\n    aiWaypoint: Object.freeze({ ...state.aiWaypoint })\x2C\x0d\n    anchor: Object.freeze({ ...state.anchor })\x2C\x0d\n    routeWaypoint: Object.freeze({ ...state.routeWaypoint })\x2C\x0d\n    firstFormationTarget: state.firstFormationTarget === null\x0d\n      ? null\x0d\n      : Object.freeze({ ...state.firstFormationTarget })\x2C\x0d\n    unitDestinations: Object.freeze([...state.destinations.entries()].map(\x0d\n      ([referenceId\x2C point]) => Object.freeze({ referenceId\x2C x: point.x\x2C y: point.y })\x2C\x0d\n    ))\x2C\x0d\n    centroid: Object.freeze(own)\x2C\x0d\n    cohesionRadius\x2C\x0d\n    maxSlotError\x2C\x0d\n    blockedCount\x2C\x0d\n    replans: state.replans\x2C\x0d\n    stalledTicks: state.lastTick - state.lastAnchorMoveTick\x2C\x0d\n    totalAnchorDistance: state.totalAnchorDistance\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function createSoloNavigationState(variant\x2C units\x2C map\x2C formationProfile = {}) {\x0d\n  requireSoloNavigationVariant(variant);\x0d\n  const own = centroid(units);\x0d\n  const anchor = { ...own };\x0d\n  const slots = assignStableSlots(units\x2C formationProfile);\x0d\n  const routeBounds = centralObstacleEnvelope(\x0d\n    map\x2C\x0d\n    slots\x2C\x0d\n    maximumCollisionRadius(units)\x2C\x0d\n  );\x0d\n  const state = {\x0d\n    variant\x2C\x0d\n    phase: variant === "cohesive" ? "awaiting-first-order" : "direct"\x2C\x0d\n    anchor\x2C\x0d\n    aiWaypoint: { ...own }\x2C\x0d\n    initialAiWaypoint: { ...own }\x2C\x0d\n    firstFormationTarget: null\x2C\x0d\n    routeWaypoint: { ...anchor }\x2C\x0d\n    nominalRing: nominalRing(map)\x2C\x0d\n    routeBounds\x2C\x0d\n    routeArc: ringArc(routeBounds\x2C anchor)\x2C\x0d\n    targetRouteArc: null\x2C\x0d\n    slots\x2C\x0d\n    destinations: new Map()\x2C\x0d\n    replans: 0\x2C\x0d\n    lastStallReplanTick: -STALL_REPLAN_TICKS\x2C\x0d\n    lastAnchorMoveTick: 0\x2C\x0d\n    lastTick: 0\x2C\x0d\n    totalAnchorDistance: 0\x2C\x0d\n    blockedReferenceIds: new Set()\x2C\x0d\n    diagnostics: null\x2C\x0d\n  };\x0d\n  state.destinations = destinationsFor(state\x2C units);\x0d\n  state.diagnostics = buildDiagnostics(state\x2C units);\x0d\n  return state;\x0d\n}\x0d\n\x0d\n\x0d\nexport function planSoloNavigation(state\x2C units\x2C map\x2C tick) {\x0d\n  state.lastTick = tick;\x0d\n  state.aiWaypoint = orderCentroid(units\x2C state.aiWaypoint);\x0d\n  if (state.variant === "cohesive") {\x0d\n    if (state.phase === "awaiting-first-order"\x0d\n        && Math.hypot(\x0d\n          state.aiWaypoint.x - state.initialAiWaypoint.x\x2C\x0d\n          state.aiWaypoint.y - state.initialAiWaypoint.y\x2C\x0d\n        ) > FIRST_ORDER_DELTA_TILES) {\x0d\n      // The opening formation belongs to the first real AI right-click\x2C not\x0d\n      // to an invented staging point near spawn. Project that order onto the\x0d\n      // body-aware obstacle envelope so every slot has a reachable\x2C legal\x0d\n      // destination; units then form while travelling there. Only after the\x0d\n      // last stragglers enter the leash does the common anchor begin its lap.\x0d\n      // The first target is the nearest body-safe point to the literal AI\x0d\n      // order. Later orders use perimeter-progress mapping so their arc never\x0d\n      // regresses\x2C but applying that proportional remap here would rotate the\x0d\n      // very first formation away from the right-click the user can see.\x0d\n      state.routeArc = ringArc(state.routeBounds\x2C state.aiWaypoint);\x0d\n      state.targetRouteArc = state.routeArc;\x0d\n      state.firstFormationTarget = ringPoint(state.routeBounds\x2C state.routeArc);\x0d\n      state.anchor = { ...state.firstFormationTarget };\x0d\n      state.routeWaypoint = { ...state.firstFormationTarget };\x0d\n      state.phase = "forming-first-order";\x0d\n      state.lastAnchorMoveTick = tick;\x0d\n    }\x0d\n    if (state.phase !== "awaiting-first-order") routeAnchor(state\x2C units\x2C map\x2C tick);\x0d\n  }\x0d\n  else state.anchor = centroid(units);\x0d\n  if (state.variant !== "cohesive") state.routeWaypoint = { ...state.aiWaypoint };\x0d\n  state.destinations = destinationsFor(state\x2C units);\x0d\n  return state.destinations;\x0d\n}\x0d\n\x0d\n\x0d\nexport function finishSoloNavigationTick(state\x2C units\x2C blockedIds) {\x0d\n  state.blockedReferenceIds = new Set(blockedIds ?? []);\x0d\n  state.diagnostics = buildDiagnostics(state\x2C units\x2C blockedIds?.size ?? 0);\x0d\n  return state.diagnostics;\x0d\n}\x0d\n\x0d\n\x0d\nexport function soloNavigationSnapshot(state) {\x0d\n  return state?.diagnostics ?? null;\x0d\n}\x0d\n
