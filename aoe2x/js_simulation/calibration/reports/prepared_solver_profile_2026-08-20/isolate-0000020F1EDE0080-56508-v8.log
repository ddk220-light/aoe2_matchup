script-source,149,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/placement.js,// Spawn placement\x2C derived from the recorded tapes and verified against every\x0d\n// one of them (tests/placement.test.mjs). No fixture is read at runtime.\x0d\n//\x0d\n// The only thing that selects a block is (owner\x2C family). Band edge is NOT a\x0d\n// key: the same family sits at different edges depending on army size\x2C and two\x0d\n// different families share an edge -- keying on it collides.\x0d\nimport { PLACEMENT_TABLE } from "./placement-table.js";\x0d\n\x0d\n\x0d\n// The four spawn blocks the archive records. Exported because capacity is per\x0d\n// (owner\x2C family): anything that needs to enumerate the families -- the units\x0d\n// endpoint's capacityByFamily\x2C for one -- must read them from here rather than\x0d\n// keep a hand-mirrored copy that can drift.\x0d\nexport const FAMILIES = Object.freeze(["rvr"\x2C "kite"\x2C "siege"\x2C "waves"]);\x0d\nconst RANGED = new Set(["mobile_ranged"\x2C "siege_ranged"]);\x0d\n\x0d\n\x0d\n// Which spawn block a pairing uses\x2C from the two units' combat classes. The\x0d\n// order of these tests is the archive's own: both-ranged wins over one-mobile\x2C\x0d\n// which wins over one-siege.\x0d\nexport function resolveFamily({ side2Class\x2C side3Class }) {\x0d\n  const bothRanged = RANGED.has(side2Class) && RANGED.has(side3Class);\x0d\n  if (bothRanged) return "rvr";\x0d\n  if (side2Class === "mobile_ranged" || side3Class === "mobile_ranged") return "kite";\x0d\n  if (side2Class === "siege_ranged" || side3Class === "siege_ranged") return "siege";\x0d\n  return "waves";\x0d\n}\x0d\n\x0d\n\x0d\nfunction cellsFor(owner\x2C family) {\x0d\n  if (owner !== 2 && owner !== 3) {\x0d\n    throw new RangeError(`owner must be 2 or 3\x2C got ${owner}`);\x0d\n  }\x0d\n  if (!FAMILIES.includes(family)) {\x0d\n    throw new RangeError(`unknown family ${family}`);\x0d\n  }\x0d\n  return PLACEMENT_TABLE[`${owner}@${family}`];\x0d\n}\x0d\n\x0d\n\x0d\n// How many units this side can field in this family. The archive never grew a\x0d\n// side-2 siege block past 16\x2C so that is the honest ceiling: beyond it there is\x0d\n// no measured geometry\x2C and inventing some would be exactly the fitting this\x0d\n// simulator exists to avoid.\x0d\nexport function sideCapacity(owner\x2C family) {\x0d\n  return cellsFor(owner\x2C family).length;\x0d\n}\x0d\n\x0d\n\x0d\nexport function placeArmy({ owner\x2C count\x2C family }) {\x0d\n  const cells = cellsFor(owner\x2C family);\x0d\n  if (!Number.isSafeInteger(count) || count < 1) {\x0d\n    throw new RangeError(`count must be a positive integer\x2C got ${count}`);\x0d\n  }\x0d\n  if (count > cells.length) {\x0d\n    throw new RangeError(\x0d\n      `owner ${owner} family ${family} has only ${cells.length} cells\x2C asked for ${count}`);\x0d\n  }\x0d\n  return Object.freeze(cells.slice(0\x2C count).map(\x0d\n    ([x\x2C y]) => Object.freeze({ x\x2C y })));\x0d\n}\x0d\n
