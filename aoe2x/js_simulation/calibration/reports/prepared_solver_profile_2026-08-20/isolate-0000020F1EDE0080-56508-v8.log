gth\x2C ivLength);\x0d\n  if (ret !== undefined) {\x0d\n    if (ret.name) ret.name = StringPrototypeToLowerCase(ret.name);\x0d\n    if (ret.type) ret.type = StringPrototypeToLowerCase(ret.type);\x0d\n  }\x0d\n  return ret;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  Cipher\x2C\x0d\n  Cipheriv\x2C\x0d\n  Decipher\x2C\x0d\n  Decipheriv\x2C\x0d\n  privateDecrypt\x2C\x0d\n  privateEncrypt\x2C\x0d\n  publicDecrypt\x2C\x0d\n  publicEncrypt\x2C\x0d\n  getCipherInfo\x2C\x0d\n};\x0d\n
