code-creation,Script,10,212502,0xe84b3f78a6,69, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/simulation-clock.js:1:1,0xe84b3f7498,~
script-source,152,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/simulation-clock.js,export const TICKS_PER_SECOND = 60;\x0d\n\x0d\nexport function secondsToTicksCeil(seconds) {\x0d\n  assertFiniteNonnegative(seconds\x2C "seconds");\x0d\n  const ticks = Math.ceil(seconds * TICKS_PER_SECOND);\x0d\n  if (!Number.isSafeInteger(ticks)) {\x0d\n    throw new RangeError("seconds must convert to a safe integer tick count");\x0d\n  }\x0d\n  return ticks;\x0d\n}\x0d\n\x0d\n// Animation timings arrive as float32 frame durations promoted to float64\x2C so\x0d\n// 45 frames of 1/30 s reads as 1.5000000782 s. Ceil would spend a whole extra\x0d\n// tick on that dust; nearest lands on the frame the game actually uses.\x0d\nexport function secondsToTicksNearest(seconds) {\x0d\n  assertFiniteNonnegative(seconds\x2C "seconds");\x0d\n  const ticks = Math.round(seconds * TICKS_PER_SECOND);\x0d\n  if (!Number.isSafeInteger(ticks)) {\x0d\n    throw new RangeError("seconds must convert to a safe integer tick count");\x0d\n  }\x0d\n  return ticks;\x0d\n}\x0d\n\x0d\nexport function ticksToSeconds(ticks) {\x0d\n  assertFiniteNonnegative(ticks\x2C "ticks");\x0d\n  if (!Number.isInteger(ticks)) {\x0d\n    throw new RangeError("ticks must be an integer");\x0d\n  }\x0d\n  return ticks / TICKS_PER_SECOND;\x0d\n}\x0d\n\x0d\nfunction assertFiniteNonnegative(value\x2C name) {\x0d\n  if (!Number.isFinite(value) || value < 0) {\x0d\n    throw new RangeError(`${name} must be finite and nonnegative`);\x0d\n  }\x0d\n}\x0d\n
