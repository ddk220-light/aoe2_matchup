script-source,153,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/targeting.js,function requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction centerDistance(a\x2C b) {\x0d\n  const dx = requireFinite(b?.x\x2C "target x") - requireFinite(a?.x\x2C "unit x");\x0d\n  const dy = requireFinite(b?.y\x2C "target y") - requireFinite(a?.y\x2C "unit y");\x0d\n  return Math.hypot(dx\x2C dy);\x0d\n}\x0d\n\x0d\n\x0d\nexport function collisionRadius(unit) {\x0d\n  const collisionSize = unit?.mechanics?.collision_size_tiles;\x0d\n  const x = requireFinite(collisionSize?.x\x2C "collision size x");\x0d\n  const y = requireFinite(collisionSize?.y\x2C "collision size y");\x0d\n  if (x <= 0 || y <= 0) {\x0d\n    throw new RangeError("collision size must be positive");\x0d\n  }\x0d\n  if (x !== y) {\x0d\n    throw new RangeError("deterministic circular collision requires equal x and y sizes");\x0d\n  }\x0d\n  return x;\x0d\n}\x0d\n\x0d\n\x0d\nexport function surfaceGap(a\x2C b) {\x0d\n  return centerDistance(a\x2C b) - collisionRadius(a) - collisionRadius(b);\x0d\n}\x0d\n\x0d\n\x0d\n// AoE2:DE lets a unit shrink its own obstruction when it bumps a FRIENDLY unit\x2C\x0d\n// so a crowd can close up instead of deadlocking. The shrink factor is a real\x0d\n// per-unit dat field (DeadFish.min_collision_size_multiplier = 0.8 here)\x2C and\x0d\n// the tapes show its three plateaus exactly: ally pairs pile up at 0.40 tiles\x0d\n// (0.20 + 0.20\x2C neither shrunk\x2C n=9954)\x2C then 0.36 (0.16 + 0.20\x2C one shrunk\x2C\x0d\n// n=2057)\x2C then 0.32 (0.16 + 0.16\x2C both shrunk\x2C n=195). Only 0.1% of samples\x0d\n// fall below 0.32. Enemies never shrink -- they hold 0.40 without exception.\x0d\nexport function allyCollisionRadius(unit) {\x0d\n  const multiplier = unit?.mechanics?.min_collision_size_multiplier;\x0d\n  if (!Number.isFinite(multiplier) || multiplier <= 0 || multiplier > 1) {\x0d\n    throw new RangeError("min collision size multiplier must be within (0\x2C 1]");\x0d\n  }\x0d\n  return collisionRadius(unit) * multiplier;\x0d\n}\x0d\n\x0d\n\x0d\n// Genie obstruction is an axis-aligned box\x2C not a circle. The authorized tapes\x0d\n// confirm it directly: across all 15 recordings enemy Champions never close\x0d\n// below a Chebyshev separation of 0.4000 tiles (= 0.2 + 0.2 half-extents)\x2C and\x0d\n// they reach that separation on whichever axis they approach from\x2C which a\x0d\n// Euclidean radius cannot produce.\x0d\nexport function chebyshevGap(a\x2C b) {\x0d\n  const dx = Math.abs(requireFinite(b?.x\x2C "target x") - requireFinite(a?.x\x2C "unit x"));\x0d\n  const dy = Math.abs(requireFinite(b?.y\x2C "target y") - requireFinite(a?.y\x2C "unit y"));\x0d\n  return Math.max(dx\x2C dy) - collisionRadius(a) - collisionRadius(b);\x0d\n}\x0d\n\x0d\n\x0d\n// Units do not act on the frame their order is issued. Pooled over the Champion\x0d\n// and Paladin recordings (n = 162 acquisitions) the first target is acquired\x0d\n// 0.952 s to 1.708 s after the start command\x2C and the two units agree on the\x0d\n// endpoints to within 4 ms (Champion 0.952/1.706\x2C Paladin 0.956/1.708; stdev\x0d\n// 0.221 vs 0.216). That makes this an ENGINE reaction lag\x2C not a unit stat.\x0d\nexport const ACQUISITION_DELAY_SECONDS = Object.freeze({ min: 0.952\x2C max: 1.708 });\x0d\n\x0d\n\x0d\n// Within one fight the per-unit delays are the ORDER STATISTICS of that range\x2C\x0d\n// not one shared value: a 9-unit fight spans 0.968-1.684 s. Modelling every\x0d\n// unit at the median collapsed a ~0.7 s stagger to zero\x2C and because a fight\x0d\n// ends when the LAST unit finishes\x2C that biased every recorded fight early --\x0d\n// 0.10-0.32 s in uncrowded ratios\x2C up to 1.24 s in crowded ones\x2C early in 9 of\x0d\n// 9 Champion-vs-Paladin ratios and never late.\x0d\n//\x0d\n// The expected i-th of n uniforms is min + i/(n+1) * (max - min). There are NO\x0d\n// free parameters here: the endpoints are measured and the rest is counting\x0d\n// units. Checked against 53 real acquisitions across both pairs\x2C mean error\x0d\n// +0.032 s\x2C mean absolute error 0.058 s.\x0d\n//\x0d\n// This is deterministic\x2C and is NOT the per-unit random jitter rejected\x0d\n// earlier. The one convention is WHICH unit takes which rank: the engine rolls\x0d\n// for that and a deterministic simulator cannot reproduce the roll\x2C so rank\x0d\n// follows reference ID. The stagger is measured; the assignment is a choice.\x0d\nexport function acquisitionDelaySeconds(rank\x2C count) {\x0d\n  if (!Number.isSafeInteger(count) || count < 1) {\x0d\n    throw new RangeError("acquisition count must be a positive safe integer");\x0d\n  }\x0d\n  if (!Number.isSafeInteger(rank) || rank < 0 || rank >= count) {\x0d\n    throw new RangeError("acquisition rank must be within the roster");\x0d\n  }\x0d\n  const { min\x2C max } = ACQUISITION_DELAY_SECONDS;\x0d\n  return min + ((rank + 1) / (count + 1)) * (max - min);\x0d\n}\x0d\n\x0d\n\x0d\n// Melee units swing from slightly outside box contact. Measured across the\x0d\n// authorized tapes: the attack envelope tops out at a Chebyshev separation of\x0d\n// 0.4999 tiles against a 0.4000 box contact\x2C i.e. 0.1 tiles of reach beyond\x0d\n// touching. This is MEASURED\x2C not sourced to a Genie field.\x0d\nexport const MELEE_CONTACT_TOLERANCE_TILES = 0.1;\x0d\n\x0d\n\x0d\n// Attack REACH is measured over the Genie OUTLINE box\x2C not the collision box.\x0d\n// The two coincide for the Champion (0.2/0.2) but not for the Paladin\x0d\n// (0.25 collision / 0.4 outline)\x2C the Battle Elephant (0.25/0.5)\x2C or the\x0d\n// Steppe Lancer (0.25/0.4)\x2C and the steppe tapes separate the two directly:\x0d\n// stationary units land swings from collision-box gaps far beyond\x0d\n// range + 0.1 (lancers at 1.33\x2C an elephant at 0.48)\x2C yet across all 2158\x0d\n// stationary swings in the three steppe archives the OUTLINE-box Chebyshev\x0d\n// gap never exceeds range + 0.1 (envelope tops: 1.0850 of 1.1 for the\x0d\n// range-1 lancer\x2C -0.05 of 0.1 for the Champion). Euclidean is refuted by\x0d\n// 30 diagonal-contact swings whose outline Euclidean gap exceeds the\x0d\n// threshold while the Chebyshev gap is inside it.\x0d\nexport function outlineRadius(unit) {\x0d\n  const outlineSize = unit?.mechanics?.outline_size_tiles;\x0d\n  const x = requireFinite(outlineSize?.x\x2C "outline size x");\x0d\n  const y = requireFinite(outlineSize?.y\x2C "outline size y");\x0d\n  if (x <= 0 || y <= 0) {\x0d\n    throw new RangeError("outline size must be positive");\x0d\n  }\x0d\n  if (x !== y) {\x0d\n    throw new RangeError("deterministic reach requires equal outline x and y sizes");\x0d\n  }\x0d\n  return x;\x0d\n}\x0d\n\x0d\n\x0d\nexport function outlineChebyshevGap(a\x2C b) {\x0d\n  const dx = Math.abs(requireFinite(b?.x\x2C "target x") - requireFinite(a?.x\x2C "unit x"));\x0d\n  const dy = Math.abs(requireFinite(b?.y\x2C "target y") - requireFinite(a?.y\x2C "unit y"));\x0d\n  return Math.max(dx\x2C dy) - outlineRadius(a) - outlineRadius(b);\x0d\n}\x0d\n\x0d\n\x0d\nfunction isLive(unit) {\x0d\n  return unit?.alive !== false;\x0d\n}\x0d\n\x0d\n\x0d\nfunction isEnemy(unit\x2C candidate) {\x0d\n  return candidate.referenceId !== unit.referenceId && candidate.owner !== unit.owner;\x0d\n}\x0d\n\x0d\n\x0d\nexport function selectPursuitTarget(unit\x2C snapshot\x2C {\x0d\n  targetLoadById = null\x2C\x0d\n  targetLoadPenaltyTiles = 0\x2C\x0d\n} = {}) {\x0d\n  if (!Array.isArray(snapshot)) throw new TypeError("snapshot must be an array");\x0d\n  if (!isLive(unit)) return null;\x0d\n  if (targetLoadById !== null && !(targetLoadById instanceof Map)) {\x0d\n    throw new TypeError("target load must be a Map");\x0d\n  }\x0d\n  if (!Number.isFinite(targetLoadPenaltyTiles) || targetLoadPenaltyTiles < 0) {\x0d\n    throw new RangeError("target load penalty must be nonnegative and finite");\x0d\n  }\x0d\n\x0d\n  if (unit.pursuitTargetId !== null && unit.pursuitTargetId !== undefined) {\x0d\n    const locked = snapshot.find(({ referenceId }) => (\x0d\n      referenceId === unit.pursuitTargetId\x0d\n    ));\x0d\n    if (locked && isLive(locked)) {\x0d\n      if (!isEnemy(unit\x2C locked)) {\x0d\n        throw new Error(`unit ${unit.referenceId} has a live friendly target`);\x0d\n      }\x0d\n      return locked;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const lineOfSight = requireFinite(\x0d\n    unit?.mechanics?.line_of_sight_tiles\x2C\x0d\n    "line of sight"\x2C\x0d\n  );\x0d\n  if (lineOfSight < 0) throw new RangeError("line of sight must be nonnegative");\x0d\n\x0d\n  let best = null;\x0d\n  let bestScore = Infinity;\x0d\n  for (const candidate of snapshot) {\x0d\n    if (!isLive(candidate) || !isEnemy(unit\x2C candidate)) continue;\x0d\n    if (centerDistance(unit\x2C candidate) > lineOfSight) continue;\x0d\n\x0d\n    const gap = surfaceGap(unit\x2C candidate);\x0d\n    const targetLoad = targetLoadById?.get(candidate.referenceId) ?? 0;\x0d\n    const score = gap + targetLoad * targetLoadPenaltyTiles;\x0d\n    if (\x0d\n      best === null ||\x0d\n      score < bestScore ||\x0d\n      // Ties are effectively unreachable and this branch is near-dead code:\x0d\n      // units acquire on a stagger\x2C so by the time any unit picks a target the\x0d\n      // others have been moving for a while and exact ties have dissolved.\x0d\n      // Measured in champion_vs_paladin 6v3: spawn positions put champions 1628\x0d\n      // and 1633 at an EXACT tie from paladin 1701 (2.2361 Euclidean\x2C 2.0000\x0d\n      // Chebyshev)\x2C but at 1701's actual acquisition moment the tape separates\x0d\n      // them 2.236 vs 2.019 and the sim 1.560 vs 1.957. Flipping this to\x0d\n      // highest-ID changed nothing anywhere\x2C in either direction.\x0d\n      //\x0d\n      // What decides the target is ACQUISITION ORDER\x2C not this tie-break.\x0d\n      (score === bestScore && candidate.referenceId < best.referenceId)\x0d\n    ) {\x0d\n      best = candidate;\x0d\n      bestScore = score;\x0d\n    }\x0d\n  }\x0d\n  return best;\x0d\n}\x0d\n\x0d\n\x0d\nexport function attackReach(unit) {\x0d\n  const range = requireFinite(unit?.mechanics?.attack_range_tiles\x2C "attack range");\x0d\n  if (range < 0) throw new RangeError("attack range must be nonnegative");\x0d\n  return range + MELEE_CONTACT_TOLERANCE_TILES;\x0d\n}\x0d\n\x0d\n\x0d\n// Attack ELIGIBILITY: outline boxes\x2C range + 0.1 (see outlineRadius). This is\x0d\n// deliberately wider than the movement stop rule (collision boxes\x2C\x0d\n// max(range\x2C 0.1) \u2014 isWithinStopRange in attacks.js): the tapes show units\x0d\n// walking well inside their own attack envelope before they stop\x2C and only\x0d\n// blocked or already-stopped units swinging from the outer envelope. That\x0d\n// split is what lets back-line Steppe Lancers fight over their front line.\x0d\n//\x0d\n// The distance METRIC splits on attack type. MELEE reach (range 0-1) is\x0d\n// Chebyshev over the outline boxes \u2014 30 diagonal-contact steppe swings sit at\x0d\n// outline-Euclidean 1.235 > 1.1 while Chebyshev is inside. PROJECTILE reach\x0d\n// is a Euclidean circle: across 6312 arbalester/skirmisher shots the maximum\x0d\n// fire distance is 8.56 = range 8 + 0.1 + both 0.2 outlines with formations\x0d\n// full of diagonal geometry \u2014 a Chebyshev rule at range 8 would show fire\x0d\n// distances beyond 11\x2C and none exist. (Box adjacency for arms' reach\x2C a\x0d\n// range circle for shots.)\x0d\nexport function isWithinReach(unit\x2C target) {\x0d\n  if (unit?.mechanics?.ranged) {\x0d\n    const distance = centerDistance(unit\x2C target);\x0d\n    // Minimum range (dat type_50.min_range): the scorpion tapes bottom out\x0d\n    // at fire distance 2.19 against its 2.0 -- center-to-center metric. A\x0d\n    // target inside it cannot be attacked (and is not an engagement\x0d\n    // candidate)\x2C which is what pushes the unit to prefer targets it can\x0d\n    // actually shoot.\x0d\n    const minRange = unit.mechanics.ranged.min_range_tiles ?? 0;\x0d\n    if (minRange > 0 && distance < minRange - 1e-12) return false;\x0d\n    const gap = distance - outlineRadius(unit) - outlineRadius(target);\x0d\n    return gap <= attackReach(unit) + 1e-12;\x0d\n  }\x0d\n  return outlineChebyshevGap(unit\x2C target) <= attackReach(unit) + 1e-12;\x0d\n}\x0d\n\x0d\n\x0d\n// A unit engages whatever enemy is inside its attack envelope\x2C not whatever\x0d\n// enemy its body happens to collide with: the tapes show units stopping and\x0d\n// swinging from ~0.1 tiles outside box contact\x2C so physical overlap is never\x0d\n// required and usually never happens. Where the sweep solver did produce a\x0d\n// contact for a pair it is preserved for ordering and reporting.\x0d\nexport function selectEngagementTarget(unit\x2C snapshot\x2C contacts) {\x0d\n  if (!Array.isArray(snapshot)) throw new TypeError("snapshot must be an array");\x0d\n  if (!Array.isArray(contacts)) throw new TypeError("contacts must be an array");\x0d\n  if (!isLive(unit)) return Object.freeze({ target: null\x2C contact: null });\x0d\n  const byReference = new Map(snapshot.map((candidate) => [candidate.referenceId\x2C candidate]));\x0d\n  const contactFor = (targetId) => contacts.find(({ leftId\x2C rightId }) => (\x0d\n    (leftId === unit.referenceId && rightId === targetId)\x0d\n    || (rightId === unit.referenceId && leftId === targetId)\x0d\n  )) ?? null;\x0d\n\x0d\n  if (unit.engagedTargetId !== null && unit.engagedTargetId !== undefined) {\x0d\n    const engaged = byReference.get(unit.engagedTargetId);\x0d\n    if (engaged && isLive(engaged) && isEnemy(unit\x2C engaged) && isWithinReach(unit\x2C engaged)) {\x0d\n      return Object.freeze({ target: engaged\x2C contact: contactFor(engaged.referenceId) });\x0d\n    }\x0d\n  }\x0d\n\x0d\n  const candidates = snapshot\x0d\n    .filter((candidate) => (\x0d\n      isLive(candidate) && isEnemy(unit\x2C candidate) && isWithinReach(unit\x2C candidate)\x0d\n    ))\x0d\n    .map((target) => ({\x0d\n      target\x2C\x0d\n      contact: contactFor(target.referenceId)\x2C\x0d\n      gap: chebyshevGap(unit\x2C target)\x2C\x0d\n    }))\x0d\n    .sort((left\x2C right) => (\x0d\n      (left.contact?.sweptToi ?? Infinity) - (right.contact?.sweptToi ?? Infinity)\x0d\n      || left.gap - right.gap\x0d\n      || left.target.referenceId - right.target.referenceId\x0d\n    ));\x0d\n  if (candidates.length === 0) return Object.freeze({ target: null\x2C contact: null });\x0d\n  const { target\x2C contact } = candidates[0];\x0d\n  return Object.freeze({ target\x2C contact });\x0d\n}\x0d\n
