= pairSeparation(mover\x2C front);\n  const projected = pairSeparation(mover\x2C front\x2C moverProposal\x2C frontProposal);\x0d\n  return projected < pairFullExtent(mover\x2C front) - EPSILON\x0d\n    && projected < current - EPSILON;\x0d\n}\x0d\n\x0d\nfunction euclideanDistance(unit\x2C target\x2C proposal = null) {\x0d\n  return Math.hypot(\x0d\n    target.x - unit.x - (proposal?.dx ?? 0)\x2C\x0d\n    target.y - unit.y - (proposal?.dy ?? 0)\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction untrackedReleaseCandidate(left\x2C right\x2C tick) {\x0d\n  const currentExtent = cleanNumber(pairSeparation(left\x2C right));\x0d\n  return Object.freeze({\x0d\n    key: pairKey(left.referenceId\x2C right.referenceId)\x2C\x0d\n    entryFraction: -1\x2C\x0d\n    projectedNormalizedDepth: cleanNumber(\x0d\n      Math.max(0\x2C pairFullExtent(left\x2C right) - currentExtent)\x0d\n        / pairFullExtent(left\x2C right)\x2C\x0d\n    )\x2C\x0d\n    progress: 0\x2C\x0d\n    reservation: releasingReservation({\x0d\n      left\x2C\x0d\n      right\x2C\x0d\n      collisionExtent: currentExtent\x2C\x0d\n      tick\x2C\x0d\n    })\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction alliedCandidate(left\x2C right\x2C proposals\x2C tick) {\x0d\n  const leftProposal = proposalFor(left\x2C proposals);\x0d\n  const rightProposal = proposalFor(right\x2C proposals);\x0d\n  if (!isMoving(leftProposal) && !isMoving(rightProposal)) return null;\x0d\n  const current = pairSeparation(left\x2C right);\x0d\n  const projected = pairSeparation(left\x2C right\x2C leftProposal\x2C rightProposal);\x0d\n  if (projected >= current - EPSILON) return null;\x0d\n  const fullExtent = pairFullExtent(left\x2C right);\x0d\n  const entryFraction = current < fullExtent - EPSILON\x0d\n    ? 0\x0d\n    : sweptEntryFraction(left\x2C right\x2C leftProposal\x2C rightProposal\x2C fullExtent);\x0d\n  if (entryFraction === null) return null;\x0d\n  const initiator = chooseInitiator(left\x2C right\x2C leftProposal\x2C rightProposal);\x0d\n  return makeCandidate({\x0d\n    left\x2C\x0d\n    right\x2C\x0d\n    initiator\x2C\x0d\n    target: null\x2C\x0d\n    kind: "allied-transit"\x2C\x0d\n    pathObstructs: false\x2C\x0d\n    entryFraction\x2C\x0d\n    projected\x2C\x0d\n    progress: stepLength(leftProposal) + stepLength(rightProposal)\x2C\x0d\n    tick\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction directEngagementCandidate(left\x2C right\x2C proposals\x2C tick) {\x0d\n  const directions = [\x0d\n    [left\x2C right]\x2C\x0d\n    [right\x2C left]\x2C\x0d\n  ].filter(([initiator\x2C target]) => isMelee(initiator) && directTarget(initiator\x2C target));\x0d\n  if (directions.length === 0) return null;\x0d\n  directions.sort(([leftInitiator]\x2C [rightInitiator]) => (\x0d\n    directTargetPriority(rightInitiator) - directTargetPriority(leftInitiator)\x0d\n      || leftInitiator.referenceId - rightInitiator.referenceId\x0d\n  ));\x0d\n  const [initiator\x2C target] = directions[0];\x0d\n  const leftProposal = proposalFor(left\x2C proposals);\x0d\n  const rightProposal = proposalFor(right\x2C proposals);\x0d\n  const current = pairSeparation(left\x2C right);\x0d\n  const projected = pairSeparation(left\x2C right\x2C leftProposal\x2C rightProposal);\x0d\n  const fullExtent = pairFullExtent(left\x2C right);\x0d\n  const entryFraction = current < fullExtent - EPSILON\x0d\n    ? 0\x0d\n    : sweptEntryFraction(left\x2C right\x2C leftProposal\x2C rightProposal\x2C fullExtent);\x0d\n  const closing = projected < current - EPSILON;\x0d\n  if (entryFraction === null || (!closing && current > fullExtent + EPSILON)) return null;\x0d\n  return makeCandidate({\x0d\n    left\x2C\x0d\n    right\x2C\x0d\n    initiator\x2C\x0d\n    target\x2C\x0d\n    kind: "engagement-contact"\x2C\x0d\n    pathObstructs: true\x2C\x0d\n    entryFraction\x2C\x0d\n    projected\x2C\x0d\n    progress: progressToward(initiator\x2C target\x2C proposalFor(initiator\x2C proposals))\x2C\x0d\n    tick\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction enemyCorridorCandidate(chaser\x2C blocker\x2C byReference\x2C proposals\x2C tick) {\x0d\n  if (!isMelee(chaser)) return null;\x0d\n  const target = directPursuitTarget(chaser\x2C byReference);\x0d\n  if (!target || target.referenceId === blocker.referenceId) return null;\x0d\n  const chaserProposal = proposalFor(chaser\x2C proposals);\x0d\n  if (!isMoving(chaserProposal)) return null;\x0d\n  const progress = progressToward(chaser\x2C target\x2C chaserProposal);\x0d\n  if (progress <= EPSILON) return null;\x0d\n  if (!insidePursuitCorridor(chaser\x2C blocker\x2C target)) return null;\x0d\n  const blockerProposal = proposalFor(blocker\x2C proposals);\x0d\n  const current = pairSeparation(chaser\x2C blocker);\x0d\n  const projected = pairSeparation(chaser\x2C blocker\x2C chaserProposal\x2C blockerProposal);\x0d\n  if (projected >= current - EPSILON) return null;\x0d\n  const fullExtent = pairFullExtent(chaser\x2C blocker);\x0d\n  const entryFraction = current < fullExtent - EPSILON\x0d\n    ? 0\x0d\n    : sweptEntryFraction(chaser\x2C blocker\x2C chaserProposal\x2C blockerProposal\x2C fullExtent);\x0d\n  if (entryFraction === null) return null;\x0d\n  return makeCandidate({\n    left: chaser\x2C\n    right: blocker\x2C\n    initiator: chaser\x2C\n    target\x2C\n    kind: "enemy-transit"\x2C\n    pathObstructs: false\x2C\n    entryFraction\x2C\x0d\n    projected\x2C\x0d\n    progress\x2C\x0d\n    tick\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction makeCandidate({\x0d\n  left\x2C\x0d\n  right\x2C\x0d\n  initiator\x2C\x0d\n  target\x2C\x0d\n  kind\x2C\x0d\n  pathObstructs\x2C\x0d\n  entryFraction\x2C\x0d\n  projected\x2C\x0d\n  progress\x2C\x0d\n  tick\x2C\x0d\n}) {\x0d\n  const [canonicalLeft\x2C canonicalRight] = left.referenceId < right.referenceId\x0d\n    ? [left\x2C right]\x0d\n    : [right\x2C left];\x0d\n  const fullExtent = pairFullExtent(left\x2C right);\n  const currentExtent = pairSeparation(left\x2C right);\n  const configuredFloor = movingFloor(left\x2C right);\n  const relativeClosure = Math.max(0\x2C currentExtent - projected);\n  // Enemy contact may consume the physical closure already proposed for this\n  // tick\x2C but it does not open a continuing lane toward the sourced deep-\n  // contact floor. This makes the contacted body part of the formation surface\n  // while preserving the brief pair compression visible in tape.\n  const enemyContactFloor = Math.max(\n    configuredFloor\x2C\n    fullExtent - relativeClosure\x2C\n  );\n  const holdsEnemySurface = kind === "engagement-contact";\n  // A ranged-ingress reservation is a temporary pass-through lane\x2C not a\n  // shrunken allied body. The rear shooter must be able to cross the front\n  // shooter's centerline before the monotonically releasing surface takes\n  // over; otherwise units whose DAT minimum multiplier is 1 (notably the\n  // Conquistador) acquire ingress but remain pinned at their full extent.\n  // Ordinary allied transit still uses the sourced moving floor.\n  const collisionExtent = kind === "ranged-ingress"\n    ? 0\n    : cleanNumber(Math.min(\n      holdsEnemySurface ? enemyContactFloor : configuredFloor\x2C\n      currentExtent\x2C\n    ));\n  const attackSurfaceExtent = kind === "engagement-contact"\x0d\n    ? fullExtent + attackRange(initiator)\x0d\n    : fullExtent;\x0d\n  return Object.freeze({\x0d\n    key: pairKey(left.referenceId\x2C right.referenceId)\x2C\x0d\n    entryFraction: cleanNumber(entryFraction)\x2C\x0d\n    projectedNormalizedDepth: cleanNumber(Math.max(0\x2C fullExtent - projected) / fullExtent)\x2C\x0d\n    progress: cleanNumber(progress)\x2C\x0d\n    reservation: Object.freeze({\x0d\n      leftId: canonicalLeft.referenceId\x2C\x0d\n      rightId: canonicalRight.referenceId\x2C\x0d\n      kind\x2C\x0d\n      collisionExtent\x2C\x0d\n      attackSurfaceExtent: cleanNumber(attackSurfaceExtent)\x2C\x0d\n      pathObstructs\x2C\x0d\n      mayDeepen: holdsEnemySurface\n        ? false\n        : currentExtent >= configuredFloor - EPSILON\x2C\n      initiatorId: initiator.referenceId\x2C\x0d\n      targetId: target?.referenceId ?? null\x2C\x0d\n      acquiredTick: tick\x2C\x0d\n    })\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction releasingReservation({ left\x2C right\x2C collisionExtent\x2C tick }) {\x0d\n  const [canonicalLeft\x2C canonicalRight] = left.referenceId < right.referenceId\x0d\n    ? [left\x2C right]\x0d\n    : [right\x2C left];\x0d\n  return Object.freeze({\x0d\n    leftId: canonicalLeft.referenceId\x2C\x0d\n    rightId: canonicalRight.referenceId\x2C\x0d\n    kind: "releasing"\x2C\x0d\n    collisionExtent\x2C\x0d\n    attackSurfaceExtent: pairFullExtent(left\x2C right)\x2C\x0d\n    pathObstructs: true\x2C\x0d\n    mayDeepen: false\x2C\x0d\n    initiatorId: null\x2C\x0d\n    targetId: null\x2C\x0d\n    acquiredTick: tick\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction reservationRemainsActive(prior\x2C left\x2C right\x2C byReference\x2C proposals) {\x0d\n  if (prior.kind === "allied-transit") {\x0d\n    if (left.owner !== right.owner) return false;\x0d\n  } else if (prior.kind === "ranged-ingress") {\n    if (left.owner !== right.owner || !isRanged(left) || !isRanged(right)) return false;\n    // The lane exists only while one shooter is physically behind the other\n    // and still advancing toward its target. Once it reaches/passes the front\n    // shooter\x2C publish the current shape as a monotonic release instead of\n    // letting the pair remain a zero-obstruction knot for the whole overlap.\n    return rangedIngressQualifies(left\x2C right\x2C byReference\x2C proposals)\n      || rangedIngressQualifies(right\x2C left\x2C byReference\x2C proposals);\n  } else if (left.owner === right.owner) {\x0d\n    return false;\x0d\n  }\x0d\n  const current = pairSeparation(left\x2C right);\x0d\n  const projected = pairSeparation(\x0d\n    left\x2C\x0d\n    right\x2C\x0d\n    proposalFor(left\x2C proposals)\x2C\x0d\n    proposalFor(right\x2C proposals)\x2C\x0d\n  );\x0d\n  if (prior.kind === "engagement-contact") {\n    const initiator = byReference.get(prior.initiatorId);\n    const target = byReference.get(prior.targetId);\n    return Boolean(initiator && target && isMelee(initiator)\n      && directTarget(initiator\x2C target)\n      && current <= prior.attackSurfaceExtent + EPSILON);\n  }\n  if (prior.kind === "enemy-transit") {\x0d\n    const initiator = byReference.get(prior.initiatorId);\x0d\n    const target = byReference.get(prior.targetId);\x0d\n    if (!initiator || !target || !isMelee(initiator)\x0d\n        || !directTarget(initiator\x2C target)) return false;\x0d\n  }\x0d\n  return (isMoving(proposalFor(left\x2C proposals)) || isMoving(proposalFor(right\x2C proposals)))\x0d\n    && (projected < current - EPSILON || current < pairFullExtent(left\x2C right) - EPSILON);\x0d\n}\x0d\n\x0d\nfunction compareCandidates(left\x2C right) {\x0d\n  return left.entryFraction - right.entryFraction\x0d\n    || left.projectedNormalizedDepth - right.projectedNormalizedDepth\x0d\n    || right.progress - left.progress\x0d\n    || left.key.localeCompare(right.key)\x0d\n    || left.reservation.initiatorId - right.reservation.initiatorId;\x0d\n}\x0d\n\x0d\nfunction directTarget(unit\x2C target) {\x0d\n  return unit.pursuitTargetId === target.referenceId\x0d\n    || unit.engagedTargetId === target.referenceId\x0d\n    || unit.attackTargetId === target.referenceId;\x0d\n}\x0d\n\x0d\nfunction directTargetPriority(unit) {\x0d\n  if (Number.isSafeInteger(unit.attackTargetId)) return 3;\x0d\n  if (Number.isSafeInteger(unit.engagedTargetId)) return 2;\x0d\n  if (Number.isSafeInteger(unit.pursuitTargetId)) return 1;\x0d\n  return 0;\x0d\n}\x0d\n\x0d\nfunction directPursuitTarget(unit\x2C byReference) {\x0d\n  for (const targetId of [unit.pursuitTargetId\x2C unit.engagedTargetId\x2C unit.attackTargetId]) {\x0d\n    const target = byReference.get(targetId);\x0d\n    if (target && target.owner !== unit.owner) return target;\x0d\n  }\x0d\n  return null;\x0d\n}\x0d\n\x0d\nfunction insidePursuitCorridor(chaser\x2C blocker\x2C target) {\x0d\n  if (blocker.owner === chaser.owner) return false;\x0d\n  const targetX = target.x - chaser.x;\x0d\n  const targetY = target.y - chaser.y;\x0d\n  const targetDistance = Math.hypot(targetX\x2C targetY);\x0d\n  if (targetDistance <= EPSILON) return false;\x0d\n  const unitX = targetX / targetDistance;\x0d\n  const unitY = targetY / targetDistance;\x0d\n  const blockerX = blocker.x - chaser.x;\x0d\n  const blockerY = blocker.y - chaser.y;\x0d\n  const forward = blockerX * unitX + blockerY * unitY;\x0d\n  const lateral = Math.abs(blockerX * unitY - blockerY * unitX);\x0d\n  return forward > EPSILON\x0d\n    && forward < targetDistance - EPSILON\x0d\n    && lateral <= pairFullExtent(chaser\x2C blocker) + EPSILON;\x0d\n}\x0d\n\x0d\nfunction progressToward(unit\x2C target\x2C proposal) {\x0d\n  if (!proposal) return 0;\x0d\n  const before = Math.hypot(target.x - unit.x\x2C target.y - unit.y);\x0d\n  const after = Math.hypot(\x0d\n    target.x - unit.x - proposal.dx\x2C\x0d\n    target.y - unit.y - proposal.dy\x2C\x0d\n  );\x0d\n  return Math.max(0\x2C before - after);\x0d\n}\x0d\n\x0d\nfunction chooseInitiator(left\x2C right\x2C leftProposal\x2C rightProposal) {\x0d\n  const leftStep = stepLength(leftProposal);\x0d\n  const rightStep = stepLength(rightProposal);\x0d\n  if (leftStep > rightStep + EPSILON) return left;\x0d\n  if (rightStep > leftStep + EPSILON) return right;\x0d\n  return left.referenceId < right.referenceId ? left : right;\x0d\n}\x0d\n\x0d\nfunction proposalFor(unit\x2C proposals) {\x0d\n  return proposals.get(unit.referenceId)\x0d\n    ?? Object.freeze({ referenceId: unit.referenceId\x2C dx: 0\x2C dy: 0 });\x0d\n}\x0d\n\x0d\nfunction pairSeparation(left\x2C right\x2C leftProposal = null\x2C rightProposal = null) {\x0d\n  return Math.max(\x0d\n    Math.abs(\x0d\n      right.x + (rightProposal?.dx ?? 0)\x0d\n        - left.x - (leftProposal?.dx ?? 0)\x2C\x0d\n    )\x2C\x0d\n    Math.abs(\x0d\n      right.y + (rightProposal?.dy ?? 0)\x0d\n        - left.y - (leftProposal?.dy ?? 0)\x2C\x0d\n    )\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction pairFullExtent(left\x2C right) {\x0d\n  return cleanNumber(collisionRadius(left) + collisionRadius(right));\x0d\n}\x0d\n\x0d\nfunction movingFloor(left\x2C right) {\x0d\n  return cleanNumber(\x0d\n    collisionRadius(left) * minimumMultiplier(left)\x0d\n      + collisionRadius(right) * minimumMultiplier(right)\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nfunction collisionRadius(unit) {\x0d\n  const radius = Math.max(\x0d\n    unit?.mechanics?.collision_size_tiles?.x ?? NaN\x2C\x0d\n    unit?.mechanics?.collision_size_tiles?.y ?? NaN\x2C\x0d\n  );\x0d\n  if (!Number.isFinite(radius) || radius < 0) {\x0d\n    throw new RangeError("collision radius must be finite and nonnegative");\x0d\n  }\x0d\n  return radius;\x0d\n}\x0d\n\x0d\nfunction minimumMultiplier(unit) {\x0d\n  const value = unit?.mechanics?.min_collision_size_multiplier;\x0d\n  if (!Number.isFinite(value) || value <= 0 || value > 1) {\x0d\n    throw new RangeError("minimum collision multiplier must be within (0\x2C 1]");\x0d\n  }\x0d\n  return value;\x0d\n}\x0d\n\x0d\nfunction attackRange(unit) {\x0d\n  const range = unit?.mechanics?.attack_range_tiles ?? 0;\x0d\n  if (!Number.isFinite(range) || range < 0) {\x0d\n    throw new RangeError("attack range must be finite and nonnegative");\x0d\n  }\x0d\n  return range;\x0d\n}\x0d\n\x0d\nfunction isMelee(unit) {\x0d\n  return unit?.mechanics?.ranged === undefined || unit.mechanics.ranged === null;\x0d\n}\x0d\n\x0d\nfunction isRanged(unit) {\x0d\n  return !isMelee(unit);\x0d\n}\x0d\n\x0d\nfunction isMoving(proposal) {\x0d\n  return stepLength(proposal) > EPSILON;\x0d\n}\x0d\n\x0d\nfunction sharedFormationOrder(left\x2C right) {\x0d\n  return left.owner === right.owner\x0d\n    && left.moveOrder !== undefined && left.moveOrder !== null\x0d\n    && right.moveOrder !== undefined && right.moveOrder !== null;\x0d\n}\x0d\n\x0d\nfunction stepLength(proposal) {\x0d\n  return proposal ? Math.hypot(proposal.dx\x2C proposal.dy) : 0;\x0d\n}\x0d\n\x0d\nfunction sweptEntryFraction(left\x2C right\x2C leftProposal\x2C rightProposal\x2C extent) {\x0d\n  const x = axisContactInterval(\x0d\n    right.x - left.x\x2C\x0d\n    rightProposal.dx - leftProposal.dx\x2C\x0d\n    extent\x2C\x0d\n  );\x0d\n  const y = axisContactInterval(\x0d\n    right.y - left.y\x2C\x0d\n    rightProposal.dy - leftProposal.dy\x2C\x0d\n    extent\x2C\x0d\n  );\x0d\n  if (!x || !y) return null;\x0d\n  const enter = Math.max(0\x2C x.enter\x2C y.enter);\x0d\n  const exit = Math.min(1\x2C x.exit\x2C y.exit);\x0d\n  return enter <= exit + EPSILON ? Math.max(0\x2C Math.min(1\x2C enter)) : null;\x0d\n}\x0d\n\x0d\nfunction axisContactInterval(start\x2C velocity\x2C extent) {\x0d\n  if (Math.abs(velocity) <= EPSILON) {\x0d\n    return Math.abs(start) <= extent + EPSILON\x0d\n      ? { enter: Number.NEGATIVE_INFINITY\x2C exit: Number.POSITIVE_INFINITY }\x0d\n      : null;\x0d\n  }\x0d\n  const first = (-extent - start) / velocity;\x0d\n  const second = (extent - start) / velocity;\x0d\n  return { enter: Math.min(first\x2C second)\x2C exit: Math.max(first\x2C second) };\x0d\n}\x0d\n\x0d\nfunction pairKey(leftId\x2C rightId) {\x0d\n  return leftId < rightId ? `${leftId}:${rightId}` : `${rightId}:${leftId}`;\x0d\n}\x0d\n\x0d\nfunction parsePairKey(key) {\x0d\n  const parts = String(key).split(":").map(Number);\x0d\n  if (parts.length !== 2 || parts.some((value) => !Number.isSafeInteger(value))) {\x0d\n    throw new Error(`invalid contact reservation pair key: ${key}`);\x0d\n  }\x0d\n  return parts;\x0d\n}\x0d\n\x0d\nfunction sortedEntries(map) {\x0d\n  return [...map.entries()].sort(([left]\x2C [right]) => left.localeCompare(right));\x0d\n}\x0d\n\x0d\nfunction diagnostic(type\x2C pair\x2C fields = {}) {\x0d\n  return Object.freeze({ type\x2C pairKey: pair\x2C ...fields });\x0d\n}\x0d\n\x0d\nfunction requireReferenceId(value\x2C name = "unit reference ID") {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\nfunction requireFinite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\nfunction cleanNumber(value) {\x0d\n  return Object.is(value\x2C -0) ? 0 : Math.round(value * 1e12) / 1e12;\x0d\n}\x0d\n
