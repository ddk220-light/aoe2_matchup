firedTick\x0d\n    || left.index - right.index\x0d\n  ));\x0d\n  for (const projectile of ordered) {\x0d\n    if (projectile.kind === "bolt") {\x0d\n      // Pass-through flight: advance one step\x2C damage every enemy whose\x0d\n      // collision box (expanded by the bolt's half width) contains the\x0d\n      // point\x2C once per victim\x2C never despawning on impact.\x0d\n      projectile.x += projectile.stepX;\x0d\n      projectile.y += projectile.stepY;\x0d\n      projectile.traveled += projectile.stepLength;\x0d\n      for (const victim of units) {\x0d\n        if (!victim.alive || victim.owner === projectile.actorOwner) continue;\x0d\n        if (projectile.hitIds.includes(victim.referenceId)) continue;\x0d\n        const dx = Math.abs(victim.x - projectile.x);\x0d\n        const dy = Math.abs(victim.y - projectile.y);\x0d\n        const reach = collisionRadius(victim) + projectile.halfWidth;\x0d\n        if (Math.max(dx\x2C dy) > reach + 1e-9) continue;\x0d\n        projectile.hitIds.push(victim.referenceId);\x0d\n        const full = calculateDamage({ mechanics: projectile.actorMechanics }\x2C victim);\x0d\n        const amount = victim.referenceId === projectile.targetId\x0d\n          ? full\x0d\n          : PASS_THROUGH_DAMAGE_FRACTION * full;\x0d\n        applyCommittedDamage(units\x2C projectile.actorId\x2C victim\x2C amount\x2C\x0d\n          tick\x2C tick\x2C events\x2C\x0d\n          { kind: "bolt-projectile"\x2C projectileIndex: projectile.hitIds.length - 1 });\x0d\n      }\x0d\n      if (projectile.traveled < projectile.totalDistance - 1e-9) {\x0d\n        remaining.push(projectile);\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (projectile.kind === "ranged") {\x0d\n      // Physical point flight: advance one step along the line\x2C hit the\x0d\n      // moment the target's collision box contains the point. Steps (7/60 =\x0d\n      // 0.117 tiles) are smaller than any collision box\x2C so nothing tunnels.\x0d\n      projectile.x += projectile.stepX;\x0d\n      projectile.y += projectile.stepY;\x0d\n      projectile.traveled += projectile.stepLength;\x0d\n      const target = byReference.get(projectile.targetId);\x0d\n      if (target?.alive) {\x0d\n        const dx = Math.abs(target.x - projectile.x);\x0d\n        const dy = Math.abs(target.y - projectile.y);\x0d\n        // The arrow is a body too: it lands when its own dat half width\x0d\n        // (projectile unit collision_size_x\x2C 0.1 for every archer projectile in\x0d\n        // the corpus) meets the victim's collision box -- the same rule the\x0d\n        // scorpion bolt already used. Measured on impact geometry: recorded\x0d\n        // arrows are last seen at a Chebyshev separation from the victim's\x0d\n        // centre whose p97 is 0.310 against champions (collision 0.20 -> 0.30)\x0d\n        // and 0.347 against heavy camels (collision 0.25 -> 0.35). The camel is\x0d\n        // the first victim in the corpus whose collision box differs from its\x0d\n        // outline\x2C which is why a bare-collision rule survived this long.\x0d\n        if (Math.max(dx\x2C dy) <= collisionRadius(target) + projectile.halfWidth + 1e-9) {\x0d\n          resolved.push(projectile);\x0d\n          continue;\x0d\n        }\x0d\n      }\x0d\n      // Expire at the aim point: the target died or left its box.\x0d\n      if (projectile.traveled < projectile.totalDistance - 1e-9\x0d\n          && tick < projectile.arrivalTick + 2) {\x0d\n        remaining.push(projectile);\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (projectile.kind === "stray") {\x0d\n      // Missed-accuracy shot: flies its scattered line and hits the FIRST\x0d\n      // enemy whose collision box contains the point \u2014 for HALF the\x0d\n      // per-victim class damage. Expires at the scattered aim point.\x0d\n      projectile.x += projectile.stepX;\x0d\n      projectile.y += projectile.stepY;\x0d\n      projectile.traveled += projectile.stepLength;\x0d\n      let struck = false;\x0d\n      for (const victim of units) {\x0d\n        if (!victim.alive || victim.owner === projectile.actorOwner) continue;\x0d\n        const dx = Math.abs(victim.x - projectile.x);\x0d\n        const dy = Math.abs(victim.y - projectile.y);\x0d\n        if (Math.max(dx\x2C dy) > collisionRadius(victim) + 1e-9) continue;\x0d\n        const full = calculateDamage({ mechanics: projectile.actorMechanics }\x2C victim);\x0d\n        applyCommittedDamage(units\x2C projectile.actorId\x2C victim\x2C\x0d\n          Math.max(1\x2C MISS_DAMAGE_FRACTION * full)\x2C tick\x2C tick\x2C events\x2C\x0d\n          { kind: "stray-projectile"\x2C projectileIndex: 0 });\x0d\n        struck = true;\x0d\n        break;\x0d\n      }\x0d\n      if (!struck && projectile.traveled < projectile.totalDistance - 1e-9\x0d\n          && tick < projectile.arrivalTick + 2) {\x0d\n        remaining.push(projectile);\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (projectile.kind === "shell") {\x0d\n      // Mangonel-family primary: arcs to the aim point and explodes on\x0d\n      // arrival. Everything (BOTH owners \u2014 dat friendly_fire 1.0) inside the\x0d\n      // blast radius takes the per-victim class damage\x2C full when the impact\x0d\n      // point is inside the victim's box\x2C linearly tapered to the edge\x0d\n      // otherwise\x2C floored at 1.\x0d\n      if (projectile.arrivalTick > tick) {\x0d\n        remaining.push(projectile);\x0d\n        continue;\x0d\n      }\x0d\n      for (const victim of units) {\x0d\n        if (!victim.alive || victim.referenceId === projectile.actorId) continue;\x0d\n        const dx = Math.abs(victim.x - projectile.aimX);\x0d\n        const dy = Math.abs(victim.y - projectile.aimY);\x0d\n        const inBox = Math.max(dx\x2C dy) <= collisionRadius(victim) + 1e-9;\x0d\n        const centerDistance = Math.hypot(dx\x2C dy);\x0d\n        if (!inBox && centerDistance > projectile.blastRadius + 1e-9) continue;\x0d\n        const fraction = inBox\x0d\n          ? 1\x0d\n          : Math.max(0\x2C 1 - centerDistance / projectile.blastRadius);\x0d\n        const full = calculateDamage({ mechanics: projectile.actorMechanics }\x2C victim);\x0d\n        applyCommittedDamage(units\x2C projectile.actorId\x2C victim\x2C\x0d\n          Math.max(1\x2C fraction * full)\x2C tick\x2C tick\x2C events\x2C\x0d\n          { kind: "shell-projectile"\x2C projectileIndex: 0 });\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (projectile.kind === "pebble") {\x0d\n      // Visual secondary (empty dat attack list): lands scattered over the\x0d\n      // spawning area; anything whose box contains the landing point takes\x0d\n      // the floor 1 damage.\x0d\n      if (projectile.arrivalTick > tick) {\x0d\n        remaining.push(projectile);\x0d\n        continue;\x0d\n      }\x0d\n      for (const victim of units) {\x0d\n        if (!victim.alive || victim.referenceId === projectile.actorId) continue;\x0d\n        const dx = Math.abs(victim.x - projectile.aimX);\x0d\n        const dy = Math.abs(victim.y - projectile.aimY);\x0d\n        if (Math.max(dx\x2C dy) > collisionRadius(victim) + 1e-9) continue;\x0d\n        applyCommittedDamage(units\x2C projectile.actorId\x2C victim\x2C 1\x2C\x0d\n          tick\x2C tick\x2C events\x2C\x0d\n          { kind: "pebble-projectile"\x2C projectileIndex: projectile.index });\x0d\n      }\x0d\n      continue;\x0d\n    }\x0d\n    if (projectile.arrivalTick > tick) {\x0d\n      remaining.push(projectile);\x0d\n      continue;\x0d\n    }\x0d\n    const target = byReference.get(projectile.targetId);\x0d\n    if (!target?.alive) continue;\x0d\n    resolved.push(projectile);\x0d\n  }\x0d\n  for (const projectile of resolved) {\x0d\n    const target = byReference.get(projectile.targetId);\x0d\n    if (!target?.alive) continue;\x0d\n    applyCommittedDamage(units\x2C projectile.actorId\x2C target\x2C projectile.amount\x2C\x0d\n      tick\x2C tick\x2C events\x2C {\x0d\n        kind: projectile.kind === "ranged" ? "ranged-projectile" : "charge-projectile"\x2C\x0d\n        projectileIndex: projectile.index\x2C\x0d\n      });\x0d\n  }\x0d\n  return remaining;\x0d\n}\x0d\n\x0d\n\x0d\nfunction applyCommittedDamage(units\x2C actorId\x2C target\x2C amount\x2C readyTick\x2C tick\x2C events\x2C extra) {\x0d\n  const hpBefore = target.hp;\x0d\n  const hpAfter = Math.max(0\x2C hpBefore - amount);\x0d\n  target.hp = hpAfter;\x0d\n  events.push(createDamageEvent({\x0d\n    tick\x2C\x0d\n    actorId\x2C\x0d\n    targetId: target.referenceId\x2C\x0d\n    readyTick\x2C\x0d\n    amount\x2C\x0d\n    hpBefore\x2C\x0d\n    hpAfter\x2C\x0d\n    ...(extra ?? {})\x2C\x0d\n  }));\x0d\n  if (hpAfter > 0) return;\x0d\n\x0d\n  target.alive = false;\x0d\n  target.pursuitTargetId = null;\x0d\n  target.engagedTargetId = null;\x0d\n  target.attackTargetId = null;\x0d\n  target.avoidance = null;\x0d\n  target.action = "dead";\x0d\n  target.actionTimers = { windup: 0\x2C reload: 0\x2C swing: 0\x2C acquire: 0 };\x0d\n  events.push(createDeathEvent({\x0d\n    tick\x2C\x0d\n    actorId\x2C\x0d\n    targetId: target.referenceId\x2C\x0d\n    readyTick\x2C\x0d\n  }));\x0d\n  for (const engaged of units) {\x0d\n    if (!engaged.alive || engaged.engagedTargetId !== target.referenceId) continue;\x0d\n    engaged.engagedTargetId = null;\x0d\n    events.push(event(\x0d\n      tick\x2C\x0d\n      "engagement-ended"\x2C\x0d\n      engaged.referenceId\x2C\x0d\n      target.referenceId\x2C\x0d\n      { reason: "target-dead" }\x2C\x0d\n    ));\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nexport function stepWorld(world) {\x0d\n  if (!world || typeof world !== "object") throw new TypeError("world is required");\x0d\n  const tick = world.tick + 1;\x0d\n  const events = [];\x0d\n\x0d\n  const snapshot = Object.freeze([...world.units]);\x0d\n  const units = snapshot.map(mutableUnit);\x0d\n  validatePursuitTargets(units\x2C tick\x2C events);\x0d\n  validateAttackTargets(\x0d\n    units\x2C\x0d\n    tick\x2C\x0d\n    events\x2C\x0d\n    world.rangedWindupRetargetOwner ?? null\x2C\x0d\n  );\x0d\n  acquirePursuitTargets(\x0d\n    units\x2C\x0d\n    tick\x2C\x0d\n    events\x2C\x0d\n    world.kiteState ?? null\x2C\n    world.rangedTargetPressureOwner ?? null\x2C\n    world.rangedOpportunityRetargetOwner ?? null\x2C\n  );\n  issueKiteOrders(world.kiteState\x2C units\x2C world.map\x2C tick\x2C events\x2C event);\x0d\n  // Melee chase tapes carry a single opening wave and then rely on unit AI\x2C\n  // so their ordinary player-order layer stays down. Ranged opponents retain\n  // their ordinary AI orders while the commanded owner is excluded from that\n  // layer and driven by the shoot-and-move controller.\n  if (!world.kiteState || world.kiteState.opponentMode === "ordinary-ranged") {\n    issueOrders(\n      world.orderState\x2C\n      units\x2C\n      tick\x2C\n      events\x2C\n      event\x2C\n      world.kiteState?.owner ?? null\x2C\n    );\n  }\n  const {\x0d\n    contacts\x2C\x0d\n    movedIds\x2C\x0d\n    blockedIds\x2C\x0d\n    velocities\x2C\x0d\n    contactUpdate\x2C\x0d\n    pairInteractions\x2C\x0d\n  } = moveUnits(\x0d\n    units\x2C\x0d\n    world.map\x2C\x0d\n    tick\x2C\x0d\n    events\x2C\x0d\n    world.kiteState ?? null\x2C\x0d\n    world.contactReservationState ?? null\x2C\x0d\n    world.contactSteeringStates ?? new Map()\x2C\x0d\n  );\x0d\n  updateEngagements(\x0d\n    units\x2C\x0d\n    contacts\x2C\x0d\n    tick\x2C\x0d\n    events\x2C\x0d\n    blockedIds\x2C\x0d\n    world.kiteState ?? null\x2C\x0d\n    pairInteractions\x2C\x0d\n  );\x0d\n  // Clone flight state: published projectiles are frozen\x2C ranged shots\x0d\n  // advance their position every tick\x2C and a bolt's hit list must not alias\x0d\n  // the previous tick's published array.\x0d\n  const projectiles = world.projectiles\x0d\n    ? world.projectiles.map((projectile) => ({\x0d\n      ...projectile\x2C\x0d\n      ...(projectile.hitIds ? { hitIds: [...projectile.hitIds] } : {})\x2C\x0d\n    }))\x0d\n    : null;\x0d\n  const ready = progressAttacks(units\x2C tick\x2C events\x2C movedIds\x2C projectiles\x2C\x0d\n    velocities\x2C world.shotRng ?? null);\x0d\n  commitReadyAttacks(units\x2C ready\x2C tick\x2C events);\x0d\n  const remainingProjectiles = projectiles\x0d\n    ? processChargeProjectiles(units\x2C projectiles\x2C tick\x2C events)\x0d\n    : null;\x0d\n\x0d\n  const publishedUnits = canonicalUnits(units);\x0d\n  const publishedEvents = Object.freeze(events);\x0d\n  const eventLog = Object.freeze([...world.eventLog\x2C ...publishedEvents]);\x0d\n  const snapshots = Object.freeze([\x0d\n    ...world.snapshots\x2C\x0d\n    createSnapshot(tick\x2C publishedUnits\x2C publishedEvents\x2C\x0d\n      soloNavigationSnapshot(world.kiteState?.soloNavigationState))\x2C\x0d\n  ]);\x0d\n  return Object.freeze({\x0d\n    ...world\x2C\x0d\n    ...(contactUpdate ? {\x0d\n      contactReservationState: contactUpdate.state\x2C\x0d\n      contactReservationDiagnostics: contactUpdate.diagnostics\x2C\x0d\n    } : {})\x2C\x0d\n    ...(remainingProjectiles !== null\x0d\n      ? { projectiles: Object.freeze(remainingProjectiles.map((p) => Object.freeze({ ...p }))) }\x0d\n      : {})\x2C\x0d\n    tick\x2C\x0d\n    units: publishedUnits\x2C\x0d\n    events: publishedEvents\x2C\x0d\n    eventLog\x2C\x0d\n    snapshots\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction outcome(world) {\x0d\n  const liveOwners = new Set(\x0d\n    world.units.filter(({ alive }) => alive).map(({ owner }) => owner)\x2C\x0d\n  );\x0d\n  if (liveOwners.size === 0) {\x0d\n    throw new Error(`invalid terminal world at tick ${world.tick}: no live owners`);\x0d\n  }\x0d\n  if (liveOwners.size > 1) return null;\x0d\n  const [winner] = liveOwners;\x0d\n  return Object.freeze({\x0d\n    outcome: "win"\x2C\x0d\n    winner\x2C\x0d\n    ticks: world.tick\x2C\x0d\n    world\x2C\x0d\n    snapshots: world.snapshots\x2C\x0d\n    events: world.eventLog\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport function runWorld(\x0d\n  world\x2C\x0d\n  { maxTicks = DEFAULT_WORLD_TICKS\x2C retainSnapshots = true } = {}\x2C\x0d\n) {\x0d\n  if (!Number.isSafeInteger(maxTicks) || maxTicks < 0) {\x0d\n    throw new RangeError("max ticks must be a nonnegative safe integer");\x0d\n  }\x0d\n  if (maxTicks > MAX_WORLD_TICKS) {\x0d\n    throw new RangeError(`max ticks must not exceed ${MAX_WORLD_TICKS}`);\x0d\n  }\x0d\n  if (typeof retainSnapshots !== "boolean") {\x0d\n    throw new TypeError("retainSnapshots must be a boolean");\x0d\n  }\x0d\n\x0d\n  if (retainSnapshots) {\x0d\n    let current = world;\x0d\n    const initialOutcome = outcome(current);\x0d\n    if (initialOutcome !== null) return initialOutcome;\x0d\n    for (let elapsed = 0; elapsed < maxTicks; elapsed += 1) {\x0d\n      current = stepWorld(current);\x0d\n      const result = outcome(current);\x0d\n      if (result !== null) return result;\x0d\n    }\x0d\n    const error = new Error(`world exceeded ${maxTicks} ticks`);\x0d\n    error.world = current;\x0d\n    throw error;\x0d\n  }\x0d\n\x0d\n  const collectedEvents = [...world.eventLog];\x0d\n  const emptySnapshots = Object.freeze([]);\x0d\n  const emptyEventLog = Object.freeze([]);\x0d\n  const compactWorld = (current\x2C eventLog = emptyEventLog) => Object.freeze({\x0d\n    ...current\x2C\x0d\n    eventLog\x2C\x0d\n    snapshots: emptySnapshots\x2C\x0d\n  });\x0d\n  const compactResult = (result\x2C current) => {\x0d\n    const eventLog = Object.freeze([...collectedEvents]);\x0d\n    const publishedWorld = compactWorld(current\x2C eventLog);\x0d\n    return Object.freeze({\x0d\n      ...result\x2C\x0d\n      world: publishedWorld\x2C\x0d\n      snapshots: emptySnapshots\x2C\x0d\n      events: eventLog\x2C\x0d\n    });\x0d\n  };\x0d\n\x0d\n  let current = world;\x0d\n  const initialOutcome = outcome(current);\x0d\n  if (initialOutcome !== null) return compactResult(initialOutcome\x2C current);\x0d\n  current = compactWorld(current);\x0d\n  for (let elapsed = 0; elapsed < maxTicks; elapsed += 1) {\x0d\n    current = stepWorld(current);\x0d\n    collectedEvents.push(...current.events);\x0d\n    const result = outcome(current);\x0d\n    if (result !== null) return compactResult(result\x2C current);\x0d\n    current = compactWorld(current);\x0d\n  }\x0d\n  const error = new Error(`world exceeded ${maxTicks} ticks`);\x0d\n  error.events = Object.freeze([...collectedEvents]);\x0d\n  error.world = compactWorld(current\x2C error.events);\x0d\n  throw error;\x0d\n}\x0d\n
