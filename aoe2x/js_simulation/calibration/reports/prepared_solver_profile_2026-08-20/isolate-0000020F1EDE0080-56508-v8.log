script-source,145,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/kite-timing.js,import { TICKS_PER_SECOND } from "../simulation-clock.js";\x0d\n\x0d\n\x0d\nexport const KITE_ORDER_CLOCK_TICKS = 40;\x0d\nexport const KITE_MOVE_INTERVAL_TICKS = 2 * KITE_ORDER_CLOCK_TICKS;\x0d\nconst EMPTY_KITE_SCENARIO_POLICY = Object.freeze({});\x0d\n\x0d\n\x0d\nfunction finite(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction positiveInteger(value\x2C name) {\x0d\n  if (!Number.isSafeInteger(value) || value <= 0) {\x0d\n    throw new RangeError(`${name} must be a positive integer`);\x0d\n  }\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction integerList(value\x2C name) {\x0d\n  if (!Array.isArray(value)\x0d\n      || value.some((tick) => !Number.isSafeInteger(tick) || tick <= 0)) {\x0d\n    throw new RangeError(`${name} must contain positive integers`);\x0d\n  }\x0d\n  return [...value];\x0d\n}\x0d\n\x0d\n\x0d\nfunction ceilToGrid(ticks\x2C grid) {\x0d\n  return Math.ceil(ticks / grid) * grid;\x0d\n}\x0d\n\x0d\n\x0d\nfunction mechanicsTicks(mechanics) {\x0d\n  const reloadSeconds = finite(mechanics?.reload_seconds\x2C "reload_seconds");\x0d\n  const attackDelaySeconds = finite(\x0d\n    mechanics?.attack_delay_seconds\x2C\x0d\n    "attack_delay_seconds"\x2C\x0d\n  );\x0d\n  if (reloadSeconds <= 0) throw new RangeError("reload_seconds must be positive");\x0d\n  if (attackDelaySeconds < 0) {\x0d\n    throw new RangeError("attack_delay_seconds must be non-negative");\x0d\n  }\x0d\n  return {\x0d\n    reload: Math.ceil(reloadSeconds * TICKS_PER_SECOND - 1e-9)\x2C\x0d\n    release: Math.round(attackDelaySeconds * TICKS_PER_SECOND)\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\n\x0d\nfunction recurringMoveOffsets(firstBeatTick\x2C beatTicks\x2C releaseTicks) {\x0d\n  let firstOffset = ceilToGrid(releaseTicks\x2C KITE_ORDER_CLOCK_TICKS);\x0d\n\x0d\n  // An opening attack outside the ordinary 40-tick order grid (the measured\x0d\n  // Hand Cannoneer tick-12 volley) rejoins the shared 80-tick movement lane.\x0d\n  // This yields absolute movement orders at 80/160/240 without giving that\x0d\n  // unit a separately calibrated recurring clock.\x0d\n  if (firstBeatTick % KITE_ORDER_CLOCK_TICKS !== 0) {\x0d\n    const readyTick = firstBeatTick + releaseTicks;\x0d\n    firstOffset = ceilToGrid(readyTick\x2C KITE_MOVE_INTERVAL_TICKS) - firstBeatTick;\x0d\n  }\x0d\n  if (firstOffset <= 0) firstOffset = KITE_ORDER_CLOCK_TICKS;\x0d\n\x0d\n  const offsets = [];\x0d\n  for (let offset = firstOffset; offset < beatTicks; offset += KITE_MOVE_INTERVAL_TICKS) {\x0d\n    offsets.push(offset);\x0d\n  }\x0d\n  return offsets;\x0d\n}\x0d\n\x0d\n\x0d\n/**\x0d\n * Derive the recurring kiting schedule from unit mechanics.\x0d\n *\x0d\n * `policy` contains only AI choices that mechanics cannot answer: an unusual\x0d\n * opening attack phase\x2C an optional bookkeeping top-up\x2C and formation/action\x0d\n * policies. It never supplies the recurring reload beat or move offsets.\x0d\n */\x0d\nexport function deriveKiteProfile(mechanics\x2C policy = {}) {\x0d\n  const ticks = mechanicsTicks(mechanics);\x0d\n  const beatTicks = ceilToGrid(ticks.reload\x2C KITE_ORDER_CLOCK_TICKS);\x0d\n  const firstBeatTick = policy.firstBeatTick === undefined\x0d\n    ? beatTicks\x0d\n    : positiveInteger(policy.firstBeatTick\x2C "firstBeatTick");\x0d\n  const topupOffsetTicks = policy.topupOffsetTicks === undefined\x0d\n    ? []\x0d\n    : integerList(policy.topupOffsetTicks\x2C "topupOffsetTicks");\x0d\n  if (topupOffsetTicks.some((tick) => tick >= beatTicks)) {\x0d\n    throw new RangeError("topupOffsetTicks must fall inside the recurring beat");\x0d\n  }\x0d\n\x0d\n  const profile = {\x0d\n    beatTicks\x2C\x0d\n    firstBeatTick\x2C\x0d\n    moveOffsetTicks: recurringMoveOffsets(firstBeatTick\x2C beatTicks\x2C ticks.release)\x2C\x0d\n    topupOffsetTicks\x2C\x0d\n    preMoveTicks: firstBeatTick >= beatTicks\x0d\n      ? Array.from(\x0d\n        { length: Math.max(0\x2C Math.ceil((firstBeatTick - KITE_MOVE_INTERVAL_TICKS)\x0d\n          / KITE_MOVE_INTERVAL_TICKS)) }\x2C\x0d\n        (_\x2C index) => (index + 1) * KITE_MOVE_INTERVAL_TICKS\x2C\x0d\n      ).filter((tick) => tick < firstBeatTick)\x0d\n      : []\x2C\x0d\n  };\x0d\n  if (policy.openingVolleyTick !== undefined) {\x0d\n    profile.openingVolleyTick = positiveInteger(\x0d\n      policy.openingVolleyTick\x2C\x0d\n      "openingVolleyTick"\x2C\x0d\n    );\x0d\n  }\x0d\n  for (const key of [\x0d\n    "formationMotion"\x2C\x0d\n    "volleyPursuit"\x2C\x0d\n    "openingVolley"\x2C\x0d\n    "kitedPath"\x2C\x0d\n    "cohortMotion"\x2C\x0d\n    "meleeWave"\x2C\x0d\n  ]) {\x0d\n    if (policy[key] !== undefined) profile[key] = policy[key];\x0d\n  }\x0d\n  if (Number.isFinite(policy.formationSpacingTiles)\x0d\n      && policy.formationSpacingTiles > 0) {\x0d\n    profile.formationSpacingTiles = policy.formationSpacingTiles;\x0d\n  }\x0d\n  return Object.freeze({\x0d\n    ...profile\x2C\x0d\n    moveOffsetTicks: Object.freeze(profile.moveOffsetTicks)\x2C\x0d\n    topupOffsetTicks: Object.freeze(profile.topupOffsetTicks)\x2C\x0d\n    preMoveTicks: Object.freeze(profile.preMoveTicks)\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nexport const KITE_POLICIES = Object.freeze({\x0d\n  elite_war_wagon: Object.freeze({\x0d\n    // The 0.9-tile War Wagon bodies march on a 0.6-tile lattice in all eight\x0d\n    // authorized Paladin/Champion recordings: conditional allied overlap\x0d\n    // depth centers at ~0.30 tiles. Cohesive navigation consumes this same\x0d\n    // profile value\x2C so it no longer collapses them back onto the generic\x0d\n    // 0.48-tile ranged lattice.\x0d\n    formationSpacingTiles: 0.6\x2C\x0d\n  })\x2C\x0d\n  heavy_cav_archer: Object.freeze({\x0d\n    firstBeatTick: 40\x2C\x0d\n    topupOffsetTicks: Object.freeze([40])\x2C\x0d\n  })\x2C\x0d\n  hand_cannoneer: Object.freeze({\x0d\n    firstBeatTick: 12\x2C\x0d\n    formationMotion: "translated_offsets"\x2C\x0d\n    volleyPursuit: "close_to_fire"\x2C\x0d\n  })\x2C\x0d\n});\x0d\n\x0d\n\x0d\nexport function kitePolicyFor(slug) {\x0d\n  return KITE_POLICIES[slug] ?? Object.freeze({});\x0d\n}\x0d\n\x0d\n\x0d\nexport function warWagonChasePolicy(kiterSlug\x2C chaserMechanics) {\x0d\n  if (kiterSlug !== "elite_war_wagon") return EMPTY_KITE_SCENARIO_POLICY;\x0d\n  const radiusX = finite(\x0d\n    chaserMechanics?.collision_size_tiles?.x\x2C\x0d\n    "chaser collision size x"\x2C\x0d\n  );\x0d\n  const radiusY = finite(\x0d\n    chaserMechanics?.collision_size_tiles?.y\x2C\x0d\n    "chaser collision size y"\x2C\x0d\n  );\x0d\n  if (radiusX <= 0 || radiusY <= 0 || radiusX !== radiusY) {\x0d\n    throw new RangeError("War Wagon chase contact requires a positive square chaser body");\x0d\n  }\x0d\n  return Object.freeze({\x0d\n    attackMoveTargetPressureTiles: 2 * radiusX\x2C\x0d\n    attackMoveStickyPursuit: true\x2C\x0d\n  });\x0d\n}\x0d\n
