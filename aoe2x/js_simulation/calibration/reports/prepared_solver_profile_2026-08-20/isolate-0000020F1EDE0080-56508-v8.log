script-source,151,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/unit-registry.js,// The units this simulator can run: one row per tape-measured mechanics\x0d\n// fixture. `class` drives three things -- which side kites\x2C how far apart the\x0d\n// two armies start (see placement.resolveFamily)\x2C and which side is normalised\x0d\n// to owner 2 in the two role-asymmetric families (see fight.js).\x0d\n//\x0d\n// A `mobile_ranged` row needs no extra field to reach its script cycle: SLUG\x0d\n// is the key. kite-profiles.js (generated by tools/derive_kite_profiles.py\x0d\n// from the recorded kiting fixtures) is keyed by exactly these slugs\x2C and\x0d\n// tests/kite-profiles.test.mjs asserts every mobile_ranged slug has a row --\x0d\n// so adding a kiter here without deriving its profile fails loudly instead of\x0d\n// silently inheriting somebody else's cadence.\x0d\n//\x0d\n// baseCost is ref_units.base_cost_* from data/golden/aoe2_reference.db\x2C the\x0d\n// same database the website serves. It is deliberately the BASE column\x2C not\x0d\n// final_cost_*: the purchase rule buys at dat base prices\x2C so a Berbers Hussar\x0d\n// costs 80 here even though the civ bonus makes it 64 in game. Regenerate the\x0d\n// numbers with tools/export_unit_costs.py.\x0d\nconst ROWS = [\x0d\n  { slug: "arbalester"\x2C label: "Arbalester"\x2C civ: "Chinese"\x2C master: 492\x2C\x0d\n    fixture: "arbalester_chinese_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 25\x2C gold: 45 } }\x2C\x0d\n  { slug: "champion"\x2C label: "Champion"\x2C civ: "Chinese"\x2C master: 567\x2C\x0d\n    fixture: "champion_chinese_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 50\x2C wood: 0\x2C gold: 20 } }\x2C\x0d\n  { slug: "elite_elephant"\x2C label: "Elite Battle Elephant"\x2C civ: "Burmese"\x2C master: 1134\x2C\x0d\n    fixture: "elite_battle_elephant_burmese_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 100\x2C wood: 0\x2C gold: 70 } }\x2C\x0d\n  { slug: "elite_fire_lancer"\x2C label: "Elite Fire Lancer"\x2C civ: "Chinese"\x2C master: 1903\x2C\x0d\n    fixture: "elite_fire_lancer_chinese_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 45\x2C gold: 45 } }\x2C\x0d\n  { slug: "elite_steppe"\x2C label: "Elite Steppe Lancer"\x2C civ: "Cumans"\x2C master: 1372\x2C\x0d\n    fixture: "elite_steppe_lancer_cumans_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 70\x2C wood: 0\x2C gold: 40 } }\x2C\x0d\n  { slug: "halberdier"\x2C label: "Halberdier"\x2C civ: "Bulgarians"\x2C master: 359\x2C\x0d\n    fixture: "halberdier_bulgarians_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 35\x2C wood: 25\x2C gold: 0 } }\x2C\x0d\n  { slug: "hand_cannoneer"\x2C label: "Hand Cannoneer"\x2C civ: "Bohemians"\x2C master: 5\x2C\x0d\n    fixture: "hand_cannoneer_bohemians_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 45\x2C wood: 0\x2C gold: 50 } }\x2C\x0d\n  { slug: "heavy_camel"\x2C label: "Heavy Camel Rider"\x2C civ: "Berbers"\x2C master: 330\x2C\x0d\n    fixture: "heavy_camel_berbers_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 55\x2C wood: 0\x2C gold: 60 } }\x2C\x0d\n  { slug: "heavy_cav_archer"\x2C label: "Heavy Cav Archer"\x2C civ: "Saracens"\x2C master: 474\x2C\x0d\n    catalogueName: "Heavy Cavalry Archer"\x2C\x0d\n    fixture: "heavy_cav_archer_saracens_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 40\x2C gold: 60 } }\x2C\x0d\n  { slug: "heavy_scorpion"\x2C label: "Heavy Scorpion"\x2C civ: "Japanese"\x2C master: 542\x2C\x0d\n    fixture: "heavy_scorpion_japanese_imperial.json"\x2C class: "siege_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 75\x2C gold: 75 } }\x2C\x0d\n  { slug: "hussar"\x2C label: "Hussar"\x2C civ: "Berbers"\x2C master: 441\x2C\x0d\n    fixture: "hussar_berbers_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 80\x2C wood: 0\x2C gold: 0 } }\x2C\x0d\n  { slug: "imp_elite_skirm"\x2C label: "Elite Skirmisher"\x2C civ: "Chinese"\x2C master: 6\x2C\x0d\n    fixture: "elite_skirmisher_chinese_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 25\x2C wood: 35\x2C gold: 0 } }\x2C\x0d\n  { slug: "paladin"\x2C label: "Paladin"\x2C civ: "Spanish"\x2C master: 569\x2C\x0d\n    fixture: "paladin_spanish_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 60\x2C wood: 0\x2C gold: 75 } }\x2C\x0d\n  { slug: "siege_onager"\x2C label: "Siege Onager"\x2C civ: "Slavs"\x2C master: 588\x2C\x0d\n    fixture: "siege_onager_slavs_imperial.json"\x2C class: "siege_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 160\x2C gold: 135 } }\x2C\x0d\n  { slug: "elite_longbowman"\x2C label: "Elite Longbowman"\x2C civ: "Britons"\x2C master: 530\x2C\x0d\n    fixture: "elite_longbowman_britons_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 35\x2C gold: 40 } }\x2C\x0d\n  { slug: "elite_throwing_axeman"\x2C label: "Elite Throwing Axeman"\x2C civ: "Franks"\x2C master: 531\x2C\x0d\n    fixture: "elite_throwing_axeman_franks_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 55\x2C wood: 0\x2C gold: 25 } }\x2C\x0d\n  { slug: "elite_woad_raider"\x2C label: "Elite Woad Raider"\x2C civ: "Celts"\x2C master: 534\x2C\x0d\n    fixture: "elite_woad_raider_celts_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 70\x2C wood: 0\x2C gold: 25 } }\x2C\x0d\n  { slug: "elite_shotel_warrior"\x2C label: "Elite Shotel Warrior"\x2C civ: "Ethiopians"\x2C master: 1018\x2C\x0d\n    fixture: "elite_shotel_warrior_ethiopians_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 50\x2C wood: 0\x2C gold: 30 } }\x2C\x0d\n  { slug: "elite_gbeto"\x2C label: "Elite Gbeto"\x2C civ: "Malians"\x2C master: 1015\x2C\x0d\n    fixture: "elite_gbeto_malians_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 50\x2C wood: 0\x2C gold: 40 } }\x2C\x0d\n  { slug: "elite_huskarl"\x2C label: "Elite Huskarl"\x2C civ: "Goths"\x2C master: 555\x2C\x0d\n    fixture: "elite_huskarl_goths_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 75\x2C wood: 0\x2C gold: 35 } }\x2C\x0d\n  { slug: "elite_teutonic_knight"\x2C label: "Elite Teutonic Knight"\x2C civ: "Teutons"\x2C master: 554\x2C\x0d\n    fixture: "elite_teutonic_knight_teutons_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 85\x2C wood: 0\x2C gold: 30 } }\x2C\x0d\n  { slug: "elite_boyar"\x2C label: "Elite Boyar"\x2C civ: "Slavs"\x2C master: 878\x2C\x0d\n    fixture: "elite_boyar_slavs_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 60\x2C wood: 0\x2C gold: 70 } }\x2C\x0d\n  { slug: "elite_tarkan"\x2C label: "Elite Tarkan"\x2C civ: "Huns"\x2C master: 757\x2C\x0d\n    fixture: "elite_tarkan_huns_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 60\x2C wood: 0\x2C gold: 60 } }\x2C\x0d\n  { slug: "elite_genoese_crossbowman"\x2C label: "Elite Genoese Crossbowman"\x2C civ: "Italians"\x2C master: 868\x2C\x0d\n    fixture: "elite_genoese_crossbowman_italians_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 45\x2C gold: 40 } }\x2C\x0d\n  { slug: "elite_plumed_archer"\x2C label: "Elite Plumed Archer"\x2C civ: "Mayans"\x2C master: 765\x2C\x0d\n    fixture: "elite_plumed_archer_mayans_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 55\x2C gold: 55 } }\x2C\x0d\n  { slug: "elite_mangudai"\x2C label: "Elite Mangudai"\x2C civ: "Mongols"\x2C master: 561\x2C\x0d\n    fixture: "elite_mangudai_mongols_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 55\x2C gold: 65 } }\x2C\x0d\n  { slug: "elite_rattan_archer"\x2C label: "Elite Rattan Archer"\x2C civ: "Vietnamese"\x2C master: 1131\x2C\x0d\n    fixture: "elite_rattan_archer_vietnamese_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 50\x2C gold: 45 } }\x2C\x0d\n  { slug: "elite_janissary"\x2C label: "Elite Janissary"\x2C civ: "Turks"\x2C master: 557\x2C\x0d\n    fixture: "elite_janissary_turks_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 60\x2C wood: 0\x2C gold: 55 } }\x2C\x0d\n  { slug: "elite_conquistador"\x2C label: "Elite Conquistador"\x2C civ: "Spanish"\x2C master: 773\x2C\x0d\n    fixture: "elite_conquistador_spanish_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 70\x2C wood: 0\x2C gold: 60 } }\x2C\x0d\n  { slug: "elite_war_wagon"\x2C label: "Elite War Wagon"\x2C civ: "Koreans"\x2C master: 829\x2C\x0d\n    fixture: "elite_war_wagon_koreans_imperial.json"\x2C class: "mobile_ranged"\x2C\x0d\n    baseCost: { food: 0\x2C wood: 200\x2C gold: 60 } }\x2C\x0d\n  { slug: "elite_magyar_huszar"\x2C label: "Elite Magyar Huszar"\x2C civ: "Magyars"\x2C master: 871\x2C\x0d\n    fixture: "elite_magyar_huszar_magyars_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 35\x2C wood: 0\x2C gold: 45 } }\x2C\x0d\n  { slug: "elite_keshik"\x2C label: "Elite Keshik"\x2C civ: "Tatars"\x2C master: 1230\x2C\x0d\n    fixture: "elite_keshik_tatars_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 60\x2C wood: 0\x2C gold: 40 } }\x2C\x0d\n  { slug: "elite_karambit_warrior"\x2C label: "Elite Karambit Warrior"\x2C civ: "Malay"\x2C master: 1125\x2C\x0d\n    fixture: "elite_karambit_warrior_malay_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 25\x2C wood: 0\x2C gold: 15 } }\x2C\x0d\n  { slug: "warrior_priest"\x2C label: "Warrior Priest"\x2C civ: "Armenians"\x2C master: 1811\x2C\x0d\n    fixture: "warrior_priest_armenians_imperial.json"\x2C class: "melee"\x2C\x0d\n    baseCost: { food: 40\x2C wood: 0\x2C gold: 50 } }\x2C\x0d\n];\x0d\n\x0d\nexport const UNIT_REGISTRY = Object.freeze(ROWS.map((row) => Object.freeze({\x0d\n  ...row\x2C\x0d\n  baseCost: Object.freeze(row.baseCost)\x2C\x0d\n})));\x0d\n\x0d\nexport const UNIT_SLUGS = Object.freeze(UNIT_REGISTRY.map(({ slug }) => slug));\x0d\n\x0d\n// The enemy-free movement lab is intentionally curated: these rows have\x0d\n// clean-room mechanics and are the ranged units requested for navigation\x0d\n// review. Order is the viewer's picker order and is part of its URL contract.\x0d\nexport const SOLO_MOVEMENT_UNIT_SLUGS = Object.freeze([\x0d\n  "hand_cannoneer"\x2C\x0d\n  "arbalester"\x2C\x0d\n  "heavy_cav_archer"\x2C\x0d\n  "heavy_scorpion"\x2C\x0d\n  "imp_elite_skirm"\x2C\x0d\n]);\x0d\n\x0d\nconst BY_SLUG = new Map(UNIT_REGISTRY.map((row) => [row.slug\x2C row]));\x0d\n\x0d\nexport function unitBySlug(slug) {\x0d\n  return BY_SLUG.get(slug);\x0d\n}\x0d\n
