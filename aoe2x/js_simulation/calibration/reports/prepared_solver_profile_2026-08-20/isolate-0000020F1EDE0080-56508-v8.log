script-source,170,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/reach-melee.js,const EPSILON = 1e-12;\x0d\n\x0d\n\x0d\nexport function hasLimitedClosurePerReload(mover\x2C target) {\x0d\n  const range = mover?.mechanics?.attack_range_tiles;\x0d\n  const reload = mover?.mechanics?.reload_seconds;\x0d\n  const moverSpeed = mover?.mechanics?.speed_tiles_per_second;\x0d\n  const targetSpeed = target?.mechanics?.speed_tiles_per_second;\x0d\n  if (!Number.isFinite(range) || range < 1 - EPSILON\x0d\n      || !Number.isFinite(reload) || reload <= 0\x0d\n      || !Number.isFinite(moverSpeed) || moverSpeed < 0\x0d\n      || !Number.isFinite(targetSpeed) || targetSpeed < 0) return false;\x0d\n  const closurePerReload = Math.max(0\x2C moverSpeed - targetSpeed) * reload;\x0d\n  return closurePerReload <= range + EPSILON;\x0d\n}\x0d\n
