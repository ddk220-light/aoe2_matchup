   return;\x0d\n  }\x0d\n\x0d\n  const restoredReferences = restoreInvalidMovement(\x0d\n    bodies\x2C obstacles\x2C bounds\x2C pairResolver\x2C\n  );\x0d\n  if (collisionRecoveryState) collisionRecoveryState.active = true;\x0d\n  reportCollisionDiagnostics(\n    onCollisionDiagnostics\x2C "fallback"\x2C MAX_CONSTRAINT_SWEEPS\x2C lastCorrection\x2C\n    restoredReferences\x2C\n  );\n}\x0d\n\x0d\n\x0d\nfunction invalidBodyReferences(bodies\x2C obstacles\x2C bounds\x2C tolerance\x2C pairResolver) {\n  const invalid = new Set();\x0d\n  for (const body of bodies) {\x0d\n    const x = body.x + body.dx;\x0d\n    const y = body.y + body.dy;\x0d\n    if (\x0d\n      x < body.radius - tolerance\x0d\n      || x > bounds.width - body.radius + tolerance\x0d\n      || y < body.radius - tolerance\x0d\n      || y > bounds.height - body.radius + tolerance\x0d\n    ) invalid.add(body.referenceId);\x0d\n    for (const obstacle of obstacles) {\x0d\n      const gap = Math.hypot(obstacle.x - x\x2C obstacle.y - y)\x0d\n        - body.radius - obstacle.radius;\x0d\n      if (gap < -tolerance) invalid.add(body.referenceId);\x0d\n    }\x0d\n  }\x0d\n  for (let i = 0; i < bodies.length; i += 1) {\x0d\n    for (let j = i + 1; j < bodies.length; j += 1) {\x0d\n      if (bodies[i].owner === bodies[j].owner) continue;\x0d\n      const gap = Math.max(\x0d\n        Math.abs(bodies[j].x + bodies[j].dx - bodies[i].x - bodies[i].dx)\x2C\x0d\n        Math.abs(bodies[j].y + bodies[j].dy - bodies[i].y - bodies[i].dy)\x2C\x0d\n      ) - preparedPairInteraction(bodies[i]\x2C bodies[j]\x2C pairResolver).collisionExtent;\n      if (gap >= -tolerance) continue;\x0d\n      invalid.add(bodies[i].referenceId);\x0d\n      invalid.add(bodies[j].referenceId);\x0d\n    }\x0d\n  }\x0d\n  return invalid;\x0d\n}\x0d\n\x0d\n\x0d\nfunction restoreInvalidMovement(bodies\x2C obstacles\x2C bounds\x2C pairResolver) {\n  const restored = new Set();\x0d\n  for (let pass = 0; pass < bodies.length; pass += 1) {\x0d\n    const invalid = invalidBodyReferences(\x0d\n      bodies\x2C obstacles\x2C bounds\x2C GEOMETRY_SLOP\x2C pairResolver\x2C\n    );\x0d\n    if (invalid.size === 0) return [...restored];\x0d\n    let grew = false;\x0d\n    for (const body of bodies) {\x0d\n      if (!invalid.has(body.referenceId) || restored.has(body.referenceId)) continue;\x0d\n      body.dx = 0;\x0d\n      body.dy = 0;\x0d\n      restored.add(body.referenceId);\x0d\n      grew = true;\x0d\n    }\x0d\n    if (!grew) break;\x0d\n  }\x0d\n\x0d\n  // The input snapshot was validated before solving\x2C so restoring every body\x0d\n  // is an always-valid deterministic last resort even for an unexpectedly\x0d\n  // tangled contact graph.\x0d\n  for (const body of bodies) {\x0d\n    body.dx = 0;\x0d\n    body.dy = 0;\x0d\n  }\x0d\n  return bodies.map(({ referenceId }) => referenceId);\x0d\n}\x0d\n\x0d\n\x0d\nfunction finalGeometryViolation(bodies\x2C obstacles\x2C bounds\x2C tolerance\x2C pairResolver) {\n  for (const body of bodies) {\x0d\n    const x = body.x + body.dx;\x0d\n    const y = body.y + body.dy;\x0d\n    if (\x0d\n      x < body.radius - tolerance ||\x0d\n      x > bounds.width - body.radius + tolerance ||\x0d\n      y < body.radius - tolerance ||\x0d\n      y > bounds.height - body.radius + tolerance\x0d\n    ) return `reference ${body.referenceId} outside bounds`;\x0d\n    for (const obstacle of obstacles) {\x0d\n      const gap = Math.hypot(obstacle.x - x\x2C obstacle.y - y)\x0d\n        - body.radius - obstacle.radius;\x0d\n      if (gap < -tolerance) {\x0d\n        return `reference ${body.referenceId} overlaps obstacle ${obstacle.label} by ${-gap}`;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  for (let i = 0; i < bodies.length; i += 1) {\n    for (let j = i + 1; j < bodies.length; j += 1) {\n      const gap = Math.max(\n        Math.abs(bodies[j].x + bodies[j].dx - bodies[i].x - bodies[i].dx)\x2C\n        Math.abs(bodies[j].y + bodies[j].dy - bodies[i].y - bodies[i].dy)\x2C\n      ) - preparedPairInteraction(bodies[i]\x2C bodies[j]\x2C pairResolver).collisionExtent;\n      if (gap < -tolerance) {\n        return `references ${bodies[i].referenceId} and ${bodies[j].referenceId} `\n          + `overlap by ${-gap}`;\n      }\n    }\n  }\n  return null;\x0d\n}\x0d\n\x0d\n\x0d\nfunction finalGeometryIsValid(bodies\x2C obstacles\x2C bounds\x2C tolerance\x2C pairResolver) {\n  return finalGeometryViolation(\n    bodies\x2C obstacles\x2C bounds\x2C tolerance\x2C pairResolver\x2C\n  ) === null;\n}\n\x0d\n\x0d\nfunction sweptContactFraction(leftBefore\x2C rightBefore\x2C leftAfter\x2C rightAfter) {\x0d\n  const startX = rightBefore.x - leftBefore.x;\x0d\n  const startY = rightBefore.y - leftBefore.y;\x0d\n  const relativeX = (rightAfter.x - rightBefore.x) - (leftAfter.x - leftBefore.x);\x0d\n  const relativeY = (rightAfter.y - rightBefore.y) - (leftAfter.y - leftBefore.y);\x0d\n  const radius = collisionRadius(leftBefore) + collisionRadius(rightBefore);\x0d\n  const c = startX * startX + startY * startY - radius * radius;\x0d\n  const finalGap = Math.hypot(\x0d\n    rightAfter.x - leftAfter.x\x2C\x0d\n    rightAfter.y - leftAfter.y\x2C\x0d\n  ) - radius;\x0d\n  if (c <= EPSILON) return finalGap <= EPSILON ? 0 : null;\x0d\n  const a = relativeX * relativeX + relativeY * relativeY;\x0d\n  if (a === 0) return null;\x0d\n  const b = 2 * (startX * relativeX + startY * relativeY);\x0d\n  const discriminant = b * b - 4 * a * c;\x0d\n  if (discriminant < -EPSILON) return null;\x0d\n  const root = Math.sqrt(Math.max(0\x2C discriminant));\x0d\n  const entering = (-b - root) / (2 * a);\x0d\n  return entering >= -EPSILON && entering <= 1 + EPSILON\x0d\n    ? Math.max(0\x2C Math.min(1\x2C entering))\x0d\n    : null;\x0d\n}\x0d\n\x0d\n\x0d\nexport function queryEnemyContactManifold(beforeSnapshot\x2C afterSnapshot) {\x0d\n  if (!Array.isArray(beforeSnapshot) || !Array.isArray(afterSnapshot)) {\x0d\n    throw new TypeError("contact snapshots must be arrays");\x0d\n  }\x0d\n  const before = [...beforeSnapshot].sort(pairKey);\x0d\n  const afterByReference = new Map();\x0d\n  for (const unit of afterSnapshot) {\x0d\n    requireReferenceId(unit?.referenceId);\x0d\n    if (afterByReference.has(unit.referenceId)) {\x0d\n      throw new Error(`duplicate unit reference ${unit.referenceId}`);\x0d\n    }\x0d\n    afterByReference.set(unit.referenceId\x2C unit);\x0d\n  }\x0d\n  if (afterByReference.size !== before.length) {\x0d\n    throw new Error("contact snapshots must contain the same units");\x0d\n  }\x0d\n\x0d\n  const contacts = [];\x0d\n  for (let leftIndex = 0; leftIndex < before.length; leftIndex += 1) {\x0d\n    const leftBefore = before[leftIndex];\x0d\n    const leftAfter = afterByReference.get(leftBefore.referenceId);\x0d\n    if (!leftAfter) throw new Error(`missing final unit ${leftBefore.referenceId}`);\x0d\n    for (let rightIndex = leftIndex + 1; rightIndex < before.length; rightIndex += 1) {\x0d\n      const rightBefore = before[rightIndex];\x0d\n      const rightAfter = afterByReference.get(rightBefore.referenceId);\x0d\n      if (!rightAfter) throw new Error(`missing final unit ${rightBefore.referenceId}`);\x0d\n      if (\x0d\n        leftBefore.alive === false\x0d\n        || rightBefore.alive === false\x0d\n        || leftAfter.alive === false\x0d\n        || rightAfter.alive === false\x0d\n        || leftBefore.owner === rightBefore.owner\x0d\n      ) continue;\x0d\n      const finalSurfaceGap = Math.hypot(\x0d\n        rightAfter.x - leftAfter.x\x2C\x0d\n        rightAfter.y - leftAfter.y\x2C\x0d\n      ) - collisionRadius(leftAfter) - collisionRadius(rightAfter);\x0d\n      let sweptToi = sweptContactFraction(\x0d\n        leftBefore\x2C\x0d\n        rightBefore\x2C\x0d\n        leftAfter\x2C\x0d\n        rightAfter\x2C\x0d\n      );\x0d\n      if (sweptToi === null && finalSurfaceGap <= EPSILON) sweptToi = 1;\x0d\n      if (sweptToi === null) continue;\x0d\n      contacts.push(Object.freeze({\x0d\n        leftId: leftBefore.referenceId\x2C\x0d\n        rightId: rightBefore.referenceId\x2C\x0d\n        sweptToi\x2C\x0d\n        finalSurfaceGap\x2C\x0d\n      }));\x0d\n    }\x0d\n  }\x0d\n  contacts.sort((left\x2C right) => (\x0d\n    left.sweptToi - right.sweptToi\x0d\n    || left.finalSurfaceGap - right.finalSurfaceGap\x0d\n    || left.leftId - right.leftId\x0d\n    || left.rightId - right.rightId\x0d\n  ));\x0d\n  return Object.freeze(contacts);\x0d\n}\x0d\n\x0d\n\x0d\nfunction validateMovementOptions(options) {\n  if (!options || typeof options !== "object" || Array.isArray(options)) {\n    throw new TypeError("movement options must be an object");\n  }\n  const onCollisionDiagnostics = options.onCollisionDiagnostics;\n  if (onCollisionDiagnostics !== undefined && typeof onCollisionDiagnostics !== "function") {\n    throw new TypeError("collision diagnostics callback must be a function");\n  }\n  const collisionRecoveryState = options.collisionRecoveryState;\n  if (collisionRecoveryState !== undefined\n      && (!collisionRecoveryState || typeof collisionRecoveryState !== "object")) {\n    throw new TypeError("collision recovery state must be an object");\n  }\n  return { onCollisionDiagnostics\x2C collisionRecoveryState };\n}\n\n\nexport function prepareMovementResolution(snapshot\x2C map\x2C options = {}) {\n  validateMovementOptions(options);\n  const pairInteractions = options.pairInteractions\n    ?? createPairInteractionSnapshot();\n  const baseBodies = normalizeBodies(snapshot\x2C []);\n  const bounds = Object.freeze(normalizeBounds(map\x2C baseBodies));\n  const obstacles = normalizeObstacles(map);\n  const pairResolver = createPreparedPairResolver(baseBodies\x2C pairInteractions);\n  const strictlyValidStart = validateStartingGeometry(\n    baseBodies\x2C obstacles\x2C bounds\x2C pairResolver\x2C\n  );\n  return Object.freeze({\n    [PREPARED_MOVEMENT_RESOLUTION]: true\x2C\n    snapshot\x2C\n    baseBodies: Object.freeze(baseBodies.map(Object.freeze))\x2C\n    bounds\x2C\n    obstacles: Object.freeze(obstacles)\x2C\n    pairInteractions\x2C\n    pairResolver\x2C\n    strictlyValidStart\x2C\n  });\n}\n\n\nexport function resolvePreparedMovementProposals(prepared\x2C proposals\x2C options = {}) {\n  if (!prepared || prepared[PREPARED_MOVEMENT_RESOLUTION] !== true) {\n    throw new TypeError("prepared movement resolution is required");\n  }\n  const { onCollisionDiagnostics\x2C collisionRecoveryState } = validateMovementOptions(options);\n  if (options.pairInteractions !== undefined\n      && options.pairInteractions !== prepared.pairInteractions) {\n    throw new Error("prepared movement pair interactions cannot change");\n  }\n  const bodies = applyMovementProposals(prepared.baseBodies\x2C proposals);\n  resolveConstraints(\n    bodies\x2C prepared.obstacles\x2C prepared.bounds\x2C prepared.pairResolver\x2C\n    onCollisionDiagnostics\x2C\n    collisionRecoveryState?.active === true || !prepared.strictlyValidStart\x2C\n    collisionRecoveryState\x2C\n  );\n  if (!finalGeometryIsValid(\n    bodies\x2C prepared.obstacles\x2C prepared.bounds\x2C GEOMETRY_SLOP\x2C prepared.pairResolver\x2C\n  )) {\n    const violation = finalGeometryViolation(\n      bodies\x2C prepared.obstacles\x2C prepared.bounds\x2C GEOMETRY_SLOP\x2C prepared.pairResolver\x2C\n    );\n    throw new Error(`collision constraints produced invalid final geometry: ${violation}`);\n  }\n\n  const nextByIndex = new Array(prepared.snapshot.length);\n  for (const body of bodies) {\n    nextByIndex[body.inputIndex] = Object.freeze({\n      ...body.unit\x2C\n      x: body.x + body.dx\x2C\x0d\n      y: body.y + body.dy\x2C\x0d\n    });\x0d\n  }\n  return Object.freeze(nextByIndex);\n}\n\n\nexport function resolveMovementProposals(snapshot\x2C proposals\x2C map\x2C options = {}) {\n  return resolvePreparedMovementProposals(\n    prepareMovementResolution(snapshot\x2C map\x2C options)\x2C\n    proposals\x2C\n    options\x2C\n  );\n}\n
