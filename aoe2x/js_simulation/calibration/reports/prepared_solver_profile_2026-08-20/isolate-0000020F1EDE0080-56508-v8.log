script-source,50,node:internal/perf/utils,'use strict';\x0d\n\x0d\nconst {\x0d\n  constants: {\x0d\n    NODE_PERFORMANCE_MILESTONE_TIME_ORIGIN\x2C\x0d\n  }\x2C\x0d\n  milestones\x2C\x0d\n} = internalBinding('performance');\x0d\n\x0d\nfunction getTimeOrigin() {\x0d\n  // Do not cache this to prevent it from being serialized into the\x0d\n  // snapshot.\x0d\n  return milestones[NODE_PERFORMANCE_MILESTONE_TIME_ORIGIN] / 1e6;\x0d\n}\x0d\n\x0d\n// Returns the time relative to the process start time in milliseconds.\x0d\nfunction now() {\x0d\n  const hr = process.hrtime();\x0d\n  return (hr[0] * 1000 + hr[1] / 1e6) - getTimeOrigin();\x0d\n}\x0d\n\x0d\n// Returns the milestone relative to the process start time in milliseconds.\x0d\nfunction getMilestoneTimestamp(milestoneIdx) {\x0d\n  const ns = milestones[milestoneIdx];\x0d\n  if (ns === -1)\x0d\n    return ns;\x0d\n  return ns / 1e6 - getTimeOrigin();\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  now\x2C\x0d\n  getMilestoneTimestamp\x2C\x0d\n};\x0d\n
