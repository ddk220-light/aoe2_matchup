script-source,92,node:internal/modules/esm/handle_process_exit,'use strict';\x0d\n\x0d\nconst { exitCodes: { kUnfinishedTopLevelAwait } } = internalBinding('errors');\x0d\n\x0d\n/**\x0d\n * Handle a Promise from running code that potentially does Top-Level Await.\x0d\n * In that case\x2C it makes sense to set the exit code to a specific non-zero value\x0d\n * if the main code never finishes running.\x0d\n */\x0d\nfunction handleProcessExit() {\x0d\n  process.exitCode ??= kUnfinishedTopLevelAwait;\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  handleProcessExit\x2C\x0d\n};\x0d\n
