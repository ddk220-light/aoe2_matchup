code-creation,Script,10,217324,0x27a60332fce,379, file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/contact-reservations.js:1:1,0x27a60331760,~
script-source,160,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/contact-reservations.js,import { isWithinReach } from "./targeting.js";\nimport { resolvePairInteraction } from "./pair-interactions.js";\n\x0d\n\x0d\nconst EPSILON = 1e-12;\x0d\nconst MAX_DEEP_CONTACT_DEGREE = 2;\x0d\nconst MAX_INCOMING_ENGAGEMENTS = 2;\x0d\n\x0d\nexport function createContactReservationState() {\x0d\n  return Object.freeze({\x0d\n    reservations: new Map()\x2C\x0d\n    inheritedExtents: new Map()\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nexport function updateContactReservations({\n  state\x2C units\x2C proposals\x2C tick\x2C pairInteractions = null\x2C\n}) {\n  requireInputs(state\x2C units\x2C proposals\x2C tick);\x0d\n  const live = units\x0d\n    .filter((unit) => unit?.alive !== false)\x0d\n    .slice()\x0d\n    .sort((left\x2C right) => left.referenceId - right.referenceId);\x0d\n  const byReference = unitMap(live);\x0d\n  const proposalByReference = proposalMap(proposals\x2C byReference);\x0d\n  const contactReservations = new Map();\x0d\n  const reservations = new Map();\x0d\n  const inheritedExtents = new Map();\x0d\n  const contactSlots = createContactSlots();\x0d\n  const diagnostics = [];\x0d\n\x0d\n  publishInheritedReleases({\x0d\n    inherited: state.inheritedExtents\x2C\x0d\n    byReference\x2C\x0d\n    inheritedExtents\x2C\x0d\n    contactReservations\x2C\x0d\n    diagnostics\x2C\n    tick\x2C\n    pairInteractions\x2C\n  });\n\x0d\n  for (const [key\x2C prior] of sortedEntries(state.reservations)) {\x0d\n    const left = byReference.get(prior.leftId);\x0d\n    const right = byReference.get(prior.rightId);\x0d\n    if (!left || !right) {\n      diagnostics.push(diagnostic("reservation-released"\x2C key\x2C { reason: "unit-missing" }));\x0d\n      continue;\n    }\n    if (pairUsesPursuitTransit(left\x2C right\x2C pairInteractions)) {\n      diagnostics.push(diagnostic("reservation-released"\x2C key\x2C {\n        reason: "pursuit-transit"\x2C\n      }));\n      continue;\n    }\n    if (sharedFormationOrder(left\x2C right)) {\x0d\n      diagnostics.push(diagnostic("reservation-released"\x2C key\x2C {\x0d\n        reason: "shared-formation-order"\x2C\x0d\n      }));\x0d\n      continue;\x0d\n    }\x0d\n    if (reservationRemainsActive(prior\x2C left\x2C right\x2C byReference\x2C proposalByReference)) {\x0d\n      if (!contactSlotsAvailable(prior\x2C left\x2C right\x2C contactSlots)) {\x0d\n        diagnostics.push(diagnostic("reservation-released"\x2C key\x2C {\x0d\n          reason: "deep-slot-conflict"\x2C\x0d\n        }));\x0d\n        inheritReleasedPair({\x0d\n          key\x2C\x0d\n          left\x2C\x0d\n          right\x2C\x0d\n          inheritedExtents\x2C\x0d\n          contactReservations\x2C\x0d\n          diagnostics\x2C\x0d\n          tick\x2C\x0d\n        });\x0d\n        continue;\x0d\n      }\x0d\n      reservations.set(key\x2C prior);\x0d\n      contactReservations.set(key\x2C prior);\x0d\n      occupyContactSlots(prior\x2C left\x2C right\x2C contactSlots);\x0d\n      diagnostics.push(diagnostic("reservation-persisted"\x2C key\x2C { kind: prior.kind }));\x0d\n      continue;\x0d\n    }\x0d\n    inheritReleasedPair({\x0d\n      key\x2C\x0d\n      left\x2C\x0d\n      right\x2C\x0d\n      inheritedExtents\x2C\x0d\n      contactReservations\x2C\x0d\n      diagnostics\x2C\x0d\n      tick\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  const candidates = generateCandidates(\n    live\x2C byReference\x2C proposalByReference\x2C tick\x2C pairInteractions\x2C\n  );\n  const admissibleShallowPairs = new Set(candidates\x0d\n    .filter(({ reservation }) => reservation.kind !== "releasing")\x0d\n    .map(({ key }) => key));\x0d\n  for (const candidate of candidates) {\x0d\n    if (contactReservations.has(candidate.key)) continue;\x0d\n    if (candidate.reservation.kind === "releasing") {\x0d\n      inheritedExtents.set(candidate.key\x2C candidate.reservation.collisionExtent);\x0d\n      contactReservations.set(candidate.key\x2C candidate.reservation);\x0d\n      diagnostics.push(diagnostic("release-published"\x2C candidate.key\x2C {\x0d\n        collisionExtent: candidate.reservation.collisionExtent\x2C\x0d\n      }));\x0d\n      continue;\x0d\n    }\n    const left = byReference.get(candidate.reservation.leftId);\n    const right = byReference.get(candidate.reservation.rightId);\n    if (!contactSlotsAvailable(candidate.reservation\x2C left\x2C right\x2C contactSlots)) {\n      // Contact-slot capacity may reject a new deep lane\x2C but an overlap that\n      // already exists must still be represented in the same authoritative\n      // pair geometry. Publishing its exact current extent prevents any\n      // further deepening without snapping the units apart or falling back to\n      // an impossible hard full-body start.\n      const currentExtent = pairSeparation(left\x2C right);\n      if (currentExtent < pairFullExtent(left\x2C right) - EPSILON) {\n        const publishedExtent = cleanNumber(currentExtent);\n        const release = releasingReservation({\n          left\x2C\n          right\x2C\n          collisionExtent: publishedExtent\x2C\n          tick\x2C\n        });\n        inheritedExtents.set(candidate.key\x2C publishedExtent);\n        contactReservations.set(candidate.key\x2C release);\n        diagnostics.push(diagnostic("release-published"\x2C candidate.key\x2C {\n          reason: "contact-slot-unavailable"\x2C\n          collisionExtent: publishedExtent\x2C\n        }));\n      }\n      continue;\n    }\n    reservations.set(candidate.key\x2C candidate.reservation);\x0d\n    contactReservations.set(candidate.key\x2C candidate.reservation);\x0d\n    occupyContactSlots(candidate.reservation\x2C left\x2C right\x2C contactSlots);\x0d\n    diagnostics.push(diagnostic("reservation-acquired"\x2C candidate.key\x2C {\x0d\n      kind: candidate.reservation.kind\x2C\x0d\n      entryFraction: candidate.entryFraction\x2C\x0d\n      projectedNormalizedDepth: candidate.projectedNormalizedDepth\x2C\x0d\n      progress: candidate.progress\x2C\x0d\n    }));\x0d\n  }\x0d\n\x0d\n  publishShallowContacts({\x0d\n    units: live\x2C\x0d\n    proposals: proposalByReference\x2C\x0d\n    contactReservations\x2C\x0d\n    inheritedExtents\x2C\x0d\n    admissiblePairs: admissibleShallowPairs\x2C\x0d\n    diagnostics\x2C\x0d\n    tick\x2C\x0d\n  });\x0d\n\x0d\n  const nextState = Object.freeze({ reservations\x2C inheritedExtents });\x0d\n  return Object.freeze({\x0d\n    state: nextState\x2C\x0d\n    contactReservations\x2C\x0d\n    diagnostics: Object.freeze(diagnostics)\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction createContactSlots() {\x0d\n  return {\x0d\n    allied: new Set()\x2C\x0d\n    enemyTransit: new Set()\x2C\x0d\n    engagementOutgoing: new Set()\x2C\x0d\n    engagementIncoming: new Map()\x2C\x0d\n    deepDegree: new Map()\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction contactSlotsAvailable(reservation\x2C left\x2C right\x2C slots) {\x0d\n  if (!left || !right) throw new Error("contact slot pair must reference live units");\x0d\n  if ((slots.deepDegree.get(left.referenceId) ?? 0) >= MAX_DEEP_CONTACT_DEGREE\x0d\n      || (slots.deepDegree.get(right.referenceId) ?? 0) >= MAX_DEEP_CONTACT_DEGREE) {\x0d\n    return false;\x0d\n  }\x0d\n  if (left.owner === right.owner) {\x0d\n    return !slots.allied.has(left.referenceId) && !slots.allied.has(right.referenceId);\x0d\n  }\x0d\n  if (reservation.kind === "engagement-contact") {\x0d\n    return engagementDirections(reservation\x2C left\x2C right).every(([initiator\x2C target]) => (\x0d\n      !slots.engagementOutgoing.has(initiator.referenceId)\x0d\n        && (slots.engagementIncoming.get(target.referenceId) ?? 0)\x0d\n          < MAX_INCOMING_ENGAGEMENTS\x0d\n    ));\x0d\n  }\x0d\n  return !slots.enemyTransit.has(left.referenceId)\x0d\n    && !slots.enemyTransit.has(right.referenceId);\x0d\n}\x0d\n\x0d\nfunction occupyContactSlots(reservation\x2C left\x2C right\x2C slots) {\x0d\n  slots.deepDegree.set(\x0d\n    left.referenceId\x2C\x0d\n    (slots.deepDegree.get(left.referenceId) ?? 0) + 1\x2C\x0d\n  );\x0d\n  slots.deepDegree.set(\x0d\n    right.referenceId\x2C\x0d\n    (slots.deepDegree.get(right.referenceId) ?? 0) + 1\x2C\x0d\n  );\x0d\n  if (left.owner === right.owner) {\x0d\n    slots.allied.add(left.referenceId);\x0d\n    slots.allied.add(right.referenceId);\x0d\n    return;\x0d\n  }\x0d\n  if (reservation.kind === "engagement-contact") {\x0d\n    for (const [initiator\x2C target] of engagementDirections(reservation\x2C left\x2C right)) {\x0d\n      slots.engagementOutgoing.add(initiator.referenceId);\x0d\n      slots.engagementIncoming.set(\x0d\n        target.referenceId\x2C\x0d\n        (slots.engagementIncoming.get(target.referenceId) ?? 0) + 1\x2C\x0d\n      );\x0d\n    }\x0d\n    return;\x0d\n  }\x0d\n  slots.enemyTransit.add(left.referenceId);\x0d\n  slots.enemyTransit.add(right.referenceId);\x0d\n}\x0d\n\x0d\nfunction engagementDirections(reservation\x2C left\x2C right) {\x0d\n  const byReference = new Map([\x0d\n    [left.referenceId\x2C left]\x2C\x0d\n    [right.referenceId\x2C right]\x2C\x0d\n  ]);\x0d\n  const initiator = byReference.get(reservation.initiatorId);\x0d\n  const target = byReference.get(reservation.targetId);\x0d\n  if (!initiator || !target) {\x0d\n    throw new Error("engagement contact must identify its pair direction");\x0d\n  }\x0d\n  const directions = [[initiator\x2C target]];\x0d\n  if (directTarget(target\x2C initiator)) directions.push([target\x2C initiator]);\x0d\n  return directions;\x0d\n}\x0d\n\x0d\nfunction publishShallowContacts({\x0d\n  units\x2C\x0d\n  proposals\x2C\x0d\n  contactReservations\x2C\x0d\n  inheritedExtents\x2C\x0d\n  admissiblePairs\x2C\x0d\n  diagnostics\x2C\x0d\n  tick\x2C\x0d\n}) {\x0d\n  for (let leftIndex = 0; leftIndex < units.length; leftIndex += 1) {\x0d\n    const left = units[leftIndex];\x0d\n    for (let rightIndex = leftIndex + 1; rightIndex < units.length; rightIndex += 1) {\x0d\n      const