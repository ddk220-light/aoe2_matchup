script-source,155,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/combat/pair-interactions.js,import { collisionRadius } from "./targeting.js";\nimport { occupiesZeroRangeMeleeContact } from "./melee-contact.js";\n\x0d\n\x0d\nconst EPSILON = 1e-12;\x0d\nconst VALID_CONTACT_RESERVATION_KINDS = new Set([\x0d\n  "allied-transit"\x2C\x0d\n  "ranged-ingress"\x2C\x0d\n  "enemy-transit"\x2C\x0d\n  "engagement-contact"\x2C\x0d\n  "shallow-contact"\x2C\x0d\n  "releasing"\x2C\x0d\n]);\x0d\nconst VALID_SNAPSHOT_OPTIONS = new Set([\n  "contactReservations"\x2C\n  "pursuitTransitReferenceIds"\x2C\n]);\n\x0d\n\x0d\nfunction requireReferenceId(value\x2C name = "reference ID") {\x0d\n  if (!Number.isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireExtent(value\x2C name) {\x0d\n  if (!Number.isFinite(value)) throw new TypeError(`${name} must be finite`);\x0d\n  if (value < 0) throw new RangeError(`${name} must be nonnegative`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction requireBoolean(value\x2C name) {\x0d\n  if (typeof value !== "boolean") throw new TypeError(`${name} must be a boolean`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n\x0d\nfunction validateCanonicalPairKey(key\x2C name) {\x0d\n  if (typeof key !== "string") throw new TypeError(`${name} key must be a string`);\x0d\n  const match = /^(\\d+):(\\d+)$/.exec(key);\x0d\n  if (!match) throw new TypeError(`${name} key must be canonical`);\x0d\n  const left = Number(match[1]);\x0d\n  const right = Number(match[2]);\x0d\n  requireReferenceId(left\x2C `${name} left reference ID`);\x0d\n  requireReferenceId(right\x2C `${name} right reference ID`);\x0d\n  if (left >= right || dynamicPairKey(left\x2C right) !== key) {\x0d\n    throw new TypeError(`${name} key must be canonical`);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction normalizeContactReservations(value) {\n  if (!(value instanceof Map)) throw new TypeError("contact reservations must be a Map");\x0d\n  const result = new Map();\x0d\n  for (const [key\x2C reservation] of value) {\x0d\n    validateCanonicalPairKey(key\x2C "contact reservation");\x0d\n    if (!reservation || typeof reservation !== "object" || Array.isArray(reservation)) {\x0d\n      throw new TypeError("contact reservation must be an object");\x0d\n    }\x0d\n    const leftId = requireReferenceId(reservation.leftId\x2C "contact left ID");\x0d\n    const rightId = requireReferenceId(reservation.rightId\x2C "contact right ID");\x0d\n    if (dynamicPairKey(leftId\x2C rightId) !== key) {\x0d\n      throw new TypeError("contact reservation IDs must match its pair key");\x0d\n    }\x0d\n    const kind = reservation.kind;\x0d\n    if (!VALID_CONTACT_RESERVATION_KINDS.has(kind)) {\x0d\n      throw new RangeError(`unknown contact reservation kind ${kind}`);\x0d\n    }\x0d\n    const collisionExtent = requireExtent(\x0d\n      reservation.collisionExtent\x2C\x0d\n      "contact collision extent"\x2C\x0d\n    );\x0d\n    const attackSurfaceExtent = requireExtent(\x0d\n      reservation.attackSurfaceExtent\x2C\x0d\n      "contact attack surface extent"\x2C\x0d\n    );\x0d\n    if (collisionExtent > attackSurfaceExtent + EPSILON) {\x0d\n      throw new RangeError("contact collision extent cannot exceed its attack surface extent");\x0d\n    }\x0d\n    const initiatorId = reservation.initiatorId === null\x0d\n      ? null\x0d\n      : requireReferenceId(reservation.initiatorId\x2C "contact initiator ID");\x0d\n    const targetId = reservation.targetId === null\x0d\n      ? null\x0d\n      : requireReferenceId(reservation.targetId\x2C "contact target ID");\x0d\n    if (!Number.isSafeInteger(reservation.acquiredTick) || reservation.acquiredTick < 0) {\x0d\n      throw new TypeError("contact acquired tick must be a nonnegative safe integer");\x0d\n    }\x0d\n    result.set(key\x2C Object.freeze({\x0d\n      leftId\x2C\x0d\n      rightId\x2C\x0d\n      kind\x2C\x0d\n      collisionExtent\x2C\x0d\n      attackSurfaceExtent\x2C\x0d\n      pathObstructs: requireBoolean(reservation.pathObstructs\x2C "contact pathObstructs")\x2C\x0d\n      mayDeepen: requireBoolean(reservation.mayDeepen\x2C "contact mayDeepen")\x2C\x0d\n      initiatorId\x2C\x0d\n      targetId\x2C\x0d\n      acquiredTick: reservation.acquiredTick\x2C\x0d\n    }));\x0d\n  }\x0d\n  return result;\x0d\n}\n\n\nfunction normalizeReferenceIds(value\x2C name) {\n  if (!(value instanceof Set)) throw new TypeError(`${name} must be a Set`);\n  const result = new Set();\n  for (const referenceId of value) {\n    result.add(requireReferenceId(referenceId\x2C `${name} reference ID`));\n  }\n  return result;\n}\n\x0d\n\x0d\nfunction interaction(kind\x2C collisionExtent\x2C pathObstructs\x2C\x0d\n  attackSurfaceExtent\x2C mayDeepen\x2C reason) {\x0d\n  return Object.freeze({\x0d\n    kind\x2C\x0d\n    collisionExtent\x2C\x0d\n    pathObstructs\x2C\x0d\n    attackSurfaceExtent\x2C\x0d\n    mayDeepen\x2C\x0d\n    reason\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\n\x0d\nfunction sourceUnit(body) {\x0d\n  return body?.unit ?? body;\x0d\n}\x0d\n\x0d\n\x0d\nfunction bodyRadius(body) {\x0d\n  return Number.isFinite(body?.radius) ? body.radius : collisionRadius(sourceUnit(body));\x0d\n}\x0d\n\x0d\n\x0d\nexport function dynamicPairKey(leftId\x2C rightId) {\x0d\n  requireReferenceId(leftId\x2C "left reference ID");\x0d\n  requireReferenceId(rightId\x2C "right reference ID");\x0d\n  if (leftId === rightId) throw new RangeError("a dynamic pair requires two references");\x0d\n  return leftId < rightId ? `${leftId}:${rightId}` : `${rightId}:${leftId}`;\x0d\n}\x0d\n\x0d\n\x0d\nexport function createPairInteractionSnapshot(options = {}) {\n  if (!options || typeof options !== "object" || Array.isArray(options)) {\x0d\n    throw new TypeError("pair interaction options must be an object");\x0d\n  }\x0d\n  for (const name of Object.keys(options)) {\x0d\n    if (!VALID_SNAPSHOT_OPTIONS.has(name)) {\x0d\n      throw new RangeError(`unknown pair interaction option ${name}`);\x0d\n    }\x0d\n  }\x0d\n  return Object.freeze({\n    contactReservations: normalizeContactReservations(\n      options.contactReservations ?? new Map()\x2C\n    )\x2C\n    pursuitTransitReferenceIds: normalizeReferenceIds(\n      options.pursuitTransitReferenceIds ?? new Set()\x2C\n      "pursuit transit references"\x2C\n    )\x2C\n  });\n}\n\n\nfunction transitsDuringPursuit(unit\x2C other\x2C snapshot) {\n  if (!snapshot.pursuitTransitReferenceIds?.has(unit.referenceId)) return false;\n  if (unit.action === "attacking") return false;\n  return unit.owner === other.owner && !occupiesZeroRangeMeleeContact(other);\n}\n\x0d\n\x0d\nexport function resolvePairInteraction(left\x2C right\x2C\x0d\n  snapshot = createPairInteractionSnapshot()) {\x0d\n  if (!snapshot || typeof snapshot !== "object") {\x0d\n    throw new TypeError("pair interaction snapshot is required");\x0d\n  }\x0d\n  const leftUnit = sourceUnit(left);\n  const rightUnit = sourceUnit(right);\n  const extent = bodyRadius(left) + bodyRadius(right);\n  // A live melee chase is an authoritative movement state. Allied bodies may\n  // influence formation shape\x2C but must never clip\x2C shorten\x2C or reject its\n  // targetward step. Enemy bodies and static map geometry remain solid.\n  if (transitsDuringPursuit(leftUnit\x2C rightUnit\x2C snapshot)\n      || transitsDuringPursuit(rightUnit\x2C leftUnit\x2C snapshot)) {\n    return interaction(\n      "pursuit-transit"\x2C\n      0\x2C\n      false\x2C\n      extent\x2C\n      true\x2C\n      "active-melee-pursuit-transit"\x2C\n    );\n  }\n  // A formation order assigns every member of the cohort its own destination.\n  // The authorized tapes show those ordered allies reforming through one\x0d\n  // another (including center crossings) instead of treating arrived members\x0d\n  // as walls. This interaction belongs above inherited reservations: an old\x0d\n  // release surface must not block a later shared formation order. As soon as\x0d\n  // either order ends\x2C the unified reservation state publishes the pair's\x0d\n  // current overlap as monotonically releasing geometry.\x0d\n  if (leftUnit.owner === rightUnit.owner\x0d\n      && leftUnit.moveOrder !== undefined && leftUnit.moveOrder !== null\x0d\n      && rightUnit.moveOrder !== undefined && rightUnit.moveOrder !== null) {\x0d\n    return interaction(\x0d\n      "formation-transit"\x2C\x0d\n      0\x2C\x0d\n      false\x2C\x0d\n      extent\x2C\x0d\n      true\x2C\x0d\n      "shared-allied-formation-order"\x2C\x0d\n    );\x0d\n  }\x0d\n  const reservation = snapshot.contactReservations?.get(\n    dynamicPairKey(left.referenceId\x2C right.referenceId)\x2C\n  );\n  if (reservation) {\n    return interaction(\n      reservation.kind\x2C\n      reservation.collisionExtent\x2C\n      reservation.pathObstructs\x2C\x0d\n      reservation.attackSurfaceExtent\x2C\x0d\n      reservation.mayDeepen\x2C\x0d\n      "unified-contact-reservation"\x2C\n    );\n  }\n  return interaction(\n    "hard"\x2C\x0d\n    extent\x2C\x0d\n    true\x2C\x0d\n    extent\x2C\x0d\n    false\x2C\x0d\n    leftUnit.owner === rightUnit.owner\x0d\n      ? "hard-allied-contact" : "hard-enemy-contact"\x2C\x0d\n  );\x0d\n}\x0d\n
