script-source,154,file:///D:/AI/aoe2_matchup/aoe2x/js_simulation/src/kite-profiles.js,// GENERATED by tools/derive_kite_profiles.py -- do not edit by hand.\x0d\n//\x0d\n// The script cycle each kiting unit runs\x2C keyed by unit slug. Re-keyed from\x0d\n// the recorded scenarios (where the profile is a property of the tape) onto\x0d\n// the KITER\x2C which is what a free-selection fight needs: the same arbalester\x0d\n// runs the same cycle whichever melee unit it is pointed at.\x0d\n//\x0d\n// KITE_PROFILE_PROVENANCE names the source fixture(s) behind every row and\x0d\n// records whether each row came from legacy or standard-unit tapes.\x0d\nexport const KITE_PROFILES = Object.freeze({\x0d\n  "arbalester": {\x0d\n    "beatTicks": 120\x2C\x0d\n    "firstBeatTick": 120\x2C\x0d\n    "moveOffsetTicks": [\x0d\n      40\x0d\n    ]\x2C\x0d\n    "preMoveTicks": [\x0d\n      80\x0d\n    ]\x2C\x0d\n    "topupOffsetTicks": []\x0d\n  }\x2C\x0d\n  "hand_cannoneer": {\x0d\n    "beatTicks": 240\x2C\x0d\n    "firstBeatTick": 12\x2C\x0d\n    "formationMotion": "translated_offsets"\x2C\x0d\n    "moveOffsetTicks": [\x0d\n      68\x2C\x0d\n      148\x2C\x0d\n      228\x0d\n    ]\x2C\x0d\n    "preMoveTicks": []\x2C\x0d\n    "topupOffsetTicks": []\x2C\x0d\n    "volleyPursuit": "close_to_fire"\x0d\n  }\x2C\x0d\n  "heavy_cav_archer": {\x0d\n    "beatTicks": 120\x2C\x0d\n    "firstBeatTick": 40\x2C\x0d\n    "moveOffsetTicks": [\x0d\n      80\x0d\n    ]\x2C\x0d\n    "preMoveTicks": []\x2C\x0d\n    "topupOffsetTicks": [\x0d\n      40\x0d\n    ]\x0d\n  }\x2C\x0d\n  "imp_elite_skirm": {\x0d\n    "beatTicks": 200\x2C\x0d\n    "firstBeatTick": 200\x2C\x0d\n    "moveOffsetTicks": [\x0d\n      40\x2C\x0d\n      120\x0d\n    ]\x2C\x0d\n    "preMoveTicks": [\x0d\n      80\x2C\x0d\n      160\x0d\n    ]\x2C\x0d\n    "topupOffsetTicks": []\x0d\n  }\x0d\n});\x0d\n\x0d\nexport const KITE_PROFILE_PROVENANCE = Object.freeze({\x0d\n  "beatRuleChecks": [\x0d\n    {\x0d\n      "agrees": true\x2C\x0d\n      "measuredBeatTicks": 120\x2C\x0d\n      "predictedBeatTicks": 120\x2C\x0d\n      "reloadSeconds": 1.7\x2C\x0d\n      "shapeAgrees": true\x2C\x0d\n      "slug": "arbalester"\x0d\n    }\x2C\x0d\n    {\x0d\n      "agrees": true\x2C\x0d\n      "measuredBeatTicks": 120\x2C\x0d\n      "predictedBeatTicks": 120\x2C\x0d\n      "reloadSeconds": 1.8\x2C\x0d\n      "shapeAgrees": false\x2C\x0d\n      "slug": "heavy_cav_archer"\x0d\n    }\x2C\x0d\n    {\x0d\n      "agrees": true\x2C\x0d\n      "measuredBeatTicks": 200\x2C\x0d\n      "predictedBeatTicks": 200\x2C\x0d\n      "reloadSeconds": 3.0\x2C\x0d\n      "shapeAgrees": true\x2C\x0d\n      "slug": "imp_elite_skirm"\x0d\n    }\x0d\n  ]\x2C\x0d\n  "fixturesScanned": 29\x2C\x0d\n  "kitingFixtures": 13\x2C\x0d\n  "orderClockTicks": 40\x2C\x0d\n  "profiles": {\x0d\n    "arbalester": {\x0d\n      "defaultedFixtures": [\x0d\n        "arbalester_vs_champion_kiting_basics.json"\x0d\n      ]\x2C\x0d\n      "fixtures": [\x0d\n        "arbalester_vs_elephant_kiting_basics.json"\x2C\x0d\n        "arbalester_vs_firelancer_kiting_basics.json"\x2C\x0d\n        "arbalester_vs_paladin_kiting_basics.json"\x2C\x0d\n        "arbalester_vs_steppe_kiting_basics.json"\x0d\n      ]\x2C\x0d\n      "source": "tape"\x0d\n    }\x2C\x0d\n    "hand_cannoneer": {\x0d\n      "acceptanceReport": "calibration/reports/hand_cannoneer_translated_persistent_measured_phase_results_2026-08-09.json"\x2C\x0d\n      "archive": "aoe2_golden_STANDARD_UNITS_WITH_TAPES.zip"\x2C\x0d\n      "measurements": {\x0d\n        "formationMotion": "shared translation of existing unit offsets"\x2C\x0d\n        "moveCadenceSeconds": 1.3333333333333333\x2C\x0d\n        "openingOrderSeconds": 0.2\x2C\x0d\n        "volleyCadenceSeconds": 4.0\x0d\n      }\x2C\x0d\n      "source": "standard-units-tape"\x2C\x0d\n      "streamsMeasured": 34\x2C\x0d\n      "zipSha256": "38E07C38344F06E527C28CD9B235ADA59AD1E722CDB8EC171296B877E8C1956D"\x0d\n    }\x2C\x0d\n    "heavy_cav_archer": {\x0d\n      "defaultedFixtures": []\x2C\x0d\n      "fixtures": [\x0d\n        "hcavarcher_vs_champion_kiting_basics.json"\x2C\x0d\n        "hcavarcher_vs_elephant_kiting_basics.json"\x2C\x0d\n        "hcavarcher_vs_paladin_kiting_basics.json"\x2C\x0d\n        "hcavarcher_vs_steppe_kiting_basics.json"\x0d\n      ]\x2C\x0d\n      "source": "tape"\x0d\n    }\x2C\x0d\n    "imp_elite_skirm": {\x0d\n      "defaultedFixtures": []\x2C\x0d\n      "fixtures": [\x0d\n        "eliteskirm_vs_champion_kiting_basics.json"\x2C\x0d\n        "eliteskirm_vs_elephant_kiting_basics.json"\x2C\x0d\n        "eliteskirm_vs_paladin_kiting_basics.json"\x2C\x0d\n        "eliteskirm_vs_steppe_kiting_basics.json"\x0d\n      ]\x2C\x0d\n      "source": "tape"\x0d\n    }\x0d\n  }\x2C\x0d\n  "registry": "aoe2x/js_simulation/src/unit-registry.js"\x2C\x0d\n  "sourceDirectory": "aoe2x/js_simulation/calibration/fixtures"\x2C\x0d\n  "ticksPerSecond": 60\x0d\n});\x0d\n
