;=============================================================================
; ddkCircleV3.per -- bigger + smoother circle.
;   * RADIUS doubled: 800 precise = 8 tiles (was 4).
;   * 16 waypoints instead of 8 -> rounder, smoother path. Spacing between
;     adjacent points is ~the same as the old 8-point/4-tile ring, so the
;     per-step pace that already followed nicely is preserved (throttle still 6).
; Center is still hardcoded to tile (40,40) (proven). Auto-centering on the army
; comes next, once the motion looks right.
;
; SPEED KNOB: gl-tick threshold (6). SIZE: the offset magnitudes (800 / 739 / 566 / 306).
;=============================================================================

(defconst gl-cx    250)   ; FIXED orbit center: x=250, y=251 (precise = tile*100)
(defconst gl-cy    251)
(defconst gl-tx    252)   ; current waypoint: x=252, y=253
(defconst gl-ty    253)
(defconst gl-idx   254)
(defconst gl-tick  255)

(defrule
	(true)
	=>
	(set-goal gl-cx 4000)
	(set-goal gl-cy 4000)
	(set-goal gl-idx 0)
	(set-goal gl-tick 0)
	(disable-self)
)

; --- THROTTLE: advance the ring index every 6 passes ---
(defrule
	(true)
	=>
	(up-modify-goal gl-tick c:+ 1)
)
(defrule
	(up-compare-goal gl-tick c:>= 6)
	=>
	(set-goal gl-tick 0)
	(up-modify-goal gl-idx c:+ 1)
	(up-modify-goal gl-idx c:mod 16)
)

; --- DISPATCH: gl-tx = center + ring offset[idx], 16 points at radius 800 ---
(defrule (up-compare-goal gl-idx c:== 0)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 800))
(defrule (up-compare-goal gl-idx c:== 1)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 739)(up-modify-goal gl-ty c:+ 306))
(defrule (up-compare-goal gl-idx c:== 2)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 566)(up-modify-goal gl-ty c:+ 566))
(defrule (up-compare-goal gl-idx c:== 3)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 306)(up-modify-goal gl-ty c:+ 739))
(defrule (up-compare-goal gl-idx c:== 4)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-ty c:+ 800))
(defrule (up-compare-goal gl-idx c:== 5)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 306)(up-modify-goal gl-ty c:+ 739))
(defrule (up-compare-goal gl-idx c:== 6)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 566)(up-modify-goal gl-ty c:+ 566))
(defrule (up-compare-goal gl-idx c:== 7)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 739)(up-modify-goal gl-ty c:+ 306))
(defrule (up-compare-goal gl-idx c:== 8)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 800))
(defrule (up-compare-goal gl-idx c:== 9)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 739)(up-modify-goal gl-ty c:- 306))
(defrule (up-compare-goal gl-idx c:== 10) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 566)(up-modify-goal gl-ty c:- 566))
(defrule (up-compare-goal gl-idx c:== 11) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 306)(up-modify-goal gl-ty c:- 739))
(defrule (up-compare-goal gl-idx c:== 12) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-ty c:- 800))
(defrule (up-compare-goal gl-idx c:== 13) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 306)(up-modify-goal gl-ty c:- 739))
(defrule (up-compare-goal gl-idx c:== 14) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 566)(up-modify-goal gl-ty c:- 566))
(defrule (up-compare-goal gl-idx c:== 15) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 739)(up-modify-goal gl-ty c:- 306))

; --- ORDER: every pass, move the whole group toward the current waypoint ---
(defrule
	(true)
	=>
	(up-full-reset-search)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-modify-sn sn-target-point-adjustment c:= 6)
	(up-target-point gl-tx action-move -1 stance-no-attack)
	(up-modify-sn sn-target-point-adjustment c:= 5)
)
