;=============================================================================
; ddkKiteV1.per -- FIRST KITING CUT (group-level): orbit + reload-gated volley.
;
; Built on the proven circle. Each pass it reads the group leader's reload
; countdown (object_data 55 = frames until it can fire again; <=0 means loaded)
; and whether an enemy exists:
;   * loaded (na<=0) AND enemy present  -> STOP and volley the nearest enemy.
;   * reloading (na>0) OR no enemy       -> keep ORBITING the ring.
; That stutter (fire when loaded, circle while reloading) is the kite. Group-
; level (leader as the clock) -- a faithful per-unit version comes later.
;
; RADIUS here is 4 tiles (400) on purpose: for the units to shoot a CENTERED
; enemy while circling, the orbit radius must be within their attack range
; (cav archer ~4). With a chasing enemy a bigger radius also works.
; SPEED KNOB: gl-tick threshold (6).
;=============================================================================

(defconst gl-cx   250)   ; orbit center: x=250, y=251 (precise = tile*100)
(defconst gl-cy   251)
(defconst gl-tx   252)   ; current waypoint: x=252, y=253
(defconst gl-ty   253)
(defconst gl-idx  254)
(defconst gl-tick 255)
(defconst gl-na   256)   ; leader's next-attack (obj 55); <=0 = ready to fire
(defconst gl-ec   260)   ; enemy count (up-get-search-state -> 4-goal block 260..263)

(defrule
	(true)
	=>
	(set-goal gl-cx 4000)
	(set-goal gl-cy 4000)
	(set-goal gl-idx 0)
	(set-goal gl-tick 0)
	(disable-self)
)

; --- THROTTLE: advance the ring index every 6 passes ---
(defrule
	(true)
	=>
	(up-modify-goal gl-tick c:+ 1)
)
(defrule
	(up-compare-goal gl-tick c:>= 6)
	=>
	(set-goal gl-tick 0)
	(up-modify-goal gl-idx c:+ 1)
	(up-modify-goal gl-idx c:mod 16)
)

; --- DISPATCH: gl-tx = center + ring offset[idx], 16 points at radius 400 ---
(defrule (up-compare-goal gl-idx c:== 0)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 400))
(defrule (up-compare-goal gl-idx c:== 1)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 370)(up-modify-goal gl-ty c:+ 153))
(defrule (up-compare-goal gl-idx c:== 2)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 283)(up-modify-goal gl-ty c:+ 283))
(defrule (up-compare-goal gl-idx c:== 3)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 153)(up-modify-goal gl-ty c:+ 370))
(defrule (up-compare-goal gl-idx c:== 4)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-ty c:+ 400))
(defrule (up-compare-goal gl-idx c:== 5)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 153)(up-modify-goal gl-ty c:+ 370))
(defrule (up-compare-goal gl-idx c:== 6)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 283)(up-modify-goal gl-ty c:+ 283))
(defrule (up-compare-goal gl-idx c:== 7)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 370)(up-modify-goal gl-ty c:+ 153))
(defrule (up-compare-goal gl-idx c:== 8)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 400))
(defrule (up-compare-goal gl-idx c:== 9)  => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 370)(up-modify-goal gl-ty c:- 153))
(defrule (up-compare-goal gl-idx c:== 10) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 283)(up-modify-goal gl-ty c:- 283))
(defrule (up-compare-goal gl-idx c:== 11) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:- 153)(up-modify-goal gl-ty c:- 370))
(defrule (up-compare-goal gl-idx c:== 12) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-ty c:- 400))
(defrule (up-compare-goal gl-idx c:== 13) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 153)(up-modify-goal gl-ty c:- 370))
(defrule (up-compare-goal gl-idx c:== 14) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 283)(up-modify-goal gl-ty c:- 283))
(defrule (up-compare-goal gl-idx c:== 15) => (up-copy-point gl-tx gl-cx)(up-modify-goal gl-tx c:+ 370)(up-modify-goal gl-ty c:- 153))

; --- SENSE: leader's reload state + does an enemy exist ---
(defrule
	(true)
	=>
	(up-full-reset-search)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-set-target-object search-local c: 0)
	(up-get-object-data 55 gl-na)
)
(defrule
	(true)
	=>
	(up-full-reset-search)
	(up-find-remote c: -1 c: 50)
	(up-get-search-state gl-ec)
)

; --- SHOOT: loaded + enemy exists -> volley the nearest enemy (find both, same rule) ---
(defrule
	(up-compare-goal gl-na c:<= 0)
	(up-compare-goal gl-ec c:>= 1)
	=>
	(up-full-reset-search)
	(up-find-remote c: -1 c: 50)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-target-objects 0 action-default -1 -1)
)

; --- ORBIT: reloading OR no enemy -> move toward the current waypoint ---
(defrule
	(up-compare-goal gl-na c:> 0)
	=>
	(up-full-reset-search)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-modify-sn sn-target-point-adjustment c:= 6)
	(up-target-point gl-tx action-move -1 stance-no-attack)
	(up-modify-sn sn-target-point-adjustment c:= 5)
)
(defrule
	(up-compare-goal gl-ec c:== 0)
	=>
	(up-full-reset-search)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-modify-sn sn-target-point-adjustment c:= 6)
	(up-target-point gl-tx action-move -1 stance-no-attack)
	(up-modify-sn sn-target-point-adjustment c:= 5)
)
