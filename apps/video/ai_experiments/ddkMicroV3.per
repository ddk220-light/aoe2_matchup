;=============================================================================
; ddkMicroV3.per -- Immortal-style GROUP micro, ported from the verified
; mechanisms of Immortal v0d10f (2026-07-01 workflow; every citation checked):
;
;   P1 MEDIAN anchor (31528-31550) + SPEED-NORMALIZED step (42048-42066):
;      the ball is anchored at its median unit (stragglers can't drag it) and
;      no step exceeds 3.9x the unit speed -- steps complete, the ball glides.
;   P2 formation-line + DOUBLE-ISSUED order under precise adjustment (42087-92):
;      the engine does per-unit spacing = the human box-select look.
;   P3 RE-ORDER THROTTLE (41874-41886): orders only on state entry or a beat --
;      units finish walking; no stutter-step.
;   P4 GROUP reload oscillator (31756-31853, 41538-41579): VOLLEY when >=90%
;      loaded (90th-percentile obj55 <= 110), MOVE when the volley is done
;      (45th-percentile obj55 fell out of the just-fired window). Percentiles
;      via sort + indexed read -- no loops. W_fire: 350ms archers, 1000ms
;      cavalry-archer class (Immortal's per-line table 31694-31743).
;   P5 RANGE SERVO (41902-42026): error = range - gap, clamped +/-500; one
;      formula backs off AND re-approaches -> exact max-range standoff.
;   P6 IDEMPOTENT ATTACK (42218, 42350-42356): strip mid-windup units
;      (obj55 >= reload-Wfire-10) and units already on the intended target,
;      then up-target-objects _true action-default -1 -1. No animation resets.
;   P8 STRAFE with persistent sign +/-200 cross (42040-42047) + obstacle flip
;      (point-contains tree 915/wall 927/gate 939) + stuck detector +
;      path-checked fan-out escape (Illuminati I-DUC 1578-1601).
;
; KEY CORRECTION from the workflow: object_data 73 = TAG (group id), NOT an
; attacking flag (Immortal defconst line 630). V1/V2's obj73 gates read tags.
; Engagement protection is statistical (the group volley window), per Immortal.
;
; Enemy = P3 (tester convention). One homogeneous ball, all unit types
; (cmdid-military class -1). Editor-Test environment.
;=============================================================================

(defconst enemy-player 3)

; --- goals (points use g,g+1; search-state blocks own 4: gl-ec 49-52, gl-ss 53-56) ---
(defconst gl-cen-x 41)
(defconst gl-cen-y 42)
(defconst gl-en-x 43)
(defconst gl-en-y 44)
(defconst gl-move-x 45)
(defconst gl-move-y 46)
(defconst gl-dir 47)
(defconst gl-strafe 48)
(defconst gl-ec 49)
(defconst gl-ss 53)
(defconst gl-erange 57)
(defconst gl-state 58)      ; 0 idle / 1 fight-approach / 2 step / 3 volley
(defconst gl-cool 59)
(defconst gl-prev-x 60)
(defconst gl-prev-y 61)
(defconst gl-snap 62)
(defconst gl-stuck 63)
(defconst gl-fan 64)
(defconst gl-lerp 65)
(defconst gl-crossfan 66)
(defconst gl-sign 67)
(defconst gl-gap 68)
(defconst gl-w116 69)
(defconst gl-outrng 70)
(defconst gl-moved 71)
(defconst gl-mid 72)
(defconst gl-p45 73)
(defconst gl-p90 74)
(defconst gl-reload 75)
(defconst gl-range 76)
(defconst gl-speed 77)
(defconst gl-step 78)
(defconst gl-err 79)
(defconst gl-neg 80)
(defconst gl-sbeat 81)
(defconst gl-entry 82)
(defconst gl-prevstate 83)
(defconst gl-class 84)
(defconst gl-i45 85)
(defconst gl-i90 86)
(defconst gl-tid 87)
(defconst gl-len 88)
(defconst gl-beat 89)

; --- INIT ---
(defrule
	(true)
	=>
	(set-goal gl-dir 1)
	(set-goal gl-cool 0)
	(set-goal gl-snap 0)
	(set-goal gl-stuck 0)
	(set-goal gl-state 0)
	(set-goal gl-prevstate 0)
	(set-goal gl-entry 0)
	(set-goal gl-sbeat 0)
	(set-goal gl-prev-x -1)
	(set-goal gl-prev-y -1)
	(set-goal gl-cen-x 0)
	(set-goal gl-cen-y 0)
	(disable-self)
)

; --- counters ---
(defrule
	(up-compare-goal gl-cool c:> 0)
	=>
	(up-modify-goal gl-cool c:- 1)
)
(defrule
	(true)
	=>
	(up-modify-goal gl-snap c:+ 1)
	(up-modify-goal gl-sbeat c:+ 1)
)

; --- SENSE A: enemy present? ---
(defrule
	(true)
	=>
	(set-goal gl-ec 0)
	(up-modify-sn sn-focus-player-number c:= enemy-player)
	(up-full-reset-search)
	(up-find-remote c: -1 c: 50)
	(up-get-search-state gl-ec)
)

; --- SENSE B: nearest enemy -> pos, range, unique id (the intended target) ---
(defrule
	(up-compare-goal gl-ec c:>= 1)
	=>
	(up-modify-sn sn-focus-player-number c:= enemy-player)
	(up-full-reset-search)
	(up-set-target-point gl-cen-x)
	(up-find-remote c: -1 c: 50)
	(up-clean-search search-remote 44 1)
	(up-set-target-object search-remote c: 0)
	(up-get-object-data 38 gl-en-x)
	(up-get-object-data 39 gl-en-y)
	(up-get-object-data 12 gl-erange)
	(up-get-object-data 0 gl-tid)
	(up-modify-goal gl-erange c:* 100)
)

; --- SENSE C: own ball -- median anchor, stats, reload percentiles.
;     search-local (all own military) SURVIVES to the STEP order below. ---
(defrule
	(up-compare-goal gl-ec c:>= 1)
	=>
	(up-full-reset-search)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-get-search-state gl-ss)
)
; (split into 3 rules: a rule may hold at most 32 facts+actions -> ERR6002)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-ss c:>= 1)
	=>
	(up-modify-goal gl-mid g:= gl-ss)
	(up-modify-goal gl-mid c:- 1)
	(up-modify-goal gl-mid c:/ 2)
	(up-modify-goal gl-i45 g:= gl-ss)
	(up-modify-goal gl-i45 c:- 1)
	(up-modify-goal gl-i45 c:* 45)
	(up-modify-goal gl-i45 c:/ 100)
	(up-modify-goal gl-i90 g:= gl-ss)
	(up-modify-goal gl-i90 c:- 1)
	(up-modify-goal gl-i90 c:* 9)
	(up-modify-goal gl-i90 c:/ 10)
)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-ss c:>= 1)
	=>
	(up-clean-search search-local 38 1)
	(up-set-target-object search-local g: gl-mid)
	(up-get-object-data 38 gl-cen-x)
	(up-get-object-data 13 gl-speed)
	(up-get-object-data 2 gl-class)
	(up-get-object-data 54 gl-reload)
	(up-get-object-data 12 gl-range)
	(up-clean-search search-local 39 1)
	(up-set-target-object search-local g: gl-mid)
	(up-get-object-data 39 gl-cen-y)
)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-ss c:>= 1)
	=>
	(up-modify-goal gl-range c:* 100)
	(up-modify-goal gl-outrng g:= gl-range)
	(up-modify-goal gl-outrng c:- 100)
	(up-modify-goal gl-step g:= gl-speed)
	(up-modify-goal gl-step c:* 390)
	(up-modify-goal gl-step c:/ 100)
	(up-get-point-distance gl-cen-x gl-en-x gl-gap)
	(up-modify-goal gl-w116 g:= gl-reload)
	(up-modify-goal gl-w116 c:- 350)
	(up-modify-goal gl-w116 c:- 10)
)
; cavalry-archer class (936): 1000ms fire window, not 350 (Immortal 31694-31743)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-ss c:>= 1)
	(up-compare-goal gl-class c:== 936)
	=>
	(up-modify-goal gl-w116 g:= gl-reload)
	(up-modify-goal gl-w116 c:- 1000)
	(up-modify-goal gl-w116 c:- 10)
	(up-modify-goal gl-w116 c:max 100)
)
; reload percentiles: p45 (desc) = "45% just fired" probe, p90 (asc) = "90% ready" probe
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-ss c:>= 1)
	=>
	(up-clean-search search-local 55 2)
	(up-set-target-object search-local g: gl-i45)
	(up-get-object-data 55 gl-p45)
	(up-clean-search search-local 55 1)
	(up-set-target-object search-local g: gl-i90)
	(up-get-object-data 55 gl-p90)
)

; --- TRANSITIONS (state persists across passes; entry flag on change) ---
(defrule
	(up-compare-goal gl-ec c:== 0)
	=>
	(set-goal gl-state 0)
)
; non-kite matchup (we don't out-range them) or enemy far beyond reach -> fight/approach
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-erange g:>= gl-outrng)
	=>
	(set-goal gl-state 1)
)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-erange g:< gl-outrng)
	(up-compare-goal gl-state c:== 0)
	=>
	(set-goal gl-state 2)
)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-erange g:< gl-outrng)
	(up-compare-goal gl-state c:== 1)
	=>
	(set-goal gl-state 2)
)
; STEP -> VOLLEY when >=90% loaded (Immortal: var118 >= 91 @ 41571)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-erange g:< gl-outrng)
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-p90 c:<= 110)
	=>
	(set-goal gl-state 3)
)
; VOLLEY -> STEP when the volley followed through (45th pct fell out of the
; just-fired window) after a minimum dwell, or on timeout (Immortal 41538-41579)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-erange g:< gl-outrng)
	(up-compare-goal gl-state c:== 3)
	(up-compare-goal gl-sbeat c:>= 6)
	(up-compare-goal gl-p45 g:< gl-w116)
	(up-compare-goal gl-p45 c:> 0)
	=>
	(set-goal gl-state 2)
)
(defrule
	(up-compare-goal gl-ec c:>= 1)
	(up-compare-goal gl-state c:== 3)
	(up-compare-goal gl-sbeat c:>= 30)
	=>
	(set-goal gl-state 2)
)
; entry detection
(defrule
	(up-compare-goal gl-state g:!= gl-prevstate)
	=>
	(set-goal gl-entry 1)
	(set-goal gl-sbeat 0)
	(up-modify-goal gl-prevstate g:= gl-state)
)

; --- STUCK detector (STEP only): every 24 passes, ball median barely moved ---
(defrule
	(up-compare-goal gl-snap c:>= 24)
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-prev-x c:>= 0)
	=>
	(up-get-point-distance gl-cen-x gl-prev-x gl-moved)
)
(defrule
	(up-compare-goal gl-snap c:>= 24)
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-prev-x c:>= 0)
	(up-compare-goal gl-moved c:< 40)
	=>
	(set-goal gl-stuck 1)
	(up-modify-goal gl-dir c:* -1)
	(set-goal gl-cool 40)
	(set-goal gl-entry 1)
)
(defrule
	(up-compare-goal gl-snap c:>= 24)
	=>
	(set-goal gl-snap 0)
	(up-copy-point gl-prev-x gl-cen-x)
)

; --- STEP 1: destination = median + range-servo (radial) + strafe (lateral) ---
(defrule
	(up-compare-goal gl-state c:== 2)
	=>
	(up-modify-goal gl-err g:= gl-range)
	(up-modify-goal gl-err g:- gl-gap)
	(up-modify-goal gl-err c:max -500)
	(up-modify-goal gl-err c:min 500)
	(set-goal gl-neg 0)
	(up-modify-goal gl-neg g:- gl-err)
	(set-goal gl-strafe 200)
	(up-modify-goal gl-strafe g:* gl-dir)
	(up-copy-point gl-move-x gl-cen-x)
	(up-lerp-tiles gl-move-x gl-en-x g: gl-neg)
	(up-cross-tiles gl-move-x gl-en-x g: gl-strafe)
)
; --- STEP 2: speed-normalize the step (never order farther than 3.9x speed) ---
(defrule
	(up-compare-goal gl-state c:== 2)
	=>
	(up-get-point-distance gl-cen-x gl-move-x gl-len)
)
(defrule
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-len g:> gl-step)
	(up-compare-goal gl-len c:> 0)
	=>
	(up-modify-goal gl-move-x g:- gl-cen-x)
	(up-modify-goal gl-move-x g:* gl-step)
	(up-modify-goal gl-move-x g:/ gl-len)
	(up-modify-goal gl-move-x g:+ gl-cen-x)
	(up-modify-goal gl-move-y g:- gl-cen-y)
	(up-modify-goal gl-move-y g:* gl-step)
	(up-modify-goal gl-move-y g:/ gl-len)
	(up-modify-goal gl-move-y g:+ gl-cen-y)
)
; --- STEP 3: obstacle at the planned point -> flip strafe + recompute inline ---
(defrule
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-cool c:== 0)
	(or (up-point-contains gl-move-x c: 915)
	(or (up-point-contains gl-move-x c: 927)
		(up-point-contains gl-move-x c: 939)))
	=>
	(up-modify-goal gl-dir c:* -1)
	(set-goal gl-cool 40)
	(set-goal gl-entry 1)
	(set-goal gl-strafe 200)
	(up-modify-goal gl-strafe g:* gl-dir)
	(up-copy-point gl-move-x gl-cen-x)
	(up-lerp-tiles gl-move-x gl-en-x g: gl-neg)
	(up-cross-tiles gl-move-x gl-en-x g: gl-strafe)
)
; --- STEP 4: stuck -> arm the fan-out ONCE (1 -> 2; guards the -1 jump) ---
(defrule
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-stuck c:== 1)
	=>
	(set-goal gl-stuck 2)
	(set-goal gl-fan 0)
	(set-goal gl-lerp -200)
	(set-goal gl-crossfan 200)
	(up-modify-goal gl-crossfan g:* gl-dir)
	(set-goal gl-sign 100)
	(up-modify-goal gl-sign g:* gl-dir)
)
; --- STEP 5: fan-out while unreachable (Illuminati I-DUC 1578-1592) ---
(defrule
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-stuck c:== 2)
	(up-compare-goal gl-fan c:< 5)
	(up-path-distance gl-move-x 1 == 65535)
	=>
	(up-modify-goal gl-lerp c:- 100)
	(up-modify-goal gl-crossfan c:* -1)
	(up-modify-goal gl-sign c:* -1)
	(up-modify-goal gl-crossfan g:+ gl-sign)
	(up-copy-point gl-move-x gl-cen-x)
	(up-lerp-tiles gl-move-x gl-en-x g: gl-lerp)
	(up-cross-tiles gl-move-x gl-en-x g: gl-crossfan)
	(up-modify-goal gl-fan c:+ 1)
	(up-jump-rule -1)
)
(defrule
	(up-compare-goal gl-state c:== 2)
	(up-compare-goal gl-stuck c:== 2)
	(up-path-distance gl-move-x 1 != 65535)
	=>
	(set-goal gl-stuck 0)
)
; --- STEP 6: throttled, DOUBLE-ISSUED formation-line ball order (P2+P3) ---
(defrule
	(up-compare-goal gl-state c:== 2)
	=>
	(up-modify-goal gl-beat g:= gl-sbeat)
	(up-modify-goal gl-beat c:mod 10)
)
(defrule
	(up-compare-goal gl-state c:== 2)
	(or (up-compare-goal gl-entry c:== 1)
		(up-compare-goal gl-beat c:== 0))
	=>
	(set-goal gl-entry 0)
	(up-bound-precise-point gl-move-x 1 c: 100)
	(up-modify-sn sn-target-point-adjustment c:= 6)
	(up-target-point gl-move-x action-move 2 stance-no-attack)
	(up-modify-sn sn-target-point-adjustment c:= 5)
	(up-modify-sn sn-target-point-adjustment c:= 6)
	(up-target-point gl-move-x action-move 2 stance-no-attack)
	(up-modify-sn sn-target-point-adjustment c:= 5)
)

; --- ATTACK (FIGHT 1 / VOLLEY 3): idempotent Immortal recipe (P6), throttled ---
(defrule
	(or (up-compare-goal gl-state c:== 1)
		(up-compare-goal gl-state c:== 3))
	=>
	(up-modify-goal gl-beat g:= gl-sbeat)
	(up-modify-goal gl-beat c:mod 8)
)
(defrule
	(or (up-compare-goal gl-state c:== 1)
		(up-compare-goal gl-state c:== 3))
	(or (up-compare-goal gl-entry c:== 1)
		(up-compare-goal gl-beat c:== 0))
	=>
	(set-goal gl-entry 0)
	(up-modify-sn sn-focus-player-number c:= enemy-player)
	(up-full-reset-search)
	(up-set-target-point gl-cen-x)
	(up-find-remote c: -1 c: 50)
	(up-clean-search search-remote 44 1)
	(up-set-target-object search-remote c: 0)
	(up-filter-include 4 -1 -1 -1)
	(up-find-local c: -1 c: 240)
	(up-remove-objects search-local 55 g:>= gl-w116)
	(up-remove-objects search-local 23 g:== gl-tid)
	(up-target-objects 1 action-default -1 -1)
)
