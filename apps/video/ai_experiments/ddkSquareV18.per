;=== DIAGNOSTIC TRACE (Rules 78+; appended AFTER all jump targets <=76, so the
;    load-bearing numbering above is untouched; each chats ONCE via a latch) ===
;--- Rule 78 -- did the tag stick? (SM saw a non-empty tagged ball) ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:>= 1)
	(up-compare-goal gDiag1 c:== 0)
	=>
	(up-modify-goal gDiag1 c:= 1)
	(chat-to-player 1 "D1 SM ALIVE - tag stuck, ball found")
)
;--- Rule 79 -- tag did NOT stick (tagged but SM finds nothing) ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:== 0)
	(up-compare-goal gDiag2 c:== 0)
	=>
	(up-modify-goal gDiag2 c:= 1)
	(chat-to-player 1 "D2 SM EMPTY - tag did not stick")
)
;--- Rule 80 -- enemy scan found something ---
(defrule
	(up-compare-goal gECount c:>= 1)
	(up-compare-goal gDiag3 c:== 0)
	=>
	(up-modify-goal gDiag3 c:= 1)
	(chat-to-player 1 "D3 ENEMY SEEN")
)
;--- Rule 81 -- position reads broken? (ball median near map origin = garbage) ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:>= 1)
	(up-compare-goal vecMed_x c:< 100)
	(up-compare-goal gDiag4 c:== 0)
	=>
	(up-modify-goal gDiag4 c:= 1)
	(chat-to-player 1 "D4 MED NEAR ZERO - reads broken")
)
;--- Rule 82 -- state 18 reached ---
(defrule
	(up-compare-goal gState c:== 18)
	(up-compare-goal gDiag5 c:== 0)
	=>
	(up-modify-goal gDiag5 c:= 1)
	(chat-to-player 1 "D5 STATE18")
)
;--- Rule 83 -- state 22 reached ---
(defrule
	(up-compare-goal gState c:== 22)
	(up-compare-goal gDiag6 c:== 0)
	=>
	(up-modify-goal gDiag6 c:= 1)
	(chat-to-player 1 "D6 STATE22")
)
;--- Rule 84 -- enemy scan ran but empty while tagged (scan/filter/reads issue) ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:>= 1)
	(up-compare-goal gECount c:== 0)
	(up-compare-goal gDiag7 c:== 0)
	=>
	(up-modify-goal gDiag7 c:= 1)
	(chat-to-player 1 "D7 ENEMY SCAN EMPTY")
)

;=== ddkModelAI PARAMETERIZATION APPENDIX (rules 78+; runs END of pass, values
;    apply NEXT pass -- one-pass lag by design so rules 0-77 numbering never moves).
;    Every constant here is from data/golden/aoe2_reference.db (see header). ===

;--- reload-scaled kite dwell: clamp(liveReload - 1400, 400, 2200). ---
(defrule
	(true)
	=>
	(up-modify-goal gDwell g:= gReload)
	(up-modify-goal gDwell c:- 1400)
	(up-modify-goal gDwell c:max 400)
	(up-modify-goal gDwell c:min 2200)
)
;--- speed-tiered strafe/step (gSpeed = min ball speed x100, live) ---
(defrule
	(true)
	=>
	(up-modify-goal gStrafeBase c:= 200)
	(up-modify-goal gStepPct c:= 390)
)
(defrule
	(up-compare-goal gSpeed c:>= 135)
	=>
	(up-modify-goal gStrafeBase c:= 240)
	(up-modify-goal gStepPct c:= 420)
)
(defrule
	(up-compare-goal gSpeed c:<= 115)
	=>
	(up-modify-goal gStrafeBase c:= 150)
	(up-modify-goal gStepPct c:= 350)
)
;--- kite gate: kite ONLY when we out-range the enemy median. ---
(defrule
	(true)
	=>
	(up-modify-goal gKiteOK c:= 0)
)
(defrule
	(up-modify-goal gTmpA g:= gERange)
	(up-modify-goal gTmpA c:+ 1)
	(up-compare-goal gRange g:> gTmpA)
	=>
	(up-modify-goal gKiteOK c:= 1)
)
;--- failsafe: not-out-ranging ball stuck in state 18 flips to VOLLEY after 2.5s ---
(defrule
	(up-compare-goal gState c:== 18)
	(up-compare-goal gKiteOK c:== 0)
	(up-compare-goal gECount c:>= 1)
	(up-compare-goal gStateAge c:>= 2500)
	=>
	(up-modify-goal gState c:= 22)
	(up-modify-goal gStateT g:= gTimeMilli)
	(up-modify-goal gStateAge c:= 0)
	(up-modify-goal gJustChanged c:= 1)
	(chat-to-player 1 "HOLD")
)
;--- melee fallback: no ranged ball ever formed (pure-melee army) -> restore the
;    engine's auto-fight AFTER Rule 76 zeroed it, so melee-vs-melee is normal ---
(defrule
	(up-compare-goal gTagged c:== 0)
	(up-compare-goal gTimeMilli c:>= 10000)
	=>
	(up-modify-sn sn-percent-enemy-sighted-response c:= 100)
	(up-modify-sn sn-enemy-sighted-response-distance c:= 20)
	(up-modify-sn sn-task-ungrouped-soldiers c:= 1)
)
;--- W_FIRE DETECT: read the ball's median ACTUAL type (obj1) after finding all
;    ranged units (classes + melee-class throwers). Latched once. ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:>= 1)
	(up-compare-goal gWset c:== 0)
	=>
	(up-full-reset-search)
	(up-find-local c: class-archery c: 240)
	(up-find-local c: class-cavalry-archer c: 240)
	(up-find-local c: class-hand-cannoneer c: 240)
	(up-find-local c: class-conquistador c: 240)
	(up-find-local c: ballista-elephant c: 240)
	(up-find-local c: elite-ballista-elephant c: 240)
	(up-find-local c: gbeto c: 240)
	(up-find-local c: elite-gbeto c: 240)
	(up-find-local c: throwing-axeman c: 240)
	(up-find-local c: elite-throwing-axeman c: 240)
	(up-find-local c: mameluke c: 240)
	(up-find-local c: elite-mameluke c: 240)
	(up-remove-objects search-local object_data-tag c:!= 1)
	(up-clean-search search-local object_data-object-id search_order-ascending)
	(up-get-search-state vecSS)
	(up-modify-goal gTmpA g:= vecSS_L)
	(up-modify-goal gTmpA c:- 1)
	(up-modify-goal gTmpA c:/ 2)
	(up-set-target-object search-local g: gTmpA)
	(up-get-object-data object_data-object-id gUType)
	(up-get-object-data object_data-class-id gUClass)
	(up-modify-goal gWset c:= 1)
)
;--- class fallbacks first (unlisted/future types), exact type rows after (later
;    rules overwrite within the same pass) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUClass c:== class-archery)
	=>
	(up-modify-goal gWfire c:= 310)
)
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUClass c:== class-cavalry-archer)
	=>
	(up-modify-goal gWfire c:= 643)
)
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUClass c:== class-hand-cannoneer)
	=>
	(up-modify-goal gWfire c:= 310)
)
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUClass c:== class-conquistador)
	=>
	(up-modify-goal gWfire c:= 277)
)
;--- THE W_FIRE TABLE -- aoe2_reference.db final_attack_delay(ms) + 60 ---
;--- 60: Janissary/Elite (delay 0) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 46)
		(up-compare-goal gUType c:== 557))
	=>
	(up-modify-goal gWfire c:= 60)
)
;--- 227: Longbowman/Elite (167), Fire Archer/Elite (167) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (up-compare-goal gUType c:== 8)
		(up-compare-goal gUType c:== 530))
		(up-compare-goal gUType c:== 1968))
		(up-compare-goal gUType c:== 1970))
	=>
	(up-modify-goal gWfire c:= 227)
)
;--- 260: Composite Bowman/Elite (200), Genitour/Elite (200) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (up-compare-goal gUType c:== 1800)
		(up-compare-goal gUType c:== 1802))
		(up-compare-goal gUType c:== 1010))
		(up-compare-goal gUType c:== 1012))
	=>
	(up-modify-goal gWfire c:= 260)
)
;--- 260: Mameluke/Elite (200), Ballista Elephant/Elite (200) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (up-compare-goal gUType c:== 282)
		(up-compare-goal gUType c:== 556))
		(up-compare-goal gUType c:== 1120))
		(up-compare-goal gUType c:== 1122))
	=>
	(up-modify-goal gWfire c:= 260)
)
;--- 277: Conquistador/Elite (217) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 771)
		(up-compare-goal gUType c:== 773))
	=>
	(up-modify-goal gWfire c:= 277)
)
;--- 293: Slinger (233), Grenadier (233), Ratha ranged/Elite (233) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (up-compare-goal gUType c:== 185)
		(up-compare-goal gUType c:== 1911))
		(up-compare-goal gUType c:== 1759))
		(up-compare-goal gUType c:== 1761))
	=>
	(up-modify-goal gWfire c:= 293)
)
;--- 310: Archer (250), Crossbowman (250), Plumed/Elite (250), Genoese Xbow/Elite (250), Blackwood/Elite (250) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (or (or (or (or (up-compare-goal gUType c:== 4)
		(up-compare-goal gUType c:== 24))
		(up-compare-goal gUType c:== 763))
		(up-compare-goal gUType c:== 765))
		(up-compare-goal gUType c:== 866))
		(up-compare-goal gUType c:== 868))
		(up-compare-goal gUType c:== 2579))
		(up-compare-goal gUType c:== 2581))
	=>
	(up-modify-goal gWfire c:= 310)
)
;--- 310: Camel Archer/Elite (250), Hand Cannoneer (250), Arambai/Elite (250) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (or (up-compare-goal gUType c:== 1007)
		(up-compare-goal gUType c:== 1009))
		(up-compare-goal gUType c:== 5))
		(up-compare-goal gUType c:== 1126))
		(up-compare-goal gUType c:== 1128))
	=>
	(up-modify-goal gWfire c:= 310)
)
;--- 377: Skirmisher/Elite/Imperial (317), Chu Ko Nu/Elite (317), Bolas Rider/Elite (317) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (or (or (or (up-compare-goal gUType c:== 7)
		(up-compare-goal gUType c:== 6))
		(up-compare-goal gUType c:== 1155))
		(up-compare-goal gUType c:== 73))
		(up-compare-goal gUType c:== 559))
		(up-compare-goal gUType c:== 2569))
		(up-compare-goal gUType c:== 2571))
	=>
	(up-modify-goal gWfire c:= 377)
)
;--- 393: Arbalester (333) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUType c:== 492)
	=>
	(up-modify-goal gWfire c:= 393)
)
;--- 410: Kipchak/Elite (350) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 1231)
		(up-compare-goal gUType c:== 1233))
	=>
	(up-modify-goal gWfire c:= 410)
)
;--- 443: Mangudai/Elite (383), Rattan Archer/Elite (383) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (or (or (up-compare-goal gUType c:== 11)
		(up-compare-goal gUType c:== 561))
		(up-compare-goal gUType c:== 1129))
		(up-compare-goal gUType c:== 1131))
	=>
	(up-modify-goal gWfire c:= 443)
)
;--- 460: Elephant Archer/Elite (400) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 873)
		(up-compare-goal gUType c:== 875))
	=>
	(up-modify-goal gWfire c:= 460)
)
;--- 477: Guecha Warrior/Elite (417) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 2562)
		(up-compare-goal gUType c:== 2564))
	=>
	(up-modify-goal gWfire c:= 477)
)
;--- 527: Throwing Axeman/Elite (467) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 281)
		(up-compare-goal gUType c:== 531))
	=>
	(up-modify-goal gWfire c:= 527)
)
;--- 560: Gbeto/Elite (500) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 1013)
		(up-compare-goal gUType c:== 1015))
	=>
	(up-modify-goal gWfire c:= 560)
)
;--- 593: War Wagon/Elite (533) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 827)
		(up-compare-goal gUType c:== 829))
	=>
	(up-modify-goal gWfire c:= 593)
)
;--- 643: Cavalry Archer (583), Xianbei Raider (583) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(or (up-compare-goal gUType c:== 39)
		(up-compare-goal gUType c:== 1952))
	=>
	(up-modify-goal gWfire c:= 643)
)
;--- 827: Heavy Cavalry Archer (767) ---
(defrule
	(up-compare-goal gWset c:== 1)
	(up-compare-goal gUType c:== 474)
	=>
	(up-modify-goal gWfire c:= 827)
)
(defrule
	(up-compare-goal gWset c:== 1)
	=>
	(up-modify-goal gWset c:= 2)
	(chat-to-player 1 "WFIRE SET")
)
;=== DYNAMIC ENEMY PLAYER (2026-07-05 v3 -- DIPLOMACY STANCE) =====================
;   History: hardcoded 3 broke AI-on-P3 (hunted itself); up-find-player was a dud;
;   the self-excluding find-remote scan was WRONG TOO -- find-remote focused on the
;   AI's OWN player DOES return its own units, so an AI on P2 locked itself and the
;   whole ball slid to its own centroid without attacking.
;   v3 asks the engine's DIPLOMACY directly: (players-stance player-N
;   diplomacy_stance-enemy) is TRUE only for players that are my ENEMY -- I am
;   never my own enemy, so this is correct from EITHER slot by construction.
;   Immortal's exact fact form (players-stance player-N diplomacy_stance-*).
;   Re-evaluated every pass; falls back to the rule-0 default (3) when no player
;   has enemy stance (old one-way-ally arenas keep working for an AI on P2).
(defrule
	(players-stance player-2 diplomacy_stance-enemy)
	=>
	(up-modify-goal gEnemyPly c:= 2)
)
(defrule
	(players-stance player-3 diplomacy_stance-enemy)
	=>
	(up-modify-goal gEnemyPly c:= 3)
)
(defrule
	(up-compare-goal gEnemyPly c:== 2)
	(up-compare-goal gDiagE c:!= 2)
	=>
	(up-modify-goal gDiagE c:= 2)
	(chat-to-player 1 "ENEMY = P2")
)
(defrule
	(up-compare-goal gEnemyPly c:== 3)
	(up-compare-goal gDiagE c:!= 3)
	=>
	(up-modify-goal gDiagE c:= 3)
	(chat-to-player 1 "ENEMY = P3")
)
;=== ddkSquareV18 = V7 oscillation (arc 0..600) + probe.  goals 202-212. ===

;--- vecSquare := loop(gS)  (gS defaults 0 = corner A) ---
(defrule
	(up-compare-goal gS c:< 600)
	=>
	(up-modify-goal vecSquare_x c:= 500)
	(up-modify-goal vecSquare_x g:+ gS)
	(up-modify-goal vecSquare_y c:= 500)
)
(defrule
	(up-compare-goal gS c:>= 600)
	(up-compare-goal gS c:< 1200)
	=>
	(up-modify-goal vecSquare_x c:= 1100)
	(up-modify-goal gTmpA g:= gS)
	(up-modify-goal gTmpA c:- 600)
	(up-modify-goal vecSquare_y c:= 500)
	(up-modify-goal vecSquare_y g:+ gTmpA)
)
(defrule
	(up-compare-goal gS c:>= 1200)
	(up-compare-goal gS c:< 1800)
	=>
	(up-modify-goal vecSquare_y c:= 1100)
	(up-modify-goal gTmpA g:= gS)
	(up-modify-goal gTmpA c:- 1200)
	(up-modify-goal vecSquare_x c:= 1100)
	(up-modify-goal vecSquare_x g:- gTmpA)
)
(defrule
	(up-compare-goal gS c:>= 1800)
	=>
	(up-modify-goal vecSquare_x c:= 500)
	(up-modify-goal gTmpA g:= gS)
	(up-modify-goal gTmpA c:- 1800)
	(up-modify-goal vecSquare_y c:= 1100)
	(up-modify-goal vecSquare_y g:- gTmpA)
)
;--- distance from the ball to the current target ---
(defrule
	(true)
	=>
	(up-get-point-distance vecMed vecSquare gDistToTgt)
)
;--- march: V7 arrival-gated step (D<350) ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(up-compare-goal gSize c:>= 1)
	(up-compare-goal gECount c:>= 1)
	(up-compare-goal gState c:== 18)
	(up-compare-goal gDistToTgt c:< 350)
	=>
	(up-modify-goal gS g:+ gDir)
)
;--- reverse at corner B ---
(defrule
	(up-compare-goal gS c:>= 600)
	=>
	(up-modify-goal gS c:= 600)
	(up-modify-goal gDir c:= -150)
)
;--- reverse at corner A (also seeds gDir=+150) ---
(defrule
	(up-compare-goal gS c:<= 0)
	=>
	(up-modify-goal gS c:= 0)
	(up-modify-goal gDir c:= 150)
)
;--- LOG: one packed message per target change.  packed = x*10000 + y ---
(defrule
	(up-compare-goal gTagged c:== 1)
	(nand (up-compare-goal vecSquare_x g:== gLastX)
		(up-compare-goal vecSquare_y g:== gLastY))
	=>
	(up-modify-goal gLastX g:= vecSquare_x)
	(up-modify-goal gLastY g:= vecSquare_y)
	(up-modify-goal gPacked g:= vecSquare_x)
	(up-modify-goal gPacked c:* 10000)
	(up-modify-goal gPacked g:+ vecSquare_y)
	(up-chat-data-to-player 1 "xy=%d" g: gPacked)
)
;--- PROBE every 1000ms: P=gTagged*100+gState ; E=gS ; D=gDistToTgt ; N=gECount ---
(defrule
	(up-modify-goal gDbgTmp g:= gTimeMilli)
	(up-modify-goal gDbgTmp g:- gDbgT)
	(up-compare-goal gDbgTmp c:>= 1000)
	=>
	(up-modify-goal gDbgT g:= gTimeMilli)
	(up-modify-goal gProbe g:= gTagged)
	(up-modify-goal gProbe c:* 100)
	(up-modify-goal gProbe g:+ gState)
	(up-chat-data-to-player 1 "P=%d" g: gProbe)
	(up-chat-data-to-player 1 "E=%d" g: gS)
	(up-chat-data-to-player 1 "D=%d" g: gDistToTgt)
	(up-chat-data-to-player 1 "N=%d" g: gECount)
)
