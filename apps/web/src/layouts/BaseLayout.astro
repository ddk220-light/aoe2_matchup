---
import about from '../generated/about.json';
import release from '../generated/release.json';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import '../styles/base.css';
import '../styles/navigation.css';
import '../styles/foundations.css';
const {page = about, title = page.title, metadata = true, assets = false} = Astro.props;
// Stylesheets and fonts are owned by this app; only document links are kept.
const links = page.links.filter(link => ['canonical', 'icon', 'alternate', 'prev', 'next'].includes(link.rel));
const fonts = 'https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    {metadata && page.meta.filter(m => !['viewport'].includes(m.name) && !m.charset).map(m => <meta {...m} />)}
    {metadata && links.map(link => <link {...link} />)}
    {!metadata && <meta name="robots" content="noindex, nofollow" />}
    {!metadata && <link rel="icon" type="image/png" href="/static/img/favicon.png" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />
    <script is:inline>
      try { var t = localStorage.getItem('aoe2-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <script>
      import '../lib/telemetry.mjs';
    </script>
    {metadata && page.structured.map(value => <script is:inline type="application/ld+json" set:html={value} />)}
    <slot name="head" />
  </head>
  <body>
    <SiteNav />
    <slot />
    <SiteFooter />
    {assets && <>
      <script is:inline set:html={about.catalog_script} />
      <script is:inline src={release.components.media.catalog_url} />
      <script is:inline src="/static/js/constants.js" />
      <script is:inline src="/static/js/api_client.js" />
    </>}
    <slot name="scripts" />
  </body>
</html>
