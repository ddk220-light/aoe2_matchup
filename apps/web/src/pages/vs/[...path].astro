---
export const prerender=false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import pages from '../../generated/remaining-pages.json';
import {frameFor} from '../../features/remaining/metadata.mjs';
import catalog from '../../generated/public-catalog.json';
import {roster} from '../../features/civilizations/data';
import '../../features/remaining/matchup.css';
const parts=(Astro.params.path??'').split('/');
const [ca,ua,cb,ub]=parts;
const a=pages.landing_units[`${ca}/${ua}`],b=pages.landing_units[`${cb}/${ub}`];
if(parts.length!==4||!pages.valid_civs.includes(ca)||!pages.valid_civs.includes(cb)||!a||!b)return new Response('Not found',{status:404,headers:{'Cache-Control':'no-store'}});
const pretty=s=>s.replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
const an=a.unit_name||pretty(ua),bn=b.unit_name||pretty(ub),canonical=`https://aoe2matchup.com/vs/${ca}/${ua}/${cb}/${ub}`;
const title=`${an} (${ca}) vs ${bn} (${cb}) — Who Wins? | AoE2 Simulator`;
const description=`Simulated 1v1 result for ${an} (${ca}) versus ${bn} (${cb}) in Age of Empires II at full upgrades. Stat comparison, costs, armor classes, and a live battle simulator to test it yourself.`;
const int=n=>Math.trunc(n||0);
const structured=[{'@context':'https://schema.org','@type':'FAQPage',mainEntity:[
 {'@type':'Question',name:`Who wins, ${an} (${ca}) or ${bn} (${cb})?`,acceptedAnswer:{'@type':'Answer',text:`Run the live battle simulator at ${canonical} to see the tick-by-tick result. The page shows full upgraded stats, costs, and armor classes for both units.`}},
 ...[[a,an,ca],[b,bn,cb]].map(([u,name,civ])=>({'@type':'Question',name:`What are the full stats for ${name}?`,acceptedAnswer:{'@type':'Answer',text:`${name} (${civ}, Imperial Age, fully upgraded): ${int(u.final_hp)} HP, ${int(u.final_attack)} attack, ${int(u.final_melee_armor)}/${int(u.final_pierce_armor)} armor.`}}))
 ]},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[['Home','/'],['Matchups','/matchups'],[`${an} vs ${bn}`,`/vs/${ca}/${ua}/${cb}/${ub}`]].map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:'https://aoe2matchup.com'+path}))}];
const frame=frameFor(pages.landing_frame,title,description,canonical,structured);
const related=[];for(const [civ,slug,name] of pages.related_units){if(civ===ca||civ===cb)continue;related.push([`/vs/${ca}/${ua}/${civ}/${slug}`,`${an} vs ${name}`],[`/vs/${civ}/${slug}/${cb}/${ub}`,`${name} vs ${bn}`]);if(related.length>=12)break;}
Astro.response.headers.set('Cache-Control','public, max-age=0, must-revalidate');
Astro.response.headers.set('Vercel-CDN-Cache-Control','public, s-maxage=86400');
const num=(x,y)=>x===y?'':x>y?'a':'b';
const cost=u=>[['food','food'],['wood','wood'],['gold','gold']].filter(([key])=>u['final_cost_'+key]).map(([key,word])=>`${int(u['final_cost_'+key])} ${word}`).join(', ');
const rows=[['Hit points',int(a.final_hp),int(b.final_hp),num(int(a.final_hp),int(b.final_hp))],
 ['Attack',int(a.final_attack),int(b.final_attack),num(int(a.final_attack),int(b.final_attack))],
 ['Melee armor',int(a.final_melee_armor),int(b.final_melee_armor),num(int(a.final_melee_armor),int(b.final_melee_armor))],
 ['Pierce armor',int(a.final_pierce_armor),int(b.final_pierce_armor),num(int(a.final_pierce_armor),int(b.final_pierce_armor))],
 ...(a.final_range||b.final_range?[['Range',a.final_range?int(a.final_range):'melee',b.final_range?int(b.final_range):'melee',num(int(a.final_range),int(b.final_range))]]:[]),
 ['Speed',a._speed,b._speed,num(Number(a._speed),Number(b._speed))],['Cost',cost(a),cost(b),'']];
const emblems=Object.fromEntries(roster.map(civ=>[civ.name,civ.emblem.url]));
const sides=[{key:'a',name:an,civ:ca,emblem:emblems[ca],sprite:catalog.sprites[an]?.url_blue||catalog.sprites[an]?.url},
 {key:'b',name:bn,civ:cb,emblem:emblems[cb],sprite:catalog.sprites[bn]?.url}];
---
<BaseLayout page={frame}>
 <div class="page-header">
  <p class="crumbs"><a href="/matchups">Matchups</a> / {an} vs {bn}</p>
  <h1>{an} vs {bn}</h1>
  <p class="subtitle">{ca} {an} against {cb} {bn}, both fully upgraded in the Imperial Age.</p>
 </div>
 <main class="container matchup-landing">
  <table class="versus">
   <thead><tr><th scope="col"><span class="visually-hidden">Stat</span></th>
    {sides.map(side=><th scope="col" class={`versus-unit versus-${side.key}`}>{side.sprite&&<img src={side.sprite} alt="" width="72" height="72" loading="eager" decoding="async"/>}<span class="versus-name">{side.name}</span><span class="versus-civ">{side.emblem&&<img src={side.emblem} alt="" width="18" height="18"/>}{side.civ}</span></th>)}
   </tr></thead>
   <tbody>{rows.map(([label,av,bv,lead])=><tr><th scope="row">{label}</th><td class:list={{lead:lead==='a'}}>{av}</td><td class:list={{lead:lead==='b'}}>{bv}</td></tr>)}</tbody>
  </table>
  <div class="versus-action">
   <a class="btn btn-gold versus-run" href={`/?a_civ=${ca}&a_unit=${ua}&b_civ=${cb}&b_unit=${ub}`}>Watch this fight in the simulator</a>
   <p>Stats alone do not settle it. The simulator plays the fight out with armor classes, attack delays, projectile travel, charges and every special ability.</p>
  </div>
  <p class="body-copy">These are the Imperial Age stats with every blacksmith, university and unique technology the civilization has, plus the civilization bonuses that apply to the unit. For the wider picture see the <a href="/units">unit rankings</a> or the <a href={`/civilizations/${ca.toLowerCase()}`}>{ca}</a> and <a href={`/civilizations/${cb.toLowerCase()}`}>{cb}</a> pages.</p>
  {related.length>0&&<nav class="related-matchups" aria-label="Related matchups"><h2 class="section-title">Related matchups</h2><ul>{related.map(([url,label])=><li><a href={url}>{label}</a></li>)}</ul></nav>}
 </main>
</BaseLayout>
