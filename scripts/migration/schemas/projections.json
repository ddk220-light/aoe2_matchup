{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoe2matchup.com/schemas/migration/projections-v1.json",
  "$defs": {
    "civilizations": {
      "type": "object", "required": ["civ_name", "age", "power_units"],
      "properties": {"civ_name": {"type": "string"}, "age": {"const": "imperial"}, "power_units": {"type": "object"}}
    },
    "advisorCategory": {"enum":["dominance","kite","plain_win","power_win","eco_win","close","cheap_loss","plain_loss",
      "kited_loss","outclassed_loss","pending"]},
    "advisor": {"oneOf": [
      {"type":"object","required":["civilizations","units","emblems","dataset","eco"],"properties":{
        "civilizations":{"type":"array","minItems":56,"maxItems":56,"uniqueItems":true,"items":{"type":"string"}},
        "units":{"type":"array","minItems":555,"maxItems":555,"items":{"type":"object","required":["id","name","civilization","profileHash","costs","icon","full_research_vm"],
          "properties":{"full_research_vm":{"type":["number","null"],"minimum":0}}}},
        "eco":{"type":"object","required":["schemaVersion","thresholds","categories","rounding","row_fields"],"properties":{
          "schemaVersion":{"const":1},"row_fields":{"type":"array","minItems":14,"maxItems":14}}},
        "dataset":{"type":"object","required":["source_commit","source_files","unresolvedPairs"],"properties":{"unresolvedPairs":{"const":0}}}}},
      {"type":"object","required":["civilization","opponents","source_commit","row_fields"],"properties":{
        "civilization":{"type":"string"},"source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "row_fields":{"type":"array","minItems":14,"maxItems":14},
        "opponents":{"type":"object","minProperties":55,"maxProperties":55,"additionalProperties":{"type":"array","minItems":1,"items":{
          "type":"array","minItems":14,"maxItems":14,"prefixItems":[
            {"type":"integer","minimum":0,"maximum":554},{"type":"integer","minimum":0,"maximum":554},
            {"enum":["a_win","b_win","close_uncertain","equivalent"]},{"enum":["observed","inferred","identity","predicted_unvalidated"]},
            {"type":"integer","minimum":1,"maximum":27},{"type":"integer","minimum":1,"maximum":27},
            {"type":"string"},{"type":"integer","minimum":0,"maximum":3},{"type":"integer","minimum":0,"maximum":68915},
            {"$ref":"#/$defs/advisorCategory"},{"$ref":"#/$defs/advisorCategory"},
            {"type":["number","null"],"minimum":0,"maximum":1.5},
            {"type":["number","null"],"exclusiveMinimum":0},{"type":["number","null"],"exclusiveMinimum":0}]}}}}}
    ]},
    "rankings": {
      "type": "object", "required": ["line_name", "building", "imperial"],
      "properties": {"line_name": {"type": "string"}, "building": {"type": "string"},
        "imperial": {"type": "array", "items": {"type": "object", "required": ["id", "civ_name", "unit_slug", "unit_name"],
          "properties": {"id": {"type": "integer"}, "civ_name": {"type": "string"}, "unit_slug": {"type": "string"}, "unit_name": {"type": "string"}}}}}
    },
    "simulator": {
      "type": "object", "required": ["civ_name", "units_by_age", "total_units"],
      "properties": {"civ_name": {"type": "string"}, "units_by_age": {"type": "object"}, "total_units": {"type": "integer", "minimum": 1}}
    },
    "economy": {"oneOf": [
      {"type":"object","required":["civilizations","metadata"],"additionalProperties":false,"properties":{
        "civilizations":{"type":"array","minItems":56,"maxItems":56,"uniqueItems":true,"items":{"type":"string"}},
        "metadata":{"type":"object","required":["schemaVersion","contextVersion","trainingWindowSeconds","resourceWeights",
            "releaseReady","assumptions","civilizationCount","profileCount","sourceHashes"],"properties":{
          "schemaVersion":{"const":4},"contextVersion":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "trainingWindowSeconds":{"const":60},"releaseReady":{"const":true},"civilizationCount":{"const":56},
          "profileCount":{"type":"integer","minimum":1},"assumptions":{"type":"array","minItems":1,"items":{"type":"string"}},
          "resourceWeights":{"type":"object","required":["food","wood","gold","stone"],"additionalProperties":false,
            "properties":{"food":{"type":"number"},"wood":{"type":"number"},"gold":{"type":"number"},"stone":{"type":"number"}}}}}}},
      {"type":"object","required":["civ","civilization","units","contextVersion","schemaVersion"],"additionalProperties":false,"properties":{
        "civ":{"type":"string"},"contextVersion":{"type":"string","pattern":"^[a-f0-9]{64}$"},"schemaVersion":{"const":4},
        "civilization":{"type":"object","required":["civ","activities","laborPrices","laborStatus","technologies","notes"],"properties":{
          "civ":{"type":"string"},"activities":{"type":"array"},"technologies":{"type":"array"},
          "laborPrices":{"type":["array","null"],"items":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number"}}}}},
        "units":{"type":"array","minItems":1,"items":{"type":"object",
          "required":["civ","unitId","mode","name","slug","pricing","productionRoutes","research","lookup"],"properties":{
            "civ":{"type":"string"},"unitId":{"type":"integer"},"mode":{"type":"string"},"name":{"type":"string"},
            "pricing":{"type":"object","required":["unitsPerPurchase"],"properties":{"unitsPerPurchase":{"type":"integer","minimum":1}}},
            "productionRoutes":{"type":"array","items":{"type":"object","required":["id","secondsPerOrder","cost"]}},
            "research":{"type":"object","required":["military","production","economicSetup"]},
            "lookup":{"type":"array","minItems":28,"maxItems":28,"items":{"type":"object",
              "required":["count","orders","producedUnits","surplusUnits","cost"]}}}}}}}
    ]}
  }
}
